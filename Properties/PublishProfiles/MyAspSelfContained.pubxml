<Project>
  <Import Project="MyAspFolder.pubxml" />
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
    <PublishDir>$(MSBuildProjectDirectory)\.tmp-owner-build\myasp-selfcontained\</PublishDir>
    <PublishUrl>$(PublishDir)</PublishUrl>
  </PropertyGroup>
</Project>
