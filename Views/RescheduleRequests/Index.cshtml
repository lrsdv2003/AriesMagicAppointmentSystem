@model AriesMagicAppointmentSystem.ViewModels.RescheduleRequestIndexViewModel
@using AriesMagicAppointmentSystem.Models
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Reschedule Requests";
    var canDecide = User.CanApproveRescheduleRequests();
    var staffOnly = User.IsInRole("Staff") && !User.IsInRole("Owner");
    string BookingCode(Booking booking) => $"BK-{booking.CreatedAt.Year}-{booking.Id:D3}";
    DateTime? OriginalDate(RescheduleRequest request) => request.OriginalDate ?? (request.Status == RescheduleRequestStatus.Pending ? request.Booking?.EventDate : null);
    DateTime? OriginalStart(RescheduleRequest request) => request.OriginalStartTime ?? (request.Status == RescheduleRequestStatus.Pending ? request.Booking?.StartTime : null);
    DateTime? OriginalEnd(RescheduleRequest request) => request.OriginalEndTime ?? (request.Status == RescheduleRequestStatus.Pending ? request.Booking?.EndTime : null);
    string AvailabilityClass(string state) => state switch {
        "Available" => "reschedule-availability-available",
        "Processed" => "reschedule-availability-processed",
        _ => "reschedule-availability-conflict"
    };
    string StatusClass(string status) => status switch {
        RescheduleRequestStatus.Approved => "status-approved",
        RescheduleRequestStatus.Rejected => "status-rejected",
        _ => "status-pending"
    };
}

<div class="staff-reschedule-page staff-final-round-list">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }
    <div class="am-filter-container">
        <form method="get" asp-action="Index" class="am-filter-bar am-filter-row staff-final-filter-toolbar aries-round3-toolbar" data-staff-autosearch="reschedules" role="search">


            <label class="visually-hidden" for="rescheduleSearch">Search reschedule requests</label>
            <div class="am-filter-search"><i class="bi bi-search" aria-hidden="true"></i><input id="rescheduleSearch" type="search" name="search" value="@Model.Search" class="form-control" placeholder="Booking ID, client, or package" /></div>
@if (staffOnly)
            {
                <div class="staff-part3-sort-control">
                    <label for="rescheduleSort">Sort by</label>
                    <select id="rescheduleSort" name="sortBy" class="form-select" aria-label="Sort pending reschedule requests">
                        <option value="newest" selected="@(Model.SortBy != "oldest")">Newest to Oldest</option>
                        <option value="oldest" selected="@(Model.SortBy == "oldest")">Oldest to Newest</option>
                    </select>
                </div>
            }
            else
            {
                <div class="dropdown"><button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"><i class="bi bi-funnel" aria-hidden="true"></i> Filters</button><div class="dropdown-menu dropdown-menu-end">
                    <label class="form-label" for="rescheduleStatus">Request status</label>
                    <select id="rescheduleStatus" name="status" class="form-select mb-3">
                        <option value="Pending" selected="@(Model.StatusFilter == RescheduleRequestStatus.Pending)">Pending review</option>
                        <option value="All" selected="@(Model.StatusFilter == "All")">All requests</option>
                        <option value="Approved" selected="@(Model.StatusFilter == RescheduleRequestStatus.Approved)">Approved</option>
                        <option value="Rejected" selected="@(Model.StatusFilter == RescheduleRequestStatus.Rejected)">Rejected</option>
                    </select>
                    <label class="form-label" for="rescheduleSortOwner">Sort requests</label>
                    <select id="rescheduleSortOwner" name="sortBy" class="form-select">
                        <option value="newest" selected="@(Model.SortBy != "oldest")">Newest first</option>
                        <option value="oldest" selected="@(Model.SortBy == "oldest")">Oldest first</option>
                    </select>
                </div></div>
            }<button type="button" class="btn btn-outline-secondary aries-refresh-now"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i><span class="visually-hidden">Refresh requests</span></button><button type="submit" class="visually-hidden">Search reschedules</button></form>
    </div>

    <div class="dashboard-panel staff-reschedule-table-panel">
        @if (!staffOnly)
        {
            <div class="staff-reschedule-panel-heading">
                <div>
                    <h2>@(Model.StatusFilter == RescheduleRequestStatus.Pending ? "Pending Reschedule Requests" : "Reschedule Request History")</h2>
                    <p>@(Model.StatusFilter == RescheduleRequestStatus.Pending ? "Only requests still requiring a Staff decision appear here by default." : "Processed requests remain available for audit and reference.")</p>
                </div>
                @if(Model.StatusFilter != RescheduleRequestStatus.Pending){
                    <a class="btn btn-outline-primary staff-round2-history-link" asp-action="Index" asp-route-status="Pending">Back to pending reviews</a>
                }
            </div>
        }

        @if (!Model.Requests.Any())
        {
            <div class="empty-state staff-reschedule-empty">
                <i class="bi bi-calendar2-check" aria-hidden="true"></i>
                <h3>@(Model.StatusFilter == RescheduleRequestStatus.Pending ? "No pending reschedule requests." : "No matching reschedule requests found.")</h3>
                <p>@(Model.StatusFilter == RescheduleRequestStatus.Pending ? "There is nothing waiting for Staff review right now." : "Try another search or status filter.")</p>
            </div>
        }
        else
        {
            <div class="table-responsive staff-reschedule-table-wrap">
                <table class="table align-middle staff-reschedule-table">
                    <thead>
                        <tr>
                            <th scope="col">Booking</th>
                            <th scope="col">Client</th>
                            <th scope="col">Original Date &amp; Time</th>
                            <th scope="col">Requested Date &amp; Time</th>
                            <th scope="col">Requested on</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Requests)
                    {
                        var request = item.Request;
                        var booking = request.Booking!;
                        var bookingCode = BookingCode(booking);
                        var originalDate = OriginalDate(request);
                        var originalStart = OriginalStart(request);
                        var originalEnd = OriginalEnd(request);
                        var originalDisplay = originalDate.HasValue && originalStart.HasValue && originalEnd.HasValue
                            ? $"{originalDate.Value:MMMM dd, yyyy}|{originalStart.Value:hh:mm tt} – {originalEnd.Value:hh:mm tt}"
                            : "Historical original schedule unavailable|—";
                        var requestedDisplay = $"{request.RequestedDate:MMMM dd, yyyy}|{request.RequestedStartTime:hh:mm tt} – {request.RequestedEndTime:hh:mm tt}";
                        <tr>
                            <td data-label="Booking"><strong class="staff-booking-code">@bookingCode</strong></td>
                            <td data-label="Client"><strong>@(booking.Client?.FullName ?? "Unknown client")</strong></td>
                            <td data-label="Original schedule">
                                <div class="reschedule-schedule neutral">
                                    <strong>@originalDisplay.Split('|')[0]</strong>
                                    <small>@originalDisplay.Split('|')[1]</small>
                                </div>
                            </td>
                            <td data-label="Requested schedule">
                                <div class="reschedule-schedule requested">
                                    <strong>@requestedDisplay.Split('|')[0]</strong>
                                    <small>@requestedDisplay.Split('|')[1]</small>
                                    @if (request.Status == RescheduleRequestStatus.Pending)
                                    {
                                        <span class="reschedule-availability @AvailabilityClass(item.Availability.State)"><i class="bi @(item.Availability.IsAvailable ? "bi-check-circle" : "bi-exclamation-triangle")" aria-hidden="true"></i> @item.Availability.State</span>
                                    }
                                </div>
                            </td>
                            <td data-label="Requested on"><time datetime="@request.CreatedAt.ToString("O")">@request.CreatedAt.ToString("MMM d, yyyy")</time></td>
                            <td data-label="Status"><span class="status-badge @StatusClass(request.Status)">@request.Status</span></td>
                            <td data-label="Actions" class="text-end">
                                <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-primary staff-final-details-action"><i class="bi bi-eye" aria-hidden="true"></i> View Details</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="staff-reschedule-cards">
                @foreach (var item in Model.Requests)
                {
                    var request = item.Request;
                    var booking = request.Booking!;
                    var bookingCode = BookingCode(booking);
                    var originalDate = OriginalDate(request);
                    var originalStart = OriginalStart(request);
                    var originalEnd = OriginalEnd(request);
                    var originalText = originalDate.HasValue && originalStart.HasValue && originalEnd.HasValue ? $"{originalDate.Value:MMM dd, yyyy} · {originalStart.Value:hh:mm tt} – {originalEnd.Value:hh:mm tt}" : "Historical original schedule unavailable";
                    var requestedText = $"{request.RequestedDate:MMM dd, yyyy} · {request.RequestedStartTime:hh:mm tt} – {request.RequestedEndTime:hh:mm tt}";
                    <article class="staff-reschedule-card">
                        <div class="staff-reschedule-card-head"><div><strong class="staff-booking-code">@bookingCode</strong></div><span class="status-badge @StatusClass(request.Status)">@request.Status</span></div>
                        <small class="staff-round1-requested-at">Requested @request.CreatedAt.ToString("MMM d, yyyy")</small>
                        <strong class="staff-reschedule-client">@(booking.Client?.FullName ?? "Unknown client")</strong>
                        <div class="staff-reschedule-card-schedules">
                            <div class="reschedule-schedule neutral"><strong>@originalText</strong></div>
                            <i class="bi bi-arrow-right reschedule-change-arrow" aria-hidden="true"></i>
                            <div class="reschedule-schedule requested"><strong>@requestedText</strong>@if (request.Status == RescheduleRequestStatus.Pending){<span class="reschedule-availability @AvailabilityClass(item.Availability.State)">@item.Availability.State</span>}</div>
                        </div>
                        <div class="staff-reschedule-card-actions">
                            <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-primary staff-final-details-action"><i class="bi bi-eye" aria-hidden="true"></i> View Details</a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
@{
    var reschedulePager = new AriesMagicAppointmentSystem.ViewModels.QueuePaginationViewModel(
        Model.TotalCount, Model.Page, 5, "Index", new Dictionary<string,string> {
            ["status"] = staffOnly ? "Pending" : (Model.StatusFilter ?? "Pending"),
            ["search"] = Model.Search ?? "",
            ["requestedDate"] = Model.RequestedDate?.ToString("yyyy-MM-dd") ?? "",
            ["sortBy"] = Model.SortBy
        });
}
<partial name="_QueuePagination" model="reschedulePager" />
</div>
