@model AriesMagicAppointmentSystem.ViewModels.RescheduleRequestCreateViewModel
@using System.Text.Json
@{ ViewData["Title"] = "Request reschedule"; ViewData["BookingExperience"] = true; }
<div class="cn-page cn-reschedule-page">
<header class="cn-page-heading"><div><p class="cn-kicker">A change of plans</p><h1>Choose a new date.</h1></div><a asp-action="MyRequests" class="cn-text-link">My requests</a></header>
@if (!Model.Bookings.Any())
{
    <section class="cn-empty"><h2>No booking is available for rescheduling.</h2><p>Open your bookings to check their status and available actions.</p><a asp-controller="Bookings" asp-action="MyBookings" class="cn-button cn-primary">View my bookings</a></section>
}
else
{
<form asp-action="Create" method="post" id="clientRescheduleForm" data-booking-submit data-availability-url="@Url.Action("CheckRescheduleDateAvailability")" data-ranges-url="@Url.Action("GetUnavailableTimeRanges")">
@Html.AntiForgeryToken()
<div asp-validation-summary="All" class="cn-error-summary" role="alert" tabindex="-1"></div>
<div class="cn-current-booking"><div class="cn-field"><label asp-for="BookingId">Booking to reschedule</label><select asp-for="BookingId" asp-items="Model.Bookings" class="cn-input" required aria-describedby="currentSchedule BookingIdError"><option value="">Select your booking</option></select><span asp-validation-for="BookingId" id="BookingIdError" class="cn-field-error"></span></div><p id="currentSchedule" class="cn-current-schedule" aria-live="polite">Select a booking to see its current schedule.</p></div>
<div class="cn-reschedule-layout">
<section class="cn-panel cn-calendar-panel" aria-labelledby="newDateTitle"><div class="cn-panel-heading"><h2 id="newDateTitle">1. Pick a new date</h2><p>At least three days ahead. Blocked dates cannot be selected.</p></div>
<div id="rescheduleCalendar" data-calendar-for="RequestedDate" hidden></div>
<details class="cn-date-entry" id="manualDate" open><summary>Enter a date manually</summary><div class="cn-field"><label asp-for="RequestedDate">New requested date</label><input asp-for="RequestedDate" type="date" min="@DateTime.Today.AddDays(3).ToString("yyyy-MM-dd")" class="cn-input" required aria-describedby="RequestedDateError"/><span asp-validation-for="RequestedDate" id="RequestedDateError" class="cn-field-error"></span></div></details>
<p class="cn-help">Date capacity and complete schedule availability are checked separately.</p>
</section>
<section class="cn-panel cn-time-panel" aria-labelledby="newTimeTitle"><div class="cn-panel-heading"><h2 id="newTimeTitle">2. Set the time</h2><p id="rescheduleDuration">Your package duration stays the same.</p></div>
<div class="cn-field"><label asp-for="RequestedStartTime">New start time</label><input asp-for="RequestedStartTime" type="time" class="cn-input" required aria-describedby="timeHelp RequestedStartTimeError"/><span asp-validation-for="RequestedStartTime" id="RequestedStartTimeError" class="cn-field-error"></span><p class="cn-help" id="timeHelp">The required one-hour buffer is preserved.</p></div>
<div id="rescheduleAvailability" class="cn-notice" role="status" aria-live="polite">Choose your booking and date to check capacity.</div><div id="rescheduleRanges" class="cn-time-ranges"></div>
<button type="button" class="cn-edit" id="checkReschedule">Refresh availability</button>
<div class="cn-field cn-reason"><label asp-for="Reason">Reason for the change</label><textarea asp-for="Reason" class="cn-input" rows="2" required placeholder="Briefly tell Staff why you need a new schedule"></textarea><span asp-validation-for="Reason" id="ReasonError" class="cn-field-error"></span></div>
<div class="cn-approval-note"><strong>Staff approval is required.</strong><span>Your current schedule stays in place until the request is approved.</span></div>
<div class="cn-actions"><button type="submit" class="cn-button cn-primary" id="submitRescheduleBtn">Request this schedule <span aria-hidden="true">→</span></button></div>
</section>
</div>
</form>
@await Component.InvokeAsync("BookingContext", new { allowedIds = Model.Bookings.Select(b => b.Value) })
<script type="application/json" id="rescheduleBlockedDates">@Html.Raw(JsonSerializer.Serialize(ViewBag.UnavailableDates as List<string> ?? new()))</script>
}
</div>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script src="~/js/booking-experience.js" asp-append-version="true"></script><script src="~/js/concierge-calendar.js" asp-append-version="true"></script> }
