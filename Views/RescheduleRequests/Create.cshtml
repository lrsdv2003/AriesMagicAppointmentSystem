@model AriesMagicAppointmentSystem.ViewModels.RescheduleRequestCreateViewModel
@using System.Text.Json
@{
 ViewData["Title"]="Request reschedule";
 ViewData["BookingExperience"]=true;
}
<link rel="stylesheet" href="~/css/client-round2-20261108.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/client-ultra-20261108.css" asp-append-version="true"/>
<div class="cn-page cn-reschedule-page r2-reschedule-wizard">
 <header class="cn-page-heading"><div><p class="cn-kicker">Change of plans</p><h1>Reschedule booking.</h1><p>Choose a new date and time. Your original booking remains confirmed until Staff approves your request.</p></div></header>
 @if(!Model.Bookings.Any()){
  <section class="cn-empty"><h2>No bookings available for rescheduling</h2><p>You currently have no verified bookings eligible for rescheduling.</p><a asp-controller="Bookings" asp-action="MyBookings" class="cn-button cn-primary">View my bookings</a></section>
 }else{
 <ol class="cr-steps r2-reschedule-steps" id="r2RescheduleSteps" aria-label="Reschedule progress">
  <li class="is-active" aria-current="step"><span>New schedule</span></li>
  <li><span>Review</span></li>
  <li><span>Request submitted</span></li>
 </ol>
 <div class="r2-reschedule-layout">
 <form asp-action="Create" method="post" id="clientRescheduleForm" data-booking-submit data-availability-url="@Url.Action("CheckRescheduleDateAvailability")" data-ranges-url="@Url.Action("GetUnavailableTimeRanges")">
  @Html.AntiForgeryToken()
  <div asp-validation-summary="All" class="cn-error-summary" role="alert" tabindex="-1"></div>
  <section class="cn-panel r2-reschedule-panel" id="r2RescheduleEdit">
   <div class="cn-panel-heading"><h2 tabindex="-1"><i class="bi bi-calendar-event" aria-hidden="true"></i> Pick your new schedule</h2><p>Select the booking and enter your proposed date and time.</p></div>
   <div class="cn-field"><label asp-for="BookingId">Booking to reschedule</label><select asp-for="BookingId" asp-items="Model.Bookings" class="cn-input" required aria-describedby="currentSchedule BookingIdError"><option value="">Select your verified booking</option></select><span asp-validation-for="BookingId" id="BookingIdError" class="cn-field-error"></span></div>
   <p id="currentSchedule" class="cn-current-schedule" aria-live="polite">Select a booking to view the current schedule.</p>
   <div class="r2-reschedule-step-line">
    <span class="r2-step-bubble">1</span><div class="cn-field"><label asp-for="RequestedDate">Pick a new date</label><p class="cn-help">Choose an event date at least three days ahead.</p><input asp-for="RequestedDate" type="date" min="@DateTime.Today.AddDays(3).ToString("yyyy-MM-dd")" class="cn-input" required aria-describedby="RequestedDateError"/><span asp-validation-for="RequestedDate" id="RequestedDateError" class="cn-field-error"></span></div>
   </div>
   <div class="r2-reschedule-step-line">
    <span class="r2-step-bubble">2</span><div class="cn-field"><label asp-for="RequestedStartTime">Set the time</label><p class="cn-help" id="rescheduleDuration">Your package duration remains unchanged.</p><input asp-for="RequestedStartTime" type="time" class="cn-input" required aria-describedby="timeHelp RequestedStartTimeError"/><span asp-validation-for="RequestedStartTime" id="RequestedStartTimeError" class="cn-field-error"></span><p class="cn-help" id="timeHelp">The required one-hour buffer is preserved.</p></div>
   </div>
   <div id="rescheduleAvailability" class="cn-notice" role="status" aria-live="polite">Choose a booking and date to check availability.</div>
   <div id="rescheduleRanges" class="cn-time-ranges"></div>
   <div class="r2-reschedule-step-line">
    <span class="r2-step-bubble">3</span><div class="cn-field cn-reason"><label asp-for="Reason">Reason for rescheduling</label><p class="cn-help">Briefly tell Staff why you need to change the schedule.</p><textarea asp-for="Reason" class="cn-input" rows="3" required maxlength="1000" placeholder="Enter your reason"></textarea><span asp-validation-for="Reason" id="ReasonError" class="cn-field-error"></span></div>
   </div>
   <div class="cn-approval-note"><strong>Staff approval required.</strong><span>Your current booking schedule is not replaced until Staff approves your request.</span></div>
   <div class="cn-actions"><button type="button" class="cn-button cn-primary" id="r2ReviewReschedule">Continue to review <i class="bi bi-arrow-right" aria-hidden="true"></i></button></div>
  </section>
  <section class="cn-panel r2-reschedule-panel" id="r2RescheduleReview" hidden>
   <div class="cn-panel-heading"><h2 tabindex="-1"><i class="bi bi-clipboard-check" aria-hidden="true"></i> Review your request</h2><p>Compare the current schedule with the requested date and time.</p></div>
   <dl class="r2-reschedule-review-list">
    <div><dt>Booking</dt><dd id="r2ResBooking">—</dd></div>
    <div><dt>Current schedule</dt><dd id="r2ResCurrent">—</dd></div>
    <div><dt>Requested schedule</dt><dd id="r2ResRequested">—</dd></div>
    <div><dt>Event venue</dt><dd id="r2ResVenue">—</dd></div>
    <div><dt>Package</dt><dd id="r2ResPackage">—</dd></div>
    <div><dt>Reason</dt><dd id="r2ResReason">—</dd></div>
   </dl>
   <div class="cn-approval-note"><strong>Request only, not yet approved.</strong><span>Staff will review the selected date and time. Your booking remains on its current schedule until approval.</span></div>
   <div class="cn-actions"><button type="button" class="cn-button cn-secondary" id="r2BackToSchedule">Back to edit</button><button type="submit" class="cn-button cn-primary" id="submitRescheduleBtn">Submit reschedule request <i class="bi bi-arrow-right" aria-hidden="true"></i></button></div>
  </section>
 </form>
 <aside class="cn-panel r2-reschedule-overview"><div class="cn-panel-heading"><h2><i class="bi bi-calendar-check" aria-hidden="true"></i> Booking overview</h2><p>Your official booking details</p></div>
  <dl class="r2-reschedule-review-list">
   <div><dt>Booking</dt><dd id="r2ContextId">Select a booking</dd></div>
   <div><dt>Current schedule</dt><dd id="r2ContextDate">—</dd></div>
   <div><dt>Location</dt><dd id="r2ContextVenue">—</dd></div>
   <div><dt>Package</dt><dd id="r2ContextPackage">—</dd></div>
  </dl>
  <p class="cn-help">The official schedule will only change after Staff approval.</p>
 </aside>
 </div>
 @await Component.InvokeAsync("BookingContext",new{allowedIds=Model.Bookings.Select(b=>b.Value)})
 <script type="application/json" id="rescheduleBlockedDates">@Html.Raw(JsonSerializer.Serialize(ViewBag.UnavailableDates as List<string>??new()))</script>
 }
</div>
@section Scripts{
 <partial name="_ValidationScriptsPartial"/>
 <script src="~/js/booking-experience.js" asp-append-version="true"></script>
 <script src="~/js/client-round2-20261108.js" asp-append-version="true"></script>
}
