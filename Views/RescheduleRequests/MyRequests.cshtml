@model IEnumerable<AriesMagicAppointmentSystem.Models.RescheduleRequest>

@{
    ViewData["Title"] = "My Reschedule Requests";
    var requests = Model.OrderByDescending(x => x.Id).ToList();
}

<div class="client-portal-header">
    <div>
        <div class="section-kicker">Client Portal</div>
        <h1 class="client-portal-title">My Reschedule Requests</h1>
        <p class="client-portal-text">Track your submitted reschedule requests and Staff decisions.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary btn-lg">New Request</a>
    </div>
</div>

<div class="client-portal-stats">
    <div class="client-portal-stat-card">
        <span class="client-portal-stat-label">Total Requests</span>
        <strong class="client-portal-stat-value">@requests.Count</strong>
        <span class="client-portal-stat-note">All reschedule requests under your account</span>
    </div>

    <div class="client-portal-stat-card">
        <span class="client-portal-stat-label">Approved</span>
        <strong class="client-portal-stat-value">
            @requests.Count(x => x.Status == AriesMagicAppointmentSystem.Models.RescheduleRequestStatus.Approved)
        </strong>
        <span class="client-portal-stat-note">Requests that were successfully approved</span>
    </div>

    <div class="client-portal-stat-card">
        <span class="client-portal-stat-label">Pending Review</span>
        <strong class="client-portal-stat-value">
            @requests.Count(x => x.Status == AriesMagicAppointmentSystem.Models.RescheduleRequestStatus.Pending)
        </strong>
        <span class="client-portal-stat-note">Requests still waiting for Staff review</span>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="client-success-banner mb-4">
        <div class="client-success-icon">✓</div>
        <div>
            <div class="client-success-title">Request Submitted</div>
            <div class="client-success-text">@TempData["Success"]</div>
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="client-error-banner mb-4">
        <div class="client-error-icon">!</div>
        <div>
            <div class="client-error-title">Reschedule Update</div>
            <div class="client-error-text">@TempData["Error"]</div>
        </div>
    </div>
}

@if (!requests.Any())
{
    <div class="empty-state client-empty-state">
        <h3>No reschedule requests yet</h3>
        <p>You have not submitted any reschedule request yet.</p>
        <a asp-action="Create" class="btn btn-primary mt-2">Create Reschedule Request</a>
    </div>
}
else
{
    <div class="client-booking-grid">
        @foreach (var item in requests)
        {
            var statusClass = item.Status switch
            {
                "Pending" => "status-pending",
                "Approved" => "status-approved",
                "Rejected" => "status-rejected",
                _ => "status-read"
            };

            var packageName = item.Booking?.PackageName ?? item.Booking?.Service?.Name ?? "Package";
            var originalDate = item.OriginalDate ?? (item.Status == AriesMagicAppointmentSystem.Models.RescheduleRequestStatus.Pending ? item.Booking?.EventDate : null);
            var originalStart = item.OriginalStartTime ?? (item.Status == AriesMagicAppointmentSystem.Models.RescheduleRequestStatus.Pending ? item.Booking?.StartTime : null);
            var originalEnd = item.OriginalEndTime ?? (item.Status == AriesMagicAppointmentSystem.Models.RescheduleRequestStatus.Pending ? item.Booking?.EndTime : null);
            var originalSchedule = originalDate.HasValue && originalStart.HasValue && originalEnd.HasValue
                ? $"{originalDate.Value:MMMM dd, yyyy}, {originalStart.Value:hh:mm tt} – {originalEnd.Value:hh:mm tt}"
                : "Historical original schedule unavailable";
            var requestedSchedule = $"{item.RequestedDate:MMMM dd, yyyy}, {item.RequestedStartTime:hh:mm tt} – {item.RequestedEndTime:hh:mm tt}";

            <div class="client-booking-card">
                <div class="client-booking-top">
                    <div>
                        <div class="client-booking-code">Reschedule Request</div>
                        <h3 class="client-booking-package">@packageName</h3>
                        <div class="client-booking-created text-muted small">
                            Request ID: RS-@item.Id.ToString("D3")
                        </div>
                    </div>

                    <span class="status-badge @statusClass">@item.Status</span>
                </div>

                <div class="client-booking-meta">
                    <div class="client-booking-meta-box">
                        <span class="client-booking-meta-label">Requested Date</span>
                        <span class="client-booking-meta-value">@item.RequestedDate.ToString("MMMM dd, yyyy")</span>
                    </div>

                    <div class="client-booking-meta-box">
                        <span class="client-booking-meta-label">Requested Start Time</span>
                        <span class="client-booking-meta-value">@item.RequestedStartTime.ToString("hh:mm tt")</span>
                    </div>
                </div>

                <div class="client-booking-details">
                    <div class="client-booking-detail-row">
                        <span>Original Schedule</span>
                        <strong>@originalSchedule</strong>
                    </div>
                    <div class="client-booking-detail-row">
                        <span>Requested Schedule</span>
                        <strong>@requestedSchedule</strong>
                    </div>
                    <div class="client-booking-detail-row">
                        <span>Reason</span>
                        <strong>@item.Reason</strong>
                    </div>
                </div>

                <div class="client-booking-note">
                    @if (item.Status == AriesMagicAppointmentSystem.Models.RescheduleRequestStatus.Pending)
                    {
                        <span>Your request is currently waiting for Staff review.</span>
                    }
                    else if (item.Status == AriesMagicAppointmentSystem.Models.RescheduleRequestStatus.Approved)
                    {
                        <span><strong>Reschedule Approved.</strong> Your booking has been moved to @requestedSchedule.</span>
                    }
                    else if (item.Status == AriesMagicAppointmentSystem.Models.RescheduleRequestStatus.Rejected)
                    {
                        <span><strong>Reschedule Request Declined.</strong> Your original event schedule remains unchanged.</span>
                    }
                </div>

                @if (item.Status == AriesMagicAppointmentSystem.Models.RescheduleRequestStatus.Rejected && !string.IsNullOrWhiteSpace(item.ClientFacingReason))
                {
                    <div class="mt-3">
                        <div class="form-section-title mb-2">Reason</div>
                        <div class="details-description-block">@item.ClientFacingReason</div>
                    </div>
                }

                <div class="client-booking-footer">
                    <div class="client-booking-footer-actions">
                        @if (item.Status == AriesMagicAppointmentSystem.Models.RescheduleRequestStatus.Pending)
                        {
                            <button type="button" class="btn btn-outline-secondary" disabled>Waiting for Review</button>
                        }
                        else if (item.Status == AriesMagicAppointmentSystem.Models.RescheduleRequestStatus.Rejected)
                        {
                            <a asp-action="Create" class="btn btn-primary">Submit New Request</a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary" disabled>No Action Needed</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}