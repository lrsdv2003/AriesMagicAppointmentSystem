@model IEnumerable<AriesMagicAppointmentSystem.Models.RescheduleRequest>
@using AriesMagicAppointmentSystem.Models
@{
    Layout = "_ClientHubLayout"; ViewData["Title"] = "Reschedule requests";
    var requests = Model.OrderByDescending(r => r.Id).ToList();
}
<div class="cn-page cn-payment-page">
<header class="cn-page-heading"><div><p class="cn-kicker">Schedule changes</p><h1>Reschedule requests.</h1></div><a asp-action="Create" class="cn-button cn-primary">New request</a></header>
@if(TempData["Success"] is string success){<div class="cn-success" role="status"><strong>Request sent for Staff review</strong>@success</div>}
@if(TempData["Error"] is string error){<div class="cn-error-summary" role="alert">@error</div>}
@if(!requests.Any())
{
    <section class="cn-empty"><h2>No schedule changes yet.</h2><p>Your requests and Staff decisions will appear here. Submitting a request keeps your current booking schedule until approval.</p><a asp-controller="Bookings" asp-action="MyBookings" class="cn-text-link">View my bookings</a></section>
}
else
{
<div class="cn-records">
@foreach(var item in requests)
{
    var package = item.Booking?.PackageName ?? item.Booking?.Service?.Name ?? "Package";
    var originalDate = item.OriginalDate ?? (item.Status == RescheduleRequestStatus.Pending ? item.Booking?.EventDate : null);
    var originalStart = item.OriginalStartTime ?? (item.Status == RescheduleRequestStatus.Pending ? item.Booking?.StartTime : null);
    var originalEnd = item.OriginalEndTime ?? (item.Status == RescheduleRequestStatus.Pending ? item.Booking?.EndTime : null);
    var original = originalDate.HasValue && originalStart.HasValue && originalEnd.HasValue ? $"{originalDate.Value:MMM d, yyyy} · {originalStart.Value:h:mm tt}–{originalEnd.Value:h:mm tt}" : "Historical original schedule unavailable";
    var requested = $"{item.RequestedDate:MMM d, yyyy} · {item.RequestedStartTime:h:mm tt}–{item.RequestedEndTime:h:mm tt}";
    <article class="cn-record"><div class="cn-record-head"><div><span class="cn-reference">RS-@item.Id.ToString("D3")</span><h2>@package</h2></div><partial name="_StatusBadge" model="item.Status"/></div>
    <dl class="cn-facts"><div><dt>Original</dt><dd>@original</dd></div><div><dt>Requested</dt><dd>@requested</dd></div></dl>
    <div class="cn-next-step cn-request-outcome">
    @if(item.Status == RescheduleRequestStatus.Pending){<span>Awaiting Staff review. Your current schedule stays in place until approval.</span>}
    else if(item.Status == RescheduleRequestStatus.Approved){<span>Staff approved your request. Your booking has moved to @requested.</span>}
    else if(item.Status == RescheduleRequestStatus.Rejected){<span>Staff declined this request. Your original event schedule remains unchanged.</span>}
    else {<span>Open your booking for its current schedule.</span>}
    </div>
    <details class="cn-disclosure"><summary>Request details</summary><p>Reason: @item.Reason</p>@if(item.Status == RescheduleRequestStatus.Rejected && !string.IsNullOrWhiteSpace(item.ClientFacingReason)){<p>Staff response: @item.ClientFacingReason</p>}@if(item.ReviewedAt.HasValue){<p>Reviewed @item.ReviewedAt.Value.ToString("MMM d, yyyy · h:mm tt")</p>}</details>
    <div class="cn-record-actions"><a asp-controller="Bookings" asp-action="Details" asp-route-id="@item.BookingId">View booking</a>@if(item.Status == RescheduleRequestStatus.Rejected){<a asp-action="Create">Request another date</a>}</div>
    </article>
}
</div>
}
</div>
