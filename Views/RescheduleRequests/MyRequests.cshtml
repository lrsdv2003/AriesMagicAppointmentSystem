@model IEnumerable<AriesMagicAppointmentSystem.Models.RescheduleRequest>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
 Layout="_ClientHubLayout";ViewData["Title"]="Rescheduling";
 var eligible=ViewBag.EligibleRescheduleOptions as List<SelectListItem>??new();
}
<div class="cn-page client-round2-action-page">

 @if(TempData["Success"] is string success){<div class="cn-success" role="status"><strong>Request submitted.</strong> @success <a asp-controller="Bookings" asp-action="MyBookings">Review your booking</a></div>}
 @if(TempData["Error"] is string error){<div class="cn-error-summary" role="alert">@error</div>}
 @if(eligible.Any()){
  <section class="hub-card r2-select-card">
   <div class="r2-card-icon"><i class="bi bi-calendar2-week" aria-hidden="true"></i></div>
   <h2>Choose a booking to reschedule</h2>
   <p>Only confirmed bookings with an Owner-verified payment and no pending rescheduling request are eligible.</p>
   <form asp-action="Create" method="get" class="r2-selection-form">
    <div class="cn-field"><label for="r2RescheduleBooking">Select verified booking</label><select id="r2RescheduleBooking" name="bookingId" class="cn-input" asp-items="eligible" required><option value="">Choose a booking</option></select></div>
    <button type="submit" class="cn-button cn-primary">Request a new schedule <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
   </form>
  </section>}
 else{
  <section class="hub-card r2-empty-action" role="status"><i class="bi bi-calendar-x" aria-hidden="true"></i><h2>No bookings available for rescheduling</h2><p>You currently have no verified bookings eligible for rescheduling. Open My Bookings to see your booking details or an existing pending request.</p><a asp-controller="Bookings" asp-action="MyBookings" class="cn-button cn-primary">View my bookings <i class="bi bi-arrow-right" aria-hidden="true"></i></a></section>}

</div>
