@model AriesMagicAppointmentSystem.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<section class="au-page"><div class="container au-split">
    <partial name="_AuthIntro" model='"login"' />
    <div class="au-panel">
        <div class="au-panel-heading"><img src="~/images/client/wonder-studio/brand-original.jpeg" alt="" width="56" height="56" /><h1>Welcome back</h1><p>Sign in to your account.</p></div>
        <partial name="_AuthNotices" />
        <form asp-action="Login" method="post" data-auth-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div asp-validation-summary="ModelOnly" class="au-validation text-danger" role="alert" tabindex="-1"></div>
            <div class="au-field"><label asp-for="Email" class="form-label">Email address</label><input asp-for="Email" autocomplete="username" class="form-control au-input" placeholder="Enter your email" aria-describedby="EmailError" /><span asp-validation-for="Email" id="EmailError" class="text-danger"></span></div>
            <div class="au-field"><label asp-for="Password" class="form-label"></label><div class="au-password"><input asp-for="Password" autocomplete="current-password" class="form-control au-input" placeholder="Enter your password" aria-describedby="PasswordError" /><button type="button" class="au-reveal" data-password-target="Password" aria-controls="Password" aria-label="Show password" aria-pressed="false" hidden><i class="bi bi-eye" aria-hidden="true"></i></button></div><span asp-validation-for="Password" id="PasswordError" class="text-danger"></span></div>
            <div class="au-options"><div class="au-remember"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe">Remember me</label></div><a asp-action="ForgotPassword">Forgot password?</a></div>
            <button type="submit" class="au-button au-primary" data-auth-label="Signing in…">Sign in <span aria-hidden="true">→</span></button>
            <p class="au-submit-status visually-hidden" role="status" data-auth-status></p>
        </form>
        <div class="au-divider"><span>New here?</span></div><a asp-action="Register" class="au-button au-secondary">Create a new account</a>
    </div>
</div></section>
@section Scripts { <partial name="_AuthScripts" /> }
