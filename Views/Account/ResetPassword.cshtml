@model AriesMagicAppointmentSystem.ViewModels.ResetPasswordViewModel
@{ ViewData["Title"] = "Reset password"; }
<section class="au-page au-compact"><div class="container"><div class="au-panel">
    <div class="au-panel-heading"><span class="au-symbol" aria-hidden="true"><i class="bi bi-shield-lock"></i></span><span class="au-kicker">Account recovery</span><h1>Choose a new password</h1><p>Set a new password to continue to your account.</p></div>
    <partial name="_AuthNotices" />
    <form asp-controller="Account" asp-action="ResetPassword" method="post" data-auth-form>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="au-validation text-danger" role="alert" tabindex="-1"></div>
        <input asp-for="Email" type="hidden" /><input asp-for="Token" type="hidden" />
        <div class="au-field"><label asp-for="NewPassword" class="form-label">New password</label><div class="au-password"><input asp-for="NewPassword" autocomplete="new-password" class="form-control au-input" placeholder="Enter a new password" aria-describedby="passwordGuidance NewPasswordError" /><button type="button" class="au-reveal" data-password-target="NewPassword" aria-controls="NewPassword" aria-label="Show new password" aria-pressed="false" hidden><i class="bi bi-eye" aria-hidden="true"></i></button></div><span asp-validation-for="NewPassword" id="NewPasswordError" class="text-danger"></span></div>
        <div class="au-field"><label asp-for="ConfirmPassword" class="form-label"></label><div class="au-password"><input asp-for="ConfirmPassword" autocomplete="new-password" class="form-control au-input" placeholder="Repeat new password" aria-describedby="ConfirmPasswordError" /><button type="button" class="au-reveal" data-password-target="ConfirmPassword" aria-controls="ConfirmPassword" aria-label="Show confirm password" aria-pressed="false" hidden><i class="bi bi-eye" aria-hidden="true"></i></button></div><span asp-validation-for="ConfirmPassword" id="ConfirmPasswordError" class="text-danger"></span></div>
        <partial name="_AuthPasswordGuidance" />
        <button type="submit" class="au-button au-primary" data-auth-label="Resetting password…">Reset password <span aria-hidden="true">→</span></button><p class="au-submit-status visually-hidden" role="status" data-auth-status></p>
    </form>
    <p class="au-help au-recovery-link">Link expired or invalid? <a asp-action="ForgotPassword">Request a new reset link</a>.</p><a asp-action="Login" class="au-back">Back to sign in</a>
</div></div></section>
@section Scripts { <partial name="_AuthScripts" /> }
