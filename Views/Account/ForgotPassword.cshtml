@model AriesMagicAppointmentSystem.ViewModels.ForgotPasswordViewModel
@{ ViewData["Title"] = "Password recovery"; }
<section class="au-page au-compact"><div class="container"><div class="au-panel">
    <div class="au-panel-heading"><span class="au-symbol" aria-hidden="true"><i class="bi bi-key"></i></span><span class="au-kicker">Account recovery</span><h1>A fresh start</h1><p>Enter your email to request a password reset link.</p></div>
    <partial name="_AuthNotices" />
    <form asp-controller="Account" asp-action="ForgotPassword" method="post" data-auth-form>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="au-validation text-danger" role="alert" tabindex="-1"></div>
        <div class="au-field"><label asp-for="Email" class="form-label">Email address</label><input asp-for="Email" class="form-control au-input" autocomplete="email" placeholder="Enter your email" aria-describedby="EmailError recoveryHelp" /><span asp-validation-for="Email" id="EmailError" class="text-danger"></span></div>
        <p id="recoveryHelp" class="au-help">If an account with that email exists, a reset link will be sent. Check your inbox and spam folder.</p>
        <button type="submit" class="au-button au-primary" data-auth-label="Requesting link…">Request reset link <span aria-hidden="true">→</span></button><p class="au-submit-status visually-hidden" role="status" data-auth-status></p>
    </form>
    <a asp-action="Login" class="au-back">Back to sign in</a>
</div></div></section>
@section Scripts { <partial name="_AuthScripts" /> }
