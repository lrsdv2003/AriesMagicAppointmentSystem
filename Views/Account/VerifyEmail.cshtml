@model AriesMagicAppointmentSystem.ViewModels.VerifyEmailViewModel
@{ ViewData["Title"] = "Verify your email"; }
<section class="au-page au-compact"><div class="container"><div class="au-panel au-verification">
    <div class="au-panel-heading"><span class="au-symbol" aria-hidden="true"><i class="bi bi-envelope-check"></i></span><span class="au-kicker">One more step</span><h1>Verify your email</h1><p>Enter the six-digit code sent to <strong class="au-recipient">@Model.MaskedEmail</strong>.</p></div>
    <partial name="_AuthNotices" />
    <form asp-action="VerifyEmail" method="post" id="verifyEmailForm" data-auth-form>
        @Html.AntiForgeryToken()
        <input asp-for="UserId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="au-validation text-danger" role="alert" tabindex="-1"></div>
        <fieldset class="au-code-fieldset" @(Model.AttemptsLocked ? "disabled" : null)>
            <legend class="visually-hidden">Email verification</legend>
            <div class="au-field"><label asp-for="Code" class="form-label">Verification code</label><input asp-for="Code" type="text" class="form-control au-input au-code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="6-digit code" aria-describedby="codeHelp CodeError" /><p id="codeHelp" class="au-help">Enter or paste all six digits.</p><span asp-validation-for="Code" id="CodeError" class="text-danger"></span></div>
        </fieldset>
        <button type="submit" class="au-button au-primary" id="verifyOtpButton" data-auth-label="Verifying…" @(Model.AttemptsLocked ? "disabled" : null)>Verify email <span aria-hidden="true">→</span></button><p class="au-submit-status visually-hidden" role="status" data-auth-status></p>
    </form>
    <div class="au-code-state">
        @if(Model.HasActiveCode && Model.ExpiresAtUtc.HasValue){<p class="au-help">Code expires in <time id="expiryCountdown" data-expires-at="@DateTime.SpecifyKind(Model.ExpiresAtUtc.Value, DateTimeKind.Utc).ToString("O")" datetime="@DateTime.SpecifyKind(Model.ExpiresAtUtc.Value, DateTimeKind.Utc).ToString("O")">until @Model.ExpiresAtUtc.Value.ToString("HH:mm") UTC</time>.</p>}
        else if(Model.AttemptsLocked){<p class="au-notice au-notice-error" role="status">Too many incorrect attempts. Request a new code to continue.</p>}
        else {<p class="au-help">No active code is available. Request a new code to continue.</p>}
    </div>
    <form asp-action="ResendVerificationCode" method="post" id="resendOtpForm" class="au-resend" data-auth-form>
        @Html.AntiForgeryToken()<input type="hidden" name="userId" value="@Model.UserId" />
        <button type="submit" class="au-button au-secondary" id="resendOtpButton" data-auth-label="Sending…" data-seconds="@Model.ResendSecondsRemaining" @(Model.ResendSecondsRemaining > 0 ? "disabled" : null)>Resend code</button>
        <p id="resendCountdown" class="au-help" aria-live="off">@(Model.ResendSecondsRemaining > 0 ? $"Available in {Model.ResendSecondsRemaining} seconds." : "")</p><p class="au-submit-status visually-hidden" role="status" data-auth-status></p>
    </form>
    <div class="au-verify-help"><p class="au-help">Check your spam folder if the email hasn’t arrived.</p>
        <details class="au-change-email"><summary>Wrong address? Change email</summary>
            <form asp-action="ChangeVerificationEmail" method="post" data-auth-form>
                @Html.AntiForgeryToken()<input type="hidden" name="userId" value="@Model.UserId" />
                <div class="au-field"><label for="verificationEmail" class="form-label">New email address</label><input id="verificationEmail" name="email" type="email" class="form-control au-input" autocomplete="email" required placeholder="name@example.com" /></div>
                <div class="au-field"><label for="verificationPassword" class="form-label">Current password</label><div class="au-password"><input id="verificationPassword" name="currentPassword" type="password" class="form-control au-input" autocomplete="current-password" required placeholder="Enter your password" /><button type="button" class="au-reveal" data-password-target="verificationPassword" aria-controls="verificationPassword" aria-label="Show current password" aria-pressed="false" hidden><i class="bi bi-eye" aria-hidden="true"></i></button></div></div>
                <button type="submit" class="au-button au-secondary" data-auth-label="Updating email…">Update email &amp; send code</button><p class="au-help">Changing the email invalidates the current code and sends a new one.</p><p class="au-submit-status visually-hidden" role="status" data-auth-status></p>
            </form>
        </details>
    </div><a asp-action="Login" class="au-back">Back to sign in</a>
</div></div></section>
@section Scripts { <partial name="_AuthScripts" /> }
