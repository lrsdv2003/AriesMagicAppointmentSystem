@model AriesMagicAppointmentSystem.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Create your account"; }
<section class="au-page"><div class="container au-split au-register">
    <partial name="_AuthIntro" model='"register"' />
    <div class="au-panel">
        <div class="au-panel-heading"><span class="au-kicker">Your next celebration</span><h1>Create your account</h1><p>One place for your plans and next steps.</p></div>
        <partial name="_AuthNotices" />
        <form asp-action="Register" method="post" data-auth-form>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="au-validation text-danger" role="alert" tabindex="-1"></div>
            <div class="au-field"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" autocomplete="name" class="form-control au-input" placeholder="Enter your full name" aria-describedby="FullNameError" /><span asp-validation-for="FullName" id="FullNameError" class="text-danger"></span></div>
            <div class="au-fields">
                <div class="au-field"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" type="tel" inputmode="tel" autocomplete="tel-national" class="form-control au-input" placeholder="09XXXXXXXXX" aria-describedby="phoneHelp PhoneNumberError" /><p id="phoneHelp" class="au-help">11 digits, starting with 09.</p><span asp-validation-for="PhoneNumber" id="PhoneNumberError" class="text-danger"></span></div>
                <div class="au-field"><label asp-for="Email" class="form-label">Email address</label><input asp-for="Email" autocomplete="email" class="form-control au-input" placeholder="Enter your email" aria-describedby="EmailError" /><span asp-validation-for="Email" id="EmailError" class="text-danger"></span></div>
            </div>
            <div class="au-fields">
                <div class="au-field"><label asp-for="Password" class="form-label"></label><div class="au-password"><input asp-for="Password" autocomplete="new-password" class="form-control au-input" placeholder="Create a password" aria-describedby="passwordGuidance PasswordError" /><button type="button" class="au-reveal" data-password-target="Password" aria-controls="Password" aria-label="Show password" aria-pressed="false" hidden><i class="bi bi-eye" aria-hidden="true"></i></button></div><span asp-validation-for="Password" id="PasswordError" class="text-danger"></span></div>
                <div class="au-field"><label asp-for="ConfirmPassword" class="form-label"></label><div class="au-password"><input asp-for="ConfirmPassword" autocomplete="new-password" class="form-control au-input" placeholder="Repeat your password" aria-describedby="ConfirmPasswordError" /><button type="button" class="au-reveal" data-password-target="ConfirmPassword" aria-controls="ConfirmPassword" aria-label="Show confirm password" aria-pressed="false" hidden><i class="bi bi-eye" aria-hidden="true"></i></button></div><span asp-validation-for="ConfirmPassword" id="ConfirmPasswordError" class="text-danger"></span></div>
            </div>
            <partial name="_AuthPasswordGuidance" />
            <button type="submit" class="au-button au-primary" data-auth-label="Creating account…">Create account <span aria-hidden="true">→</span></button><p class="au-submit-status visually-hidden" role="status" data-auth-status></p>
        </form>
        <div class="au-divider"><span>Already have an account?</span></div><a asp-action="Login" class="au-button au-secondary">Back to sign in</a>
    </div>
</div></section>
@section Scripts { <partial name="_AuthScripts" /> }
