@model AriesMagicAppointmentSystem.ViewModels.CalendarIndexViewModel
@using AriesMagicAppointmentSystem.Models
@using System.Text.Json

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Event Calendar";
    var useStaffColors = User.IsInRole("Staff") && !User.IsInRole("Owner");
    var originalPackageColors = ViewBag.PackageColors as IDictionary<string, string> ?? new Dictionary<string, string>();
    var packageColors = originalPackageColors.ToDictionary(item => item.Key, item => useStaffColors
        ? item.Key.Contains("All In", StringComparison.OrdinalIgnoreCase) ? "gold"
        : item.Key.Contains("Deluxe", StringComparison.OrdinalIgnoreCase) ? "red"
        : item.Key.Contains("Premium", StringComparison.OrdinalIgnoreCase) ? "blue"
        : item.Value
        : item.Value, StringComparer.OrdinalIgnoreCase);
    string PackageName(Booking b) => !string.IsNullOrWhiteSpace(b.PackageName) ? b.PackageName : b.Service?.Name ?? "Package";
    string PackageKey(string name) => packageColors.TryGetValue(name, out var key) ? key : "pink";
    var now = DateTime.Now;
    var confirmed = Model.Bookings.Where(b => b.Status == BookingStatus.Confirmed).ToList();
    var upcoming = confirmed
        .Where(b => b.EventDate.Date.Add(b.StartTime.TimeOfDay) >= now)
        .OrderBy(b => b.EventDate).ThenBy(b => b.StartTime).ToList();
    var dayData = confirmed.GroupBy(b => b.EventDate.Date).ToDictionary(
        g => g.Key.ToString("yyyy-MM-dd"),
        g => new {
            count = g.Count(),
            items = g.Select(b => new {
                bookingId = b.Id,
                bookingCode = "BK-" + b.CreatedAt.Year + "-" + b.Id.ToString("D3"),
                packageName = PackageName(b),
                key = PackageKey(PackageName(b))
            }).ToArray()
        });
    var dayDataJson = JsonSerializer.Serialize(dayData);
    var packageColorsJson = JsonSerializer.Serialize(packageColors);
    var blockedDatesJson = JsonSerializer.Serialize(ViewBag.BlockedDates ?? new List<object>());
}

@* FullCalendar 6 injects its CSS from the existing pinned JavaScript bundle. *@

<div class="staff-calendar-page">
    <div class="staff-round1-calendar-layout">

    <section class="staff-calendar-panel" aria-labelledby="calendarHeading">
        <div class="staff-calendar-toolbar">
            <div>
                <h2 id="calendarHeading">Confirmed Schedule</h2>
                <p>Select a date with events to open the booking preview.</p>
            </div>
            <div class="staff-calendar-nav" aria-label="Calendar navigation">
                @if(User.IsInRole("Owner")){<a asp-action="Settings" class="btn btn-primary"><i class="bi bi-gear" aria-hidden="true"></i> Calendar Settings</a>}
                <button type="button" class="btn btn-outline-secondary" id="calPrev" aria-label="Previous month"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
                <button type="button" class="btn btn-outline-secondary" id="calToday">Today</button>
                <button type="button" class="btn btn-outline-secondary" id="calNext" aria-label="Next month"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
            </div>
        </div>
        <div class="staff-calendar-month-row">
            <strong id="calendarTitle" aria-live="polite"></strong>
            <div class="staff-package-legend am-filter-bar am-filter-chips" id="calendarPackageChips" aria-label="Package legend and filter">
                <span class="staff-package-legend-label">Package Legend</span>
                <button type="button" class="package-legend-filter active" data-package-filter="" aria-pressed="true">All</button>
                @foreach (var item in packageColors.OrderBy(x => x.Key))
                {
                    <button type="button" class="package-legend-filter" data-package-filter="@item.Key" aria-pressed="false">
                        <span class="package-dot package-@item.Value"></span><span>@item.Key</span>
                    </button>
                }
                <span class="package-legend-blocked"><span class="blocked-legend-mark" aria-hidden="true">×</span> @(useStaffColors ? "Unavailable" : "Blocked / Unavailable")</span>
            </div>
        </div>
        <div class="staff-calendar-loading" id="calendarLoading" role="status">
            <span class="spinner-border spinner-border-sm"></span> Loading event schedule...
        </div>
        <div class="staff-calendar-error d-none" id="calendarError" role="alert">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <span>Unable to load the event schedule. Please try again.</span>
            <button type="button" class="btn btn-sm btn-outline-danger" id="calendarRetry">Retry</button>
        </div>
        <div id="calendar" aria-label="Confirmed booking calendar"></div>
    </section>

    <section class="staff-upcoming-panel" aria-labelledby="upcomingHeading">
        @if(useStaffColors){
        <h2 class="staff-final-upcoming-title" id="upcomingHeading">Upcoming Confirmed Bookings</h2>
        }else{
        <div class="staff-upcoming-heading">
            <div>
                <h2 id="upcomingHeading">Upcoming Confirmed Bookings</h2>
                <p>Nearest event date and time first.</p>
            </div>
        </div>
        }
        @if (!upcoming.Any())
        {
            <div class="staff-upcoming-empty"><i class="bi bi-calendar2-check" aria-hidden="true"></i><span>No upcoming confirmed events.</span></div>
        }
        else
        {
            <div class="staff-upcoming-table-wrap">
                <table class="table staff-upcoming-table" id="upcomingTable">
                    <thead><tr><th scope="col">Booking</th><th scope="col">Client</th><th scope="col">Event Date & Time</th><th scope="col">Package</th><th scope="col">Location</th><th scope="col" class="text-end">Action</th></tr></thead>
                    <tbody>
                    @foreach (var booking in upcoming)
                    {
                        var packageName = PackageName(booking);
                        var colorKey = PackageKey(packageName);
                        var bookingCode = $"BK-{booking.CreatedAt.Year}-{booking.Id:D3}";
                        <tr class="js-upcoming-row" data-search="@(bookingCode) @(booking.Client?.FullName) @(booking.PartyVenue)" data-package="@packageName">
                            <td><strong>@bookingCode</strong></td>
                            <td>@(booking.Client?.FullName ?? "Unknown client")</td>
                            <td><strong>@booking.EventDate.ToString("MMM dd, yyyy")</strong><span>@booking.StartTime.ToString("hh:mm tt")</span></td>
                            <td><span class="package-badge package-@colorKey"><span class="package-dot"></span>@packageName</span></td>
                            <td><strong>@booking.PartyVenue</strong><span>@(booking.DistanceKm.HasValue ? $"{booking.DistanceKm.Value:N1} KM" : "Distance unavailable")</span></td>
                            <td class="text-end"><a asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-primary">View Details</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="staff-upcoming-cards" id="upcomingCards">
                @foreach (var booking in upcoming)
                {
                    var packageName = PackageName(booking);
                    var colorKey = PackageKey(packageName);
                    var bookingCode = $"BK-{booking.CreatedAt.Year}-{booking.Id:D3}";
                    <article class="staff-upcoming-card js-upcoming-row" data-search="@(bookingCode) @(booking.Client?.FullName) @(booking.PartyVenue)" data-package="@packageName">
                        <div class="staff-upcoming-card-head"><strong>@bookingCode</strong><span class="package-badge package-@colorKey">@packageName</span></div>
                        <span>@(booking.Client?.FullName ?? "Unknown client")</span>
                        <span><i class="bi bi-calendar-event" aria-hidden="true"></i> @booking.EventDate.ToString("MMM dd, yyyy") · @booking.StartTime.ToString("hh:mm tt")</span>
                        <span><i class="bi bi-geo-alt" aria-hidden="true"></i> @booking.PartyVenue</span>
                        <a asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-primary">View Details</a>
                    </article>
                }
            </div>
            <div class="staff-upcoming-empty d-none" id="upcomingFilteredEmpty" role="status"><i class="bi bi-calendar-x" aria-hidden="true"></i><span>No confirmed bookings match the selected package.</span></div>
            <nav class="staff-round2-calendar-pager" aria-label="Upcoming confirmed booking pages">
              <button type="button" class="btn btn-outline-secondary" id="staffUpcomingPrev" aria-label="Previous confirmed booking page"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
              <span id="staffUpcomingPageInfo" aria-live="polite">Page 1 of 1</span>
              <button type="button" class="btn btn-primary" id="staffUpcomingNext" aria-label="Next confirmed booking page"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
            </nav>
        }
    </section>
    </div>
</div>
@if(useStaffColors){
<div class="modal fade staff-preview-modal staff-final-booking-modal" id="bookingPreviewModal" tabindex="-1" aria-labelledby="bookingPreviewTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div><span class="staff-preview-kicker">Confirmed Event</span><h2 class="modal-title fs-5" id="bookingPreviewTitle">Booking <span id="previewBooking"></span></h2></div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close booking preview"></button>
            </div>
            <div class="modal-body">
                <div id="previewLoading" class="staff-preview-state" role="status"><span class="spinner-border spinner-border-sm"></span> Loading booking details...</div>
                <div id="previewError" class="staff-preview-state staff-preview-error d-none" role="alert">
                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                    <span>Unable to load this booking preview. Please retry.</span>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="previewRetry">Retry</button>
                </div>
                <div id="previewContent" class="d-none">
                    <p class="staff-final-preview-position" id="previewPosition" aria-live="polite"></p>
                    <div class="staff-final-preview-group">
                      <h3><i class="bi bi-calendar-event" aria-hidden="true"></i> Event Schedule</h3>
                      <dl><div><dt>Date</dt><dd id="previewDate"></dd></div>
                          <div><dt>Time</dt><dd id="previewTime"></dd></div></dl>
                    </div>
                    <div class="staff-final-preview-group">
                      <h3><i class="bi bi-geo-alt" aria-hidden="true"></i> Event Information</h3>
                      <dl><div><dt>Package</dt><dd id="previewPackage"></dd></div>
                          <div><dt>Venue</dt><dd id="previewVenue"></dd></div></dl>
                    </div>
                    <div class="staff-final-preview-group">
                      <h3><i class="bi bi-person-lines-fill" aria-hidden="true"></i> Contact Information</h3>
                      <dl><div><dt>Contact Person</dt><dd id="previewContactPerson"></dd></div>
                          <div><dt>Contact Number</dt><dd id="previewContactNumber"></dd></div></dl>
                    </div>
                </div>
            </div>
            <div class="modal-footer staff-preview-footer">
                <div class="staff-preview-browse" id="previewBrowse">
                    <button type="button" class="btn btn-outline-secondary" id="previewPrevious" aria-label="Previous booking"><i class="bi bi-chevron-left" aria-hidden="true"></i> Previous</button>
                    <button type="button" class="btn btn-outline-secondary" id="previewNext" aria-label="Next booking">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
                <a href="#" class="btn btn-primary" id="previewDetails">View Full Details</a>
            </div>
        </div>
    </div>
</div>
 }else{
<div class="modal fade staff-preview-modal" id="bookingPreviewModal" tabindex="-1" aria-labelledby="bookingPreviewTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div><span class="staff-preview-kicker">Quick Booking Preview</span><h2 class="modal-title fs-5" id="bookingPreviewTitle">Confirmed Booking</h2></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="previewLoading" class="staff-preview-state"><span class="spinner-border spinner-border-sm"></span> Loading booking...</div>
                <div id="previewError" class="staff-preview-state staff-preview-error d-none" role="alert">
                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                    <span>Unable to load the event schedule. Please try again.</span>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="previewRetry">Retry</button>
                </div>
                <div id="previewContent" class="d-none">
                    <div class="staff-preview-position" id="previewPosition"></div>
                    <div class="staff-preview-grid">
                        <div><span>Booking</span><strong id="previewBooking"></strong></div>
                        <div><span>Client</span><strong id="previewClient"></strong></div>
                        <div><span>Event Date</span><strong id="previewDate"></strong></div>
                        <div><span>Start Time</span><strong id="previewStart"></strong></div>
                        <div><span>Expected End Time</span><strong id="previewEnd"></strong></div>
