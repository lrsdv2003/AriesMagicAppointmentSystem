<div class="modal fade staff-blocked-modal" id="blockedDateModal" tabindex="-1" aria-labelledby="blockedDateTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <div><span class="staff-preview-kicker">Schedule Notice</span><h2 class="modal-title fs-5" id="blockedDateTitle">Schedule Unavailable</h2></div>
                <button type="button" class="btn-close @(useStaffColors ? "btn-close-white" : "")" data-bs-dismiss="modal" aria-label="Close schedule notice"></button>
            </div>
            <div class="modal-body">
                <div class="staff-blocked-date" id="blockedDateDisplay"></div>
                <span class="staff-blocked-label">Reason</span>
                <p id="blockedReasonDisplay" class="mb-0">No additional information provided.</p>
            </div>
        </div>
    </div>
</div>

@if (useStaffColors) {<script src="~/lib/fullcalendar/index.global.min.js" asp-append-version="true"></script>} else {<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>}

@section Scripts {
<script>
(() => {
    'use strict';
    const dayData = @Html.Raw(dayDataJson);
    const packageColors = @Html.Raw(packageColorsJson);
    const blockedDates = @Html.Raw(blockedDatesJson);
    const blockedDateMap = Object.fromEntries(blockedDates.map(item => [item.date, item]));
    const previewUrl = '@Url.Action("GetReservationsByDate", "Calendar")';
    let calendar;
    let activePackageFilter = '';
    let selectedDate = null;
    const staffCalendar = @useStaffColors.ToString().ToLowerInvariant();
    let selectedCell = null;
    let previewItems = [];
    let previewIndex = 0;
    let previewRequestSerial = 0;
    let applyUpcomingFilters = () => {};
    const formatDateKey = date => {
        const y = date.getFullYear();
        const m = String(date.getMonth() + 1).padStart(2, '0');
        const d = String(date.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
    };
    const packageKey = name => packageColors[name] || 'pink';
    const previewModalEl = document.getElementById('bookingPreviewModal');
    const previewModal = previewModalEl ? new bootstrap.Modal(previewModalEl) : null;
    const blockedModalEl = document.getElementById('blockedDateModal');
    const blockedModal = blockedModalEl ? new bootstrap.Modal(blockedModalEl) : null;

    const filteredDayItems = dateKey => {
        const items = dayData[dateKey]?.items || [];
        return activePackageFilter ? items.filter(item => item.packageName === activePackageFilter) : items;
    };

    function openBlockedDate(dateKey, cell) {
        const blocked = blockedDateMap[dateKey];
        if (!blocked) return false;
        selectedDate = dateKey;
        setSelectedCell(cell);
        const date = new Date(`${dateKey}T00:00:00`);
        document.getElementById('blockedDateDisplay').textContent = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
        document.getElementById('blockedReasonDisplay').textContent = blocked.reason?.trim() || 'No additional information provided.';
        blockedModal?.show();
        return true;
    }

    function setSelectedCell(cell) {
        selectedCell?.classList.remove('staff-calendar-selected');
        selectedCell = cell || null;
        selectedCell?.classList.add('staff-calendar-selected');
    }

    async function openDatePreview(dateKey, cell, preferredBookingId = null) {
        if (openBlockedDate(dateKey, cell)) return;
        const requestSerial = ++previewRequestSerial;
        const visibleItems = filteredDayItems(dateKey);
        if (!visibleItems.length) return;
        selectedDate = dateKey;
        setSelectedCell(cell);
        document.getElementById('previewLoading').classList.remove('d-none');
        document.getElementById('previewError').classList.add('d-none');
        document.getElementById('previewContent').classList.add('d-none');
        document.getElementById('previewPrevious').disabled = true;
        document.getElementById('previewNext').disabled = true;
        document.getElementById('previewDetails').classList.add('disabled');
        previewModal?.show();
        try {
            const response = await fetch(`${previewUrl}?date=${encodeURIComponent(dateKey)}`, { headers: { 'Accept': 'application/json' } });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const returnedItems = await response.json();
            if (requestSerial !== previewRequestSerial) return;
            previewItems = returnedItems;
            if (activePackageFilter) {
                previewItems = previewItems.filter(item => item.packageName === activePackageFilter);
            }
            if (!Array.isArray(previewItems) || previewItems.length === 0) throw new Error('No bookings returned');
            previewIndex = preferredBookingId == null ? 0
                : Math.max(0, previewItems.findIndex(item => Number(item.bookingId) === Number(preferredBookingId)));
            renderPreview();
        } catch (error) {
            console.error('Calendar preview failed:', error);
            document.getElementById('previewLoading').classList.add('d-none');
            document.getElementById('previewError').classList.remove('d-none');
        }
    }

    function renderPreview() {
        if (!staffCalendar) {

        const item = previewItems[previewIndex];
        if (!item) return;
        document.getElementById('previewLoading').classList.add('d-none');
        document.getElementById('previewError').classList.add('d-none');
        document.getElementById('previewContent').classList.remove('d-none');
        document.getElementById('previewPosition').textContent = `Booking ${previewIndex + 1} of ${previewItems.length}`;
        document.getElementById('previewBooking').textContent = item.bookingCode;
        document.getElementById('previewClient').textContent = item.clientName;
        document.getElementById('previewDate').textContent = item.eventDate;
        document.getElementById('previewStart').textContent = item.startTime;
        document.getElementById('previewEnd').textContent = item.endTime;
        const pkg = document.getElementById('previewPackage');
        pkg.className = `package-badge package-${packageKey(item.packageName)}`;
        pkg.textContent = item.packageName;
        document.getElementById('previewVenue').textContent = item.venue;
        document.getElementById('previewDistance').textContent = item.distanceKm != null ? `${Number(item.distanceKm).toFixed(1)} KM` : 'Distance unavailable';
        const details = document.getElementById('previewDetails');
        details.href = item.detailsUrl || '#';
        details.classList.toggle('disabled', !item.detailsUrl);
        document.getElementById('previewPrevious').disabled = previewIndex === 0;
        document.getElementById('previewNext').disabled = previewIndex >= previewItems.length - 1;
            } else {

        const item = previewItems[previewIndex];
        if (!item) return;
        document.getElementById('previewLoading').classList.add('d-none');
        document.getElementById('previewError').classList.add('d-none');
        document.getElementById('previewContent').classList.remove('d-none');
        document.getElementById('previewPosition').textContent = previewItems.length > 1
            ? 'Booking ' + (previewIndex + 1) + ' of ' + previewItems.length + ' on this date' : '';
        document.getElementById('previewBooking').textContent = item.bookingCode || 'Unknown';
        document.getElementById('previewDate').textContent = item.eventDate || 'Not available';
        document.getElementById('previewTime').textContent = (item.startTime || '—') + ' – ' + (item.endTime || '—');
        document.getElementById('previewPackage').textContent = item.packageName || 'Not available';
        document.getElementById('previewVenue').textContent = item.venue || 'Not provided';
        document.getElementById('previewContactPerson').textContent = item.contactPerson?.trim() || 'Not provided';
        document.getElementById('previewContactNumber').textContent = item.contactNumber?.trim() || 'Not provided';
        document.getElementById('previewBrowse').hidden = previewItems.length <= 1;
        const details = document.getElementById('previewDetails');
        details.href = item.detailsUrl || '#';
        details.classList.toggle('disabled', !item.detailsUrl);
        document.getElementById('previewPrevious').disabled = previewIndex === 0;
        document.getElementById('previewNext').disabled = previewIndex >= previewItems.length - 1;
            }
    }

    function renderDaySummary(cell, key) {
        const frame = cell.querySelector('.fc-daygrid-day-frame');
        if (!frame) return;
        frame.querySelector('.staff-day-content')?.remove();
        const content = document.createElement('div');
        content.className = 'staff-day-content';
        frame.appendChild(content);
        cell.classList.remove('staff-calendar-has-events', 'staff-calendar-blocked');
        // Keep FullCalendar's grid semantics; the inner frame is the action.
        cell.setAttribute('role', 'gridcell');
        // Its date-only label would omit the added visible booking summary.
        cell.removeAttribute('aria-labelledby');
        frame.removeAttribute('role');
        frame.removeAttribute('aria-label');
        frame.removeAttribute('aria-description');
        frame.removeAttribute('tabindex');

        const blocked = blockedDateMap[key];
        const visibleItems = filteredDayItems(key);
        const date = new Date(`${key}T00:00:00`);
        const displayDate = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

        if (blocked) {
            cell.classList.add('staff-calendar-blocked');
            const blockedLabel = document.createElement('span');
            blockedLabel.className = 'staff-day-blocked-label';
            blockedLabel.textContent = 'Blocked';
            content.appendChild(blockedLabel);
        }

        if (visibleItems.length) {
            cell.classList.add('staff-calendar-has-events');
            const box = document.createElement('div');
            box.className = 'staff-day-summary';
            const dots = document.createElement('div');
            dots.className = 'staff-day-dots';
            visibleItems.slice(0, 4).forEach(item => {
                const dot = document.createElement('span');
                dot.className = `package-dot package-${item.key}`;
                dot.title = item.packageName;
                dot.setAttribute('role', 'img');
                dot.setAttribute('aria-label', item.packageName);
                dots.appendChild(dot);
            });
            if (visibleItems.length > 4) {
                const more = document.createElement('span');
                more.className = 'staff-day-more';
                more.textContent = `+${visibleItems.length - 4}`;
                more.setAttribute('aria-label', `${visibleItems.length - 4} more bookings`);
                dots.appendChild(more);
            }
            const count = document.createElement('strong');
            count.append(document.createTextNode(String(visibleItems.length)));
            const word = document.createElement('span');
            word.className = 'staff-day-count-label';
            word.textContent = visibleItems.length === 1 ? ' Booking' : ' Bookings';
            count.appendChild(word);
            box.append(dots, count);
            content.appendChild(box);
            if (staffCalendar && !blocked) {
                const links = document.createElement('div');
                links.className = 'staff-final-day-bookings';
                visibleItems.slice(0, 2).forEach(item => {
                    const trigger = document.createElement('button');
                    trigger.type = 'button';
                    trigger.className = 'staff-final-day-booking';
                    trigger.textContent = item.bookingCode;
                    trigger.setAttribute('aria-label', 'Preview ' + item.bookingCode + ' on ' + displayDate);
                    trigger.addEventListener('click', event => {
                        event.preventDefault();
                        event.stopPropagation();
                        openDatePreview(key, cell, item.bookingId);
                    });
                    links.appendChild(trigger);
                });
                if (visibleItems.length > 2) {
                    const more = document.createElement('button');
                    more.type = 'button';
                    more.className = 'staff-final-day-more-button';
                    more.textContent = '+' + (visibleItems.length - 2) + ' more';
                    more.setAttribute('aria-label', 'Browse all bookings on ' + displayDate);
                    more.addEventListener('click', event => {
                        event.preventDefault(); event.stopPropagation();
                        openDatePreview(key, cell);
                    });
                    links.appendChild(more);
                }
                content.appendChild(links);
            }
        }

        if (staffCalendar && visibleItems.length && !blocked) {
            // The per-booking triggers are the focusable controls. A parent button
            // here would create inaccessible nested interactive elements.
            frame.removeAttribute('role');
            frame.removeAttribute('tabindex');
            frame.setAttribute('aria-label', displayDate + ': ' + visibleItems.length + ' confirmed bookings');
        } else if (blocked || visibleItems.length) {
            frame.tabIndex = 0;
            frame.setAttribute('role', 'button');
            frame.setAttribute('aria-description', displayDate);
        }
    }

    function mountDaySummary(info) {
        const key = formatDateKey(info.date);
        info.el.dataset.staffDate = key;
        renderDaySummary(info.el, key);
        info.el.addEventListener('keydown', event => {
            if (event.target instanceof Element && event.target.closest('.staff-final-day-booking,.staff-final-day-more-button')) return;
            if ((event.key === 'Enter' || event.key === ' ') && (blockedDateMap[key] || filteredDayItems(key).length)) {
                event.preventDefault();
                openDatePreview(key, info.el);
            }
        });
    }

    function refreshDaySummaries() {
        document.querySelectorAll('[data-staff-date]').forEach(cell => renderDaySummary(cell, cell.dataset.staffDate));
    }

    function initCalendar() {
        const calendarEl = document.getElementById('calendar');
        const loading = document.getElementById('calendarLoading');
        const error = document.getElementById('calendarError');
        if (!calendarEl) return;
        loading?.classList.remove('d-none');
        error?.classList.add('d-none');
        calendarEl.classList.remove('d-none');
        try {
        calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: false,
            height: 'auto',
            fixedWeekCount: false,
            showNonCurrentDates: true,
            dayCellDidMount: mountDaySummary,
            dateClick: info => {
                if (info.jsEvent?.target instanceof Element &&
                    info.jsEvent.target.closest('.staff-final-day-booking,.staff-final-day-more-button')) return;
                if (!staffCalendar) { openDatePreview(info.dateStr, info.dayEl); return; }
                openDatePreview(info.dateStr, info.dayEl);
            },
            datesSet: () => {
                document.getElementById('calendarTitle').textContent = calendar.view.title;
                document.getElementById('calendarLoading').classList.add('d-none');
                selectedCell = null;
            }
        });
        calendar.render();
        document.getElementById('calPrev')?.addEventListener('click', () => calendar.prev());
        document.getElementById('calNext')?.addEventListener('click', () => calendar.next());
        document.getElementById('calToday')?.addEventListener('click', () => calendar.today());
        } catch (errorValue) {
            console.error('Calendar initialization failed:', errorValue);
            loading?.classList.add('d-none');
            calendarEl.classList.add('d-none');
            error?.classList.remove('d-none');
        }
    }

    function initPreviewControls() {
        document.getElementById('previewPrevious')?.addEventListener('click', () => {
            if (previewIndex > 0) { previewIndex--; renderPreview(); }
        });
        document.getElementById('previewNext')?.addEventListener('click', () => {
            if (previewIndex < previewItems.length - 1) { previewIndex++; renderPreview(); }
        });
        document.getElementById('previewRetry')?.addEventListener('click', () => {
            if (selectedDate) openDatePreview(selectedDate, selectedCell);
        });
    }

    function initOwnerUpcomingFilters() {
        const tableRows = [...document.querySelectorAll('#upcomingTable tbody .js-upcoming-row')];
        const cards = [...document.querySelectorAll('#upcomingCards .js-upcoming-row')];
        const empty = document.getElementById('upcomingFilteredEmpty');
        const info = document.getElementById('staffUpcomingPageInfo');
        const prev = document.getElementById('staffUpcomingPrev');
        const next = document.getElementById('staffUpcomingNext');
        let page = 1;
        const matched = row => {
            return !activePackageFilter || row.dataset.package === activePackageFilter;
        };
        applyUpcomingFilters = (resetPage = false) => {
            if (resetPage === true) page = 1;
            const size = 5;
            const matching = tableRows.filter(matched);
            const count = matching.length;
            const totalPages = Math.max(1, Math.ceil(count / size));
            page = Math.max(1, Math.min(page, totalPages));
            const visible = new Set(matching.slice((page-1)*size,page*size));
            tableRows.forEach((row,i) => row.classList.toggle('d-none', !visible.has(row)));
            cards.forEach((card,i) => card.classList.toggle('d-none',
                !tableRows[i] || !visible.has(tableRows[i])));
            empty?.classList.toggle('d-none', count > 0);
            if (info) info.textContent = 'Page ' + page + ' of ' + totalPages;
            if (prev) prev.disabled = page <= 1;
            if (next) next.disabled = page >= totalPages;
        };
        prev?.addEventListener('click', () => { page--;applyUpcomingFilters(); });
        next?.addEventListener('click', () => { page++;applyUpcomingFilters(); });
        applyUpcomingFilters(true);
    }


    function initUpcomingFilters() {
        if (!staffCalendar) { initOwnerUpcomingFilters(); return; }
        const tableRows = [...document.querySelectorAll('#upcomingTable tbody .js-upcoming-row')];
        const cards = [...document.querySelectorAll('#upcomingCards .js-upcoming-row')];
        const empty = document.getElementById('upcomingFilteredEmpty');
        const pager = document.querySelector('.staff-round2-calendar-pager');
        const info = document.getElementById('staffUpcomingPageInfo');
        const prev = document.getElementById('staffUpcomingPrev');
        const next = document.getElementById('staffUpcomingNext');
        const size = 5;
        let page = 1;
        applyUpcomingFilters = (resetPage = false) => {
            if (resetPage === true) page = 1;
            const matching = tableRows.filter(row => !activePackageFilter || row.dataset.package === activePackageFilter);
            const pages = Math.max(1, Math.ceil(matching.length / size));
            page = Math.max(1, Math.min(page, pages));
            const visible = new Set(matching.slice((page - 1) * size, page * size));
            tableRows.forEach(row => row.classList.toggle('d-none', !visible.has(row)));
            cards.forEach((card,i) => card.classList.toggle('d-none', !tableRows[i] || !visible.has(tableRows[i])));
            empty?.classList.toggle('d-none', matching.length > 0);
            if (info) info.textContent = 'Page ' + page + ' of ' + pages;
            if (prev) prev.disabled = page <= 1;
            if (next) next.disabled = page >= pages;
            if (pager) pager.hidden = matching.length === 0;
        };
        prev?.addEventListener('click', () => { page--; applyUpcomingFilters(); });
        next?.addEventListener('click', () => { page++; applyUpcomingFilters(); });
        applyUpcomingFilters(true);
    }

    function initLegendFilters() {
        document.querySelectorAll('.package-legend-filter').forEach(button => {
            button.addEventListener('click', () => {
                activePackageFilter = button.dataset.packageFilter || '';
                document.querySelectorAll('.package-legend-filter').forEach(item => {
                    const active = item === button;
                    item.classList.toggle('active', active);
                    item.setAttribute('aria-pressed', active ? 'true' : 'false');
                });
                setSelectedCell(null);
                refreshDaySummaries();
                applyUpcomingFilters();
            });
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        initCalendar();
        initPreviewControls();
        initUpcomingFilters();
        initLegendFilters();
        document.getElementById('calendarRetry')?.addEventListener('click', () => {
            calendar?.destroy();
            calendar = null;
            initCalendar();
        });
    });
})();
</script>
}
