@model AriesMagicAppointmentSystem.Controllers.StaffProfileInput
@{Layout="_DashboardLayout";ViewData["Title"]="Edit Staff Profile";}
<section class="dash-panel owner-staff-profile" aria-labelledby="staffProfileTitle"><h2 id="staffProfileTitle">Staff profile</h2><p>Update contact details. Login email, password, roles and history are preserved.</p><form method="post" asp-action="EditStaff"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="text-danger" role="alert"></div><div><label asp-for="FullName">Full name</label><input asp-for="FullName" class="form-control" maxlength="100" required /><span asp-validation-for="FullName" class="text-danger"></span></div><div><label asp-for="PhoneNumber">Phone number</label><input asp-for="PhoneNumber" class="form-control" type="tel" maxlength="30" /><span asp-validation-for="PhoneNumber" class="text-danger"></span></div><div class="mt-3 d-flex gap-2"><button class="btn btn-primary">Save profile</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div></form></section>
