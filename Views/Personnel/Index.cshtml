@model AriesMagicAppointmentSystem.Controllers.PersonnelPage
@{Layout="_DashboardLayout";ViewData["Title"]="Personnel Accounts";}
<div class="admin-console personnel-console">
<header class="admin-heading"><p>Invite authorized colleagues. Every new account must verify enrollment and choose its own password.</p></header>
@if(TempData["ErrorMessage"] is string error){<p class="alert alert-danger" role="alert">@error</p>}
@if(TempData["SuccessMessage"] is string success){<p class="alert alert-success" role="status">@success</p>}
<section class="dash-panel owner-personnel-invite" aria-labelledby="personnelInviteTitle">
<div class="owner-invite-intro"><i class="bi bi-person-plus" aria-hidden="true"></i><h2 id="personnelInviteTitle">Invite a colleague</h2><p>Send secure enrollment for an authorized Staff or Admin account.</p></div>
<form asp-action="Invite" method="post" class="owner-invite-form">
<div><label for="personName">Full name</label><input id="personName" name="FullName" class="form-control" required maxlength="100" autocomplete="name" /></div>
<div><label for="personEmail">Approved email</label><input id="personEmail" name="Email" class="form-control" type="email" required maxlength="254" autocomplete="email" /></div>
<div class="owner-invite-wide"><label for="personRole">Role</label><select id="personRole" name="Role" class="form-select" aria-describedby="personnelEnrollmentHelp"><option value="Staff">Staff</option>@if(Model.Owner){<option value="Admin">Admin</option>}</select></div>
<p id="personnelEnrollmentHelp">No password is assigned here. Enrollment links expire and can be used once. Accounts remain inactive until enrollment succeeds.</p><button class="btn btn-primary" type="submit"><i class="bi bi-send" aria-hidden="true"></i> Send invitation</button>
</form></section>
<section class="dash-panel"><h2>Authorized Personnel</h2><div class="owner-personnel-search"><label for="ownerPersonnelSearch">Search personnel</label><input type="search" class="form-control" id="ownerPersonnelSearch" placeholder="Search by name or email" autocomplete="off" /></div><div class="table-responsive" tabindex="0" role="region" aria-label="Personnel account actions; scroll horizontally on smaller screens"><table class="table" id="ownerPersonnelTable"><caption>Personnel access and enrollment status</caption><thead><tr><th scope="col">Name / Email</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead><tbody>
@foreach(var person in Model.Accounts){<tr><td>@person.FullName<br/>@person.Email</td><td><span class="status-badge">@person.Role</span></td><td><span class="status-badge">@person.Status</span></td><td>
@if(person.Status.StartsWith("Pending")){<form asp-action="Resend" method="post"><input type="hidden" name="id" value="@person.Id"/><button class="btn btn-outline-secondary" type="submit">Resend invitation</button></form>}
@if(person.Status.StartsWith("Revoked")){<p class="text-muted">This invitation has been revoked. It cannot be used to enroll.</p>}
else {<form asp-action="Manage" method="post" data-personnel-confirm><input type="hidden" name="id" value="@person.Id"/><label for="action-@person.Id">Action for @person.FullName</label><select class="form-select" name="operation" id="action-@person.Id"><option value="RevokeSessions">Revoke sessions</option><option value="Deactivate">Deactivate</option><option value="Reactivate">Reactivate</option>@if(person.Status.StartsWith("Pending")){<option value="Revoke">Revoke invitation</option>}@if(Model.Owner&&!person.Status.StartsWith("Pending")){<option value="Role">Change role</option>}</select>
@if(Model.Owner&&!person.Status.StartsWith("Pending")){<label for="role-@person.Id">New role (for Change role only)</label><select class="form-select" name="role" id="role-@person.Id"><option value="Staff">Staff</option><option value="Admin">Admin</option></select>}
<button class="btn btn-outline-secondary" type="submit">Apply account action</button></form>}</td></tr>}
</tbody></table></div><p id="ownerPersonnelSearchResult" class="owner-financial-caption" role="status" aria-live="polite"></p>@if(Model.Accounts.Count==0){<p>No Admin or Staff accounts have been enrolled.</p>}</section>
@if(Model.Owner){<section class="dash-panel"><h2>Account management audit</h2><p>Latest 50 account events. Identifiers let the operator reconcile each event with the authorized account record.</p><ul>@foreach(var item in Model.Audit){<li><time>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</time> — @item.Description<br/>Actor: @item.PerformedByUserId · Account: @item.AffectedRecordId</li>}</ul></section>}
</div>
