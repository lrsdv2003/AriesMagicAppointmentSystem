@model AriesMagicAppointmentSystem.Controllers.PersonnelPage
@{Layout="_DashboardLayout";ViewData["Title"]="Personnel accounts";}
<div class="admin-console personnel-console">
<header class="admin-heading"><p>Invite authorized colleagues. Every new account must verify enrollment and choose its own password.</p></header>
@if(TempData["ErrorMessage"] is string error){<p class="alert alert-danger" role="alert">@error</p>}
@if(TempData["SuccessMessage"] is string success){<p class="alert alert-success" role="status">@success</p>}
<section class="dash-panel"><h2>Invite a colleague</h2><form asp-action="Invite" method="post">
<label for="personName">Full name</label><input id="personName" name="FullName" class="form-control" required maxlength="100" autocomplete="name" />
<label for="personEmail">Approved email</label><input id="personEmail" name="Email" class="form-control" type="email" required maxlength="254" autocomplete="email" />
<label for="personRole">Role</label><select id="personRole" name="Role" class="form-select"><option value="Staff">Staff</option>@if(Model.Owner){<option value="Admin">Admin</option>}</select>
<p>No password is assigned here. Enrollment links expire and can be used once.</p><button class="btn btn-primary" type="submit">Send invitation</button></form></section>
<section class="dash-panel"><h2>Authorized personnel</h2><div class="table-responsive" tabindex="0" role="region" aria-label="Personnel account actions; scroll horizontally on smaller screens"><table class="table"><caption>Personnel access and enrollment status</caption><thead><tr><th scope="col">Person</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead><tbody>
@foreach(var person in Model.Accounts){<tr><td>@person.FullName<br/>@person.Email</td><td>@person.Role</td><td>@person.Status</td><td>
@if(person.Status.StartsWith("Pending")){<form asp-action="Resend" method="post"><input type="hidden" name="id" value="@person.Id"/><button class="btn btn-outline-secondary" type="submit">Resend invitation</button></form>}
<form asp-action="Manage" method="post"><input type="hidden" name="id" value="@person.Id"/><label for="action-@person.Id">Action for @person.FullName</label><select class="form-select" name="operation" id="action-@person.Id"><option value="RevokeSessions">Revoke sessions</option><option value="Deactivate">Deactivate</option><option value="Reactivate">Reactivate</option>@if(person.Status.StartsWith("Pending")){<option value="Revoke">Revoke invitation</option>}@if(Model.Owner&&!person.Status.StartsWith("Pending")){<option value="Role">Change role</option>}</select>
@if(Model.Owner&&!person.Status.StartsWith("Pending")){<label for="role-@person.Id">New role (for Change role only)</label><select class="form-select" name="role" id="role-@person.Id"><option value="Staff">Staff</option><option value="Admin">Admin</option></select>}
<button class="btn btn-outline-secondary" type="submit">Apply account action</button></form></td></tr>}
</tbody></table></div>@if(Model.Accounts.Count==0){<p>No Admin or Staff accounts have been enrolled.</p>}</section>
@if(Model.Owner){<section class="dash-panel"><h2>Account management audit</h2><p>Latest 50 account events. Identifiers let the operator reconcile each event with the authorized account record.</p><ul>@foreach(var item in Model.Audit){<li><time>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</time> — @item.Description<br/>Actor: @item.PerformedByUserId · Account: @item.AffectedRecordId</li>}</ul></section>}
</div>
