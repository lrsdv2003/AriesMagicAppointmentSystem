@model AriesMagicAppointmentSystem.Models.Service
@using AriesMagicAppointmentSystem.ViewModels
@{ ViewData["Title"] = Model.Name; }
<header class="cr-page-heading"><div><span class="cr-eyebrow">The experience, up close</span><h1>@Model.Name</h1><p>@Model.DurationInHours hours · Starting at ₱@Model.Price.ToString("N0")</p></div><a asp-action="Packages" class="btn btn-outline-secondary">All packages</a></header>
<div class="cr-detail-grid"><div><div class="cx-package-detail-art"><partial name="_ClientMedia" model='ClientMedia.Get("detail")' /></div><section class="cr-card mt-4"><h2>About the show</h2><p>@(string.IsNullOrWhiteSpace(Model.Description) ? "Live entertainment for your celebration. Explore the inclusions below to see what is part of this package." : Model.Description)</p><h3>Suitable occasions</h3><p>Birthdays, school events, and company celebrations. Tell us about your event during booking so staff can review the fit.</p><h3>What’s included</h3><ul class="cr-inclusion-list">@foreach(var inclusion in Model.Inclusions.OrderBy(i=>i.Id)){<li>@inclusion.Name</li>}</ul></section><section class="cr-card mt-4"><h2>Before you book</h2><details class="cr-terms"><summary>When do I pay?</summary><p>Wait for staff approval, then pay at least ₱2,000 and upload your proof. The owner verifies the payment before confirmation.</p></details><details class="cr-terms"><summary>Are travel fees included?</summary><p>The booking flow calculates any travel fee using your venue and schedule. You will see it before submitting.</p></details><details class="cr-terms"><summary>Can I customize the package?</summary><p>You may remove up to two inclusions marked as removable during booking. Removing one or two eligible inclusions gives a single ₱2,000 discount.</p></details><details class="cr-terms"><summary>Is my schedule reserved immediately?</summary><p>No. A request is reviewed first and follows the payment confirmation process. Check the terms during booking.</p></details></section></div><aside><section class="cr-card cr-price-summary"><span class="cr-eyebrow">@Model.DurationInHours hours</span><h2>@Model.Name</h2><p class="cr-package-price">₱@Model.Price.ToString("N0")</p><p>Travel fees are calculated after you select your venue and date.</p><a asp-controller="Bookings" asp-action="CreateStepOne" asp-route-serviceId="@Model.Id" class="btn btn-primary w-100">Book this package</a></section></aside></div>
