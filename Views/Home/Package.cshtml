@model AriesMagicAppointmentSystem.Models.Service
@{ ViewData["Title"] = Model.Name; }
<nav class="we-breadcrumb" aria-label="Breadcrumb"><a asp-action="Packages">Experiences</a><span aria-hidden="true">/</span><span aria-current="page">@Model.Name</span></nav>
<header class="we-detail-heading"><span class="we-kicker">The experience, up close</span><h1>@Model.Name</h1><p>@Model.DurationInHours @(Model.DurationInHours == 1 ? "hour" : "hours") of live entertainment</p></header>
<div class="we-detail-grid">
    <div class="we-detail-content">
        <section class="we-detail-section" aria-labelledby="aboutExperienceTitle">
            <span class="we-kicker">Made for your occasion</span><h2 id="aboutExperienceTitle">About the <em>experience.</em></h2>
            <p class="we-description">@(string.IsNullOrWhiteSpace(Model.Description) ? "Explore this package’s listed inclusions and choose the experience for your celebration." : Model.Description)</p>
            <h3>What’s included</h3>
            @if (Model.Inclusions.Any())
            {
                <ul class="we-detail-inclusions">@foreach (var inclusion in Model.Inclusions.OrderBy(i => i.Id)) { <li>@inclusion.Name</li> }</ul>
            }
            else { <p>Inclusion details are not available for this package.</p> }
            <h3>Suitable occasions</h3><p>Birthdays, school events, and company celebrations. Tell us about your event during booking so staff can review the fit.</p>
        </section>
        <section class="we-detail-section we-faq" aria-labelledby="beforeBookingTitle">
            <span class="we-kicker">A few useful details</span><h2 id="beforeBookingTitle">Before you <em>book.</em></h2>
            <details><summary>When do I pay?<span aria-hidden="true">+</span></summary><p>Wait for staff approval, then pay at least ₱2,000 and upload your proof. The owner verifies the payment before confirmation.</p></details>
            <details><summary>Are travel fees included?<span aria-hidden="true">+</span></summary><p>The booking flow calculates any travel fee using your venue and schedule. You will see it before submitting.</p></details>
            <details><summary>Can I customize the package?<span aria-hidden="true">+</span></summary><p>You may remove up to two inclusions marked as removable during booking. Removing one or two eligible inclusions gives a single ₱2,000 discount.</p></details>
            <details><summary>Is my schedule reserved immediately?<span aria-hidden="true">+</span></summary><p>No. A request is reviewed first and follows the payment confirmation process. Check the terms during booking.</p></details>
        </section>
    </div>
    <aside class="we-booking-panel" aria-labelledby="bookingPanelTitle">
        <div class="we-booking-summary">
            <span class="we-kicker">Your experience</span><h2 id="bookingPanelTitle">@Model.Name</h2>
            <p class="we-price"><span>Package price</span><strong>₱@Model.Price.ToString(Model.Price % 1 == 0 ? "N0" : "N2")</strong></p>
            <p class="we-summary-duration">@Model.DurationInHours @(Model.DurationInHours == 1 ? "hour" : "hours") / Live entertainment</p>
            <p>Travel fees are calculated after you select your venue and date.</p>
            <a asp-controller="Bookings" asp-action="CreateStepOne" asp-route-serviceId="@Model.Id" class="we-button we-button-primary we-detail-book">Book this package <span aria-hidden="true">→</span></a>
            <a asp-action="Packages" class="we-text-link">Compare all experiences <span aria-hidden="true">↗</span></a>
        </div>
    </aside>
</div>
