@{
    ViewData["Title"] = "Magician & Event Entertainment";

    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    var isStaffAdminOrOwner = isAuthenticated && !User.IsInRole("Client");

    var bookCtaController = "Bookings";
    var bookCtaAction = "CreateStepOne";

    if (!isAuthenticated)
    {
        bookCtaController = "Account";
        bookCtaAction = "Register";
    }
    else if (isStaffAdminOrOwner)
    {
        bookCtaController = User.IsInRole("Owner") ? "Reports" : User.IsInRole("Admin") ? "UserManagement" : "Bookings";
        bookCtaAction = "Index";
    }
}

<section class="magic-hero">
    <div class="magic-hero-grain" aria-hidden="true"></div>
    <div class="container magic-hero-grid">
        <div class="magic-hero-copy" data-magic-reveal>
            <div class="magic-eyebrow"><span></span> Live Magic • Ventriloquism • Event Entertainment</div>
            <h1>Turn your next event into a <em>moment of wonder.</em></h1>
            <p class="magic-hero-lead">
                Aries Magic blends interactive illusions, comedy, hosting, and audience participation into a polished entertainment experience made for celebrations people remember.
            </p>

            <div class="magic-hero-actions">
                <a asp-controller="@bookCtaController" asp-action="@bookCtaAction" class="btn magic-primary-cta magic-hero-cta">
                    <span>Plan Your Show</span><i class="bi bi-arrow-up-right"></i>
                </a>
                <a href="#experiences" class="magic-secondary-link"><span class="magic-play"><i class="bi bi-play-fill"></i></span> Explore the experience</a>
            </div>

            <div class="magic-proof-row">
                <div><strong>3 hrs</strong><span>full event window</span></div>
                <div><strong>₱2,000</strong><span>required downpayment</span></div>
                <div><strong>Flexible</strong><span>package customization</span></div>
            </div>
        </div>

        <div class="magic-hero-visual" data-magic-reveal>
            <div class="magic-hero-orbit" aria-hidden="true"></div>
            <div class="magic-photo-frame magic-photo-main">
                <img src="~/images/magic-performance-1.jpeg" alt="Aries Magic performing an interactive magic show" />
                <div class="magic-photo-shade"></div>
                <div class="magic-photo-caption">
                    <span>Signature Experience</span>
                    <strong>Interactive illusion & audience magic</strong>
                </div>
            </div>
            <div class="magic-floating-card magic-floating-card-top">
                <i class="bi bi-stars"></i><span>Live wonder<br /><strong>for every age</strong></span>
            </div>
            <div class="magic-floating-card magic-floating-card-bottom">
                <span class="magic-live-dot"></span><span>Now accepting<br /><strong>event bookings</strong></span>
            </div>
            <span class="magic-spark magic-spark-a" aria-hidden="true">✦</span>
            <span class="magic-spark magic-spark-b" aria-hidden="true">✧</span>
            <span class="magic-spark magic-spark-c" aria-hidden="true">✦</span>
        </div>
    </div>

    <a href="#experiences" class="magic-scroll-cue" aria-label="Scroll to experiences"><span>Discover</span><i class="bi bi-arrow-down"></i></a>
</section>

<section class="magic-marquee" aria-label="Aries Magic services">
    <div class="container magic-marquee-window">
        <div class="magic-marquee-track">
            <span>ILLUSION MAGIC <b>✦</b></span>
            <span>VENTRILOQUISM <b>✦</b></span>
            <span>BUBBLE SHOW <b>✦</b></span>
            <span>PARTY HOSTING <b>✦</b></span>
            <span>AUDIENCE PARTICIPATION <b>✦</b></span>
        </div>
    </div>
</section>

<section class="magic-section magic-experiences" id="experiences">
    <div class="container">
        <div class="magic-section-heading" data-magic-reveal>
            <div>
                <span class="magic-kicker">The Aries Experience</span>
                <h2>More than a show.<br />A room full of reactions.</h2>
            </div>
            <p>Designed for birthdays, schools, company gatherings, and special celebrations—each experience is built around energy, interaction, and memorable audience moments.</p>
        </div>

        <div class="magic-bento" data-magic-reveal>
            <article class="magic-bento-card magic-bento-large" style="--magic-bg:url('/images/audience-show-4.jpeg')">
                <div class="magic-bento-content">
                    <span>01 / Audience Magic</span>
                    <h3>Make your guests part of the impossible.</h3>
                    <p>Interactive routines turn spectators into the stars of the show.</p>
                </div>
            </article>
            <article class="magic-bento-card" style="--magic-bg:url('/images/ventriloquism-3.jpeg')">
                <div class="magic-bento-content">
                    <span>02 / Ventriloquism</span>
                    <h3>Character, comedy & surprise.</h3>
                </div>
            </article>
            <article class="magic-bento-card" style="--magic-bg:url('/images/bubble-show-5.jpeg')">
                <div class="magic-bento-content">
                    <span>03 / Bubble Show</span>
                    <h3>A visual finale made for photos.</h3>
                </div>
            </article>
            <article class="magic-bento-card magic-bento-wide" style="--magic-bg:url('/images/magic-hosting-2.jpeg')">
                <div class="magic-bento-content">
                    <span>04 / Event Hosting</span>
                    <h3>A smooth program with the energy turned all the way up.</h3>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="magic-section magic-packages-section" id="packages">
    <div class="container">
        <div class="magic-section-heading magic-section-heading-center" data-magic-reveal>
            <span class="magic-kicker">Show Packages</span>
            <h2>Choose how big you want the magic to feel.</h2>
            <p>Start with a curated package, then personalize selected inclusions during booking.</p>
        </div>

        <div class="magic-package-grid">
            @{ var publicPackages = new[] { new AriesMagicAppointmentSystem.ViewModels.PackageCardViewModel { Name = "Premium Package", Eyebrow = "Premium", Number = "01", Description = "A high-energy mix of hosting, illusion, comedy, and audience interaction.", Price = 19800m, Featured = false, Inclusions = new() { "Professional Party Host", "Game Facilitator", "Ventriloquism", "Illusion Magic Performance", "Audience Participation" }, ActionController = bookCtaController, ActionName = bookCtaAction, ActionLabel = "Choose Premium" },
                new AriesMagicAppointmentSystem.ViewModels.PackageCardViewModel { Name = "Deluxe Package", Eyebrow = "Deluxe", Number = "02", Description = "A celebration-ready experience with magic, ventriloquism, games, and a bubble show.", Price = 20000m, Featured = true, Inclusions = new() { "Professional Party Host", "Game Facilitator", "Professional Magician", "Ventriloquism", "Bubble Show Experience" }, ActionController = bookCtaController, ActionName = bookCtaAction, ActionLabel = "Choose Deluxe" },
                new AriesMagicAppointmentSystem.ViewModels.PackageCardViewModel { Name = "All In Package", Eyebrow = "All In", Number = "03", Description = "The complete premium experience with grand illusion and bubble-show highlights.", Price = 24500m, Featured = false, Inclusions = new() { "Professional Party Host", "Ventriloquism", "Illusion Magic", "Bubble Show Highlights", "Premium Event Experience" }, ActionController = bookCtaController, ActionName = bookCtaAction, ActionLabel = "Choose All In" } }; }
            @foreach(var package in publicPackages){<partial name="_PackageCard" model="package" />}
        </div>

        <div class="magic-package-note" data-magic-reveal>
            <i class="bi bi-magic"></i>
            <span><strong>Make it yours.</strong> Eligible packages allow up to two removable inclusions during booking.</span>
        </div>
    </div>
</section>

<section class="magic-section magic-process-section" id="how-it-works">
    <div class="container">
        <div class="magic-process-shell">
            <div class="magic-process-intro" data-magic-reveal>
                <span class="magic-kicker">Booking Journey</span>
                <h2>From idea to event day, without the guesswork.</h2>
                <p>The booking flow keeps every important detail in one place—from your first request through payment and confirmation.</p>
                <a asp-controller="@bookCtaController" asp-action="@bookCtaAction" class="btn magic-primary-cta">Start your booking <i class="bi bi-arrow-up-right"></i></a>
            </div>

            <div class="magic-process-list" data-magic-reveal>
                <div class="magic-process-item"><span>01</span><div><h3>Tell us about your event</h3><p>Event type, venue, motif, guests, date, time, and contact details.</p></div></div>
                <div class="magic-process-item"><span>02</span><div><h3>Build your show package</h3><p>Choose a package and personalize available inclusions to fit your celebration.</p></div></div>
                <div class="magic-process-item"><span>03</span><div><h3>Get your booking reviewed</h3><p>Staff checks the request and schedule before opening the payment step.</p></div></div>
                <div class="magic-process-item"><span>04</span><div><h3>Secure the schedule</h3><p>Upload the required ₱2,000 downpayment and track verification online.</p></div></div>
            </div>
        </div>
    </div>
</section>

<section class="magic-section magic-gallery-section">
    <div class="container">
        <div class="magic-section-heading" data-magic-reveal>
            <div><span class="magic-kicker">On Stage</span><h2>The kind of energy you can’t put in a spreadsheet.</h2></div>
            <p>Real entertainment is about reactions—the laugh, the gasp, the moment everyone reaches for their camera.</p>
        </div>
        <div class="magic-gallery" data-magic-reveal>
            <figure class="magic-gallery-a"><img src="~/images/magic-performance-1.jpeg" alt="Magic performance" /><figcaption>Illusion</figcaption></figure>
            <figure class="magic-gallery-b"><img src="~/images/audience-show-4.jpeg" alt="Audience participating in the magic show" /><figcaption>Interaction</figcaption></figure>
            <figure class="magic-gallery-c"><img src="~/images/ventriloquism-3.jpeg" alt="Ventriloquism performance" /><figcaption>Comedy</figcaption></figure>
            <figure class="magic-gallery-d"><img src="~/images/bubble-show-5.jpeg" alt="Bubble show performance" /><figcaption>Wonder</figcaption></figure>
        </div>
    </div>
</section>

<section class="magic-section magic-testimonial-section">
    <div class="container">
        <div class="magic-quote" data-magic-reveal>
            <div class="magic-quote-mark">“</div>
            <blockquote>The best events don’t just keep guests busy. They give everyone one story they keep talking about after the lights go down.</blockquote>
            <div class="magic-quote-signature"><span></span> The Aries Magic experience</div>
        </div>
    </div>
</section>

<section class="magic-final-cta">
    <div class="container">
        <div class="magic-final-cta-shell" data-magic-reveal>
            <div>
                <span class="magic-kicker">Your event deserves a little impossible.</span>
                <h2>Ready to bring the magic?</h2>
            </div>
            <a asp-controller="@bookCtaController" asp-action="@bookCtaAction" class="btn magic-light-cta">Book Aries Magic <i class="bi bi-arrow-up-right"></i></a>
        </div>
    </div>
</section>
