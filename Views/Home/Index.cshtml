@model IEnumerable<AriesMagicAppointmentSystem.Models.Service>
@using AriesMagicAppointmentSystem.ViewModels
@{ ViewData["Title"] = "The Wonder Studio"; }
<section class="cx-hero container">
    <div class="cx-hero-copy">
        <span class="cx-kicker"><span aria-hidden="true">✳</span> Aries Magic / The Wonder Studio</span>
        <h1>A little magic.<br /><em>A lot of <br />memories.</em></h1>
        <p>Make room for something extraordinary. Explore live entertainment for your celebration, and bring your favourite people together.</p>
        <div class="cx-actions"><a asp-controller="Bookings" asp-action="CreateStepOne" class="btn btn-primary">Let’s plan your event <span aria-hidden="true">↗</span></a><a asp-action="Packages" class="cx-text-link">Explore experiences <span aria-hidden="true">→</span></a></div>
        <div class="cx-hero-note"><span><i class="bi bi-stars" aria-hidden="true"></i> A show to share.</span><span>A moment to keep.</span></div>
    </div>
    <div class="cx-hero-art"><partial name="_ClientMedia" model='ClientMedia.Get("hero")' /><span class="wonder-orbit" aria-hidden="true">✳</span><span class="cx-art-stamp" aria-hidden="true">A LITTLE<br />OUT OF THE<br />ORDINARY.</span><span class="wonder-image-note">Good people. Great anticipation.</span></div>
</section>
<div class="cx-ribbon"><div class="container"><span>Birthdays & celebrations</span><span aria-hidden="true">✳</span><span>School events</span><span aria-hidden="true">✳</span><span>Company gatherings</span><a href="#how-it-works">Your event starts here ↗</a></div></div>
<section class="cx-story" id="about"><div class="container wonder-intro">
    <div class="wonder-intro-art"><partial name="_ClientMedia" model='ClientMedia.Get("intro")' /></div>
    <div><span class="cx-kicker">01 / More than a show</span><h2>For the joy<br />of <em>being together.</em></h2></div>
    <div><p class="cx-lead">A little surprise goes a long way.</p><p>Aries Magic brings live entertainment to celebrations, school events, and company gatherings. Find a package that fits your occasion. We’ll help you take the next step.</p><a asp-action="Packages" class="cx-text-link">Find your kind of wonder <span aria-hidden="true">↗</span></a></div>
</div></section>
<section class="cx-section container" id="packages"><div class="cx-section-head"><div><span class="cx-kicker">02 / Experiences to remember</span><h2>Your occasion.<br /><em>Our kind of magic.</em></h2></div><div><p>Different celebrations. The same sense of possibility. Discover what’s included and make the experience your own.</p><a asp-action="Packages" class="cx-text-link">Explore all experiences <span aria-hidden="true">→</span></a></div></div><partial name="_ClientPackageCards" model="Model.Take(3)" /></section>
<section class="wonder-showcase" aria-labelledby="showcaseTitle"><div class="container wonder-showcase-grid">
    <div><span class="cx-kicker">03 / A change of atmosphere</span><h2 id="showcaseTitle">A room full<br />of <em>possibility.</em></h2><p>The lights, the anticipation, the shared surprise. This is a space for the moments that bring a celebration to life.</p><a href="#gallery" class="btn btn-outline-light">Step into the gallery <span aria-hidden="true">↗</span></a><p class="wonder-media-note">Illustrative stage preview. Event photography and an approved showreel will follow.</p></div>
    <div class="wonder-showcase-art"><partial name="_ClientMedia" model='ClientMedia.Get("showcase")' /></div>
</div></section>
<section class="cx-planning" id="how-it-works"><div class="container"><div class="cx-section-head"><div><span class="cx-kicker">04 / A simple beginning</span><h2>Less figuring it out.<br /><em>More looking forward.</em></h2></div><p>Your venue, experience, and event details come together in one guided booking journey.</p></div>
<ol class="cx-process"><li><span>01</span><h3>Set the scene</h3><p>Check your venue and a date at least three days ahead. See serviceability and estimated travel fees.</p></li><li><span>02</span><h3>Find your experience</h3><p>Explore packages, personalize eligible inclusions, and tell us about your event.</p></li><li><span>03</span><h3>Send your request</h3><p>Review the price and submit for Staff approval. A request alone does not reserve the schedule.</p></li><li><span>04</span><h3>Follow the next step</h3><p>After approval, upload your downpayment proof. Owner verification completes confirmation.</p></li></ol>
<div class="wonder-booking-notes"><details><summary>What’s included in the price?</summary><p>Your review separates the package price, eligible customization discount, and estimated travel fees before you submit.</p></details><details><summary>When do I pay?</summary><p>Wait for Staff approval, then follow the instructions in your booking. The applicable minimum downpayment is PHP 2,000, verified by the Owner.</p></details></div>
</div></section>
@{ var publicStories = ViewData["PublicTestimonials"] as IEnumerable<ClientTestimonial> ?? Array.Empty<ClientTestimonial>(); }
<partial name="_ClientTestimonials" model="publicStories" />
<section class="cx-section container" id="gallery"><div class="cx-section-head"><div><span class="cx-kicker">06 / A glimpse of the feeling</span><h2>A little unexpected.<br /><em>Entirely memorable.</em></h2></div><p>An editorial space for event memories. These locally made artwork previews will give way to approved photography.</p></div><div class="cx-gallery">
@foreach (var key in new[] { "gallery-1", "gallery-2", "gallery-3" }) { var media = ClientMedia.Get(key); <button type="button" class="cx-gallery-item" data-gallery-src="@media.Source" data-gallery-alt="@media.Alt" aria-label="Enlarge artwork preview: @media.Alt"><partial name="_ClientMedia" model="media" /><span class="cx-gallery-label">Explore the artwork <span aria-hidden="true">↗</span></span></button> }
</div></section>
<section class="cx-closing"><div class="container cx-closing-grid"><div><span class="cx-kicker">Your people. Your occasion.</span><h2>Let’s create something<br /><em>unforgettable.</em></h2><p>Start with a place and a date. We’ll take it from there, one clear step at a time.</p></div><div class="cx-closing-actions"><a asp-controller="Bookings" asp-action="CreateStepOne" class="btn btn-light">Let’s plan your event <span aria-hidden="true">↗</span></a><span>Venue & date → Experience → Event details → Review</span></div></div></section>
<dialog id="clientGallery" class="cx-gallery-dialog" aria-labelledby="galleryTitle"><div class="cx-dialog-bar"><h2 id="galleryTitle">A glimpse of the wonder</h2><button type="button" class="btn btn-outline-secondary" data-gallery-close>Close ×</button></div><img alt="" width="1200" height="900" /><p>Illustrative placeholder. Approved event media will replace this artwork.</p></dialog>
