@model IEnumerable<AriesMagicAppointmentSystem.Models.Service>
@{ ViewData["Title"] = "Magic for your next celebration"; }
<section class="cr-home-hero"><img src="~/images/magic-performance-1.jpeg" alt="Aries Magic performing an interactive show" fetchpriority="high"/><div class="container cr-home-hero-copy"><span class="cr-eyebrow">Aries Magic · Live event entertainment</span><h1>A little wonder.<br/>A lasting memory.</h1><p>Bring your celebration to life with interactive magic, comedy, and moments your guests share together.</p><div class="cr-inline-actions"><a asp-controller="Bookings" asp-action="CreateStepOne" class="btn btn-primary">Book Now</a><a asp-action="Packages" class="btn btn-light">Explore packages</a></div></div></section>
<section class="cr-home-section" id="about"><div class="container cr-about-grid"><div><span class="cr-eyebrow">Meet the experience</span><h2>Make your guests<br/>part of the show.</h2></div><div><p>From audience participation to illusion and ventriloquism, Aries Magic brings entertainment to birthdays, school events, and company celebrations.</p><p>Choose a package, check your venue and date, and keep your booking updates together in your account.</p></div></div></section>
<section class="cr-home-section cr-section-tint" id="packages"><div class="container"><div class="cr-section-heading"><div><span class="cr-eyebrow">Find your show</span><h2>A package for your celebration</h2></div><a asp-action="Packages" class="btn btn-outline-secondary">All packages</a></div><partial name="_ClientPackageCards" model="Model.Take(3)" /></div></section>
<section class="cr-home-section"><div class="container"><div class="cr-section-heading"><div><span class="cr-eyebrow">On stage</span><h2>Real performances. Shared reactions.</h2></div></div><div class="cr-photo-gallery"><img src="~/images/audience-show-4.jpeg" alt="Audience members enjoying an Aries Magic performance" loading="lazy"/><img src="~/images/ventriloquism-3.jpeg" alt="Aries Magic ventriloquism performance" loading="lazy"/><img src="~/images/bubble-show-5.jpeg" alt="A bubble show during an Aries Magic event" loading="lazy"/></div></div></section>
<section class="cr-home-section cr-section-tint" id="how-it-works"><div class="container"><span class="cr-eyebrow">Easy to plan</span><h2>From your first idea to event day</h2><div class="cr-how-grid"><article><span>01</span><h3>Check location & date</h3><p>See serviceability, estimated distance, and travel fees early.</p></article><article><span>02</span><h3>Choose your show</h3><p>Pick an available package and personalize eligible inclusions.</p></article><article><span>03</span><h3>Send your request</h3><p>Add your event details, review the price, and submit for staff approval.</p></article><article><span>04</span><h3>Confirm with payment</h3><p>After approval, upload your downpayment proof and follow its verification status.</p></article></div></div></section>
<section class="cr-home-section"><div class="container cr-final-cta"><div><span class="cr-eyebrow">Your next celebration</span><h2>Let’s make it memorable.</h2><p>Start with your venue and preferred date.</p></div><a asp-controller="Bookings" asp-action="CreateStepOne" class="btn btn-primary">Check availability</a></div></section>
