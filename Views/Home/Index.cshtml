@model IEnumerable<AriesMagicAppointmentSystem.Models.Service>
@using AriesMagicAppointmentSystem.ViewModels
@{ ViewData["Title"] = "A show worth gathering for"; }
<section class="cx-hero container">
    <div class="cx-hero-copy"><span class="cx-kicker">Aries Magic / Event entertainment</span><h1>A show worth<br /><em>gathering for.</em></h1><p>Give your guests something to talk about. Explore our entertainment packages and bring a little wonder to your next celebration.</p><div class="cx-actions"><a asp-controller="Bookings" asp-action="CreateStepOne" class="btn btn-primary">Plan your celebration <span aria-hidden="true">↗</span></a><a asp-action="Packages" class="cx-text-link">Find your show <span aria-hidden="true">→</span></a></div><div class="cx-hero-note"><span>Made for the moment.</span><span>Planned around your event.</span></div></div>
    <div class="cx-hero-art"><partial name="_ClientMedia" model='ClientMedia.Get("hero")' /><span class="cx-art-stamp" aria-hidden="true">LET THE<br />SHOW BEGIN.</span></div>
</section>
<div class="cx-ribbon"><div class="container"><span>Good company.</span><span>A little surprise.</span><span>A shared memory.</span><a href="#how-it-works">See how booking works ↗</a></div></div>
<section class="cx-section container" id="packages"><div class="cx-section-head"><div><span class="cx-kicker">01 / Find your show</span><h2>Your occasion.<br /><em>Our kind of magic.</em></h2></div><div><p>Compare the packages, see what’s included, and choose the experience that fits your plans.</p><a asp-action="Packages" class="cx-text-link">Explore all packages →</a></div></div><partial name="_ClientPackageCards" model="Model.Take(3)" /></section>
<section class="cx-story" id="about"><div class="container cx-story-grid"><div><span class="cx-kicker">02 / More than a moment on stage</span><h2>The best part?<br /><em>Being there together.</em></h2></div><div><p class="cx-lead">An event is more than a date on a calendar. It’s the people you bring together.</p><p>Aries Magic offers event entertainment with packages you can explore and request online. Start with your venue and date, then make the details yours.</p><a asp-controller="Bookings" asp-action="CreateStepOne" class="cx-text-link">Let’s start planning →</a></div></div></section>
<section class="cx-section container" id="gallery"><div class="cx-section-head"><div><span class="cx-kicker">03 / A glimpse of the experience</span><h2>Room for<br /><em>a little wonder.</em></h2></div><p>Our visual story is taking shape. These artwork previews mark the spaces for approved event photography.</p></div><div class="cx-gallery">
@foreach (var key in new[] { "hero", "gallery-2", "gallery-3" }) { var media = ClientMedia.Get(key); <button type="button" class="cx-gallery-item" data-gallery-src="@media.Source" data-gallery-alt="@media.Alt" aria-label="Enlarge artwork preview: @media.Alt"><partial name="_ClientMedia" model="media" /><span class="cx-gallery-label">View artwork <span aria-hidden="true">↗</span></span></button> }
</div><div class="cx-film"><span class="cx-film-icon" aria-hidden="true">▶</span><div><span class="cx-kicker">The moving picture / 16:9</span><h3>A closer look, coming into focus.</h3><p>Showreel placeholder — an approved performance film will appear here. No video is available yet.</p></div></div></section>
<section class="cx-planning" id="how-it-works"><div class="container"><div class="cx-section-head"><div><span class="cx-kicker">04 / From idea to event day</span><h2>A little less planning.<br /><em>A lot more anticipation.</em></h2></div><p>Your venue, package, pricing, and updates come together in one booking journey.</p></div><ol class="cx-process"><li><span>01</span><h3>Set the scene</h3><p>Check your venue and a date at least three days ahead. See serviceability and estimated travel fees.</p></li><li><span>02</span><h3>Choose the experience</h3><p>Compare available packages, personalize eligible inclusions, and add your event details.</p></li><li><span>03</span><h3>Send your request</h3><p>Review your price and submit for staff approval. A request alone does not reserve the schedule.</p></li><li><span>04</span><h3>Follow the confirmation</h3><p>After approval, upload your downpayment proof and track verification in your account.</p></li></ol></div></section>
<section class="cx-section container cx-assurance"><div><span class="cx-kicker">Clear details. Confident decisions.</span><h2>Know where<br /><em>you stand.</em></h2></div><div><details open><summary>See the price before you submit</summary><p>Your booking summary separates package price, eligible customization discount, and estimated travel fees. Final checks happen when you submit.</p></details><details><summary>Keep every update together</summary><p>Review your booking, payment verification, notifications, and requests from your client account.</p></details><details><summary>What happens after I request a show?</summary><p>Staff review your request first. Follow the next step displayed in your booking before sending payment proof.</p></details></div></section>
@{ var publicStories = ViewData["PublicTestimonials"] as IEnumerable<ClientTestimonial> ?? Array.Empty<ClientTestimonial>(); }
<partial name="_ClientTestimonials" model="publicStories" />
<section class="cx-closing"><div class="container cx-closing-grid"><div><span class="cx-kicker">Your people. Your occasion.</span><h2>Make room for<br /><em>the unexpected.</em></h2><p>Start with a place and a date. Find the show that brings everyone together.</p></div><div class="cx-closing-actions"><a asp-controller="Bookings" asp-action="CreateStepOne" class="btn btn-light">Plan your celebration <span aria-hidden="true">↗</span></a><a asp-action="Packages" class="cx-closing-link">Still exploring? See the packages →</a><span>Venue & date → Package → Event details → Review</span></div></div></section>
<dialog id="clientGallery" class="cx-gallery-dialog" aria-labelledby="galleryTitle"><div class="cx-dialog-bar"><h2 id="galleryTitle">Artwork preview</h2><button type="button" class="btn btn-outline-secondary" data-gallery-close>Close ×</button></div><img alt="" width="1200" height="900" /><p>Illustrative placeholder. Approved event media will replace this artwork.</p></dialog>
