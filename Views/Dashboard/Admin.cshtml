@model AriesMagicAppointmentSystem.ViewModels.RoleDashboardViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "System Administration"; }
<div class="admin-console">
<header class="admin-heading"><div><h2>System overview</h2><p>Manage accounts, availability, packages and system records.</p></div></header>
<div class="admin-metrics">
<a asp-controller="UserManagement" asp-action="Index"><span>Total users</span><strong>@Model.TotalUsers</strong></a>
<a asp-controller="UserManagement" asp-action="Index" asp-route-role="Staff" asp-route-status="Active"><span>Active Staff</span><strong>@Model.ActiveStaff</strong></a>
<a asp-controller="UserManagement" asp-action="Index" asp-route-role="Client" asp-route-status="Active"><span>Active Clients</span><strong>@Model.ActiveClients</strong></a>
<a asp-controller="Services" asp-action="Index"><span>Active packages</span><strong>@Model.ActivePackages</strong></a>
<a asp-controller="Services" asp-action="Archived"><span>Archived packages</span><strong>@Model.ArchivedPackages</strong></a>
<a asp-controller="Calendar" asp-action="Index"><span>Blocked dates</span><strong>@Model.BlockedDates</strong></a>
</div>
<section class="admin-panel"><h3>System records</h3><div class="admin-actions"><a asp-controller="TrashHistory" asp-action="Index" class="btn btn-outline-secondary">Trash History</a><a asp-controller="SystemActivity" asp-action="Index" class="btn btn-outline-secondary">System Activity</a></div></section>
</div>
