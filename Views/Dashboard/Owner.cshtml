@model AriesMagicAppointmentSystem.ViewModels.RoleDashboardViewModel
@using AriesMagicAppointmentSystem.Models
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Owner Dashboard"; var events = Model.TodayEvents.Concat(Model.UpcomingEvents).Take(5).ToList(); }
<div class="role-workspace" data-role="Owner">
<partial name="_DashboardStart" model="Model" />
<div class="dash-content-grid">
<section class="dash-panel"><div class="dash-section-heading"><h3>Payments Awaiting Verification</h3><a asp-controller="Payments" asp-action="PendingVerification">View All Payments</a></div>
@if(Model.UnavailableSections.Contains("queues")){<p class="dash-empty">Unable to load payment submissions.</p>}
else if(!Model.RecentPaymentsToVerify.Any()){<p class="dash-empty">No payments currently require verification.</p>}
else {<p class="dash-note">@Model.PendingPayments pending &middot; Oldest first</p><div class="dash-list">
@foreach(var payment in Model.RecentPaymentsToVerify){
var ocr = payment.OcrVerifications.Where(o=>o.VerificationPurpose == OcrVerificationPurposes.PaymentProof).OrderByDescending(o=>o.ProcessedAt).FirstOrDefault();
<article class="dash-row"><div class="dash-record"><strong>BK-@(payment.Booking?.CreatedAt.Year)-@payment.BookingId.ToString("D3")</strong><span>@(payment.Booking?.Client?.FullName ?? "Client not recorded")</span><strong>PHP @payment.Amount.ToString("N2")</strong><small>OCR: @AriesMagicAppointmentSystem.ViewModels.AdminActivityPresentation.Label(ocr?.VerificationResult ?? "Not processed")</small></div><a class="dash-button" asp-controller="Payments" asp-action="Verify" asp-route-id="@payment.Id">Review<span class="visually-hidden"> payment @payment.Id</span></a></article>
}
</div>}
</section>
<section class="dash-panel"><div class="dash-section-heading"><h3>Refund Requests</h3><a asp-controller="Payments" asp-action="RefundRequests">View All Refunds</a></div>
@if(Model.UnavailableSections.Contains("queues")){<p class="dash-empty">Unable to load refund requests.</p>}
else if(!Model.RecentRefundRequests.Any()){<p class="dash-empty">No refunds currently require review.</p>}
else{<div class="dash-list">
@foreach(var refund in Model.RecentRefundRequests){
<article class="dash-row"><div class="dash-record"><strong>RF-@refund.Id.ToString("D4") &middot; Booking #@refund.BookingId</strong><span>@(refund.Booking?.Client?.FullName ?? "Client not recorded")</span><strong>PHP @refund.Amount.ToString("N2") requested</strong><partial name="_DashboardBadge" model="refund.Status" /></div><a class="dash-button" asp-controller="Payments" asp-action="RefundReview" asp-route-id="@refund.Id">Review<span class="visually-hidden"> refund @refund.Id</span></a></article>
}
</div>}
</section>
</div>
<section class="dash-panel"><div class="dash-section-heading"><h3>Business Overview</h3><a asp-controller="Reports" asp-action="Index">Open Reports</a></div>
@if(Model.UnavailableSections.Contains("business overview")){<p class="dash-empty">Unable to load business overview.</p>}
else {
<div class="dash-business-facts"><div><span>Confirmed this month</span><strong>@Model.ConfirmedBookings</strong></div><div><span>Completed this month</span><strong>@Model.CompletedBookings</strong></div><div><span>Most booked package this month</span><strong>@Model.MostBookedPackage</strong><small>Confirmed and completed events</small></div></div>
@if(Model.BookingTrend.Any()){
<figure class="dash-trend"><figcaption>Booking volume by event month <span>All statuses &middot; Latest six months</span></figcaption><div class="dash-trend-rows">
@foreach(var point in Model.BookingTrend){<div class="dash-trend-row"><span>@point.Label</span><meter min="0" max="@Math.Max(1,Model.BookingTrend.Max(p=>p.Count))" value="@point.Count" aria-label="@point.Label bookings">@point.Count</meter><strong>@point.Count</strong></div>}
</div></figure>
}
}
</section>
<section class="dash-panel"><div class="dash-section-heading"><h3>Upcoming Events</h3><a asp-controller="Calendar" asp-action="Index">View Calendar</a></div>
@if(Model.UnavailableSections.Contains("schedule")){<p class="dash-empty">Unable to load upcoming events.</p>}
else if(!events.Any()){<p class="dash-empty">No upcoming confirmed events.</p>}
else{<partial name="_DashboardEvents" model="events" />}
</section>
<partial name="_DashboardRecentActivity" model="Model" />
</div>
