@model AriesMagicAppointmentSystem.ViewModels.RoleDashboardViewModel
@using AriesMagicAppointmentSystem.Models
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Owner Dashboard";
}
<div class="role-workspace owner-round1-dashboard" data-role="Owner">
    <header class="owner-round1-heading">
        <span class="dash-eyebrow">Owner Workspace</span>
        <h1>Owner Dashboard</h1>
        <p>Monitor finances and review pending requests.</p>
    </header>
    <div class="owner-round1-grid">
        <section class="dash-panel owner-round1-requests" aria-labelledby="ownerFinancialRequestsTitle">
            <div class="dash-section-heading">
                <div><h2 id="ownerFinancialRequestsTitle"><i class="bi bi-credit-card" aria-hidden="true"></i> Financial Requests</h2><p>Review pending payment proofs and refund requests.</p></div>
            </div>
            <div class="owner-round1-tabs" role="tablist" aria-label="Financial request type">
                <button id="ownerPaymentsTab" class="owner-round1-tab active" type="button" role="tab" aria-controls="ownerPaymentsPanel" aria-selected="true" data-owner-tab="payments">Verify Payments (@Model.PendingPayments)</button>
                <button id="ownerRefundsTab" class="owner-round1-tab" type="button" role="tab" aria-controls="ownerRefundsPanel" aria-selected="false" tabindex="-1" data-owner-tab="refunds">Refund Requests (@(Model.PendingRefunds + Model.RefundProofsAwaitingVerification))</button>
            </div>
            <div id="ownerPaymentsPanel" class="owner-round1-tabpanel" role="tabpanel" tabindex="0" aria-labelledby="ownerPaymentsTab" data-owner-panel="payments">
                @if(Model.UnavailableSections.Contains("queues")){<p class="dash-empty">Unable to load payment requests.</p>}
                else if(!Model.RecentPaymentsToVerify.Any()){<p class="dash-empty">No payment proofs currently require review.</p>}
                else {
                    <div class="owner-round1-request-list">
                    @foreach(var payment in Model.RecentPaymentsToVerify) {
                        var ocr = payment.OcrVerifications.Where(o => o.VerificationPurpose == OcrVerificationPurposes.PaymentProof).OrderByDescending(o => o.ProcessedAt).FirstOrDefault();
                        var indicator = ocr?.VerificationResult == OcrVerificationResults.MismatchDetected ? "Receipt details conflict" : ocr?.VerificationResult == OcrVerificationResults.OcrFailed ? "OCR unclear" : ocr?.IsDuplicateReference == true || ocr?.IsDuplicateImage == true ? "Possible duplicate" : "Needs manual review";
                        <article class="owner-round1-request-row">
                            <div><strong class="owner-booking-code">BK-@(payment.Booking?.CreatedAt.Year)-@payment.BookingId.ToString("D3")</strong><span>@(payment.Booking?.Client?.FullName ?? "Client not recorded")</span></div>
                            <div><small>Claimed Amount</small><strong>&#8369;@((payment.ExpectedAmountAtUpload ?? payment.Amount).ToString("N2"))</strong></div>
                            <div><small>Submitted</small><span>@payment.UploadedAt.ToString("MMM d, yyyy")</span></div>
                            <div><span class="owner-round1-indicator">@indicator</span></div>
                            <a class="btn btn-primary btn-sm" asp-controller="Payments" asp-action="Verify" asp-route-id="@payment.Id">Review<span class="visually-hidden"> payment @payment.Id</span></a>
                        </article>
                    }
                    </div>
                }
                <a class="owner-round1-view-all" asp-controller="Payments" asp-action="PendingVerification">View all payment requests <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div id="ownerRefundsPanel" class="owner-round1-tabpanel" role="tabpanel" tabindex="0" aria-labelledby="ownerRefundsTab" data-owner-panel="refunds" hidden>
                @if(Model.UnavailableSections.Contains("queues")){<p class="dash-empty">Unable to load refund requests.</p>}
                else if(!Model.RecentRefundRequests.Any()){<p class="dash-empty">No refund requests currently require review.</p>}
                else {
                    <div class="owner-round1-request-list">
                    @foreach(var refund in Model.RecentRefundRequests) {
                        <article class="owner-round1-request-row">
                            <div><strong class="owner-booking-code">BK-@(refund.Booking?.CreatedAt.Year)-@refund.BookingId.ToString("D3")</strong><span>@(refund.Booking?.Client?.FullName ?? "Client not recorded")</span></div>
                            <div><small>Requested Refund</small><strong>&#8369;@refund.Amount.ToString("N2")</strong></div>
                            <div><small>Status</small><span>@refund.Status</span></div>
                            <div><span class="owner-round1-indicator">Manual review required</span></div>
                            <a class="btn btn-primary btn-sm" asp-controller="Payments" asp-action="RefundReview" asp-route-id="@refund.Id">Review<span class="visually-hidden"> refund @refund.Id</span></a>
                        </article>
                    }
                    </div>
                }
                <a class="owner-round1-view-all" asp-controller="Payments" asp-action="RefundRequests">View all refund requests <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
        </section>
        <aside class="owner-round1-metrics" aria-label="Financial overview">
            @if(Model.UnavailableSections.Contains("financial overview")){<div class="dash-panel"><p class="dash-empty">Financial metrics unavailable. No estimated totals are shown.</p></div>}
            else {
                <article class="dash-panel owner-round1-metric"><span class="owner-round1-metric-icon"><i class="bi bi-wallet2" aria-hidden="true"></i></span><div><span>Net Collected</span><strong>&#8369;@Model.NetCollectedRevenue.ToString("N2")</strong><small>Verified collections less completed refunds</small></div></article>
                <article class="dash-panel owner-round1-metric"><span class="owner-round1-metric-icon"><i class="bi bi-layers" aria-hidden="true"></i></span><div><span>Outstanding Balance</span><strong>&#8369;@Model.OutstandingReceivables.ToString("N2")</strong><small>Eligible outstanding collections</small></div></article>
                <article class="dash-panel owner-round1-metric"><span class="owner-round1-metric-icon"><i class="bi bi-calendar3" aria-hidden="true"></i></span><div><span>Booking Value</span><strong>&#8369;@Model.BookingValue.ToString("N2")</strong><small>Total eligible booking value</small></div></article>
            }
            <p class="owner-round1-helper"><i class="bi bi-info-circle" aria-hidden="true"></i> Financial decisions are reviewed on dedicated pages. <a asp-controller="Reports" asp-action="Index">Financial summary</a></p>
        </aside>
    </div>
</div>
