@model AriesMagicAppointmentSystem.ViewModels.RoleDashboardViewModel
@using AriesMagicAppointmentSystem.Models
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Staff Dashboard";
   var upcoming = Model.TodayEvents.Concat(Model.UpcomingEvents).OrderBy(b=>b.EventDate).ThenBy(b=>b.StartTime).Take(5).ToList();
}
<div class="staff-round1-dashboard" data-staff-priority>
<header class="staff-round1-intro"><div><span class="dash-eyebrow">Staff workspace</span><h1>Staff Dashboard</h1><p>Operations command center · Focus on the requests and conversations that need attention.</p></div></header>
@if(Model.UnavailableSections.Any()){<div class="dash-load-errors" role="status">@foreach(var section in Model.UnavailableSections){<p>Unable to load @(section). <a asp-controller="Dashboard" asp-action="Staff">Retry</a></p>}</div>}
<section class="staff-round1-metrics" aria-label="Current Staff priorities">
 <a class="staff-round1-metric" asp-controller="Communications" asp-action="Index" asp-route-filter="unread"><span class="staff-round1-metric-icon tone-message"><i class="bi bi-chat-dots" aria-hidden="true"></i></span><div><h2>Unread Client Messages</h2><strong>@(Model.UnavailableSections.Contains("messages")?"—":Model.UnreadClientConversations.ToString("N0"))</strong><small>Requires your response</small></div><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
 <a class="staff-round1-metric" asp-controller="Bookings" asp-action="Index" asp-route-bookingStatus="Pending"><span class="staff-round1-metric-icon tone-booking"><i class="bi bi-journal-check" aria-hidden="true"></i></span><div><h2>Pending Booking Requests</h2><strong>@(Model.UnavailableSections.Contains("requests")?"—":Model.PendingBookings.ToString("N0"))</strong><small>Awaiting Staff review</small></div><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
 <a class="staff-round1-metric" asp-controller="RescheduleRequests" asp-action="Index" asp-route-status="Pending"><span class="staff-round1-metric-icon tone-reschedule"><i class="bi bi-arrow-left-right" aria-hidden="true"></i></span><div><h2>Pending Reschedule Requests</h2><strong>@(Model.UnavailableSections.Contains("requests")?"—":Model.PendingReschedules.ToString("N0"))</strong><small>Awaiting Staff approval</small></div><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
</section>
<div class="staff-round1-columns">
<section class="staff-round1-panel staff-round1-priority" aria-labelledby="staffPriorityTitle">
 <div class="staff-round1-section-head"><div><span class="dash-eyebrow">Today's priorities</span><h2 id="staffPriorityTitle"><i class="bi bi-lightning-charge" aria-hidden="true"></i> Priority Workspace</h2><p>Your top tasks, organized by next action.</p></div></div>
 <div class="staff-round1-tabs" role="tablist" aria-label="Priority categories">
 <button type="button" role="tab" aria-controls="staffTabMessages" id="staffPriorityMessages" aria-selected="true" tabindex="0" data-staff-tab="messages">Client Messages <span>@Model.UnreadClientConversations</span></button>
 <button type="button" role="tab" aria-controls="staffTabBookings" id="staffPriorityBookings" aria-selected="false" tabindex="-1" data-staff-tab="bookings">Booking Requests <span>@Model.PendingBookings</span></button>
 <button type="button" role="tab" aria-controls="staffTabReschedules" id="staffPriorityReschedules" aria-selected="false" tabindex="-1" data-staff-tab="reschedules">Reschedule Requests <span>@Model.PendingReschedules</span></button>
 </div>
 <div class="staff-round1-tab-panel" id="staffTabMessages" role="tabpanel" aria-labelledby="staffPriorityMessages" data-staff-panel="messages">
 @if(Model.UnavailableSections.Contains("messages")){<p class="staff-round1-empty">Unable to load messages right now.</p>}
 else if(!Model.RecentClientConversations.Any()){<p class="staff-round1-empty">No active Client conversations to display.</p>}
 else{<div class="staff-round1-task-list">@foreach(var c in Model.RecentClientConversations){<article class="staff-round1-task"><span class="staff-round1-task-avatar" aria-hidden="true">@if(!string.IsNullOrWhiteSpace(c.AvatarUrl)){<img src="@c.AvatarUrl" alt="" loading="lazy" onerror="this.hidden=true;this.nextElementSibling.hidden=false"/><span hidden>@c.Initials</span>}else{<span>@c.Initials</span>}</span><div class="staff-round1-task-copy"><strong>@c.Name</strong><p>@c.Preview</p><small><time datetime="@c.SentAt.ToString("O")">@c.SentAt.ToLocalTime().ToString("MMM d, h:mm tt")</time>@if(c.UnreadCount>0){<span class="staff-round1-new">@c.UnreadCount unread</span>}</small></div><a class="staff-round1-action" asp-controller="Communications" asp-action="Index" asp-route-id="@c.Id">Open Conversation</a></article>}</div>}
 </div>
 <div class="staff-round1-tab-panel" id="staffTabBookings" role="tabpanel" aria-labelledby="staffPriorityBookings" data-staff-panel="bookings" hidden>
 @if(Model.UnavailableSections.Contains("requests")){<p class="staff-round1-empty">Unable to load booking requests.</p>}
 else if(!Model.RecentBookingRequests.Any()){<p class="staff-round1-empty">No pending booking requests.</p>}
 else{<div class="staff-round1-task-list">@foreach(var b in Model.RecentBookingRequests){<article class="staff-round1-task"><span class="staff-round1-task-avatar" aria-hidden="true"><i class="bi bi-journal-text"></i></span><div class="staff-round1-task-copy"><strong class="staff-round1-booking-code">BK-@b.CreatedAt.Year-@b.Id.ToString("D3")</strong><p>@(b.Client?.FullName??"Client not recorded") · @b.EventDate.ToString("MMM d, yyyy") · @b.StartTime.ToString("h:mm tt")</p><small>Pending Staff review</small></div><a class="staff-round1-action" asp-controller="Bookings" asp-action="Details" asp-route-id="@b.Id">View Details</a></article>}</div>}
 </div>
 <div class="staff-round1-tab-panel" id="staffTabReschedules" role="tabpanel" aria-labelledby="staffPriorityReschedules" data-staff-panel="reschedules" hidden>
 @if(Model.UnavailableSections.Contains("requests")){<p class="staff-round1-empty">Unable to load reschedules.</p>}
 else if(!Model.RecentRescheduleRequests.Any()){<p class="staff-round1-empty">No pending reschedule requests.</p>}
 else{<div class="staff-round1-task-list">@foreach(var r in Model.RecentRescheduleRequests){<article class="staff-round1-task"><span class="staff-round1-task-avatar" aria-hidden="true"><i class="bi bi-calendar2-week"></i></span><div class="staff-round1-task-copy"><strong class="staff-round1-booking-code">BK-@r.Booking?.CreatedAt.Year-@r.BookingId.ToString("D3")</strong><p>@(r.Booking?.Client?.FullName??"Client not recorded") · Requested @r.RequestedDate.ToString("MMM d, yyyy") @r.RequestedStartTime.ToString("h:mm tt")</p><small>Current: @((r.OriginalDate??r.Booking?.EventDate)?.ToString("MMM d, yyyy")??"Unavailable")</small></div><a class="staff-round1-action" asp-controller="RescheduleRequests" asp-action="Details" asp-route-id="@r.Id">View Details</a></article>}</div>}
 </div>
</section>
<aside class="staff-round1-panel staff-round1-upcoming" aria-labelledby="staffUpcomingTitle">
 <div class="staff-round1-section-head"><div><span class="dash-eyebrow">Your next scheduled events</span><h2 id="staffUpcomingTitle"><i class="bi bi-calendar3" aria-hidden="true"></i> Upcoming Events</h2><p>Next confirmed events with venue information.</p></div></div>
 @if(Model.UnavailableSections.Contains("schedule")){<p class="staff-round1-empty">Unable to load the calendar.</p>}
 else if(!upcoming.Any()){<p class="staff-round1-empty">No upcoming confirmed events.</p>}
 else{<div class="staff-round1-event-list">@foreach(var b in upcoming){<article class="staff-round1-event"><time class="staff-round1-date" datetime="@b.EventDate.ToString("yyyy-MM-dd")"><strong>@b.EventDate.ToString("dd")</strong><span>@b.EventDate.ToString("MMM yyyy")</span></time><div><a class="staff-round1-booking-code" asp-controller="Bookings" asp-action="Details" asp-route-id="@b.Id">BK-@b.CreatedAt.Year-@b.Id.ToString("D3")</a><strong>@b.StartTime.ToString("h:mm tt") – @b.EndTime.ToString("h:mm tt")</strong><p title="@b.PartyVenue">@(string.IsNullOrWhiteSpace(b.PartyVenue)?"Venue not recorded":b.PartyVenue)</p></div></article>}</div>}
 <a asp-controller="Calendar" asp-action="Index" class="staff-round1-calendar-link"><i class="bi bi-calendar-week" aria-hidden="true"></i> View Calendar</a>
</aside>
</div></div>