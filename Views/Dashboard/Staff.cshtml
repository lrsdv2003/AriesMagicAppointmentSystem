@model AriesMagicAppointmentSystem.ViewModels.RoleDashboardViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Staff Dashboard"; }
<div class="role-workspace" data-role="Staff">
<partial name="_DashboardStart" model="Model" />
<div class="dash-content-grid">
<section class="dash-panel"><div class="dash-section-heading"><h3>@(Model.TodayEvents.Any() ? "Today's Schedule" : "Next Upcoming Events")</h3><a asp-controller="Calendar" asp-action="Index">View Calendar</a></div>
@if(Model.UnavailableSections.Contains("schedule")){<p class="dash-empty">Unable to load the schedule.</p>}
else if(Model.TodayEvents.Any()){<partial name="_DashboardEvents" model="Model.TodayEvents" />}
else {<p class="dash-note">No events scheduled today.</p>
@if(Model.UpcomingEvents.Any()){<partial name="_DashboardEvents" model="Model.UpcomingEvents" />}else{<p class="dash-empty">No upcoming confirmed events.</p>}}
</section>
<section class="dash-panel"><div class="dash-section-heading"><h3>Booking Requests</h3><a asp-controller="Bookings" asp-action="Index" asp-route-bookingStatus="Pending">View All</a></div>
@if(Model.UnavailableSections.Contains("requests")){<p class="dash-empty">Unable to load requests.</p>}
else if(!Model.RecentBookingRequests.Any()){<p class="dash-empty">No booking requests currently require your attention.</p>}
else {<p class="dash-note">@Model.PendingBookings awaiting review &middot; Oldest first</p><div class="dash-list">
@foreach(var booking in Model.RecentBookingRequests){
<article class="dash-row"><div class="dash-record"><strong>BK-@booking.CreatedAt.Year-@booking.Id.ToString("D3")</strong><span>@(booking.Client?.FullName ?? "Client not recorded")</span><small>@booking.PackageName &middot; @booking.EventDate.ToString("MMM d, yyyy")</small><partial name="_DashboardBadge" model="booking.Status" /></div><a class="dash-button" asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id">Review<span class="visually-hidden"> booking @booking.Id</span></a></article>
}
</div>}
</section>
</div>
@if(!Model.UnavailableSections.Contains("requests") && Model.RecentRescheduleRequests.Any()){
<section class="dash-panel"><div class="dash-section-heading"><h3>Reschedule Requests</h3><a asp-controller="RescheduleRequests" asp-action="Index" asp-route-status="Pending">View All</a></div><div class="dash-list">
@foreach(var request in Model.RecentRescheduleRequests){
<article class="dash-row"><div class="dash-record"><strong>@(request.Booking?.Client?.FullName ?? "Client not recorded")</strong><span>Booking #@request.BookingId &middot; Requested @request.RequestedDate.ToString("MMM d, yyyy")</span></div><a class="dash-button" asp-controller="RescheduleRequests" asp-action="Details" asp-route-id="@request.Id">Review<span class="visually-hidden"> reschedule @request.Id</span></a></article>
}
</div></section>}
<partial name="_DashboardRecentActivity" model="Model" />
</div>
