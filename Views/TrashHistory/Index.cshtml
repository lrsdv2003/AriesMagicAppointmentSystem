@model AriesMagicAppointmentSystem.ViewModels.TrashHistoryIndexViewModel
@using AriesMagicAppointmentSystem.Models
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Archives";
    ViewData["HideWorkspaceHeading"] = true;
    var f = Model.Filters;
    var hasActiveFilters = f.Reason.HasValue || f.DateFrom.HasValue || f.DateTo.HasValue;
    var filtered = !string.IsNullOrWhiteSpace(f.Search) || hasActiveFilters ||
                   (!string.IsNullOrWhiteSpace(f.PaymentStatus) && f.PaymentStatus != "All") ||
                   !string.IsNullOrWhiteSpace(f.AssignedStaffId);
    var archivePager = new AriesMagicAppointmentSystem.ViewModels.QueuePaginationViewModel(
        Model.TotalCount, Model.Filters.Page, 5, "Index", new Dictionary<string,string> {
            ["Search"] = f.Search ?? "",
            ["Reason"] = f.Reason?.ToString("d") ?? "",
            ["PaymentStatus"] = f.PaymentStatus,
            ["AssignedStaffId"] = f.AssignedStaffId ?? "",
            ["DateFrom"] = f.DateFrom?.ToString("yyyy-MM-dd") ?? "",
            ["DateTo"] = f.DateTo?.ToString("yyyy-MM-dd") ?? "",
            ["SortBy"] = f.SortBy ?? "newest"
        });
}
<div class="owner-archives-page">
    <div class="owner-archives-toolbar">
    <form method="get" asp-action="Index" class="am-filter-bar aries-round3-toolbar" data-aries-round3-filter="true">
        <div class="am-filter-row">

            <!-- Direct Search Input -->
            <div class="am-filter-search">
                <div class="input-group w-100">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input aria-label="Search records" type="text" name="Search" value="@f?.Search" class="form-control border-start-0"
                           placeholder="Booking ID, client, package, event type..." />
                </div>
            </div>

            <!-- Floating Filter Popover Dropdown -->
            <div class="dropdown filter-dropdown-wrapper">
                <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2"
                        type="button"
                        id="trashFilterDropdown"
                        data-bs-toggle="dropdown"
                        data-bs-auto-close="outside"
                        aria-expanded="false">
                    <i class="bi bi-funnel" aria-hidden="true"></i>
                    <span>Filters</span>
                    @if (hasActiveFilters)
                    {
                        <span class="filter-active-dot"></span>
                    }
                </button>

                <!-- Floating Card Content -->
                <div class="dropdown-menu dropdown-menu-end filter-popover-menu"
                     aria-labelledby="trashFilterDropdown"
                     >

                    <h6 class="fw-bold mb-3">Filter Archived Requests</h6>

                    <div class="mb-3">
                        <label class="form-label" for="TrashHistoryIndexReason">Reason</label>
<select id="TrashHistoryIndexReason" name="Reason" class="form-select form-select-sm">
                            <option value="">All Reasons</option>
                            @foreach (TrashReason reason in Enum.GetValues(typeof(TrashReason)))
                            {
                                <option value="@((int)reason)" selected="@(f?.Reason == reason)">@AriesMagicAppointmentSystem.ViewModels.BusinessActivityPresentation.Label(reason)</option>
                            }
                        </select>
                    </div>


                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label" for="TrashHistoryIndexDateFrom">Archived from</label>
<input id="TrashHistoryIndexDateFrom" type="date" name="DateFrom" value="@(f?.DateFrom?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="TrashHistoryIndexDateTo">Archived to</label>
<input id="TrashHistoryIndexDateTo" type="date" name="DateTo" value="@(f?.DateTo?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                        </div>
                    </div>

                    <hr class="my-3" />

                    <label class="form-label" for="archiveSort">Sort by</label>
                    <select id="archiveSort" class="form-select form-select-sm mb-2" name="SortBy">
                      <option value="newest" selected="@(f?.SortBy != "oldest")">Newest to Oldest</option>
                      <option value="oldest" selected="@(f?.SortBy == "oldest")">Oldest to Newest</option>
                    </select>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset filters</a>
                </div>
            </div>

            <!-- Action Buttons -->
            <button type="submit" class="visually-hidden">Search</button>

            <a class="btn btn-outline-secondary aries-round3-refresh" asp-action="Index"
               asp-route-Search="@f?.Search" asp-route-Reason="@(f?.Reason?.ToString("d"))"
               asp-route-PaymentStatus="@f?.PaymentStatus" asp-route-AssignedStaffId="@f?.AssignedStaffId"
               asp-route-DateFrom="@(f?.DateFrom?.ToString("yyyy-MM-dd"))"
               asp-route-DateTo="@(f?.DateTo?.ToString("yyyy-MM-dd"))"
               asp-route-SortBy="@f?.SortBy" asp-route-Page="@f?.Page"
               aria-label="Refresh archived bookings" title="Refresh archived bookings"
               data-owner-archives-refresh="true"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></a>
        </div>
    </form>
    </div>
    <p id="ownerArchivesRefreshStatus" class="owner-archives-refresh-feedback" role="status" aria-live="polite" hidden></p>
    <div id="ownerArchivesResults">
        <div class="staff-data-table-frame owner-archives-table-frame" data-staff-table-capacity="5">
            <div class="staff-data-table-scroll" tabindex="0" role="region"
                 aria-label="Archived booking records; scroll horizontally to view all columns">
                <table class="staff-data-table owner-archives-table">
                    <caption class="visually-hidden">Archived booking records</caption>
                    <colgroup>
                        <col class="owner-archives-col-id" />
                        <col class="owner-archives-col-client" />
                        <col class="owner-archives-col-event" />
                        <col class="owner-archives-col-archive" />
                        <col class="owner-archives-col-status" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col">Booking ID</th>
                            <th scope="col">Client Name</th>
                            <th scope="col">Date and Time</th>
                            <th scope="col">Archive Date</th>
                            <th scope="col">Final Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Bookings.Any())
                        {
                            <tr class="staff-data-table-empty-row">
                                <td colspan="5">
                                    <div class="staff-data-table-empty" role="status">
                                        <i class="bi bi-inbox" aria-hidden="true"></i>
                                        @if (filtered)
                                        {
                                            <strong>No matching archives</strong>
                                            <p>Try adjusting your search or sorting.</p>
                                            <a asp-action="Index" class="staff-data-table-reset">Clear filters</a>
                                        }
                                        else
                                        {
                                            <strong>No archived bookings</strong>
                                            <p>There are no archived booking records to display.</p>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Bookings)
                            {
                                <tr>
                                    <td data-label="Booking ID"><strong class="owner-archives-code">@item.BookingCode</strong></td>
                                    <td data-label="Client Name">@item.ClientName</td>
                                    <td data-label="Date and Time">
                                        <time datetime="@item.EventDate.ToString("yyyy-MM-dd")">@item.EventDate.ToString("MMM d, yyyy")</time>
                                        <span class="owner-archives-cell-secondary">
                                            @DateTime.Today.Add(item.StartTime).ToString("h:mm tt") &ndash; @DateTime.Today.Add(item.EndTime).ToString("h:mm tt")
                                        </span>
                                    </td>
                                    <td data-label="Archive Date">
                                        @if (item.ArchiveDateRecorded)
                                        {
                                            <time datetime="@item.ArchivedAt.ToString("O")">@item.ArchivedAt.ToString("MMM d, yyyy")</time>
                                        }
                                        else
                                        {
                                            <span class="owner-archives-cell-secondary">Not recorded</span>
                                        }
                                    </td>
                                    <td data-label="Final Status">
                                        <span class="owner-archives-status">@(string.IsNullOrWhiteSpace(item.BookingStatus) ? "Not recorded" : item.BookingStatus)</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_QueuePagination" model="archivePager" />
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/owner-archives.js" asp-append-version="true"></script>
}
