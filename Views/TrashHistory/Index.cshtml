@model AriesMagicAppointmentSystem.ViewModels.TrashHistoryIndexViewModel
@using AriesMagicAppointmentSystem.Models
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Trash History"; var f = Model.Filters; var hasActiveFilters = f.Reason.HasValue || f.DateFrom.HasValue || f.DateTo.HasValue; }
<div class="admin-console">
<header class="admin-heading"><div><h2>Archived booking records</h2><p>Read-only records of cancelled, declined and expired requests.</p></div></header>
<div class="am-filter-container">
    <form method="get" asp-action="Index" class="am-filter-bar">
        <div class="am-filter-row">
            
            <!-- Direct Search Input -->
            <div class="am-filter-search">
                <div class="input-group w-100">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input aria-label="Search records" type="text" name="Search" value="@f?.Search" class="form-control border-start-0"
                           placeholder="Booking ID, client, package, event type..." />
                </div>
            </div>

            <!-- Floating Filter Popover Dropdown -->
            <div class="dropdown filter-dropdown-wrapper">
                <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2" 
                        type="button" 
                        id="trashFilterDropdown" 
                        data-bs-toggle="dropdown" 
                        data-bs-auto-close="outside" 
                        aria-expanded="false">
                    <i class="bi bi-funnel"></i>
                    <span>Filters</span>
                    @if (hasActiveFilters)
                    {
                        <span class="filter-active-dot"></span>
                    }
                </button>

                <!-- Floating Card Content -->
                <div class="dropdown-menu dropdown-menu-end filter-popover-menu" 
                     aria-labelledby="trashFilterDropdown" 
                     style="width: 350px;">
                    
                    <h6 class="fw-bold mb-3">Filter Archived Requests</h6>
                    
                    <div class="mb-3">
                        <label class="form-label" for="TrashHistoryIndexReason">Reason</label>
<select id="TrashHistoryIndexReason" name="Reason" class="form-select form-select-sm">
                            <option value="">All Reasons</option>
                            @foreach (TrashReason reason in Enum.GetValues(typeof(TrashReason)))
                            {
                                <option value="@((int)reason)" selected="@(f?.Reason == reason)">@AriesMagicAppointmentSystem.ViewModels.AdminActivityPresentation.Label(reason)</option>
                            }
                        </select>
                    </div>


                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label" for="TrashHistoryIndexDateFrom">Archived from</label>
<input id="TrashHistoryIndexDateFrom" type="date" name="DateFrom" value="@(f?.DateFrom?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="TrashHistoryIndexDateTo">Archived to</label>
<input id="TrashHistoryIndexDateTo" type="date" name="DateTo" value="@(f?.DateTo?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                        </div>
                    </div>

                    <hr class="my-3" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light btn-sm">Reset</a>
                        <button type="submit" class="btn btn-primary btn-sm">Apply Filters</button>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <button type="submit" class="btn btn-primary">Search</button>

            @if (f != null && (!string.IsNullOrEmpty(f.Search) || hasActiveFilters))
            {
                <a asp-action="Index" class="btn btn-link text-decoration-none text-muted">Reset</a>
            }
        </div>
    </form>
</div>


<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th scope="col">Record</th><th scope="col">Type</th><th scope="col">Archived by</th><th scope="col">Archived date</th><th scope="col">Recovery</th><th scope="col">Actions</th></tr></thead><tbody>
@foreach(var item in Model.Bookings) {
<tr><td data-label="Record"><div><strong>@item.BookingCode</strong><small>@item.ClientName</small></div></td><td data-label="Type"><span class="admin-badge">Booking</span></td><td data-label="Archived by">@item.ArchivedBy</td><td data-label="Archived date">@(item.ArchiveDateRecorded ? item.ArchivedAt.ToString("MMM d, yyyy") : "Not recorded")</td><td data-label="Recovery"><span class="admin-badge">Read-only archive</span></td><td data-label="Actions"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">View</a></td></tr>
}
</tbody></table>@if(!Model.Bookings.Any()) { <p class="admin-empty">Trash is empty.</p> }</div>
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    @for (var p = Math.Max(1, Model.Filters.Page - 2); p <= Math.Min(Model.TotalPages, Model.Filters.Page + 2); p++)
                    {
                        <li class="page-item @(p == f?.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p"
                               asp-route-Search="@f?.Search"
                               asp-route-Reason="@(f?.Reason?.ToString("d"))"
                               asp-route-PaymentStatus="@f?.PaymentStatus"
                               asp-route-AssignedStaffId="@f?.AssignedStaffId"
                               asp-route-DateFrom="@(f?.DateFrom?.ToString("yyyy-MM-dd"))"
                               asp-route-DateTo="@(f?.DateTo?.ToString("yyyy-MM-dd"))">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        }

<section class="admin-panel"><h3>Archived packages</h3><p class="admin-note">Package records can be restored through Package Management.</p>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th scope="col">Record</th><th scope="col">Type</th><th scope="col">Archived by</th><th scope="col">Archived date (UTC)</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead><tbody>
@foreach(var package in Model.ArchivedPackages) {
var archive = Model.PackageArchives.GetValueOrDefault(package.Id.ToString());
<tr><td data-label="Record">@package.Name</td><td data-label="Type"><span class="admin-badge">Package</span></td><td data-label="Archived by">@(archive?.PerformedByUserName ?? "Not recorded")</td><td data-label="Archived date (UTC)">@(archive?.CreatedAt.ToString("MMM d, yyyy h:mm tt") ?? "Not recorded")</td><td data-label="Status">Restorable</td><td data-label="Actions"><a asp-controller="Services" asp-action="Restore" asp-route-id="@package.Id" class="btn btn-outline-secondary">Restore</a></td></tr>
}
</tbody></table>@if(!Model.ArchivedPackages.Any()) { <p class="admin-empty">No archived packages.</p> }</div></section>
</div>
