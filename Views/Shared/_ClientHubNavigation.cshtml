@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var links = new[]
    {
        ("Dashboard", "Bookings", "Dashboard", "bi-house-door"),
        ("My bookings", "Bookings", "MyBookings", "bi-calendar2-event"),
        ("Payments", "Payments", "MyUploads", "bi-wallet2"),
        ("Rescheduling", "RescheduleRequests", "MyRequests", "bi-calendar2-week"),
        ("Refund requests", "Payments", "MyRefundRequests", "bi-arrow-return-left")
    };
}
<nav class="hub-navigation" aria-label="Client navigation">
    <div class="hub-nav-group">
        @foreach (var (label, linkController, linkAction, icon) in links)
        {
            var active = controller == linkController;
            if (controller == "Bookings" && linkController == "Bookings")
                active = action is "Dashboard" or "ClientDashboard" ? linkAction == "Dashboard" : linkAction == "MyBookings";
            if (controller == "Payments" && linkController == "Payments")
                active = action is "MyRefundRequests" or "RequestRefund" ? linkAction == "MyRefundRequests" : linkAction == "MyUploads";

            <a asp-controller="@linkController" asp-action="@linkAction" aria-current="@(active ? "page" : null)">
                <i class="bi @icon" aria-hidden="true"></i><span>@label</span>
            </a>
        }
    </div>
</nav>
