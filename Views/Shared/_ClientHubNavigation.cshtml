@{
 var controller=ViewContext.RouteData.Values["controller"]?.ToString();
 var action=ViewContext.RouteData.Values["action"]?.ToString();
 var groups=new[]{
  ("Your space",new[]{("My bookings","Bookings","MyBookings","bi-calendar2-event")}),
  ("Event management",new[]{("Payments","Payments","MyUploads","bi-wallet2"),("Rescheduling","RescheduleRequests","MyRequests","bi-calendar2-week"),("Refund requests","Payments","MyRefundRequests","bi-arrow-return-left")})};
}
<div class="hub-brand"><a asp-controller="Home" asp-action="Index" class="client-brand"><partial name="_WonderBrand"/></a><span>Client workspace</span></div>
<nav class="hub-navigation" aria-label="Client navigation">
@foreach(var group in groups){<div class="hub-nav-group"><p class="hub-nav-caption">@group.Item1</p>
@foreach(var link in group.Item2){
 var active=controller==link.Item2;
 if(controller=="Bookings") active=link.Item3=="MyBookings";
 if(controller=="Payments") active=(action=="MyRefundRequests"||action=="RequestRefund")?link.Item3=="MyRefundRequests":link.Item3=="MyUploads";
 <a asp-controller="@link.Item2" asp-action="@link.Item3" aria-current="@(active?"page":null)"><i class="bi @link.Item4" aria-hidden="true"></i><span>@link.Item1</span></a>
}</div>}
</nav>
<div class="hub-rail-footer"><span>Manage your bookings and event plans.</span></div>
