@inject Microsoft.Extensions.Options.IOptions<Microsoft.AspNetCore.Identity.IdentityOptions> IdentityRules
@{ var rules = IdentityRules.Value.Password; }
<p class="au-help" id="passwordGuidance">Use at least @rules.RequiredLength characters.@if(rules.RequireDigit){<text> Include a number.</text>}@if(rules.RequireLowercase){<text> Include a lowercase letter.</text>}@if(rules.RequireUppercase){<text> Include an uppercase letter.</text>}@if(rules.RequireNonAlphanumeric){<text> Include a symbol.</text>}</p>
