@model AriesMagicAppointmentSystem.ViewModels.InternalProfileViewModel
@{
    var profileController = User.IsInRole("Client") ? "Profile" : "InternalProfile";
}
<form asp-controller="@profileController" asp-action="ChangePassword" method="post" data-account-form>
                        @Html.AntiForgeryToken()
                        <div class="up-field">
                            <label for="Password_CurrentPassword">Current Password</label>
                            <div class="up-password">
                                <input asp-for="Password.CurrentPassword" class="up-input" autocomplete="current-password" required />
                                <button type="button" class="up-password-toggle" data-toggle-password="Password_CurrentPassword" aria-controls="Password_CurrentPassword" aria-pressed="false" aria-label="Show current password">Show</button>
                            </div>
                            <span asp-validation-for="Password.CurrentPassword" class="up-error-text"></span>
                        </div>
                        <div class="up-field">
                            <label for="Password_NewPassword">New Password</label>
                            <div class="up-password">
                                <input asp-for="Password.NewPassword" class="up-input" autocomplete="new-password" required minlength="12" aria-describedby="passwordRules" />
                                <button type="button" class="up-password-toggle" data-toggle-password="Password_NewPassword" aria-controls="Password_NewPassword" aria-pressed="false" aria-label="Show new password">Show</button>
                            </div>
                            <span asp-validation-for="Password.NewPassword" class="up-error-text"></span>
                        </div>
                        <div class="up-field">
                            <label for="Password_ConfirmPassword">Confirm New Password</label>
                            <div class="up-password">
                                <input asp-for="Password.ConfirmPassword" class="up-input" autocomplete="new-password" required />
                                <button type="button" class="up-password-toggle" data-toggle-password="Password_ConfirmPassword" aria-controls="Password_ConfirmPassword" aria-pressed="false" aria-label="Show password confirmation">Show</button>
                            </div>
                            <span asp-validation-for="Password.ConfirmPassword" class="up-error-text"></span>
                        </div>
                        <ul class="up-password-rules" id="passwordRules">@foreach(var rule in Model.PasswordRules){<li>@rule</li>}</ul>
                        <div class="up-actions"><button type="submit" class="up-btn up-btn-primary" data-saving="Updating...">Change Password</button><button type="reset" class="up-btn up-btn-outline">Cancel</button></div>
                    </form>
