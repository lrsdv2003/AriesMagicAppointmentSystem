@model ErrorViewModel
@{
    ViewData["Title"] = "Unable to complete request";
    var internalUser = User.IsInRole("Staff") || User.IsInRole("Admin") || User.IsInRole("Owner");
    Layout = internalUser ? "_DashboardLayout" : "_Layout";
    var destination = User.IsInRole("Owner") ? "Owner" : User.IsInRole("Admin") ? "Admin" : "Staff";
}
<section class="ui-panel cr-card" role="alert">
    @if (!internalUser) { <h1>Unable to complete request</h1> }
    <p>Please try again. If the issue continues, share the request ID with support.</p>
    @if (Model.ShowRequestId) { <p>Request ID: <code>@Model.RequestId</code></p> }
    @if (internalUser) { <a asp-controller="Dashboard" asp-action="@destination" class="btn btn-primary">Back to dashboard</a> }
    else { <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a> }
</section>
