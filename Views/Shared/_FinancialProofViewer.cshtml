<div class="modal fade owner-proof-modal" id="financialProofModal" tabindex="-1" aria-labelledby="financialProofTitle" aria-hidden="true">
<div class="modal-dialog modal-dialog-centered modal-xl"><div class="modal-content">
<div class="modal-header"><h2 class="modal-title fs-5" id="financialProofTitle">Financial Proof</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
<div class="d-flex gap-2 p-2 border-bottom" role="group" aria-label="Proof zoom controls">
<button type="button" class="btn btn-outline-secondary btn-sm" data-proof-zoom="-1">Zoom out</button>
<button type="button" class="btn btn-outline-secondary btn-sm" data-proof-zoom="0">Fit image</button>
<button type="button" class="btn btn-outline-secondary btn-sm" data-proof-zoom="1">Zoom in</button>
<span id="financialProofZoom" class="align-self-center" aria-live="polite">100%</span></div>
<div class="modal-body"><img id="financialProofImage" alt="Enlarged financial proof" /><p id="financialProofError" class="alert alert-warning d-none" role="alert">Unable to load this proof. Close the preview and refresh the page.</p></div>
</div></div></div>
