@model AriesMagicAppointmentSystem.ViewModels.QueuePaginationViewModel
<div class="aries-five-pager" data-page-size="5" role="group" aria-label="Five record pagination">
    <span class="aries-five-total" role="status">@Model.TotalCount matching record@(Model.TotalCount == 1 ? "" : "s")</span>
    <nav class="aries-five-actions" aria-label="Record pages">
        @if(Model.Page > 1) {
            <a class="btn btn-outline-secondary" asp-action="@Model.Action" asp-all-route-data="Model.Routes(Model.Page - 1)" aria-label="Previous page" title="Previous page"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
        } else {
            <button class="btn btn-outline-secondary" type="button" aria-label="Previous page" disabled><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
        }
        <span class="aries-five-page" aria-live="polite">Page @Model.Page of @Model.TotalPages</span>
        @if(Model.Page < Model.TotalPages) {
            <a class="btn btn-primary" asp-action="@Model.Action" asp-all-route-data="Model.Routes(Model.Page + 1)" aria-label="Next page" title="Next page"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
        } else {
            <button class="btn btn-outline-secondary" type="button" aria-label="Next page" disabled><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
        }
    </nav>
</div>
