@using System.Security.Claims
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var isHome = currentController == "Home" && currentAction == "Index";
    var isClient = User.Identity?.IsAuthenticated == true && User.IsInRole("Client");
    var pageClass = $"client-{currentController.ToLowerInvariant()} client-{currentController.ToLowerInvariant()}-{currentAction.ToLowerInvariant()}";
    var clientUnreadCount = 0;
    if (isClient)
    {
        var clientUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!string.IsNullOrEmpty(clientUserId))
        {
            clientUnreadCount = _clientDbContext.Notifications
                .Count(n => n.UserId == clientUserId && !n.IsRead);

        }
    }
}
@inject AriesMagicAppointmentSystem.Data.ApplicationDbContext _clientDbContext

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#194F49" />
    <meta name="description" content="Explore Aries Magic entertainment packages, check your venue and date, and manage your event booking in one place." />
    <title>@ViewData["Title"] - Aries Magic</title>
    <link rel="preload" href="~/fonts/wonder/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/wonder/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/aries-client-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AriesMagicAppointmentSystem.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/magic-client-v2.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/magic-client-consistency.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/communication-center.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ocr-verification.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/package-cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/filters.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/client-refresh.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/client-experience.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/feedback.css" asp-append-version="true" />
</head>
<body class="client-body @pageClass @(isHome ? "client-home-page" : "client-inner-page")">
    <a class="magic-skip-link" href="#mainContent">Skip to content</a>

    <div class="am-page-loader" id="ariesPageLoader" aria-hidden="true">
        <span class="am-loader-sigil"></span>
    </div>

    <div class="magic-ambient magic-ambient-one" aria-hidden="true"></div>
    <div class="magic-ambient magic-ambient-two" aria-hidden="true"></div>

    <header class="client-navbar-wrap" id="siteHeader">
        <nav class="navbar navbar-expand-lg client-navbar" aria-label="Main navigation">
            <div class="container magic-nav-container">
                <a class="navbar-brand client-brand" asp-controller="Home" asp-action="Index" aria-label="Aries Magic home">
                    <span class="brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-opacity=".28" />
                            <path d="M20 5.5 22.6 16l10.6 3L22.6 22 20 34.5 17.4 22 6.8 19l10.6-3L20 5.5Z" fill="currentColor" />
                        </svg>
                    </span>
                    <span class="brand-copy">
                        <strong>Aries Magic</strong>
                        <small>The Wonder Studio</small>
                    </span>
                </a>

                <button class="navbar-toggler magic-navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#clientNavbar" aria-controls="clientNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span aria-hidden="true">☰</span>
                </button>

                <div class="collapse navbar-collapse" id="clientNavbar">
                    <ul class="navbar-nav mx-auto client-nav-links">
                        <li class="nav-item"><a class="nav-link @(isHome ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link @(currentController == "Home" && (currentAction == "Packages" || currentAction == "Package") ? "active" : "")" asp-controller="Home" asp-action="Packages">Experiences</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="about">About</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="gallery">Gallery</a></li>
                    </ul>

                    <div class="client-nav-actions">
                        @if (isClient)
                        {
                            <a asp-controller="Notifications" asp-action="Index" class="magic-icon-btn d-none d-lg-inline-flex position-relative @(currentController == "Notifications" ? "active" : "")" aria-label="Notifications@(clientUnreadCount > 0 ? $", {clientUnreadCount} unread" : "")" title="Notifications">
                                <i class="bi bi-bell" aria-hidden="true"></i>
                                @if (clientUnreadCount > 0)
                                {
                                    <span class="notification-badge" aria-hidden="true">
                                        @(clientUnreadCount > 99 ? "99+" : clientUnreadCount.ToString())
                                    </span>
                                }
                            </a>

                            <div class="dropdown">
                                <button class="magic-account-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="magic-account-avatar"><i class="bi bi-person" aria-hidden="true"></i></span>
                                    <span>My Account</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end magic-account-menu">
                                    <li><a class="dropdown-item" asp-controller="Bookings" asp-action="Dashboard"><i class="bi bi-house" aria-hidden="true"></i> My Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Bookings" asp-action="MyBookings"><i class="bi bi-calendar2-event" aria-hidden="true"></i> My Bookings</a></li>
                                    <li><a class="dropdown-item" asp-controller="Payments" asp-action="MyUploads"><i class="bi bi-wallet2" aria-hidden="true"></i> My Payments</a></li>
                                    <li><a class="dropdown-item" asp-controller="Communications" asp-action="Index" asp-route-view="inbox"><i class="bi bi-chat-dots" aria-hidden="true"></i> Messages</a></li>
                                    <li><a class="dropdown-item" asp-controller="Feedback" asp-action="Index">My feedback</a></li>
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle" aria-hidden="true"></i> Profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell" aria-hidden="true"></i> Notifications</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>

                            <a asp-controller="Bookings" asp-action="CreateStepOne" class="btn magic-primary-cta">
                                <span>Book a show ↗</span>
                            </a>


                        }
                        else if (User.Identity?.IsAuthenticated == true)
                        {
                            var dashboardAction = User.IsInRole("Owner") ? "Owner" : User.IsInRole("Admin") ? "Admin" : "Staff";
                            <a asp-controller="Dashboard" asp-action="@dashboardAction" class="btn magic-primary-cta">Go to Dashboard</a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="magic-text-btn">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="magic-text-btn">Sign in</a>
                            <a asp-controller="Bookings" asp-action="CreateStepOne" class="btn magic-primary-cta">Book your event ↗</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @if (isClient && !isHome && currentController != "Home")
    {
        <nav class="cx-account-nav" aria-label="Your account">
            <div class="container">
                <a asp-controller="Bookings" asp-action="Dashboard" aria-current="@(currentAction is "Dashboard" or "ClientDashboard" ? "page" : null)">Overview</a>
                <a asp-controller="Bookings" asp-action="MyBookings" aria-current="@(currentAction == "MyBookings" ? "page" : null)">Bookings</a>
                <a asp-controller="Payments" asp-action="MyUploads" aria-current="@(currentController == "Payments" ? "page" : null)">Payments</a>
                <a asp-controller="RescheduleRequests" asp-action="MyRequests" aria-current="@(currentController == "RescheduleRequests" ? "page" : null)">Rescheduling</a>
                <a asp-controller="Communications" asp-action="Index" asp-route-view="inbox" aria-current="@(currentController == "Communications" ? "page" : null)">Messages</a>
                <a asp-controller="Notifications" asp-action="Index" aria-current="@(currentController == "Notifications" ? "page" : null)">Updates</a>
                <a asp-controller="Profile" asp-action="Index" aria-current="@(currentController == "Profile" ? "page" : null)">Profile</a>
                <a asp-controller="Feedback" asp-action="Index" aria-current="@(currentController == "Feedback" ? "page" : null)">Feedback</a>
            </div>
        </nav>
    }

    <main tabindex="-1" id="mainContent" class="client-main">
        @if (isHome || currentController == "Communications")
        {
            @RenderBody()
        }
        else
        {
            <div class="container client-page-wrap">
                @RenderBody()
            </div>
        }
    </main>

    <footer class="client-footer">
        <div class="container">
            <div class="magic-footer-top">
                <div class="magic-footer-brand">
                    <a class="client-brand" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark" aria-hidden="true"><i class="bi bi-stars" aria-hidden="true"></i></span>
                        <span class="brand-copy"><strong>Aries Magic</strong><small>The Wonder Studio</small></span>
                    </a>
                    <p>A little magic. A lot of memories.<br />Live entertainment for the people you bring together.</p>
                </div>

                <div class="magic-footer-links">
                    <div>
                        <h2 class="cx-footer-heading">Discover</h2>
                        <a asp-controller="Home" asp-action="Index" asp-fragment="about">About</a>
                        <a asp-controller="Home" asp-action="Packages">Experiences</a>
                        <a asp-controller="Bookings" asp-action="CreateStepOne">Availability</a>
                        <a asp-controller="Home" asp-action="Index" asp-fragment="gallery">Gallery</a>
                    </div>
                    <div>
                        <h2 class="cx-footer-heading">Your plans</h2>
                        @if (isClient)
                        {
                            <a asp-controller="Bookings" asp-action="Dashboard">My Dashboard</a>
                            <a asp-controller="Bookings" asp-action="MyBookings">My Bookings</a>
                            <a asp-controller="Payments" asp-action="MyUploads">Payments</a>
                            <a asp-controller="Profile" asp-action="Index">Profile</a>
                            <a asp-controller="Communications" asp-action="Index" asp-route-view="inbox">Messages</a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login">Sign In</a>
                            <a asp-controller="Account" asp-action="Register">Create Account</a>
                        }
                    </div>
                </div>
                <div class="cx-footer-invitation"><span class="cx-kicker">An occasion in mind?</span><p>Let’s set<br /><em>the scene.</em></p><a asp-controller="Bookings" asp-action="CreateStepOne" class="cx-text-link">Find your date <span aria-hidden="true">↗</span></a></div>
            </div>

            <div class="footer-bottom">
                <span>&copy; @DateTime.Now.Year Aries Magic. All rights reserved.</span>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/magic-client-v2.js" asp-append-version="true"></script>
    <script src="~/js/client-experience.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/communication-global.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/filters.js" asp-append-version="true"></script>
    <script src="~/js/app-ui.js" asp-append-version="true"></script>
</body>
</html>
