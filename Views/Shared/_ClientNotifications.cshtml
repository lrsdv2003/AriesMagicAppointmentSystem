@model IEnumerable<AriesMagicAppointmentSystem.Models.Notification>
@{var notices=Model.OrderByDescending(n=>n.CreatedAt).ToList();var unread=notices.Count(n=>!n.IsRead);}
<div class="hub-heading"><div><span class="hub-kicker">Booking & account updates</span><h1>Notifications</h1><p>@unread unread · @notices.Count total updates, newest first.</p></div>@if(unread>0){<form asp-action="MarkAllRead" method="post">@Html.AntiForgeryToken()<button class="cn-button cn-secondary" type="submit">Mark all as read</button></form>}</div>
@if(notices.Count==0){<section class="hub-card hub-empty"><h2>You’re all caught up.</h2><p>New booking, payment and account updates will appear here.</p><a asp-controller="Bookings" asp-action="MyBookings" class="cn-button cn-secondary">My bookings</a></section>}
else{<div id="hubNotices" class="client-notification-list">@foreach(var group in notices.GroupBy(n=>n.CreatedAt.Date==DateTime.Today?"Today":"Earlier")){<section class="hub-notice-group"><h2>@group.Key</h2><div class="hub-card hub-notice-list">@foreach(var notice in group){<partial name="_NotificationRow" model="notice"/>}</div></section>}</div>}
