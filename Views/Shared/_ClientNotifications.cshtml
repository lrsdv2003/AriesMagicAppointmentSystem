@model IEnumerable<AriesMagicAppointmentSystem.Models.Notification>
@{var notices=Model.OrderByDescending(n=>n.CreatedAt).ToList();var unread=notices.Count(n=>!n.IsRead);}
<div class="hub-heading"><div><span class="hub-kicker">Booking & account updates</span><h1>Notifications.</h1><p>@unread unread. Open an update to see its related page.</p></div>@if(unread>0){<form asp-action="MarkAllRead" method="post">@Html.AntiForgeryToken()<button class="cn-button cn-secondary" type="submit">Mark all as read</button></form>}</div>
@if(notices.Count==0){<section class="hub-card hub-empty"><h2>You’re all caught up.</h2><p>New booking, payment and account updates will appear here.</p><a asp-controller="Bookings" asp-action="Dashboard" class="cn-text-link">Back to overview</a></section>}
else{<div class="hub-filter-buttons" role="group" aria-label="Notification view"><button type="button" data-notice-filter="all" aria-pressed="true">All updates</button><button type="button" data-notice-filter="unread" aria-pressed="false">Unread</button></div><div id="hubNotices">@foreach(var group in notices.GroupBy(n=>n.CreatedAt.Date==DateTime.Today?"Today":"Earlier")){<section class="hub-notice-group" data-notice-group><h2>@group.Key</h2><div class="hub-card hub-notice-list">@foreach(var notice in group){<partial name="_NotificationRow" model="notice"/>}</div></section>}</div><p id="hubNoticeEmpty" class="hub-card hub-empty-note" hidden>No unread updates. You’re all caught up.</p><p id="hubNoticeCount" class="cn-help" role="status"></p>}
