@model AriesMagicAppointmentSystem.ViewModels.CommunicationCenterViewModel
@using AriesMagicAppointmentSystem.Extensions
@{var selected=Model.SelectedConversation;var last=selected?.Messages.LastOrDefault()?.Id??0;}
<div id="communicationCenter" class="comm-page comm-page-client hub-messages @(selected!=null?"comm-has-selection":"")" data-conversation-id="@(selected?.Id??0)" data-last-message-id="@last" data-messages-url="@Url.Action("MessagesSince","Communications")" data-unread-url="@Url.Action("UnreadCount","Communications")">
<header class="hub-heading"><div><span class="hub-kicker">A conversation for every detail</span><h1>Messages.</h1><p>Booking questions stay with your event. Support is here for everything else.</p></div><form asp-action="StartSupport" method="post">@Html.AntiForgeryToken()<button type="submit" class="cn-button cn-primary">Contact support</button></form></header>
@if(TempData["Error"] is string error){<div class="cn-error-summary" role="alert">@error</div>}@if(TempData["Success"] is string success){<div class="cn-success" role="status">@success</div>}
<div class="comm-workspace">
<aside class="comm-conversation-panel" aria-label="Conversation list"><div class="comm-panel-top"><div class="hub-section-heading"><h2>Your inbox</h2><span class="hub-help">@Model.UnreadConversationCount unread</span></div><form asp-action="Index" method="get" class="hub-inbox-search"><input type="hidden" name="filter" value="@Model.Filter"/><input type="hidden" name="view" value="inbox"/><label for="hubConversationSearch" class="visually-hidden">Search conversations</label><input id="hubConversationSearch" type="search" name="q" value="@Model.Search" placeholder="Search conversations"/><button type="submit" aria-label="Search conversations"><i class="bi bi-search" aria-hidden="true"></i></button></form><nav class="comm-filter-strip" aria-label="Conversation filters">@foreach(var item in new[]{("all","All"),("unread","Unread"),("booking","Bookings"),("support","Support")}){<a asp-action="Index" asp-route-filter="@item.Item1" asp-route-view="inbox" asp-route-q="@Model.Search" class="@(Model.Filter==item.Item1?"active":"")" aria-current="@(Model.Filter==item.Item1?"true":null)">@item.Item2</a>}</nav>@if(!string.IsNullOrWhiteSpace(Model.Search)){<a asp-action="Index" asp-route-view="inbox" class="hub-help">Clear search</a>}</div>
<div class="comm-conversation-list" tabindex="0" role="region" aria-label="Your conversation list">@if(Model.Conversations.Count==0){<div class="comm-list-empty"><strong>@(string.IsNullOrWhiteSpace(Model.Search)?"No conversations to show.":"No conversations match.")</strong><span>Try another filter or contact support above.</span></div>}else{@foreach(var item in Model.Conversations){<a asp-action="Index" asp-route-id="@item.Id" asp-route-filter="@Model.Filter" asp-route-q="@Model.Search" class="comm-conversation-item @(selected?.Id==item.Id?"active":"") @(item.UnreadCount>0?"unread":"")" aria-current="@(selected?.Id==item.Id?"true":null)"><span class="comm-avatar" aria-hidden="true">@item.Initials</span><span class="comm-item-copy"><span class="comm-item-heading"><strong>@item.Title</strong><time>@item.LastActivityAt.ToLocalTime().ToString("MMM d")</time></span><span class="comm-item-subtitle">@item.Subtitle</span><span class="comm-item-preview">@item.LatestMessage</span></span>@if(item.UnreadCount>0){<span class="comm-unread-pill" aria-label="@item.UnreadCount unread messages">@item.UnreadCount</span>}</a>}}</div></aside>
<section class="comm-chat-panel" aria-label="Selected conversation">
@if(selected==null){<div class="comm-chat-empty"><i class="bi bi-chat-dots" aria-hidden="true"></i><h2>Pick up the conversation.</h2><p>Select a message from your inbox. For a booking question, you can also open the conversation from your booking details.</p><a asp-controller="Bookings" asp-action="MyBookings">View my bookings</a></div>}
else{
<header class="comm-chat-header"><a asp-action="Index" asp-route-view="inbox" asp-route-filter="@Model.Filter" asp-route-q="@Model.Search" class="comm-mobile-back" aria-label="Back to conversations"><i class="bi bi-arrow-left" aria-hidden="true"></i></a><div class="comm-chat-title"><div><h2>@selected.Title</h2><p>@selected.ParticipantSummary</p></div></div>@if(selected.BookingId.HasValue){<a asp-controller="Bookings" asp-action="Details" asp-route-id="@selected.BookingId" class="comm-secondary-btn">View booking</a>}</header>
<div class="cx-chat-connection"><span id="commConnectionStatus" role="status" aria-live="polite">Checking for updates…</span><button type="button" id="commRetry" hidden>Retry connection</button></div>
<div class="comm-message-history" id="commMessageHistory" role="log" tabindex="0" aria-label="Conversation messages" aria-live="polite" aria-relevant="additions"><div class="comm-history-start"><span>Conversation started</span></div>@foreach(var message in selected.Messages){<article class="comm-message @(message.IsMine?"mine":"theirs")" data-message-id="@message.Id"><div class="comm-message-meta"><strong>@(message.IsMine?"You":message.SenderName)</strong><span>@message.SenderRole</span><time>@message.SentAt.ToLocalTime().ToString("MMM d, h:mm tt")</time></div>@if(message.MessageType=="ActionRequest"){<div class="comm-action-card"><strong>@message.RequestType · @message.RequestStatus</strong><p>@message.Content</p>@if(!string.IsNullOrWhiteSpace(message.ActionLink)&&User.CanFollowModuleLink(message.ActionLink)){<a href="@message.ActionLink" class="comm-secondary-btn">Open related page</a>}</div>}else{<div class="comm-bubble">@message.Content</div>}@if(message.IsMine){<span class="comm-delivery-state">Sent</span>}</article>}</div>
<button type="button" id="commLatest" class="cx-chat-latest" hidden>New messages · Go to latest ↓</button>
@if(selected.CanSend){<form asp-action="SendMessage" method="post" id="commComposer" class="comm-composer">@Html.AntiForgeryToken()<input type="hidden" name="conversationId" value="@selected.Id"/><div class="comm-composer-row"><label for="commMessageInput" class="visually-hidden">Message</label><textarea name="messageContent" id="commMessageInput" rows="1" maxlength="4000" placeholder="Write a message…" required></textarea><button class="comm-send-btn" type="submit">Send <span aria-hidden="true">↑</span></button></div><div class="comm-composer-note"><span id="commComposerStatus" role="status" aria-live="polite"></span><span>Enter to send · Shift + Enter for a new line</span></div></form>}else{<p class="cn-notice">Sending is unavailable for this conversation. You can still read its messages.</p>}
}
</section></div></div>
