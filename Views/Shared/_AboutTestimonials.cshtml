@model IEnumerable<AriesMagicAppointmentSystem.ViewModels.ClientTestimonial>
@{ var stories = Model.Where(s => s.CanPublish).Take(3).ToList(); }
@if (stories.Count > 0)
{
<section class="wa-section wa-feedback" aria-labelledby="aboutFeedbackTitle">
    <div class="container">
        <div class="wa-section-heading"><div><span class="wa-kicker">After the applause</span><h2 id="aboutFeedbackTitle">From the people<br /><em>who were there.</em></h2></div><p>Verified client feedback, shared with permission.</p></div>
        <div class="wa-feedback-grid">
            @foreach (var story in stories)
            {
                <figure class="wa-feedback-card">
                    @if (story.OverallRating.HasValue) { <span class="wa-rating" aria-label="Overall experience: @story.OverallRating out of 5">@story.OverallRating / 5 · Overall experience</span> }
                    <blockquote>@story.Excerpt</blockquote>
                    @foreach (var imageId in story.PublicImageIds) { <img class="wa-feedback-photo" src="@Url.Action("Public", "FeedbackMedia", new { id = imageId })" alt="Approved event photograph shared with client permission" width="600" height="400" loading="lazy" /> }
                    <figcaption><strong>@story.PublicName</strong><span>@story.EventLabel</span></figcaption>
                </figure>
            }
        </div>
    </div>
</section>
}
