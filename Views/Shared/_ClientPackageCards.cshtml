@model IEnumerable<AriesMagicAppointmentSystem.Models.Service>
@{ var packages = Model.ToList(); var number = 0; }
<div class="we-cards">
@foreach (var package in packages)
{
    var inclusions = package.Inclusions.OrderBy(i => i.Id).ToList();
    number++;
    <article class="we-card" aria-labelledby="package-@package.Id">
        <header class="we-card-heading">
            <span class="we-card-number" aria-hidden="true">@number.ToString("D2")</span>
            <h2 id="package-@package.Id">@package.Name</h2>
            <p class="we-duration">@package.DurationInHours @(package.DurationInHours == 1 ? "hour" : "hours") <span aria-hidden="true">/</span> Live entertainment</p>
        </header>
        <div class="we-card-body">
            <div class="we-card-overview">
                <p class="we-price"><span>Package price</span><strong>₱@package.Price.ToString(package.Price % 1 == 0 ? "N0" : "N2")</strong></p>
                @if (!string.IsNullOrWhiteSpace(package.Description)) { <p class="we-description">@package.Description</p> }
            </div>
            <div class="we-inclusions">
                <h3>What’s included</h3>
                @if (inclusions.Count > 0)
                {
                    <ul>@foreach (var inclusion in inclusions) { <li>@inclusion.Name</li> }</ul>
                }
                else { <p class="we-inclusions-empty">Inclusion details are not available for this package.</p> }
            </div>
            <div class="we-card-actions">
                <a asp-controller="Bookings" asp-action="CreateStepOne" asp-route-serviceId="@package.Id" class="we-button we-button-primary we-card-book">Choose this package <span aria-hidden="true">→</span><span class="visually-hidden">: @package.Name</span></a>
                <a asp-controller="Home" asp-action="Package" asp-route-id="@package.Id" class="we-text-link we-card-details">View full details <span aria-hidden="true">↗</span><span class="visually-hidden">: @package.Name</span></a>
            </div>
        </div>
    </article>
}
</div>
@if (packages.Count == 0)
{
    <div class="we-empty"><h3>The next show is taking shape.</h3><p>Packages are being updated. Please check back soon.</p><a asp-controller="Home" asp-action="Index" class="we-text-link">Back to Home <span aria-hidden="true">→</span></a></div>
}
