@model IEnumerable<AriesMagicAppointmentSystem.Models.Service>
@using AriesMagicAppointmentSystem.ViewModels
@{ var number = 0; }
<div class="cx-packages">
@foreach(var package in Model)
{
    var media = ClientMedia.Get(new[] { "hero", "gallery-2", "gallery-3" }[number++ % 3]);
    <article class="cx-package"><div class="cx-package-art"><partial name="_ClientMedia" model="media" /><span class="cx-package-number">@number.ToString("D2")</span></div><div class="cx-package-body"><span class="cx-kicker">@package.DurationInHours hours / Live entertainment</span><h3>@package.Name</h3><p class="cx-price"><span>Package from</span> ₱@package.Price.ToString("N0")</p>@if(!string.IsNullOrWhiteSpace(package.Description)){<p class="cx-package-description">@package.Description</p>}<ul>@foreach(var inclusion in package.Inclusions.OrderBy(i=>i.Id).Take(3)){<li>@inclusion.Name</li>}</ul><a asp-controller="Home" asp-action="Package" asp-route-id="@package.Id" class="cx-text-link">Discover the package <span aria-hidden="true">↗</span><span class="visually-hidden">: @package.Name</span></a></div></article>
}
</div>
@if(!Model.Any()){<div class="cr-card cr-empty"><h2>The next show is taking shape.</h2><p>Packages are being updated. Please check back soon.</p></div>}
