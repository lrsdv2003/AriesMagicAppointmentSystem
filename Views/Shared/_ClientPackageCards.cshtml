@model IEnumerable<AriesMagicAppointmentSystem.Models.Service>
@using AriesMagicAppointmentSystem.ViewModels
@{ var number = 0; }
<div class="cx-packages">
@foreach(var package in Model)
{
    var media = ClientMedia.Get(new[] { "service-1", "service-2", "service-3" }[number++ % 3]);
    <article class="cx-package">
        <div class="cx-package-art"><partial name="_ClientMedia" model="media" /><span class="cx-package-number">@number.ToString("D2")</span></div>
        <div class="cx-package-body">
            <span class="cx-kicker">@package.DurationInHours hours / Live entertainment</span>
            <h3>@package.Name</h3>
            <p class="cx-price"><span>Package price</span> ₱@package.Price.ToString("N0")</p>
            @if(!string.IsNullOrWhiteSpace(package.Description)){<p class="cx-package-description">@package.Description</p>}
            <ul>@foreach(var inclusion in package.Inclusions.OrderBy(i=>i.Id).Take(3)){<li>@inclusion.Name</li>}</ul>
            <a asp-controller="Home" asp-action="Package" asp-route-id="@package.Id" class="cx-text-link">Explore the details <span aria-hidden="true">↗</span><span class="visually-hidden">: @package.Name</span></a>
            <a asp-controller="Bookings" asp-action="CreateStepOne" asp-route-serviceId="@package.Id" class="btn btn-outline-primary cx-package-book">Choose this experience <span class="visually-hidden">: @package.Name</span><span aria-hidden="true">↗</span></a>
        </div>
    </article>
}
</div>
@if(!Model.Any()){<div class="cr-card cr-empty"><h2>The next show is taking shape.</h2><p>Packages are being updated. Please check back soon.</p></div>}
