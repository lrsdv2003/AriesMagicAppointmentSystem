@model AriesMagicAppointmentSystem.ViewModels.ConfirmedBookingChangeEditViewModel
@using System.Globalization
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = $"BK-{Model.Booking.CreatedAt.Year}-{Model.Booking.Id:D3}";
    ViewData["HideWorkspaceHeading"] = true;
    var booking = Model.Booking;
}
<div class="confirmed-change-page owner-confirmed-change-page">
  <header class="confirmed-change-heading owner-booking-detail-header">
    <h1>BK-@booking.CreatedAt.Year-@booking.Id.ToString("D3")</h1>
    <a asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id" class="btn btn-outline-secondary">Back to Booking Details</a>
  </header>
  @if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert">@error</div>}
  <div class="confirmed-change-layout">
    <section class="confirmed-change-card" aria-labelledby="changeTitle">
      <h2 id="changeTitle">Package and Venue</h2>
      <form asp-controller="BookingChanges" asp-action="Propose" method="post" id="confirmedChangeForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="BookingId" value="@booking.Id"/>
        <div class="confirmed-change-field">
          <label for="confirmedPackage">Package</label>
          <select name="ServiceId" id="confirmedPackage" class="form-select" required>
            @foreach(var service in Model.AvailablePackages){
              <option value="@service.Id" selected="@(Model.Input.ServiceId == service.Id)">@service.Name — &#8369;@service.Price.ToString("N2") (@service.DurationInHours hour(s))</option>
            }
          </select>
          <small>Changing packages resets earlier inclusion removals and may change the performance duration. Schedule conflicts are checked before sending.</small>
        </div>
        <div class="confirmed-change-field">
          <label for="confirmedVenue">Full event venue address</label>
          <textarea id="confirmedVenue" name="Venue" rows="2" minlength="8" maxlength="500" class="form-control" required>@Model.Input.Venue</textarea>
          <small>For a new venue, select a precise location result or enter its verified map pin below.</small>
        </div>
        <div class="confirmed-change-field">
          <label for="confirmedVenueSearch">Search for the venue's location pin</label>
          <div class="confirmed-change-search"><input id="confirmedVenueSearch" type="search" class="form-control" placeholder="Venue, street, city, Philippines" autocomplete="off"/>
            <button type="button" id="confirmedSearch" class="btn btn-outline-primary">Find location</button></div>
          <div id="confirmedPlaces" class="confirmed-change-places" role="status" aria-live="polite"></div>
        </div>
        <details class="confirmed-change-coordinates"><summary>Verify or enter the precise venue pin</summary>
          <p>Use coordinates for the actual event location, not the center of a city.</p>
          <div class="confirmed-change-coordinate-row">
            <div><label for="confirmedLatitude">Latitude</label><input id="confirmedLatitude" name="Latitude" type="number" min="-90" max="90" step="any" class="form-control" value="@Model.Input.Latitude?.ToString(CultureInfo.InvariantCulture)"/></div>
            <div><label for="confirmedLongitude">Longitude</label><input id="confirmedLongitude" name="Longitude" type="number" min="-180" max="180" step="any" class="form-control" value="@Model.Input.Longitude?.ToString(CultureInfo.InvariantCulture)"/></div>
          </div>
        </details>
        <div class="confirmed-change-actions" aria-label="Submission actions">
          <button type="submit" class="btn btn-primary confirmed-change-submit" data-loading-text="Sending...">Send proposal to Client</button>
        </div>
      </form>
    </section>
    <aside class="confirmed-change-card confirmed-change-summary" aria-label="Current contract">
      <h2>Current confirmed booking</h2>
      <dl>
        <div><dt>Package</dt><dd>@booking.PackageName</dd></div>
        <div><dt>Venue</dt><dd>@booking.PartyVenue</dd></div>
        <div><dt>Schedule</dt><dd>@booking.EventDate.ToString("MMM d, yyyy") · @booking.StartTime.ToString("h:mm tt")–@booking.EndTime.ToString("h:mm tt")</dd></div>
        <div><dt>Travel fee</dt><dd>&#8369;@booking.TravelFee.ToString("N2")</dd></div>
        <div><dt>Booking total</dt><dd>&#8369;@booking.FinalPrice.ToString("N2")</dd></div>
        <div><dt>Verified payments</dt><dd>&#8369;@Model.VerifiedPayments.ToString("N2")</dd></div>
        <div><dt>Remaining balance</dt><dd>&#8369;@Math.Max(0m,booking.FinalPrice-Model.VerifiedPayments).ToString("N2")</dd></div>
      </dl>
    </aside>
  </div>
</div>
<script src="~/js/confirmed-booking-edit-20261109.js" asp-append-version="true"></script>
