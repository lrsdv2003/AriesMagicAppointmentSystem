@model AriesMagicAppointmentSystem.Models.ApplicationUser
@{
 Layout = "_DashboardLayout"; ViewData["Title"] = "User Details";
 bool canManage = ViewBag.CanManage == true;
}
<div class="admin-console">
<header class="admin-heading"><div><h2>@Model.FullName</h2><p>Account administration</p></div><a asp-action="Index" class="btn btn-outline-secondary">Back to Users</a></header>
<section class="admin-panel"><h3>Account information</h3><dl class="admin-facts"><div><dt>Email</dt><dd>@Model.Email</dd></div><div><dt>Role</dt><dd><span class="admin-badge">@ViewBag.Roles</span></dd></div><div><dt>Account status</dt><dd>@(!Model.IsActive ? "Disabled" : Model.LockoutEnd > DateTimeOffset.UtcNow ? "Locked" : "Active")</dd></div><div><dt>Email verification</dt><dd>@(Model.EmailConfirmed ? "Verified" : "Unverified")</dd></div></dl></section>
<section class="admin-panel"><h3>Account activity</h3><dl class="admin-facts"><div><dt>Created (UTC)</dt><dd>@Model.CreatedAt.ToString("MMM d, yyyy h:mm tt")</dd></div><div><dt>Last login (UTC)</dt><dd>@(Model.LastLoginAt?.ToString("MMM d, yyyy h:mm tt") ?? "Never logged in")</dd></div></dl></section>
@if(canManage) {
<section class="admin-panel"><h3>Edit Staff account</h3>
<form asp-action="EditStaff" method="post" data-admin-confirm="Save changes to this staff account?">
@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.Id" />
<div class="admin-form-grid"><div><label for="fullName">Full name</label><input id="fullName" name="FullName" value="@Model.FullName" required class="form-control" /></div><div><label for="email">Email</label><input id="email" name="Email" type="email" value="@Model.Email" required class="form-control" /></div><div><label for="phone">Phone</label><input id="phone" name="PhoneNumber" required value="@Model.PhoneNumber" class="form-control" /></div></div>
<div class="admin-actions"><button class="btn btn-primary">Save Changes</button></div></form>
</section>
<section class="admin-panel"><h3>Account access</h3><p>@(Model.IsActive ? "Deactivation prevents this staff member from signing in." : "Activation allows this staff member to sign in again.")</p>
<form asp-action="@(Model.IsActive ? "DisableStaff" : "ActivateStaff")" method="post" data-admin-confirm="Confirm this change to staff account access?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><button class="btn @(Model.IsActive ? "btn-outline-danger" : "btn-outline-primary")">@(Model.IsActive ? "Deactivate" : "Activate")</button></form></section>
} else { <p class="admin-note">This account is read-only under the current account administration permissions.</p> }
</div>
