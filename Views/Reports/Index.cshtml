@model AriesMagicAppointmentSystem.ViewModels.ReportDashboardViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Financial Summary";
    ViewData["HideWorkspaceHeading"] = true;
    var financialRecordFiltersActive =
        Model.StartDate.HasValue || Model.EndDate.HasValue || Model.Month.HasValue ||
        Model.Year.HasValue || !string.IsNullOrWhiteSpace(Model.PackageFilter) ||
        !string.IsNullOrWhiteSpace(Model.BookingStatusFilter) ||
        !string.IsNullOrWhiteSpace(Model.RecordSearch) ||
        !string.IsNullOrWhiteSpace(Model.RecordStatus);
}
<div class="owner-reports-page">
    @if(!ViewData.ModelState.IsValid){<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>}
    <div class="owner-report-toolbar">
    <form asp-action="Index" method="get" class="am-filter-bar am-filter-row" aria-label="Report filters">
    <div class="owner-filter-summary"><i class="bi bi-calendar-range" aria-hidden="true"></i><span>@(Model.StartDate.HasValue || Model.EndDate.HasValue ? $"{Model.StartDate?.ToString("MMM dd, yyyy") ?? "Any start"} - {Model.EndDate?.ToString("MMM dd, yyyy") ?? "Any end"}" : "All event dates")</span></div>
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"><i class="bi bi-funnel" aria-hidden="true"></i> Filters</button>
        <div class="dropdown-menu dropdown-menu-end p-3">
            <label class="form-label" for="startDate">Event Start Date</label><input type="date" id="startDate" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control mb-3" />
            <label class="form-label" for="endDate">Event End Date</label><input type="date" id="endDate" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control mb-3" />
            <div class="row g-2">
                <div class="col-6"><label class="form-label" for="reportMonth">Month</label><select id="reportMonth" name="month" class="form-select mb-3"><option value="">Any month</option>@for(var m=1;m<=12;m++){<option value="@m" selected="@(Model.Month==m)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>}</select></div>
                <div class="col-6"><label class="form-label" for="reportYear">Year</label><select id="reportYear" name="year" class="form-select mb-3"><option value="">Any year</option>@foreach(var reportYear in Model.AvailableYears){<option value="@reportYear" selected="@(Model.Year==reportYear)">@reportYear</option>}</select></div>
            </div>
            <label class="form-label" for="reportPackage">Package</label><select id="reportPackage" name="package" class="form-select mb-3"><option value="">All packages</option>@foreach(var packageName in Model.AvailablePackages){<option value="@packageName" selected="@(Model.PackageFilter==packageName)">@packageName</option>}</select>
            <label class="form-label" for="reportStatus">Booking Status</label><select id="reportStatus" name="bookingStatus" class="form-select mb-3"><option value="">All statuses</option>@foreach(var status in Model.AvailableBookingStatuses){<option value="@status" selected="@(Model.BookingStatusFilter==status)">@status</option>}</select>
            <div class="d-flex justify-content-end gap-2"><a asp-action="Index" class="btn btn-light">Clear Filters</a><button type="submit" class="btn btn-primary">Apply Filters</button></div>
        </div>
    </div>
</form>
        <div class="owner-report-actions"><a asp-action="ExportCsv" asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")" asp-route-month="@Model.Month" asp-route-year="@Model.Year" asp-route-package="@Model.PackageFilter" asp-route-bookingStatus="@Model.BookingStatusFilter" class="btn btn-outline-primary"><i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i> Export CSV</a><button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer" aria-hidden="true"></i> Print</button></div>
    </div>
    <section class="owner-report-section" aria-labelledby="financialOverviewTitle">
        <div class="owner-report-heading"><div><h2 id="financialOverviewTitle">Financial Overview</h2></div><span class="owner-report-note">Net Collected: ₱@Model.NetCollectedRevenue.ToString("N2")</span></div>
        <div class="owner-report-metrics">
            <article><span>Total Booking Value</span><strong>₱@Model.TotalBookingValue.ToString("N2")</strong><small>Excludes cancelled, declined and expired bookings</small></article>
            <article class="positive"><span>Collected Revenue</span><strong>₱@Model.TotalCollectedRevenue.ToString("N2")</strong><small>Verified payments received</small></article>
            <article class="warning"><span>Outstanding Balance</span><strong>₱@Model.OutstandingReceivables.ToString("N2")</strong><small>Still owed by clients</small></article>
            <article class="negative"><span>Total Refunds</span><strong>₱@Model.RefundsIssued.ToString("N2")</strong><small>Completed refunds only</small></article>
        </div>
    </section>
    <section class="owner-report-section" aria-labelledby="trendTitle">
        <div class="owner-report-heading"><div><h2 id="trendTitle">Financial Visualizations</h2></div></div>
        <div class="owner-chart-grid">
            <article class="owner-chart-card"><div><h3>Revenue Over Time</h3><p>Collection dates for the selected bookings.</p></div><div class="owner-chart-frame"><canvas id="revenueTrendChart" role="img" aria-describedby="reportChartData" aria-label="Verified revenue over time"></canvas></div></article>
            <article class="owner-chart-card"><div><h3>Revenue by Package</h3><p>Verified collections minus completed refunds by package.</p></div>@if(Model.PackageLabels.Any()){<div class="owner-chart-frame"><canvas id="packageRevenueChart" role="img" aria-describedby="reportChartData" aria-label="Net revenue by package"></canvas></div>}else{<div class="owner-chart-empty">No package revenue found for the selected filters.</div>}</article>
            <article class="owner-chart-card"><div><h3>Payment Verification Status</h3><p>Current verification outcomes.</p></div><div class="owner-chart-frame owner-chart-frame-donut"><canvas id="paymentStatusChart" role="img" aria-describedby="reportChartData" aria-label="Payment verification status distribution"></canvas></div></article>
        </div>
    </section>
    <details class="owner-report-section owner-operational-details">
        <summary>Booking activity and operational totals</summary>
        <p>Confirmed bookings: @Model.ConfirmedBookings · Completed events: @Model.CompletedBookings</p>
    <section class="owner-report-section" aria-labelledby="bookingPerformanceTitle">
        <div class="owner-report-heading"><div><h2 id="bookingPerformanceTitle">Operational Summary</h2></div></div>
        <div class="owner-performance-row"><div><span>Confirmation Rate</span><strong>@Model.ConfirmationRate.ToString("N1")%</strong></div><div><span>Average Active Booking Value</span><strong>₱@Model.AverageBookingValue.ToString("N2")</strong></div><div><span>Cancelled / Declined</span><strong>@Model.CancelledBookings</strong></div><div><span>Fully Paid</span><strong>@Model.FullyPaidBookings</strong></div><div><span>Partial / Unpaid</span><strong>@Model.PartiallyPaidBookings / @Model.UnpaidBookings</strong></div></div>
    </section>
        <div class="owner-operational-charts">
            <article class="owner-chart-card"><div><h3>Bookings Over Time</h3><p>Booking activity by month.</p></div><div class="owner-chart-frame"><canvas id="monthlyBookingsChart" role="img" aria-describedby="reportChartData" aria-label="Bookings over time"></canvas></div></article>
            <article class="owner-chart-card"><div><h3>Package Bookings</h3><p>Booking volume by package.</p></div>@if(Model.PackageLabels.Any()){<div class="owner-chart-frame"><canvas id="packageTrendChart" role="img" aria-describedby="reportChartData" aria-label="Bookings by package"></canvas></div>}else{<div class="owner-chart-empty">No package data found for the selected filters.</div>}</article>
        </div>
    </details>
    <details class="owner-report-section" id="reportChartData">
        <summary>View chart data</summary>
        <div class="table-responsive mt-3"><table class="table"><caption>Monthly activity for selected bookings</caption><thead><tr><th scope="col">Month</th><th scope="col">Bookings</th><th scope="col">Collected Revenue</th></tr></thead><tbody>
        @for(var i=0;i<Model.MonthlyLabels.Count;i++){<tr><th scope="row">@Model.MonthlyLabels[i]</th><td>@Model.MonthlyBookingCounts[i]</td><td>&#8369;@Model.MonthlyRevenue[i].ToString("N2")</td></tr>}
        </tbody></table></div>
        <div class="table-responsive"><table class="table"><caption>Package performance</caption><thead><tr><th scope="col">Package</th><th scope="col">Bookings</th><th scope="col">Net Revenue</th></tr></thead><tbody>
        @for(var i=0;i<Model.PackageLabels.Count;i++){<tr><th scope="row">@Model.PackageLabels[i]</th><td>@Model.PackageBookingCounts[i]</td><td>&#8369;@Model.PackageRevenue[i].ToString("N2")</td></tr>}
        </tbody></table></div>
        <p>Awaiting review: @Model.PendingCount; Verified: @Model.VerifiedCount; Rejected: @Model.RejectedCount; Additional evidence required: @Model.EvidenceRequiredCount.</p>
    </details>

    <section class="owner-report-section owner-report-records-section" aria-labelledby="recordsTitle">
        <div class="owner-report-heading owner-report-records-heading">
            <div><h2 id="recordsTitle">Booking Financial Records</h2></div>
            <span>Showing @Model.BookingRecords.Count of @Model.RecordsTotalCount records</span>
        </div>
        <form asp-action="Index" method="get" class="am-filter-bar am-filter-row aries-round3-toolbar" data-aries-round3-filter="true" role="search" aria-label="Search financial booking records">
            <input type="hidden" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="month" value="@Model.Month" />
            <input type="hidden" name="year" value="@Model.Year" />
            <input type="hidden" name="package" value="@Model.PackageFilter" />
            <input type="hidden" name="bookingStatus" value="@Model.BookingStatusFilter" />
            <div class="am-filter-search"><i class="bi bi-search" aria-hidden="true"></i><label for="ownerFinancialRecordSearch" class="visually-hidden">Search booking financial records</label>
                <input id="ownerFinancialRecordSearch" class="form-control" name="recordSearch" type="search" value="@Model.RecordSearch" placeholder="Search booking, client, package, or venue" /></div>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"><i class="bi bi-funnel" aria-hidden="true"></i> Filters</button>
                <div class="dropdown-menu dropdown-menu-end p-3">
                    <label class="form-label" for="ownerRecordStatus">Financial record status</label>
                    <select id="ownerRecordStatus" name="recordStatus" class="form-select mb-3">
                        <option value="" selected="@(string.IsNullOrWhiteSpace(Model.RecordStatus))">All statuses</option>
                        @foreach(var status in Model.AvailableBookingStatuses) {
                            <option value="@status" selected="@(status == Model.RecordStatus)">@status</option>
                        }
                    </select>
                    <a asp-action="Index" asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                       asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                       asp-route-month="@Model.Month" asp-route-year="@Model.Year"
                       asp-route-package="@Model.PackageFilter" asp-route-bookingStatus="@Model.BookingStatusFilter"
                       class="btn btn-outline-secondary btn-sm">Reset record filters</a>
                </div>
            </div>
            <button type="submit" class="visually-hidden">Search records</button>
            <a asp-action="Index" class="btn btn-outline-secondary aries-round3-refresh"
               asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
               asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
               asp-route-month="@Model.Month" asp-route-year="@Model.Year"
               asp-route-package="@Model.PackageFilter" asp-route-bookingStatus="@Model.BookingStatusFilter"
               asp-route-recordSearch="@Model.RecordSearch" asp-route-recordStatus="@Model.RecordStatus"
               asp-route-page="@Model.RecordPage" aria-label="Refresh booking financial records"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i><span>Refresh</span></a>
        </form>
        <div class="staff-data-table-frame owner-financial-records-frame" data-staff-table-capacity="5">
            <div class="staff-data-table-scroll owner-financial-records-scroll" tabindex="0" role="region"
                 aria-label="Booking financial records; scroll horizontally to view all columns">
                <table class="staff-data-table owner-audit-table owner-financial-records-table">
                    <caption class="visually-hidden">Financial information for matching booking records</caption>
                    <colgroup>
                        <col class="owner-financial-col-booking" />
                        <col class="owner-financial-col-client" />
                        <col class="owner-financial-col-package" />
                        <col class="owner-financial-col-date" />
                        <col class="owner-financial-col-value" />
                        <col class="owner-financial-col-collected" />
                        <col class="owner-financial-col-outstanding" />
                        <col class="owner-financial-col-status" />
                        <col class="owner-financial-col-action" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col">Booking</th>
                            <th scope="col">Client</th>
                            <th scope="col">Package</th>
                            <th scope="col">Event Date</th>
                            <th scope="col" class="owner-financial-amount">Booking Value</th>
                            <th scope="col" class="owner-financial-amount">Collected</th>
                            <th scope="col" class="owner-financial-amount">Outstanding</th>
                            <th scope="col">Status</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.BookingRecords.Any())
                        {
                            <tr class="staff-data-table-empty-row">
                                <td colspan="9">
                                    <div class="staff-data-table-empty" role="status">
                                        <i class="bi bi-inbox" aria-hidden="true"></i>
                                        @if (financialRecordFiltersActive)
                                        {
                                            <strong>No matching financial records</strong>
                                            <p>Try adjusting your search or filters.</p>
                                            <a asp-action="Index" class="staff-data-table-reset">Clear filters</a>
                                        }
                                        else
                                        {
                                            <strong>No financial records</strong>
                                            <p>No financial records are available to display.</p>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach(var booking in Model.BookingRecords){Model.BookingFinancials.TryGetValue(booking.Id,out var finance);<tr><td data-label="Booking"><strong class="owner-booking-code">BK-@booking.CreatedAt.Year-@booking.Id.ToString("D3")</strong></td><td data-label="Client">@(booking.Client?.FullName??"Unknown Client")</td><td data-label="Package">@booking.PackageName</td><td data-label="Event Date">@booking.EventDate.ToString("MMM dd, yyyy")</td><td class="owner-financial-amount" data-label="Booking Value">₱@((finance?.BookingTotal??booking.FinalPrice).ToString("N2"))</td><td class="owner-financial-amount" data-label="Collected">₱@((finance?.TotalVerifiedPayments??0m).ToString("N2"))</td><td class="owner-financial-amount" data-label="Outstanding">₱@((booking.Status is AriesMagicAppointmentSystem.Models.BookingStatus.Cancelled or AriesMagicAppointmentSystem.Models.BookingStatus.Declined or AriesMagicAppointmentSystem.Models.BookingStatus.Expired ? 0m : finance?.RemainingBalance??booking.FinalPrice).ToString("N2"))</td><td data-label="Status"><span class="status-badge status-read">@booking.Status</span></td><td data-label="Action"><a asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-primary">Details</a></td></tr>}

                        }
                    </tbody>
                </table>
            </div>
        @{
            var recordsPager = new AriesMagicAppointmentSystem.ViewModels.QueuePaginationViewModel(
                Model.RecordsTotalCount, Model.RecordPage, 5, "Index", new Dictionary<string,string> {
                    ["startDate"] = Model.StartDate?.ToString("yyyy-MM-dd") ?? "",
                    ["endDate"] = Model.EndDate?.ToString("yyyy-MM-dd") ?? "",
                    ["month"] = Model.Month?.ToString() ?? "",
                    ["year"] = Model.Year?.ToString() ?? "",
                    ["package"] = Model.PackageFilter,
                    ["bookingStatus"] = Model.BookingStatusFilter,
                    ["recordSearch"] = Model.RecordSearch,
                    ["recordStatus"] = Model.RecordStatus
                });
        }
        <partial name="_QueuePagination" model="recordsPager" />
        </div>
    </section>
</div>
@section Scripts{
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(() => {
    const monthlyLabels=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels));
    const monthlyBookings=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBookingCounts));
    const monthlyRevenue=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenue));
    const packageLabels=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PackageLabels));
    const packageCounts=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PackageBookingCounts));
    const packageRevenue=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PackageRevenue));
    const paymentCounts=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new[]{Model.PendingCount,Model.VerifiedCount,Model.RejectedCount,Model.EvidenceRequiredCount}));
    const packageColors=packageLabels.map(name => /all\s*in/i.test(name)?'#eab308':/deluxe/i.test(name)?'#dc3545':/premium/i.test(name)?'#278be8':'#6b93bd');
    const currency=value=>new Intl.NumberFormat('en-PH',{style:'currency',currency:'PHP',maximumFractionDigits:0}).format(value);
    if(typeof Chart === 'undefined') return;
    const common={responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{usePointStyle:true,boxWidth:8}}}};
    new Chart(document.getElementById('revenueTrendChart'),{type:'line',data:{labels:monthlyLabels,datasets:[{label:'Collected Revenue',data:monthlyRevenue,tension:.35,borderWidth:2,pointRadius:3}]},options:{...common,plugins:{...common.plugins,legend:{display:false},tooltip:{callbacks:{label:c=>currency(c.parsed.y)}}},scales:{y:{beginAtZero:true,ticks:{callback:v=>currency(v)}}}}});
    new Chart(document.getElementById('monthlyBookingsChart'),{type:'bar',data:{labels:monthlyLabels,datasets:[{label:'Bookings',data:monthlyBookings,borderRadius:7}]},options:{...common,plugins:{...common.plugins,legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{precision:0}}}}});
    const pkg=document.getElementById('packageTrendChart'); if(pkg)new Chart(pkg,{type:'bar',data:{labels:packageLabels,datasets:[{label:'Bookings',data:packageCounts,backgroundColor:packageColors,borderRadius:7}]},options:{...common,indexAxis:'y',plugins:{...common.plugins,legend:{display:false}},scales:{x:{beginAtZero:true,ticks:{precision:0}}}}});
    const pkgRevenue=document.getElementById('packageRevenueChart'); if(pkgRevenue)new Chart(pkgRevenue,{type:'bar',data:{labels:packageLabels,datasets:[{label:'Net Revenue',data:packageRevenue,backgroundColor:packageColors,borderRadius:7}]},options:{...common,indexAxis:'y',plugins:{...common.plugins,legend:{display:false},tooltip:{callbacks:{label:c=>currency(c.parsed.x)}}},scales:{x:{beginAtZero:true,ticks:{callback:v=>currency(v)}}}}});
    new Chart(document.getElementById('paymentStatusChart'),{type:'doughnut',data:{labels:['Awaiting review','Verified','Rejected','Additional evidence'],datasets:[{data:paymentCounts,backgroundColor:['#b45309','#15803d','#b91c1c','#6d28d9'],borderWidth:2}]},options:{...common,cutout:'68%'}});
})();
</script>}
