@model AriesMagicAppointmentSystem.ViewModels.ReportDashboardViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Reports Center";
}

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
}

<!-- Unified Header Toolbar (Filters + Actions) -->
<div class="dashboard-panel mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Report Filters</h3>
    </div>

    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label for="startDate" class="form-label fw-semibold text-secondary small mb-1">Start Date</label>
            <input type="date"
                   id="startDate"
                   name="startDate"
                   value="@Model.StartDate?.ToString("yyyy-MM-dd")"
                   class="form-control" />
        </div>

        <div class="col-md-3">
            <label for="endDate" class="form-label fw-semibold text-secondary small mb-1">End Date</label>
            <input type="date"
                   id="endDate"
                   name="endDate"
                   value="@Model.EndDate?.ToString("yyyy-MM-dd")"
                   class="form-control" />
        </div>

        <!-- Filter Action Buttons -->
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="bi bi-funnel me-1"></i>
                Generate Report
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Clear
            </a>
        </div>

        <!-- Export & Print Buttons -->
        <div class="col-md-3 d-flex gap-2 justify-content-md-end">
            <a asp-action="ExportCsv"
               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
               class="btn btn-success flex-grow-1">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>
                Export CSV
            </a>

            <button type="button"
                    class="btn btn-outline-secondary flex-grow-1"
                    onclick="window.print()">
                <i class="bi bi-printer me-1"></i>
                Print
            </button>
        </div>
    </form>
</div>

<!-- Key Stat Cards -->
<div class="dashboard-stat-grid mb-4">
    <div class="dashboard-stat-card stat-info">
        <span class="dashboard-stat-icon"><i class="bi bi-journal-text"></i></span>
        <span class="dashboard-stat-label">Total Bookings</span>
        <strong>@Model.TotalBookings</strong>
    </div>
    <div class="dashboard-stat-card stat-success">
        <span class="dashboard-stat-icon"><i class="bi bi-check2-circle"></i></span>
        <span class="dashboard-stat-label">Confirmed</span>
        <strong>@Model.ConfirmedBookings</strong>
        <small>Ready for event</small>
    </div>
    <div class="dashboard-stat-card stat-neutral">
        <span class="dashboard-stat-icon"><i class="bi bi-flag"></i></span>
        <span class="dashboard-stat-label">Completed</span>
        <strong>@Model.CompletedBookings</strong>
    </div>
    <div class="dashboard-stat-card stat-danger">
        <span class="dashboard-stat-icon"><i class="bi bi-x-circle"></i></span>
        <span class="dashboard-stat-label">Cancelled / Declined</span>
        <strong>@Model.CancelledBookings</strong>
    </div>
    <div class="dashboard-stat-card stat-warning">
        <span class="dashboard-stat-icon"><i class="bi bi-cash-stack"></i></span>
        <span class="dashboard-stat-label">Verified Revenue</span>
        <strong>₱@Model.TotalRevenue.ToString("N2")</strong>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="dashboard-panel">
            <div class="dashboard-list-heading">
                <h3>Booking Report</h3>
                <span class="badge bg-primary">Last 6 months</span>
            </div>
            <div style="height: 260px;">
                <canvas id="monthlyBookingsChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="dashboard-panel">
            <div class="dashboard-list-heading">
                <h3>Revenue Report</h3>
                <span class="badge bg-success">Verified</span>
            </div>
            <div style="height: 260px;">
                <canvas id="revenueTrendChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="dashboard-panel">
            <div class="dashboard-list-heading">
                <h3>Payment Status</h3>
                <span class="badge bg-secondary">@(Model.PendingCount + Model.VerifiedCount + Model.RejectedCount) total</span>
            </div>
            <div style="height: 260px; display: flex; align-items: center; justify-content: center;">
                <canvas id="paymentStatusChart" style="max-height: 240px; max-width: 240px;"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="dashboard-panel">
            <div class="dashboard-list-heading">
                <h3>Package Trends</h3>
                <span class="badge bg-info">Top 8</span>
            </div>
            @if (Model.PackageLabels.Any())
            {
                <div style="height: 260px;">
                    <canvas id="packageTrendChart"></canvas>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-bar-chart"></i>
                    <h3>No package data</h3>
                    <p>No package trend data for the selected period.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Performance Metrics -->
<div class="dashboard-panel mb-4">
    <div class="dashboard-list-heading">
        <h3>Performance Metrics</h3>
    </div>
    <div class="dashboard-stat-grid">
        <div class="dashboard-stat-card stat-neutral text-center">
            <span class="dashboard-stat-label">Successful Booking Rate</span>
            <strong>@Model.ConfirmationRate.ToString("N1")%</strong>
        </div>
        <div class="dashboard-stat-card stat-neutral text-center">
            <span class="dashboard-stat-label">Average Booking Value</span>
            <strong>₱@Model.AverageBookingValue.ToString("N2")</strong>
        </div>
        <div class="dashboard-stat-card stat-neutral text-center">
            <span class="dashboard-stat-label">Avg Payment Processing</span>
            <strong>@Model.AveragePaymentProcessingDays.ToString("N1") days</strong>
        </div>
        <div class="dashboard-stat-card stat-neutral text-center">
            <span class="dashboard-stat-label">Repeat Customer Rate</span>
            <strong>@Model.CustomerRetentionRate.ToString("N1")%</strong>
        </div>
    </div>
</div>

<!-- Table Records Section -->
<div class="dashboard-panel">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h3 class="mb-1">Booking Report Records</h3>
            <p class="page-subtitle mb-0">
               
            </p>
        </div>

        <span class="badge bg-secondary">
            @Model.BookingRecords.Count record(s)
        </span>
    </div>

    @if (!Model.BookingRecords.Any())
    {
        <div class="empty-state">
            <h3>No report records</h3>
            
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Booking ID</th>
                        <th>Client</th>
                        <th>Package</th>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Venue</th>
                        <th>Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model.BookingRecords)
                    {
                        <tr>
                            <td>#@booking.Id</td>
                            <td>@(booking.Client?.FullName ?? "Unknown Client")</td>
                            <td>@booking.PackageName</td>
                            <td>@booking.EventType</td>
                            <td>@booking.EventDate.ToString("MMM dd, yyyy")</td>
                            <td>@booking.PartyVenue</td>
                            <td>₱@booking.FinalPrice.ToString("N2")</td>
                            <td><span class="badge bg-secondary">@booking.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const monthlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels));
        const monthlyBookingCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBookingCounts));
        const monthlyRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenue));
        const packageLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PackageLabels));
        const packageBookingCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PackageBookingCounts));
        const paymentCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new[]
        {
            Model.PendingCount,
            Model.VerifiedCount,
            Model.RejectedCount
        }));

        new Chart(document.getElementById("monthlyBookingsChart"), {
            type: "bar",
            data: {
                labels: monthlyLabels,
                datasets: [{ label: "Bookings", data: monthlyBookingCounts, borderRadius: 8 }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } }
            }
        });

        new Chart(document.getElementById("revenueTrendChart"), {
            type: "line",
            data: {
                labels: monthlyLabels,
                datasets: [{ label: "Verified Revenue", data: monthlyRevenue, tension: 0.35, fill: false }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } }
            }
        });

        new Chart(document.getElementById("paymentStatusChart"), {
            type: "doughnut",
            data: {
                labels: ["Pending", "Verified", "Rejected"],
                datasets: [{ data: paymentCounts }]
            },
            options: { responsive: true }
        });

        const packageTrendCanvas = document.getElementById("packageTrendChart");
        if (packageTrendCanvas) {
            new Chart(packageTrendCanvas, {
                type: "bar",
                data: {
                    labels: packageLabels,
                    datasets: [{ label: "Bookings", data: packageBookingCounts, borderRadius: 8 }]
                },
                options: {
                    indexAxis: "y",
                    responsive: true,
                    plugins: { legend: { display: false } }
                }
            });
        }
    </script>
}