@model AriesMagicAppointmentSystem.ViewModels.CommunicationCenterViewModel
@using AriesMagicAppointmentSystem.Models
@using AriesMagicAppointmentSystem.Extensions
@{
    var isClient = User.IsInRole("Client");
    var isStaff = User.IsInRole("Staff");
    var isOwner = User.IsInRole("Owner");
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    Layout = isClient ? "_ClientHubLayout" : "_DashboardLayout";
    ViewData["Title"] = "Messages";
    var selected = Model.SelectedConversation;
    // A support thread is displayed against its actual Client on internal roles.
    // Clients see an actual Staff/Owner participant when one has joined.
    var otherParticipant = selected?.SupportClientId != null && (isStaff || isOwner)
        ? selected.Participants.FirstOrDefault(p => p.UserId == selected.SupportClientId)
        : selected?.Participants.FirstOrDefault(p => p.UserId != currentUserId);
    var headingName = isClient && selected?.SupportClientId != null
        ? "Aries Magic Support"
        : otherParticipant?.Name ?? selected?.Title ?? "Conversation";
    var headingRole = isClient && selected?.SupportClientId != null
        ? "Support"
        : otherParticipant?.Role ?? "Conversation";
    var hasExplicitConversationId = int.TryParse(Context.Request.Query["id"], out var requestedId)
        || int.TryParse(Context.Request.RouteValues["id"]?.ToString(), out requestedId);
    var selectedFromUrl = hasExplicitConversationId && selected?.Id == requestedId;
    var lastMessageId = selected?.Messages.LastOrDefault()?.Id ?? 0;
    var canCompleteRequests = User.IsInRole("Owner");
}

<div id="communicationCenter"
     class="comm-page comm-unified @(isClient ? "comm-page-client" : "comm-page-dashboard") @(selectedFromUrl ? "comm-has-selection" : "")"
     data-conversation-id="@(selected?.Id ?? 0)"
     data-last-message-id="@lastMessageId"
     data-messages-url="@Url.Action("MessagesSince", "Communications")"
     data-unread-url="@Url.Action("UnreadCount", "Communications")"
     data-summaries-url="@Url.Action("ConversationSummaries", "Communications")"
     data-read-states-url="@Url.Action("ReadStates", "Communications")">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger comm-alert">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success comm-alert">@TempData["Success"]</div>
    }

    <div class="comm-workspace">
        <aside class="comm-conversation-panel" aria-label="Conversation list">
            <div class="comm-panel-top">
                <div class="comm-panel-title-row">
                    <div>
                        <span class="comm-eyebrow">Inbox</span>
                        <h2>Conversations</h2>
                    </div>
                    @if (Model.UnreadConversationCount > 0)
                    {
                        <span class="comm-count-pill">@Model.UnreadConversationCount unread</span>
                    }
                </div>

                <form method="get" asp-action="Index" class="comm-conversation-search" role="search">
                    <label for="commConversationSearch" class="visually-hidden">Search conversations</label>
                    <input id="commConversationSearch" type="search" name="q" value="@Model.Search" placeholder="Search conversations" autocomplete="off" />
                    <button type="submit" aria-label="Search conversations" title="Search conversations"><i class="bi bi-search" aria-hidden="true"></i></button>
                </form>
                @if (isClient && Model.Conversations.Count == 0 && string.IsNullOrWhiteSpace(Model.Search))
                {
                    @* Canonical support provisioning is a booking/support workflow, not manual New Conversation creation. *@
                    <form asp-action="StartSupport" method="post" class="comm-support-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="comm-support-btn"><i class="bi bi-headset" aria-hidden="true"></i><span>Contact Aries Magic Support</span></button>
                    </form>
                }
            </div>

            <div class="comm-sidebar-status" role="status" aria-live="polite" hidden></div>
            <div class="comm-conversation-list" tabindex="@(isClient ? "0" : null)" role="@(isClient ? "region" : null)" aria-label="@(isClient ? "Your conversation list" : null)">
                @if (Model.Conversations.Count == 0)
                {
                    <div class="comm-list-empty">
                        <i class="bi bi-chat-dots" aria-hidden="true"></i>
                        <strong>@(string.IsNullOrWhiteSpace(Model.Search) ? "No conversations yet" : "No matching conversations")</strong>
                        <span>@(string.IsNullOrWhiteSpace(Model.Search) ? "Your conversations will appear here when available." : "Try a different search.")</span>
                    </div>
                }
                else
                {
                    foreach (var item in Model.Conversations)
                    {
                        var isSelected = selected?.Id == item.Id;
                        <a asp-action="Index" asp-route-id="@item.Id" asp-route-filter="@Model.Filter" asp-route-q="@Model.Search" class="comm-conversation-item @(isSelected ? "active" : "") @(item.UnreadCount > 0 ? "unread" : "")" data-conversation-id="@item.Id" aria-current="@(isSelected ? "page" : null)">
                            <span class="comm-avatar">@if(!string.IsNullOrWhiteSpace(item.AvatarUrl)){<img src="@item.AvatarUrl" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover" onerror="this.hidden=true;this.nextElementSibling.hidden=false" /><span hidden>@item.Initials</span>}else{@item.Initials}</span>
                            <span class="comm-item-copy">
                                <span class="comm-item-heading">
                                    <strong>@item.DisplayName</strong>
                                    <time>@(item.LastActivityAt.ToLocalTime().Date == DateTime.Today ? item.LastActivityAt.ToLocalTime().ToString("h:mm tt") : item.LastActivityAt.ToLocalTime().ToString("MMM d"))</time>
                                </span>
                                <span class="comm-item-subtitle">@item.Subtitle</span>
                                <span class="comm-item-preview">@item.LatestMessage</span>
                            </span>
                            <span class="comm-item-signals">
                                @if (item.UnreadCount > 0)
                                {
                                    <span class="comm-unread-pill">@(item.UnreadCount > 99 ? "99+" : item.UnreadCount)</span>
                                }
                            </span>
                        </a>
                    }
                }
            </div>
        </aside>

        <section class="comm-chat-panel" aria-label="Selected conversation">
            @if (selected == null)
            {
                <div class="comm-chat-empty">
                    <i class="bi bi-chat-dots" aria-hidden="true"></i>
                    <h2>Select a conversation</h2>
                    <p>Choose a conversation to view its messages.</p>
                </div>
            }
            else
            {
                <header class="comm-chat-header">
                    <a asp-action="Index" asp-route-id="" asp-route-view="inbox" asp-route-filter="@Model.Filter" asp-route-q="@Model.Search" class="comm-mobile-back" aria-label="Back to conversations"><i class="bi bi-arrow-left" aria-hidden="true"></i></a>
                    <div class="comm-chat-title">
                        <span class="comm-avatar comm-avatar-lg" aria-hidden="true">
                            @if(!string.IsNullOrWhiteSpace(otherParticipant?.AvatarUrl))
                            {
                                <img src="@otherParticipant.AvatarUrl" alt="" loading="lazy" onerror="this.hidden=true;this.nextElementSibling.hidden=false" />
                                <span hidden>@otherParticipant.Initials</span>
                            }
                            else
                            {
                                @(otherParticipant?.Initials ?? "AM")
                            }
                        </span>
                        <div class="comm-chat-title-copy">
                            <h2>@headingName</h2>
                            <p>@headingRole</p>
                        </div>
                    </div>
                    @if (selected.BookingId.HasValue)
                    {
                        <a class="btn comm-secondary-btn" asp-controller="Bookings" asp-action="Details" asp-route-id="@selected.BookingId">
                            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> View Booking
                        </a>
                    }
                </header>

                @if (isClient)
                {
                    <div class="cx-chat-connection"><span id="commConnectionStatus" role="status" aria-live="polite">Checking for updates…</span><button type="button" id="commRetry" hidden>Retry connection</button></div>
                }

                <div class="comm-message-history" id="commMessageHistory" role="log" tabindex="0" aria-label="Conversation messages" aria-live="polite" aria-relevant="additions">
                    <div class="comm-history-start"><span>Conversation started</span></div>
                    @if(selected.Messages.Count == 0)
                    {
                        <p class="comm-history-empty">No messages yet. Messages will appear here.</p>
                    }
                    @foreach (var message in selected.Messages)
                    {
                        <article class="comm-message @(message.IsMine ? "mine" : "theirs")" data-message-id="@message.Id">
                            @if(!message.IsMine){
                              <span class="comm-sender-avatar comm-avatar" aria-hidden="true">
                                @if(!string.IsNullOrWhiteSpace(message.SenderAvatarUrl)){
                                  <img src="@message.SenderAvatarUrl" alt="" loading="lazy" onerror="this.hidden=true;this.nextElementSibling.hidden=false"/><span hidden>@string.Concat(message.SenderName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => char.ToUpperInvariant(n[0])))</span>
                                }else{@string.Concat(message.SenderName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => char.ToUpperInvariant(n[0])))}
                              </span>
                            }
                            <div class="comm-message-meta"><strong>@(message.IsMine ? "You" : message.SenderName)</strong><span>@message.SenderRole</span><time>@message.SentAt.ToLocalTime().ToString("MMM d, h:mm tt")</time></div>
                            @if (message.RelatedBookingId.HasValue)
                            {
                                <div class="comm-booking-context-chip"><i class="bi bi-calendar-event" aria-hidden="true"></i><span>Regarding booking #@message.RelatedBookingId</span>
                                @{<a asp-controller="Bookings" asp-action="Details" asp-route-id="@message.RelatedBookingId">View booking</a>}</div>
                            }
                            @if (message.MessageType == MessageTypes.ActionRequest)
                            {
                                <div class="comm-action-card @(message.RequestStatus == MessageRequestStatuses.Completed ? "completed" : "")">
                                    <div class="comm-action-card-top"><span><i class="bi bi-lightning-charge-fill" aria-hidden="true"></i> @(message.RequestType ?? "Operational Request")</span><span class="comm-request-status">@(message.RequestStatus ?? "Open")</span></div>
                                    <p>@message.Content</p>
                                    <div class="comm-action-actions">
                                        @if (!string.IsNullOrWhiteSpace(message.ActionLink) && User.CanFollowModuleLink(message.ActionLink))
                                        {
                                            <a href="@message.ActionLink" class="btn btn-sm comm-secondary-btn"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Related Page</a>
                                        }
                                        @if (canCompleteRequests && message.RequestStatus != MessageRequestStatuses.Completed)
                                        {
                                            <form asp-action="CompleteRequest" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="messageId" value="@message.Id" />
                                                <button class="btn btn-sm comm-primary-btn" type="submit"><i class="bi bi-check2-circle" aria-hidden="true"></i> Mark Completed</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="comm-bubble">@message.Content</div>
                            }
                            @if (message.IsMine)
                            {
                                <span class="comm-delivery-state"><i class="bi @(message.IsReadByOthers ? "bi-check2-all" : "bi-check2")" aria-hidden="true"></i> @(message.IsReadByOthers ? "Read" : "Sent")</span>
                            }
                        </article>
                    }
                </div>

                <button type="button" id="commLatest" class="cx-chat-latest" hidden>New messages — Go to latest</button>

                @if (selected.CanSend)
                {
                    <form asp-action="SendMessage" method="post" id="commComposer" class="comm-composer">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="conversationId" value="@selected.Id" />
                        @if(selected.SupportClientId != null)
                        {
                            <div class="comm-booking-selector"><label for="commBookingContext">Message about</label>
                            <select id="commBookingContext" name="relatedBookingId">
                            <option value="">General question · No specific booking</option>
                            @foreach(var booking in selected.BookingOptions){<option value="@booking.Id" selected="@(selected.SelectedRelatedBookingId==booking.Id)">@booking.Label</option>}
                            </select><span>Optional booking reference for the Client and team.</span></div>
                        }
                        <div class="comm-composer-row">
                            <label for="commMessageInput" class="visually-hidden">Message</label><textarea name="messageContent" id="commMessageInput" rows="1" maxlength="4000" placeholder="Type a message..." required></textarea>
                            <button class="comm-send-btn" type="submit" aria-label="Send message" title="Send message"><i class="bi bi-send" aria-hidden="true"></i></button>
                        </div>
                        <div class="comm-composer-note"><span id="commComposerStatus" role="status" aria-live="polite"></span><span><kbd>Enter</kbd> send - <kbd>Shift</kbd>+<kbd>Enter</kbd> new line</span></div>
                    </form>
                }
            }
        </section>


    </div>
</div>
@section Scripts {
    <script src="~/js/communication-center.js" asp-append-version="true"></script>
}
