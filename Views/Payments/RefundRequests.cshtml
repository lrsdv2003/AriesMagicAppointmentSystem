@model IEnumerable<AriesMagicAppointmentSystem.Models.RefundRequest>
@using AriesMagicAppointmentSystem.Models
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Refund Verification";
    var requests = Model.ToList();
    var isOwner = User.IsInRole("Owner");
    string OcrClass(string? result) => result switch { OcrVerificationResults.LikelyMatch => "ocr-likely", OcrVerificationResults.PartialMatch => "ocr-partial", OcrVerificationResults.MismatchDetected => "ocr-mismatch", OcrVerificationResults.OcrFailed => "ocr-failed", _ => "ocr-manual" };
    string StatusClass(string status) => status switch { RefundStatus.Refunded => "status-verified", RefundStatus.Rejected => "status-rejected", RefundStatus.Approved => "status-confirmed", _ => "status-pending" };
    string StatusLabel(string status) => status switch { RefundStatus.Pending => "AWAITING REVIEW", RefundStatus.UnderReview => "AWAITING REVIEW", RefundStatus.Approved => "APPROVED · PROCESS REFUND", RefundStatus.RefundProcessing => "AWAITING FINAL VERIFICATION", RefundStatus.Refunded => "COMPLETED", RefundStatus.Rejected => "REJECTED", _ => status.ToUpperInvariant() };
    string ShortReason(string? value) => string.IsNullOrWhiteSpace(value) ? "No reason provided" : value.Length <= 58 ? value : value[..55] + "...";
}
<div class="owner-financial-page">
    <div class="page-header owner-page-header"><div><span class="owner-eyebrow">Financial Oversight</span><h1>Refund Verification</h1><p class="page-subtitle">Review refund eligibility, supporting evidence, and the financial impact before deciding.</p></div></div>
    @if(TempData["Success"]!=null){<div class="alert alert-success" role="status">@TempData["Success"]</div>}
    @if(TempData["Error"]!=null){<div class="alert alert-danger" role="alert">@TempData["Error"]</div>}
    <div class="owner-summary-row"><div><span>Shown</span><strong>@requests.Count</strong></div><div><span>Awaiting Review</span><strong>@requests.Count(x=>x.Status==RefundStatus.Pending||x.Status==RefundStatus.UnderReview)</strong></div><div><span>Awaiting Final Verification</span><strong>@requests.Count(x=>x.Status==RefundStatus.RefundProcessing)</strong></div></div>
    <form method="get" class="owner-filter-card" aria-label="Refund verification filters">
        <div class="owner-filter-search"><i class="bi bi-search"></i><input type="search" name="q" value="@ViewBag.Search" placeholder="Search booking, client, or reference" aria-label="Search refund queue" /></div>
        <div class="dropdown"><button class="btn btn-outline-secondary dropdown-toggle owner-filter-trigger" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside"><i class="bi bi-funnel"></i> Filters</button><div class="dropdown-menu dropdown-menu-end owner-filter-menu p-3"><label class="form-label" for="RefundRequestsfilter">Refund Status</label><select id="RefundRequestsfilter" name="filter" class="form-select mb-3"><option value="all" selected="@(ViewBag.Filter=="all")">All statuses</option><option value="UnderReview" selected="@(ViewBag.Filter==RefundStatus.UnderReview)">Awaiting Owner Review</option><option value="Approved" selected="@(ViewBag.Filter==RefundStatus.Approved)">Approved</option><option value="RefundProcessing" selected="@(ViewBag.Filter==RefundStatus.RefundProcessing)">Awaiting Final Verification</option><option value="Refunded" selected="@(ViewBag.Filter==RefundStatus.Refunded)">Completed</option><option value="Rejected" selected="@(ViewBag.Filter==RefundStatus.Rejected)">Rejected</option></select><div class="d-flex justify-content-end gap-2"><a asp-action="RefundRequests" class="btn btn-light">Reset</a><button class="btn btn-primary">Apply Filters</button></div></div></div>
        <button class="btn btn-primary owner-search-btn" type="submit">Search</button>
    </form>
    <div class="dashboard-panel owner-table-panel">
        @if(!requests.Any()){<div class="owner-empty-state"><i class="bi bi-arrow-counterclockwise"></i><h2>No refund requests require your attention.</h2><p>Try another filter if you are reviewing completed or rejected requests.</p></div>}
        else{<div class="table-responsive"><table class="table owner-audit-table align-middle"><thead><tr><th>Booking</th><th>Client</th><th>Refund Amount</th><th>Reason</th><th>Proof</th><th>Verification Result</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>
        @foreach(var item in requests){var ocr=item.OcrVerifications.Where(o=>o.VerificationPurpose==OcrVerificationPurposes.RefundSupport).OrderByDescending(o=>o.ProcessedAt).FirstOrDefault(); var packageName=item.Booking?.PackageName??item.Booking?.Service?.Name??"Package";<tr><td><strong class="owner-booking-code">BK-@item.Booking?.CreatedAt.Year-@item.BookingId.ToString("D3")</strong><span class="owner-cell-subtext">@packageName</span></td><td><strong>@(item.Booking?.Client?.FullName??"Unknown client")</strong></td><td><strong>₱@item.Amount.ToString("N2")</strong><span class="owner-cell-subtext">Eligible: ₱@Math.Min(item.Amount,item.OriginalPayment?.Amount??0m).ToString("N2")</span></td><td><span title="@item.ClientReason">@ShortReason(item.ClientReason)</span></td><td><button type="button" class="owner-proof-button js-refund-proof" data-proof-src="@Url.Action("RefundProof","Payments",new{id=item.Id})" data-proof-title="Refund evidence for BK-@item.BookingId" aria-label="Enlarge refund proof"><img src="@Url.Action("RefundProof","Payments",new{id=item.Id})" class="owner-proof-thumb" alt="Refund proof thumbnail" /></button></td><td><span class="ocr-badge @OcrClass(ocr?.VerificationResult)">@(ocr?.VerificationResult??"Manual Review Required")</span></td><td><span class="status-badge @StatusClass(item.Status)">@StatusLabel(item.Status)</span></td><td class="text-end"><a asp-action="RefundReview" asp-route-id="@item.Id" class="btn btn-sm btn-primary">@(isOwner?"Review":"View")</a></td></tr>}
        </tbody></table></div>}
    </div>
</div>
<partial name="_FinancialProofViewer" />
@section Scripts { <script src="~/js/owner-financial.js" asp-append-version="true"></script> }
