@model IEnumerable<AriesMagicAppointmentSystem.Models.RefundRequest>
@using AriesMagicAppointmentSystem.Models
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Refund Requests";
    ViewData["HideWorkspaceHeading"] = true;
    var requests = Model.ToList();
    var pagination = ViewData["QueuePage"] as AriesMagicAppointmentSystem.ViewModels.QueuePaginationViewModel
        ?? new(requests.Count, 1, 5, "RefundRequests", new() { ["filter"] = "all" });
    string StatusClass(string status) => status switch {
        RefundStatus.Refunded => "status-completed",
        RefundStatus.Rejected => "status-rejected",
        RefundStatus.Approved => "status-confirmed",
        _ => "status-pending"
    };
    string StatusLabel(string status) => status switch {
        RefundStatus.Pending or RefundStatus.UnderReview => "AWAITING REVIEW",
        RefundStatus.Approved => "APPROVED - PROCESS REFUND",
        RefundStatus.RefundProcessing => "AWAITING FINAL VERIFICATION",
        RefundStatus.Refunded => "COMPLETED",
        RefundStatus.Rejected => "REJECTED",
        _ => status.ToUpperInvariant()
    };
}
<div class="owner-financial-page owner-queue-page owner-refund-requests">
    @if(TempData["Success"] != null) { <div class="alert alert-success" role="status">@TempData["Success"]</div> }
    @if(TempData["Error"] != null) { <div class="alert alert-danger" role="alert">@TempData["Error"]</div> }

    <form method="get" class="am-filter-bar am-filter-row aries-round3-toolbar"
          data-aries-round3-filter="true" aria-label="Refund request filters">
        <div class="am-filter-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" name="q" value="@ViewBag.Search"
                   placeholder="Search booking, client, or reference" aria-label="Search refund requests" />
        </div>
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                    data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                <i class="bi bi-funnel" aria-hidden="true"></i> Filters
            </button>
            <div class="dropdown-menu dropdown-menu-end p-3">
                <label class="form-label" for="RefundRequestsfilter">Refund Status</label>
                <select id="RefundRequestsfilter" name="filter" class="form-select mb-3">
                    <option value="all" selected="@(ViewBag.Filter == "all")">All statuses</option>
                    <option value="UnderReview" selected="@(ViewBag.Filter == RefundStatus.UnderReview || ViewBag.Filter == RefundStatus.Pending)">Awaiting Owner Review</option>
                    <option value="Approved" selected="@(ViewBag.Filter == RefundStatus.Approved)">Approved</option>
                    <option value="RefundProcessing" selected="@(ViewBag.Filter == RefundStatus.RefundProcessing)">Awaiting Final Verification</option>
                    <option value="Refunded" selected="@(ViewBag.Filter == RefundStatus.Refunded)">Completed</option>
                    <option value="Rejected" selected="@(ViewBag.Filter == RefundStatus.Rejected)">Rejected</option>
                </select>
                <a asp-action="RefundRequests" class="btn btn-outline-secondary btn-sm">Reset filters</a>
            </div>
        </div>
        <div class="owner-queue-sort">
            <label for="refundSortBy">Sort by</label>
            <select class="form-select" id="refundSortBy" name="sortBy" data-owner-verification-sort
                    aria-label="Sort refunds by request date">
                <option value="newest" selected="@((string?)ViewBag.SortBy != "oldest")">Newest to Oldest</option>
                <option value="oldest" selected="@((string?)ViewBag.SortBy == "oldest")">Oldest to Newest</option>
            </select>
        </div>
        <button class="visually-hidden" type="submit">Search</button>
        <a class="btn btn-outline-secondary owner-queue-refresh"
           asp-action="RefundRequests" asp-all-route-data="pagination.Routes()"
           data-queue-refresh aria-label="Refresh refund requests" title="Refresh refund requests">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </a>
    </form>

    <div class="staff-data-table-frame owner-queue-table-frame owner-verification-table-frame owner-refund-table-frame"
         data-staff-table-capacity="5">
        <div class="dashboard-panel owner-table-panel staff-data-table-panel">
            <div class="table-responsive staff-data-table-scroll" tabindex="0" role="region"
                 aria-label="Refund records; scroll horizontally for all columns">
                <table class="table owner-audit-table staff-data-table align-middle">
                    <colgroup>
                        <col class="owner-refund-col-booking" />
                        <col class="owner-refund-col-client" />
                        <col class="owner-refund-col-amount" />
                        <col class="owner-refund-col-proof" />
                        <col class="owner-refund-col-status" />
                        <col class="owner-refund-col-action" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col">Booking ID</th>
                            <th scope="col">Client</th>
                            <th scope="col">Refund Amount</th>
                            <th scope="col">Supporting Proof</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!requests.Any())
                    {
                        <tr class="staff-data-table-empty-row">
                            <td colspan="6">
                                <div class="staff-data-table-empty" role="status">
                                    <i class="bi bi-inbox" aria-hidden="true"></i>
                                    @if (ViewBag.HasOtherRefundRequests == true)
                                    {
                                        <strong>No matching requests</strong>
                                        <p>Try adjusting your search or filters.</p>
                                        <a asp-action="RefundRequests" class="staff-data-table-reset">Clear filters</a>
                                    }
                                    else
                                    {
                                        <strong>No refund requests</strong>
                                        <p>There are no refund requests to display.</p>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in requests)
                        {
                            <tr>
                                <td><strong class="owner-booking-code">BK-@item.Booking?.CreatedAt.Year-@item.BookingId.ToString("D3")</strong></td>
                                <td><strong>@(item.Booking?.Client?.FullName ?? "Unknown client")</strong></td>
                                <td>
                                    <strong>&#8369;@item.Amount.ToString("N2")</strong>
                                    @if(item.ApprovedAmount.HasValue)
                                    {
                                        <span class="owner-cell-subtext">Approved: &#8369;@item.ApprovedAmount.Value.ToString("N2")</span>
                                    }
                                </td>
                                <td>
                                    @if(!string.IsNullOrWhiteSpace(item.PaymentProofImagePath))
                                    {
                                        <button type="button" class="owner-proof-button js-refund-proof"
                                                data-proof-src="@Url.Action("RefundProof","Payments",new{id=item.Id})"
                                                data-proof-title="Refund evidence for BK-@item.BookingId"
                                                aria-label="Enlarge supporting proof for refund @item.Id">
                                            <img loading="lazy" src="@Url.Action("RefundProof","Payments",new{id=item.Id})"
                                                 class="owner-proof-thumb" alt="Refund proof thumbnail" />
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="owner-cell-subtext">No supporting proof recorded</span>
                                    }
                                </td>
                                <td><span class="status-badge @StatusClass(item.Status)">@StatusLabel(item.Status)</span></td>
                                <td class="text-end">
                                    <a asp-action="RefundReview" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                        Review<span class="visually-hidden"> refund @item.Id</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <partial name="_QueuePagination" model="pagination" />
    </div>
</div>
<partial name="_FinancialProofViewer" />
@section Scripts { <script src="~/js/owner-financial.js" asp-append-version="true"></script> }
