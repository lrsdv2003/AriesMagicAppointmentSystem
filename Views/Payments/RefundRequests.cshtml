@model IEnumerable<AriesMagicAppointmentSystem.Models.RefundRequest>
@using AriesMagicAppointmentSystem.Models
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Refund Requests";
    var requests = Model.ToList();
    var pagination = ViewData["QueuePage"] as AriesMagicAppointmentSystem.ViewModels.QueuePaginationViewModel
        ?? new(requests.Count, 1, 10, "RefundRequests", new() { ["filter"] = "all" }) {
            AwaitingReviewCount = requests.Count(x => x.Status is RefundStatus.Pending or RefundStatus.UnderReview),
            AwaitingFinalVerificationCount = requests.Count(x => x.Status == RefundStatus.RefundProcessing) };
    string OcrClass(string? result) => result switch { OcrVerificationResults.MismatchDetected => "ocr-mismatch", OcrVerificationResults.OcrFailed => "ocr-failed", _ => "ocr-manual" };
    string OcrLabel(string? result) => result switch { OcrVerificationResults.MismatchDetected => "Receipt details conflict", OcrVerificationResults.OcrFailed => "OCR unclear", _ => "Manual review required" };
    string StatusClass(string status) => status switch { RefundStatus.Refunded => "status-completed", RefundStatus.Rejected => "status-rejected", RefundStatus.Approved => "status-confirmed", _ => "status-pending" };
    string StatusLabel(string status) => status switch { RefundStatus.Pending or RefundStatus.UnderReview => "AWAITING REVIEW", RefundStatus.Approved => "APPROVED · PROCESS REFUND", RefundStatus.RefundProcessing => "AWAITING FINAL VERIFICATION", RefundStatus.Refunded => "COMPLETED", RefundStatus.Rejected => "REJECTED", _ => status.ToUpperInvariant() };
}
<div class="owner-financial-page">
    @if(TempData["Success"]!=null){<div class="alert alert-success" role="status">@TempData["Success"]</div>}
    @if(TempData["Error"]!=null){<div class="alert alert-danger" role="alert">@TempData["Error"]</div>}
    <div class="owner-summary-row" aria-label="Refund summary for all matching records">
        <div><span>Matching Records</span><strong>@pagination.TotalCount</strong></div>
        <div><span>Awaiting Review</span><strong>@pagination.AwaitingReviewCount</strong></div>
        <div><span>Awaiting Final Verification</span><strong>@pagination.AwaitingFinalVerificationCount</strong></div>
    </div>
    <form method="get" class="am-filter-bar am-filter-row" aria-label="Refund verification filters">
        <input type="hidden" name="pageSize" value="@pagination.PageSize" />
        <div class="am-filter-search"><i class="bi bi-search" aria-hidden="true"></i><input type="search" name="q" value="@ViewBag.Search" placeholder="Search booking, client, or reference" aria-label="Search refund queue" /></div>
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"><i class="bi bi-funnel" aria-hidden="true"></i> Filters</button>
            <div class="dropdown-menu dropdown-menu-end p-3">
                <label class="form-label" for="RefundRequestsfilter">Refund Status</label>
                <select id="RefundRequestsfilter" name="filter" class="form-select mb-3">
                    <option value="all" selected="@(ViewBag.Filter=="all")">All statuses</option>
                    <option value="UnderReview" selected="@(ViewBag.Filter==RefundStatus.UnderReview || ViewBag.Filter==RefundStatus.Pending)">Awaiting Owner Review</option>
                    <option value="Approved" selected="@(ViewBag.Filter==RefundStatus.Approved)">Approved</option>
                    <option value="RefundProcessing" selected="@(ViewBag.Filter==RefundStatus.RefundProcessing)">Awaiting Final Verification</option>
                    <option value="Refunded" selected="@(ViewBag.Filter==RefundStatus.Refunded)">Completed</option>
                    <option value="Rejected" selected="@(ViewBag.Filter==RefundStatus.Rejected)">Rejected</option>
                </select>
                <div class="d-flex justify-content-end gap-2"><a asp-action="RefundRequests" class="btn btn-light">Clear Filters</a><button class="btn btn-primary">Apply Filters</button></div>
            </div>
        </div>
        <button class="btn btn-primary" type="submit">Search</button>
        <a class="btn btn-outline-secondary" asp-action="RefundRequests" asp-all-route-data="pagination.Routes()" data-queue-refresh><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</a>
    </form>
    <div class="dashboard-panel owner-table-panel">
        @if(!requests.Any()){
            <div class="owner-empty-state"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i><h2>No refund requests match this view.</h2><p>Try another filter to review pending, completed or rejected requests.</p></div>
        }else{
            <div class="table-responsive" tabindex="0" role="region" aria-label="Refund records; scroll horizontally for all columns"><table class="table owner-audit-table align-middle">
                <thead><tr><th scope="col">Booking ID</th><th scope="col">Client</th><th scope="col">Refund Amount</th><th scope="col">Reason</th><th scope="col">Supporting Proof</th><th scope="col">Review Indicator</th><th scope="col">Status</th><th scope="col" class="text-end">Action</th></tr></thead>
                <tbody>
                @foreach(var item in requests){
                    var ocr = item.OcrVerifications.Where(o => o.VerificationPurpose == OcrVerificationPurposes.RefundSupport).OrderByDescending(o => o.ProcessedAt).ThenByDescending(o => o.Id).FirstOrDefault();
                    <tr>
                        <td><strong class="owner-booking-code">BK-@item.Booking?.CreatedAt.Year-@item.BookingId.ToString("D3")</strong><span class="owner-cell-subtext">@(item.Booking?.PackageName ?? item.Booking?.Service?.Name ?? "Package")</span></td>
                        <td><strong>@(item.Booking?.Client?.FullName ?? "Unknown client")</strong></td>
                        <td><strong>₱@item.Amount.ToString("N2")</strong>@if(item.ApprovedAmount.HasValue){<span class="owner-cell-subtext">Approved: ₱@item.ApprovedAmount.Value.ToString("N2")</span>}</td>
                        <td>@if(string.IsNullOrWhiteSpace(item.ClientReason)){<span>No reason provided</span>}else if(item.ClientReason.Length<=80){<span>@item.ClientReason</span>}else{<details class="owner-refund-reason"><summary>@(item.ClientReason[..77] + "...")</summary><p>@item.ClientReason</p></details>}</td>
                        <td>@if(!string.IsNullOrWhiteSpace(item.PaymentProofImagePath)){<button type="button" class="owner-proof-button js-refund-proof" data-proof-src="@Url.Action("RefundProof","Payments",new{id=item.Id})" data-proof-title="Refund evidence for BK-@item.BookingId" aria-label="Enlarge supporting proof for refund @item.Id"><img loading="lazy" src="@Url.Action("RefundProof","Payments",new{id=item.Id})" class="owner-proof-thumb" alt="Refund proof thumbnail" /></button>}else{<span class="owner-cell-subtext">No supporting proof recorded</span>}</td>
                        <td><span class="ocr-badge @OcrClass(ocr?.VerificationResult)">@OcrLabel(ocr?.VerificationResult)</span></td>
                        <td><span class="status-badge @StatusClass(item.Status)">@StatusLabel(item.Status)</span></td>
                        <td class="text-end"><a asp-action="RefundReview" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Review<span class="visually-hidden"> refund @item.Id</span></a></td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
        <partial name="_QueuePagination" model="pagination" />
    </div>
</div>
<partial name="_FinancialProofViewer" />
@section Scripts { <script src="~/js/owner-financial.js" asp-append-version="true"></script> }
