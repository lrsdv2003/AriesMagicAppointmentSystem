@model IEnumerable<AriesMagicAppointmentSystem.Models.RefundRequest>
@using AriesMagicAppointmentSystem.Models
@{
    Layout = "_DashboardLayout"; ViewData["Title"] = "Refund Verification"; var requests = Model.ToList();
    string Badge(string? result) => result switch { OcrVerificationResults.LikelyMatch => "ocr-likely", OcrVerificationResults.PartialMatch => "ocr-partial", OcrVerificationResults.MismatchDetected => "ocr-mismatch", OcrVerificationResults.OcrFailed => "ocr-failed", _ => "ocr-manual" };
}
<div class="page-header"><div><h1>Refund Verification</h1><p class="page-subtitle">Compare refund evidence with the original payment before an Admin/Owner makes the final decision.</p></div></div>
@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}
<div class="ocr-queue-stats"><div><small>Results shown</small><strong>@requests.Count</strong></div><div><small>Under review</small><strong>@requests.Count(x=>x.Status==RefundStatus.UnderReview || x.Status==RefundStatus.Pending)</strong></div><div><small>Processing</small><strong>@requests.Count(x=>x.Status==RefundStatus.Approved || x.Status==RefundStatus.RefundProcessing)</strong></div></div>
<form method="get" class="ocr-filterbar"><select name="filter" class="form-select"><option value="all">All statuses</option><option value="UnderReview">Under Review</option><option value="Approved">Approved</option><option value="RefundProcessing">Refund Processing</option><option value="Refunded">Completed</option><option value="Rejected">Rejected</option></select><input class="form-control" name="q" value="@ViewBag.Search" placeholder="Refund ID, booking, client, reference..."/><button class="btn btn-primary">Filter</button></form>
<div class="dashboard-panel ocr-queue-panel">
@if(!requests.Any()){<div class="empty-state"><h3>No matching refund requests</h3></div>}
else{<div class="table-responsive"><table class="table align-middle ocr-queue-table"><thead><tr><th>Client / Booking</th><th>Requested</th><th>Original Payment</th><th>Evidence</th><th>OCR Result</th><th>Status</th><th>Requested</th><th></th></tr></thead><tbody>
@foreach(var item in requests){var ocr=item.OcrVerifications.Where(o=>o.VerificationPurpose==OcrVerificationPurposes.RefundSupport).OrderByDescending(o=>o.ProcessedAt).FirstOrDefault();<tr><td><strong>@item.Booking?.Client?.FullName</strong><small>Booking #@item.BookingId · RF-@item.Id.ToString("D4")</small></td><td>₱@item.Amount.ToString("N2")</td><td>₱@((item.OriginalPayment?.Amount??0).ToString("N2"))<small>@(item.OriginalPayment?.PaymentMethod ?? "N/A")</small></td><td><img src="@Url.Action("RefundProof","Payments",new{id=item.Id})" class="payment-proof-thumb" alt="Protected refund evidence"/></td><td><span class="ocr-badge @Badge(ocr?.VerificationResult)">@(ocr?.VerificationResult ?? "Manual Review")</span></td><td><span class="status-badge status-pending">@item.Status</span></td><td><small>@item.RequestedAt.ToString("MMM dd, yyyy")</small></td><td class="text-end"><a asp-action="RefundReview" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Open Review</a></td></tr>}
</tbody></table></div>}
</div>