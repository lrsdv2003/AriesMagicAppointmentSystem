@model AriesMagicAppointmentSystem.Models.RefundRequest
@using AriesMagicAppointmentSystem.Models
@using AriesMagicAppointmentSystem.ViewModels
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Refund Verification";
    var supportOcr = Model.OcrVerifications.Where(x=>x.VerificationPurpose==OcrVerificationPurposes.RefundSupport).OrderByDescending(x=>x.ProcessedAt).FirstOrDefault();
    var confirmationOcr = Model.OcrVerifications.Where(x=>x.VerificationPurpose==OcrVerificationPurposes.RefundConfirmation).OrderByDescending(x=>x.ProcessedAt).FirstOrDefault();
    var finance = ViewBag.FinancialSummary as BookingFinancialSummaryViewModel;
    var canDecide = User.IsInRole("Owner");
    var approvedRefund = Model.ApprovedAmount ?? Math.Min(Model.Amount, Model.OriginalPayment?.Amount ?? 0m);
    var projectedNet = finance == null ? 0m : Model.Status is RefundStatus.Refunded or RefundStatus.Rejected ? finance.NetCollected : Math.Max(0m, finance.NetCollected - approvedRefund);
    var bookingCode = $"BK-{Model.Booking?.CreatedAt.Year}-{Model.BookingId:D3}";
    string ResultClass(string? result)=>result switch{OcrVerificationResults.LikelyMatch=>"ocr-likely",OcrVerificationResults.PartialMatch=>"ocr-partial",OcrVerificationResults.MismatchDetected=>"ocr-mismatch",OcrVerificationResults.OcrFailed=>"ocr-failed",_=>"ocr-manual"};
    string StatusClass(string status)=>status switch{RefundStatus.Refunded=>"status-verified",RefundStatus.Rejected=>"status-rejected",RefundStatus.Approved=>"status-confirmed",_=>"status-pending"};
    string StatusLabel(string status)=>status switch{RefundStatus.Pending=>"AWAITING REVIEW",RefundStatus.UnderReview=>"AWAITING REVIEW",RefundStatus.Approved=>"APPROVED · PROCESS REFUND",RefundStatus.RefundProcessing=>"AWAITING FINAL VERIFICATION",RefundStatus.Refunded=>"COMPLETED",RefundStatus.Rejected=>"REJECTED",_=>status.ToUpperInvariant()};
}
<div class="owner-financial-page owner-review-page">
    <div class="page-header owner-page-header"><div><span class="owner-eyebrow">Refund Verification Workspace</span><h1>RF-@Model.Id.ToString("D4") · @bookingCode</h1><p class="page-subtitle">Review eligibility, supporting evidence, and financial impact before moving the refund to its next stage.</p></div><a asp-action="RefundRequests" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Refunds</a></div>
    @if(TempData["Success"]!=null){<div class="alert alert-success" role="status">@TempData["Success"]</div>}
    @if(TempData["Error"]!=null){<div class="alert alert-danger" role="alert">@TempData["Error"]</div>}
    <div class="owner-review-layout">
        <section class="owner-proof-panel"><div class="owner-section-heading"><div><span class="owner-section-kicker">Evidence</span><h2>Refund Supporting Proof</h2></div><span class="status-badge @StatusClass(Model.Status)">@StatusLabel(Model.Status)</span></div><button type="button" class="owner-proof-large js-refund-proof"><img src="@Url.Action("RefundProof","Payments",new{id=Model.Id})" alt="Protected refund supporting proof" /></button><p class="owner-proof-help"><i class="bi bi-zoom-in"></i> Click the proof to enlarge it.</p></section>
        <div class="owner-review-stack">
            <section class="owner-review-card"><div class="owner-section-heading"><div><span class="owner-section-kicker">Booking</span><h2>Booking Information</h2></div></div><dl class="owner-detail-grid"><div><dt>Booking ID</dt><dd>@bookingCode</dd></div><div><dt>Client</dt><dd>@(Model.Booking?.Client?.FullName??"Unknown client")</dd></div><div><dt>Package</dt><dd>@(Model.Booking?.PackageName??Model.Booking?.Service?.Name??"N/A")</dd></div><div><dt>Event Date</dt><dd>@(Model.Booking?.EventDate.ToString("MMM dd, yyyy")??"N/A")</dd></div></dl></section>
            <section class="owner-review-card"><div class="owner-section-heading"><div><span class="owner-section-kicker">Source Transaction</span><h2>Original Payment</h2></div></div><dl class="owner-detail-grid"><div><dt>Booking Total</dt><dd>₱@((finance?.BookingTotal??Model.Booking?.FinalPrice??0m).ToString("N2"))</dd></div><div><dt>Total Paid</dt><dd>₱@((finance?.TotalVerifiedPayments??0m).ToString("N2"))</dd></div><div><dt>Original Reference</dt><dd>@(Model.OriginalPayment?.TransactionReference??"N/A")</dd></div><div><dt>Payment Method</dt><dd>@(Model.OriginalPayment?.PaymentMethod??"N/A")</dd></div></dl></section>
            <section class="owner-review-card"><div class="owner-section-heading"><div><span class="owner-section-kicker">Client Request</span><h2>Refund Request</h2></div></div><dl class="owner-detail-grid"><div><dt>Requested Amount</dt><dd>₱@Model.Amount.ToString("N2")</dd></div><div><dt>Eligible Refund</dt><dd>₱@Math.Min(Model.Amount,Model.OriginalPayment?.Amount??0m).ToString("N2")</dd></div><div><dt>Request Date</dt><dd>@Model.RequestedAt.ToString("MMM dd, yyyy · hh:mm tt")</dd></div><div><dt>Refund Recipient</dt><dd>@Model.GCashAccountName · @Model.GCashNumber</dd></div><div class="owner-detail-wide"><dt>Reason</dt><dd>@Model.ClientReason</dd></div></dl></section>
            <section class="owner-review-card"><div class="owner-section-heading"><div><span class="owner-section-kicker">Automated Analysis</span><h2>OCR / Proof Analysis</h2></div><span class="ocr-badge @ResultClass(supportOcr?.VerificationResult)">@(supportOcr?.VerificationResult??"Manual Review Required")</span></div>@if(supportOcr==null){<div class="owner-empty-inline">No OCR result available. Continue with manual review.</div>}else{<dl class="owner-detail-grid"><div><dt>Detected Amount</dt><dd>@(supportOcr.ExtractedAmount.HasValue?$"₱{supportOcr.ExtractedAmount.Value:N2}":"Not detected")</dd></div><div><dt>Reference</dt><dd>@(supportOcr.ExtractedReferenceNumber??"Not detected")</dd></div><div><dt>Recipient</dt><dd>@(supportOcr.ExtractedReceiver??"Not detected")</dd></div><div><dt>Date</dt><dd>@(supportOcr.ExtractedDate?.ToString("MMM dd, yyyy")??"Not detected")</dd></div><div><dt>Status</dt><dd>@(supportOcr.ExtractedStatus??"Not detected")</dd></div><div><dt>Confidence</dt><dd>@(supportOcr.OcrConfidence.HasValue ? supportOcr.OcrConfidence.Value.ToString("0.0") + "%" : "Not available")</dd></div></dl><details class="owner-raw-details"><summary>View raw OCR text</summary><pre>@(supportOcr.RawText??supportOcr.ProcessingError??"No readable text extracted.")</pre></details>}</section>
            @if(finance!=null){<section class="owner-review-card"><div class="owner-section-heading"><div><span class="owner-section-kicker">Financial Impact</span><h2>Refund Impact</h2></div></div><div class="owner-financial-grid"><div><span>Current Collected</span><strong>₱@finance.TotalVerifiedPayments.ToString("N2")</strong></div><div><span>Completed Refunds</span><strong>₱@finance.CompletedRefunds.ToString("N2")</strong></div><div><span>This Refund</span><strong>₱@approvedRefund.ToString("N2")</strong></div><div><span>Current Net Collected</span><strong>₱@finance.NetCollected.ToString("N2")</strong></div><div class="owner-impact-highlight"><span>@(Model.Status is RefundStatus.Refunded or RefundStatus.Rejected ? "Current Net Collected" : "Net After Completed Refund")</span><strong>₱@projectedNet.ToString("N2")</strong></div></div><p class="owner-card-note">Only a completed refund changes net collected revenue.</p></section>}
        </div>
    </div>
    @if(canDecide && (Model.Status==RefundStatus.Pending||Model.Status==RefundStatus.UnderReview)){
        <section class="owner-action-bar"><div><strong>Owner Decision</strong><span>Approval moves this request to refund processing. Rejection requires a reason.</span></div><div class="owner-action-buttons"><button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#approveRefundModal"><i class="bi bi-check2-circle"></i> Approve Refund</button><button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectRefundModal"><i class="bi bi-x-circle"></i> Reject Refund</button></div></section>
    } else if(!canDecide && (Model.Status==RefundStatus.Pending||Model.Status==RefundStatus.UnderReview)){<div class="alert alert-info">Admin access is read-only. This request requires Owner review.</div>}
    @if(canDecide && (Model.Status==RefundStatus.Approved||Model.Status==RefundStatus.RefundProcessing||Model.Status==RefundStatus.Refunded)){
        <section class="owner-review-card owner-refund-processing"><div class="owner-section-heading"><div><span class="owner-section-kicker">Refund Processing</span><h2>Refund Confirmation Proof</h2></div><span class="status-badge status-pending">@StatusLabel(Model.Status)</span></div>
            @if(!string.IsNullOrWhiteSpace(Model.RefundProofImagePath)){<div class="owner-refund-confirm-grid"><button type="button" class="owner-proof-large owner-proof-compact js-confirm-proof"><img src="@Url.Action("RefundProof","Payments",new{id=Model.Id,confirmation=true})" alt="Refund confirmation proof" /></button><div><span class="ocr-badge @ResultClass(confirmationOcr?.VerificationResult)">@(confirmationOcr?.VerificationResult??"Awaiting OCR")</span>@if(confirmationOcr!=null){<dl class="owner-detail-grid mt-3"><div><dt>Approved Refund</dt><dd>₱@approvedRefund.ToString("N2")</dd></div><div><dt>Detected Amount</dt><dd>@(confirmationOcr.ExtractedAmount.HasValue?$"₱{confirmationOcr.ExtractedAmount.Value:N2}":"Not detected")</dd></div><div><dt>Recipient</dt><dd>@(confirmationOcr.ExtractedReceiver??"Not detected")</dd></div><div><dt>Reference</dt><dd>@(confirmationOcr.ExtractedReferenceNumber??"Not detected")</dd></div><div><dt>Status</dt><dd>@(confirmationOcr.ExtractedStatus??"Not detected")</dd></div></dl>}</div></div>}
            @if(Model.Status!=RefundStatus.Refunded){<form asp-action="UploadRefundProof" method="post" enctype="multipart/form-data" class="owner-proof-upload js-owner-action-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><div><label class="form-label" for="refundProofFile">Refund confirmation screenshot</label><input id="refundProofFile" class="form-control" type="file" name="refundProofImage" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" required /></div><button class="btn btn-primary js-owner-submit" data-loading-text="Analyzing..."><i class="bi bi-cloud-arrow-up"></i> @(string.IsNullOrWhiteSpace(Model.RefundProofImagePath)?"Upload & Analyze Proof":"Replace & Re-analyze Proof")</button></form>}
            @if(Model.Status==RefundStatus.RefundProcessing&&confirmationOcr!=null){<button class="btn btn-success mt-3" data-bs-toggle="modal" data-bs-target="#completeRefundModal"><i class="bi bi-check2-circle"></i> Confirm Refund Completed</button>}
        </section>
    }
    @if(Model.Status==RefundStatus.Refunded){<div class="owner-success-state"><i class="bi bi-check-circle-fill"></i><div><strong>Refund Completed</strong><span>Final verification completed @Model.RefundCompletedAt?.ToString("MMM dd, yyyy · hh:mm tt").</span></div></div>}
</div>
<partial name="_FinancialProofViewer" />
@if(canDecide && (Model.Status==RefundStatus.Pending||Model.Status==RefundStatus.UnderReview)){
<div class="modal fade owner-decision-modal" id="approveRefundModal" tabindex="-1" aria-labelledby="approveRefundModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form asp-action="ApproveRefund" method="post" class="js-owner-action-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><div class="modal-header"><h2 id="approveRefundModalTitle" class="modal-title fs-5">Approve Refund</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><p>Approve a refund of <strong>₱@Math.Min(Model.Amount,Model.OriginalPayment?.Amount??0m).ToString("N2")</strong> for <strong>@bookingCode</strong>?</p><p class="owner-card-note mb-0">This authorizes processing. Revenue changes only after the refund is completed.</p></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-success js-owner-submit" data-loading-text="Approving...">Approve Refund</button></div></form></div></div></div>
<div class="modal fade owner-decision-modal" id="rejectRefundModal" tabindex="-1" aria-labelledby="rejectRefundModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form asp-action="RejectRefund" method="post" class="js-owner-action-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><div class="modal-header"><h2 id="rejectRefundModalTitle" class="modal-title fs-5">Reject Refund</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><label class="form-label" for="refundRejectReason">Rejection Reason</label><select aria-label="Suggested rejection reason" id="refundRejectPreset" class="form-select mb-2"><option value="">Choose a reason</option><option>Refund amount is not eligible</option><option>Supporting proof does not match</option><option>Duplicate request</option><option>Incorrect payment record</option><option>Other</option></select><textarea id="refundRejectReason" name="rejectionReason" maxlength="1000" class="form-control" rows="3" required placeholder="Reason shown to the client"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-danger js-owner-submit" data-loading-text="Rejecting...">Reject Refund</button></div></form></div></div></div>}
@if(canDecide&&Model.Status==RefundStatus.RefundProcessing&&confirmationOcr!=null){<div class="modal fade owner-decision-modal" id="completeRefundModal" tabindex="-1" aria-labelledby="completeRefundModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form asp-action="MarkAsRefunded" method="post" class="js-owner-action-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><div class="modal-header"><h2 id="completeRefundModalTitle" class="modal-title fs-5">Confirm Refund Completed</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><p>Confirm that <strong>₱@approvedRefund.ToString("N2")</strong> has actually been refunded and the confirmation proof has been manually reviewed.</p><div class="owner-confirm-impact"><span>Net Collected After Completion</span><strong>₱@projectedNet.ToString("N2")</strong></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-success js-owner-submit" data-loading-text="Completing...">Confirm Completed</button></div></form></div></div></div>}
@section Scripts { <script src="~/js/owner-financial.js" asp-append-version="true"></script> }
