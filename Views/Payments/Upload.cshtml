@model AriesMagicAppointmentSystem.ViewModels.PaymentUploadViewModel
@{ ViewData["Title"] = "Payment"; }
<header class="cr-page-heading"><div><span class="cr-eyebrow">Confirm your celebration</span><h1>Pay & upload proof</h1><p>Follow the instructions, upload your receipt, then track verification.</p></div><a asp-action="MyUploads" class="btn btn-outline-secondary">My payments</a></header>
<ol class="cr-steps cr-payment-steps" aria-label="Payment progress"><li class="is-active" aria-current="step">Payment instructions</li><li>Upload proof</li><li>Verification status</li></ol>
<form asp-action="Upload" method="post" enctype="multipart/form-data" id="clientPaymentForm" novalidate data-has-errors="@(!ViewData.ModelState.IsValid ? "true" : "false")">
@Html.AntiForgeryToken()
<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<section class="cr-card" id="paymentInstructions"><h2>Choose your booking</h2><label asp-for="BookingId" class="form-label">Booking and outstanding balance</label><select asp-for="BookingId" asp-items="Model.Bookings" class="form-select" required><option value="">Select an approved booking</option></select><span asp-validation-for="BookingId" class="text-danger"></span>
<div class="cr-payment-guide"><div><h3>Send your payment</h3><p>The minimum initial downpayment is <strong>₱@Model.FixedDownpaymentAmount.ToString("N2")</strong>. You may pay more, or the exact remaining balance when it is below ₱2,000.</p><ol><li>Scan the GCash QR using your payment app.</li><li>Confirm the recipient and amount before sending.</li><li>Save a clear screenshot or receipt of the successful transaction.</li></ol><p>Your proof will be reviewed before the payment reduces your balance.</p></div><figure><img src="@Model.GCashQrPath" class="cr-payment-qr" alt="GCash payment QR code"/><figcaption><a href="@Model.GCashQrPath" download="aries-gcash-qr.jpeg">Save QR image</a></figcaption></figure></div>
<div class="cr-panel-actions"><button type="button" class="btn btn-primary" id="continuePayment">I have paid — upload proof</button></div></section>
<section class="cr-card" id="paymentProof" hidden><h2 tabindex="-1">Upload your receipt</h2><p>Use a clear, complete screenshot showing the payment details.</p><div class="cr-form-grid"><div><label asp-for="Amount">Amount paid</label><input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" required/><span asp-validation-for="Amount" class="text-danger"></span></div><div><label asp-for="PaymentMethod">Payment method</label><select asp-for="PaymentMethod" class="form-select"><option>GCash</option><option>Maya</option><option>Bank Transfer</option><option>Online Banking</option><option>Other</option></select></div><div class="cr-full"><label asp-for="ProofImage">Payment proof</label><input asp-for="ProofImage" type="file" class="form-control" data-proof-input accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" required/><span asp-validation-for="ProofImage" class="text-danger"></span><small>JPG, PNG, or WEBP · maximum 5 MB</small><div class="proof-preview-shell" data-proof-preview hidden><img alt="Your selected payment proof"/><div><button type="button" class="btn btn-sm btn-outline-secondary" data-proof-replace>Replace image</button><button type="button" class="btn btn-sm btn-outline-danger" data-proof-remove>Remove image</button></div></div></div></div><div class="cr-panel-actions"><button type="button" class="btn btn-outline-secondary" id="backPayment">Back to instructions</button><button type="submit" class="btn btn-primary">Submit proof for verification</button></div></section>
</form>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script src="~/js/proof-preview.js" asp-append-version="true"></script>
<script>
(() => { const form=document.getElementById('clientPaymentForm'),intro=document.getElementById('paymentInstructions'),proof=document.getElementById('paymentProof'),steps=[...document.querySelectorAll('.cr-payment-steps li')];function showProof(show){intro.hidden=show;proof.hidden=!show;steps.forEach((s,i)=>{s.classList.toggle('is-active',i===(show?1:0));s.classList.toggle('is-done',show&&i===0);if(i===(show?1:0))s.setAttribute('aria-current','step');else s.removeAttribute('aria-current');});if(show)proof.querySelector('h2').focus();}document.getElementById('continuePayment').onclick=()=>{const booking=document.getElementById('BookingId');if(booking.reportValidity())showProof(true);};document.getElementById('backPayment').onclick=()=>showProof(false);document.getElementById('ProofImage').addEventListener('change',e=>e.target.setCustomValidity(e.target.files[0]?.size>5*1024*1024?'Choose an image smaller than 5 MB.':''));form.addEventListener('submit',e=>{if(proof.hidden){e.preventDefault();return;}const file=document.getElementById('ProofImage');file.setCustomValidity(file.files[0]?.size>5*1024*1024?'Choose an image smaller than 5 MB.':'');if(!form.checkValidity()){e.preventDefault();form.reportValidity();}});if(form.dataset.hasErrors==='true'&&document.getElementById('BookingId').value)showProof(true);})();
</script>
}
