@model IEnumerable<AriesMagicAppointmentSystem.Models.Payment>
@using AriesMagicAppointmentSystem.Models
@using AriesMagicAppointmentSystem.ViewModels
@{
    Layout = "_ClientHubLayout"; ViewData["Title"] = "Payment activity";
    var payments = Model.OrderByDescending(p => p.UploadedAt).ToList();
    var financials = ViewBag.FinancialSummaries as Dictionary<int, BookingFinancialSummaryViewModel> ?? new();
}
<div class="cn-page cn-payment-page">
<header class="cn-page-heading"><div><p class="cn-kicker">Receipts & verification</p><h1>Payment activity.</h1></div><a asp-action="Upload" class="cn-button cn-primary">Upload receipt</a></header>
@if (TempData["Success"] is string success) { <div class="cn-success" role="status"><strong>Receipt received</strong>@success</div> }
@if (TempData["Error"] is string error) { <div class="cn-error-summary" role="alert">@error</div> }
@if (!payments.Any())
{
    <section class="cn-empty"><h2>No receipts yet.</h2><p>After your booking is approved, upload a receipt here to start Owner verification.</p><a asp-controller="Bookings" asp-action="MyBookings" class="cn-text-link">View my bookings</a></section>
}
else
{
<div class="cn-records">
@foreach (var item in payments)
{
    financials.TryGetValue(item.BookingId, out var finance);
    var packageName = item.Booking?.PackageName ?? item.Booking?.Service?.Name ?? "Package";
    var statusLabel = item.Status == PaymentStatus.Pending ? "Awaiting payment verification" : item.Status == PaymentStatus.AdditionalEvidenceRequired ? "Clearer receipt needed" : item.Status;
    var next = item.Status switch { PaymentStatus.Pending => "Your receipt is with the Owner. No action is needed while it is reviewed; your balance updates after verification.", PaymentStatus.Verified => "The Owner verified this payment. It is included in your verified payments below.", PaymentStatus.AdditionalEvidenceRequired => "The Owner needs a clearer image. Replace the receipt below to continue the review.", PaymentStatus.Rejected => "This receipt was rejected. Open your booking or upload another eligible payment proof.", _ => "Open your booking for the latest next steps." };
    <article class="cn-record cn-payment-record">
        <div class="cn-record-head"><div><span class="cn-reference">@if(item.Booking != null){<span>BK-@item.Booking.CreatedAt.Year-@item.Booking.Id.ToString("D3")</span>}</span><h2>@packageName</h2><partial name="_StatusBadge" model="statusLabel"/></div><div><p>Receipt amount</p><p class="cn-amount">₱@item.Amount.ToString("N2")</p></div></div>
        <div class="cn-next-step">@next</div>
        @if (finance != null) { <dl class="cn-inline-finance"><div><dt>Booking total</dt><dd>₱@finance.BookingTotal.ToString("N2")</dd></div><div><dt>Required downpayment</dt><dd>₱@finance.RequiredDownpayment.ToString("N2")</dd></div><div><dt>Verified payments</dt><dd>₱@finance.TotalVerifiedPayments.ToString("N2")</dd></div><div><dt>Remaining balance</dt><dd>₱@finance.RemainingBalance.ToString("N2")</dd></div></dl> }
        <details class="cn-disclosure"><summary>Receipt & transaction details</summary><div class="cn-receipt"><a href="@Url.Action("PaymentProof", "Payments", new {id=item.Id})" target="_blank" rel="noopener"><img src="@Url.Action("PaymentProof", "Payments", new {id=item.Id})" alt="Private receipt for payment @item.Id" loading="lazy"/></a><div><p>Uploaded @item.UploadedAt.ToString("MMM d, yyyy · h:mm tt")</p><p>Method: @item.PaymentMethod</p><a href="@Url.Action("PaymentProof", "Payments", new {id=item.Id})" target="_blank" rel="noopener" class="cn-text-link">Open private receipt</a></div></div></details>
        @if (item.Status == PaymentStatus.AdditionalEvidenceRequired)
        {
            <form asp-action="ReplaceProof" method="post" enctype="multipart/form-data" data-booking-submit class="cn-replacement">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><p class="cn-help">@(item.ReviewerNote ?? "A clearer screenshot is required.")</p><div class="cn-field"><label for="replacement-@item.Id">Replacement payment proof</label><input id="replacement-@item.Id" class="cn-file-input" type="file" name="proofImage" data-booking-file accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" required/><p class="cn-help">JPG, PNG, or WEBP · up to 5 MB. Replacing proof does not verify payment.</p></div><div class="cn-actions"><button type="submit" class="cn-button cn-primary">Send clearer receipt</button></div></form>
        }
        <div class="cn-record-actions"><a asp-controller="Bookings" asp-action="Details" asp-route-id="@item.BookingId">View booking</a>@if(item.Status == PaymentStatus.Rejected){<a asp-action="Upload" asp-route-bookingId="@item.BookingId">Upload another receipt</a>}</div>
    </article>
}
</div>
}
<div class="cn-links"><a asp-action="MyRefundRequests">Refund requests</a><a asp-controller="Bookings" asp-action="MyBookings">My bookings</a></div>
</div>
@section Scripts { <script src="~/js/booking-experience.js" asp-append-version="true"></script> }
