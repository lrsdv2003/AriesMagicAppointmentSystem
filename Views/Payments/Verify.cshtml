@model AriesMagicAppointmentSystem.Models.Payment
@using AriesMagicAppointmentSystem.Models
@using AriesMagicAppointmentSystem.ViewModels
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Payment Verification";
    var ocr = Model.OcrVerifications.Where(x => x.VerificationPurpose == OcrVerificationPurposes.PaymentProof).OrderByDescending(x => x.ProcessedAt).FirstOrDefault();
    var finance = ViewBag.FinancialSummary as BookingFinancialSummaryViewModel;
    var isOwner = User.IsInRole("Owner");
    var pending = Model.Status == PaymentStatus.Pending;
    var afterPaid = finance == null ? Model.Amount : pending ? finance.TotalVerifiedPayments + Model.Amount : finance.TotalVerifiedPayments;
    var afterRemaining = finance == null ? 0m : pending ? Math.Max(0m, finance.BookingTotal - afterPaid) : finance.RemainingBalance;
    var overpayment = pending && finance != null && (Model.Amount > finance.RemainingBalance || (ocr?.ExtractedAmount.HasValue == true && ocr.ExtractedAmount.Value > finance.RemainingBalance));
    string ResultClass(string? result) => result switch { OcrVerificationResults.LikelyMatch => "ocr-likely", OcrVerificationResults.PartialMatch => "ocr-partial", OcrVerificationResults.MismatchDetected => "ocr-mismatch", OcrVerificationResults.OcrFailed => "ocr-failed", _ => "ocr-manual" };
    string StatusClass(string status) => status switch { PaymentStatus.Verified => "status-verified", PaymentStatus.Rejected => "status-rejected", _ => "status-pending" };
    string StatusLabel(string status) => status switch { PaymentStatus.Pending => "AWAITING REVIEW", PaymentStatus.AdditionalEvidenceRequired => "ADDITIONAL EVIDENCE REQUIRED", PaymentStatus.Verified => "VERIFIED", PaymentStatus.Rejected => "REJECTED", _ => status.ToUpperInvariant() };
    var expectedReceiver = (string?)ViewBag.ExpectedReceiver ?? "Aries Magic";
    string Compare(string? actual, string expected) => string.IsNullOrWhiteSpace(actual) ? "Not Detected" : AriesMagicAppointmentSystem.Services.OcrComparison.ReceiverMatches(actual, expected) ? "Match" : "Mismatch";
    string CompareClass(string result) => result == "Match" ? "compare-match" : result == "Mismatch" ? "compare-mismatch" : "compare-missing";
    string StatusResult(string? value) => string.IsNullOrWhiteSpace(value) ? "Not Detected" : AriesMagicAppointmentSystem.Services.OcrComparison.IsSuccessful(value) ? "Match" : "Mismatch";
    var amountResult = ocr?.ExtractedAmount.HasValue == true ? (Math.Abs(ocr.ExtractedAmount.Value - Model.Amount) <= .01m ? "Match" : "Mismatch") : "Not Detected";
    var receiverResult = ocr == null ? "Not Detected" : Compare(ocr.ExtractedReceiver, expectedReceiver);
    var statusResult = StatusResult(ocr?.ExtractedStatus);
    var assessmentTitle = ocr?.VerificationResult ?? "Manual Review Required";
    var bookingCode = $"BK-{Model.Booking?.CreatedAt.Year}-{Model.BookingId:D3}";
}
<div class="owner-financial-page owner-review-page">
    <div class="page-header owner-page-header"><div><span class="owner-eyebrow">Payment Verification Workspace</span><h1>@bookingCode</h1><p class="page-subtitle">Confirm the payment proof, financial impact, and OCR assessment before taking action.</p></div><a asp-action="PendingVerification" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Queue</a></div>
    @if (TempData["Success"] != null){<div class="alert alert-success" role="status">@TempData["Success"]</div>}
    @if (TempData["Error"] != null){<div class="alert alert-danger" role="alert">@TempData["Error"]</div>}
    <div class="owner-review-layout">
        <section class="owner-proof-panel" aria-labelledby="paymentProofHeading">
            <div class="owner-section-heading"><div><span class="owner-section-kicker">Evidence</span><h2 id="paymentProofHeading">Payment Proof</h2></div><span class="status-badge @StatusClass(Model.Status)">@StatusLabel(Model.Status)</span></div>
            <button type="button" class="owner-proof-large js-proof-preview" aria-label="Enlarge payment proof"><img src="@Url.Action("PaymentProof","Payments",new{id=Model.Id})" alt="Protected payment proof" /></button>
            <p class="owner-proof-help"><i class="bi bi-zoom-in"></i> Click the proof to enlarge it.</p>
        </section>
        <div class="owner-review-stack">
            <section class="owner-review-card"><div class="owner-section-heading"><div><span class="owner-section-kicker">Booking</span><h2>Booking Information</h2></div></div><dl class="owner-detail-grid"><div><dt>Booking ID</dt><dd>@bookingCode</dd></div><div><dt>Client</dt><dd>@(Model.Booking?.Client?.FullName ?? "Unknown client")</dd></div><div><dt>Package</dt><dd>@(Model.Booking?.PackageName ?? Model.Booking?.Service?.Name ?? "N/A")</dd></div><div><dt>Event Date & Time</dt><dd>@(Model.Booking == null ? "N/A" : $"{Model.Booking.EventDate:MMM dd, yyyy} · {Model.Booking.StartTime:hh:mm tt}")</dd></div><div><dt>Total Booking Amount</dt><dd>₱@((finance?.BookingTotal ?? Model.Booking?.FinalPrice ?? 0m).ToString("N2"))</dd></div></dl></section>
            @if(finance!=null){<section class="owner-review-card"><div class="owner-section-heading"><div><span class="owner-section-kicker">Financial Impact</span><h2>Payment Summary</h2></div></div><div class="owner-financial-grid"><div><span>Booking Total</span><strong>₱@finance.BookingTotal.ToString("N2")</strong></div><div><span>Already Paid</span><strong>₱@finance.TotalVerifiedPayments.ToString("N2")</strong></div><div><span>Submitted Payment</span><strong>₱@Model.Amount.ToString("N2")</strong></div><div><span>@(pending ? "Remaining Before Approval" : "Current Remaining Balance")</span><strong>₱@finance.RemainingBalance.ToString("N2")</strong></div><div class="owner-impact-highlight"><span>@(pending ? "Remaining After Approval" : "Current Remaining Balance")</span><strong>₱@afterRemaining.ToString("N2")</strong></div></div>@if(overpayment){<div class="owner-warning-box"><i class="bi bi-exclamation-triangle-fill"></i><div><strong>Approval blocked</strong><span>The submitted or detected amount exceeds the current remaining balance.</span></div></div>}</section>}
            <section class="owner-review-card"><div class="owner-section-heading"><div><span class="owner-section-kicker">Automated Analysis</span><h2>OCR Extraction</h2></div><span class="ocr-badge @ResultClass(ocr?.VerificationResult)">@assessmentTitle</span></div>
                @if(ocr==null){<div class="owner-empty-inline"><i class="bi bi-eye-slash"></i> No OCR result is available. Review the proof manually.</div>}
                else{<dl class="owner-detail-grid"><div><dt>Detected Amount</dt><dd>@(ocr.ExtractedAmount.HasValue?$"₱{ocr.ExtractedAmount.Value:N2}":"Not detected")</dd></div><div><dt>Reference Number</dt><dd>@(ocr.ExtractedReferenceNumber??"Not detected")</dd></div><div><dt>Sender</dt><dd>@(ocr.ExtractedSender??"Not detected")</dd></div><div><dt>Receiver</dt><dd>@(ocr.ExtractedReceiver??"Not detected")</dd></div><div><dt>Transaction Date</dt><dd>@(ocr.ExtractedDate?.ToString("MMM dd, yyyy")??"Not detected")</dd></div><div><dt>Transaction Time</dt><dd>@(ocr.ExtractedTime?.ToString()??"Not detected")</dd></div><div><dt>Status</dt><dd>@(ocr.ExtractedStatus??"Not detected")</dd></div><div><dt>Confidence</dt><dd>@(ocr.OcrConfidence.HasValue ? ocr.OcrConfidence.Value.ToString("0.0") + "%" : "Not available")</dd></div></dl><details class="owner-raw-details"><summary>View raw OCR text</summary><pre>@ocr.RawText</pre></details>}
            </section>
            <section class="owner-review-card"><div class="owner-section-heading"><div><span class="owner-section-kicker">Cross-check</span><h2>Expected vs Detected</h2></div></div><div class="table-responsive"><table class="table owner-compare-table"><thead><tr><th>Field</th><th>Expected</th><th>Detected</th><th>Result</th></tr></thead><tbody><tr><td>Amount</td><td>₱@Model.Amount.ToString("N2")</td><td>@(ocr?.ExtractedAmount.HasValue==true?$"₱{ocr.ExtractedAmount.Value:N2}":"Not detected")</td><td><span class="owner-compare-result @CompareClass(amountResult)">@amountResult</span></td></tr><tr><td>Receiver</td><td>@expectedReceiver</td><td>@(ocr?.ExtractedReceiver??"Not detected")</td><td><span class="owner-compare-result @CompareClass(receiverResult)">@receiverResult</span></td></tr><tr><td>Status</td><td>Successful / Completed</td><td>@(ocr?.ExtractedStatus??"Not detected")</td><td><span class="owner-compare-result @CompareClass(statusResult)">@statusResult</span></td></tr></tbody></table></div></section>
            <section class="owner-assessment-card"><div><span class="owner-section-kicker">OCR Assessment</span><h2>@assessmentTitle</h2><p>@(!string.IsNullOrWhiteSpace(ocr?.WarningSummary) ? ocr.WarningSummary : (ocr?.VerificationResult==OcrVerificationResults.LikelyMatch?"Important payment fields appear consistent. Final verification still requires Owner review.":"Review the highlighted fields and proof before deciding."))</p></div><i class="bi bi-shield-check"></i></section>
        </div>
    </div>
    <section class="owner-action-bar" aria-label="Payment verification actions">
        <div><strong>Owner Decision</strong><span>Financial actions require confirmation.</span></div>
        <div class="owner-action-buttons">
            @if(isOwner && pending){<button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#approvePaymentModal" disabled="@overpayment"><i class="bi bi-check2-circle"></i> Approve Payment</button><button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectPaymentModal"><i class="bi bi-x-circle"></i> Reject Payment</button><button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#evidencePaymentModal"><i class="bi bi-image"></i> Request New Proof</button>}

        </div>
    </section>
</div>
<partial name="_FinancialProofViewer" />
@if(isOwner && pending){
<div class="modal fade owner-decision-modal" id="approvePaymentModal" tabindex="-1" aria-labelledby="approvePaymentModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form asp-action="Verify" method="post" class="js-owner-action-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><div class="modal-header"><h2 id="approvePaymentModalTitle" class="modal-title fs-5">Approve Payment</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><p>You are about to verify <strong>₱@Model.Amount.ToString("N2")</strong> for <strong>@bookingCode</strong>.</p><div class="owner-confirm-impact"><span>Remaining Balance After Approval</span><strong>₱@afterRemaining.ToString("N2")</strong></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-success js-owner-submit" data-loading-text="Approving...">Approve Payment</button></div></form></div></div></div>
<div class="modal fade owner-decision-modal" id="rejectPaymentModal" tabindex="-1" aria-labelledby="rejectPaymentModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form asp-action="Reject" method="post" class="js-owner-action-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><div class="modal-header"><h2 id="rejectPaymentModalTitle" class="modal-title fs-5">Reject Payment</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><label class="form-label" for="paymentRejectReason">Rejection Reason</label><select aria-label="Suggested rejection reason" id="paymentRejectPreset" class="form-select mb-2"><option value="">Choose a reason</option><option>Incorrect amount</option><option>Wrong receiver</option><option>Failed transaction</option><option>Duplicate reference</option><option>Unclear proof</option><option>Other</option></select><textarea id="paymentRejectReason" name="rejectionReason" maxlength="1000" class="form-control" rows="3" required placeholder="Reason shown to the client"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger js-owner-submit" data-loading-text="Rejecting...">Reject Payment</button></div></form></div></div></div>
<div class="modal fade owner-decision-modal" id="evidencePaymentModal" tabindex="-1" aria-labelledby="evidencePaymentModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form asp-action="RequestAdditionalEvidence" method="post" class="js-owner-action-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><div class="modal-header"><h2 id="evidencePaymentModalTitle" class="modal-title fs-5">Request New Proof</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><label class="form-label" for="evidenceReason">What should the client provide?</label><textarea id="evidenceReason" name="reason" class="form-control" rows="3" placeholder="Example: Please upload a clearer screenshot showing the full reference number."></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-warning js-owner-submit" data-loading-text="Sending...">Request New Proof</button></div></form></div></div></div>}
@section Scripts { <script src="~/js/owner-financial.js" asp-append-version="true"></script> }
