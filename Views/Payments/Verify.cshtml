@model AriesMagicAppointmentSystem.Models.Payment
@using AriesMagicAppointmentSystem.Models
@using AriesMagicAppointmentSystem.ViewModels
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Payment Verification";
    var ocr = Model.OcrVerifications.Where(x => x.VerificationPurpose == OcrVerificationPurposes.PaymentProof).OrderByDescending(x => x.ProcessedAt).FirstOrDefault();
    var finance = ViewBag.FinancialSummary as BookingFinancialSummaryViewModel;
    var isOwner = User.IsInRole("Owner");
    var pending = Model.Status == PaymentStatus.Pending;
    var expectedAtUpload = Model.ExpectedAmountAtUpload ?? Model.Amount;
    var afterPaid = finance == null ? Model.Amount : pending ? finance.TotalVerifiedPayments + Model.Amount : finance.TotalVerifiedPayments;
    var afterRemaining = finance == null ? 0m : pending ? Math.Max(0m, finance.BookingTotal - afterPaid) : finance.RemainingBalance;
    var overpayment = pending && finance != null && Model.Amount > finance.RemainingBalance;
    var possibleOcrOverpayment = pending && finance != null && ocr?.ExtractedAmount > finance.RemainingBalance;
    var expectedReceiver = (string?)ViewBag.ExpectedReceiver ?? "Aries Magic";
    string Compare(string? actual, string expected) => string.IsNullOrWhiteSpace(actual) ? "Not Detected" : AriesMagicAppointmentSystem.Services.OcrComparison.ReceiverMatches(actual, expected) ? "Match" : "Mismatch";
    string CompareClass(string result) => result == "Match" ? "compare-match" : result is "Mismatch" or "Possible overpayment" or "Possible underpayment" ? "compare-mismatch" : "compare-missing";
    string StatusResult(string? value) => string.IsNullOrWhiteSpace(value) ? "Not Detected" : AriesMagicAppointmentSystem.Services.OcrComparison.IsSuccessful(value) ? "Match" : "Mismatch";
    var amountResult = AriesMagicAppointmentSystem.Services.OcrComparison.AmountLabel(expectedAtUpload, ocr?.ExtractedAmount, string.IsNullOrWhiteSpace(ocr?.ProcessingError) ? ocr?.OcrConfidence : null);
    var amountDifference = ocr?.ExtractedAmount - expectedAtUpload;
    var receiverResult = ocr == null ? "Not Detected" : Compare(ocr.ExtractedReceiver, expectedReceiver);
    var statusResult = StatusResult(ocr?.ExtractedStatus);
    var assessmentTitle = ocr?.VerificationResult switch { OcrVerificationResults.LikelyMatch => "Ready for Review", _ => "Needs Manual Review" };
    var bookingCode = $"BK-{Model.Booking?.CreatedAt.Year}-{Model.BookingId:D3}";
    ViewData["Title"] = bookingCode;
    ViewData["HideWorkspaceHeading"] = true;
    ViewData["OwnerBookingBackController"] = "Payments";
    ViewData["OwnerBookingBackAction"] = "PendingVerification";
    ViewData["OwnerBookingBackLabel"] = "Back to Queue";
}
<div class="owner-financial-page owner-review-page owner-booking-detail-page" data-owner-booking-variant="payment">
    <partial name="_OwnerBookingDetailHeader" model="bookingCode" />
    @if (TempData["Success"] != null) { <div class="alert alert-success" role="status">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger" role="alert">@TempData["Error"]</div> }
    <div class="owner-booking-detail-layout">
        <div class="owner-booking-detail-main" aria-label="Payment review information">
<section class="owner-review-card"><div class="owner-section-heading"><div><h2>Booking Information</h2></div></div><dl class="owner-detail-grid"><div><dt>Client</dt><dd>@(Model.Booking?.Client?.FullName ?? "Unknown client")</dd></div><div><dt>Package</dt><dd>@(Model.Booking?.PackageName ?? Model.Booking?.Service?.Name ?? "N/A")</dd></div><div><dt>Event Date & Time</dt><dd>@(Model.Booking == null ? "N/A" : $"{Model.Booking.EventDate:MMM dd, yyyy} · {Model.Booking.StartTime:hh:mm tt}")</dd></div></dl><div class="owner-booking-proof-inside"><section class="owner-booking-proof-inline" aria-labelledby="paymentProofHeading">
            <div class="owner-section-heading"><div><h2 id="paymentProofHeading">Payment Proof</h2><a asp-action="ProofHistory" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">Submission history (@Model.ProofRevisions.Count)</a></div></div>
            <button type="button" class="owner-proof-large js-proof-preview" aria-label="Enlarge payment proof"><img src="@Url.Action("PaymentProof","Payments",new{id=Model.Id})" alt="Protected payment proof" /></button>
            <p class="owner-proof-help"><i class="bi bi-zoom-in" aria-hidden="true"></i> Click the proof to enlarge it.</p>
        </section></div></section>
@if(finance!=null){<section class="owner-review-card"><div class="owner-section-heading"><div><h2>Payment Summary</h2></div></div><div class="owner-financial-grid"><div><span>Booking Total</span><strong>₱@finance.BookingTotal.ToString("N2")</strong></div><div><span>Already Paid</span><strong>₱@finance.TotalVerifiedPayments.ToString("N2")</strong></div><div><span>Expected at Submission</span><strong>₱@expectedAtUpload.ToString("N2")</strong>@if(Model.Status==PaymentStatus.Verified){<span class="owner-cell-subtext">Owner-verified amount: ₱@Model.Amount.ToString("N2")</span>}</div><div><span>@(pending ? "Remaining Before Approval" : "Current Remaining Balance")</span><strong>₱@finance.RemainingBalance.ToString("N2")</strong></div><div class="owner-impact-highlight"><span>@(pending ? "Remaining After Approval" : "Current Remaining Balance")</span><strong>₱@afterRemaining.ToString("N2")</strong></div></div>@if(overpayment){<div class="owner-warning-box"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><div><strong>Approval blocked</strong><span>The submitted amount exceeds the remaining balance. Owner approval must respect the current financial ledger.</span></div></div>}</section>}
            <section class="owner-review-card"><div class="owner-section-heading"><div><h2>OCR Extraction</h2></div></div>
                @if(ocr==null){<div class="owner-empty-inline"><i class="bi bi-eye-slash" aria-hidden="true"></i> No OCR result is available. Review the proof manually.</div>}
                else{<dl class="owner-detail-grid"><div><dt>OCR-Detected Amount (advisory)</dt><dd>@(ocr.ExtractedAmount.HasValue?$"₱{ocr.ExtractedAmount.Value:N2}":"Not detected")</dd></div><div><dt>Amount Reliability</dt><dd>@(ocr.AmountReliability??"Legacy OCR — recheck manually")</dd></div><div><dt>Reference Number</dt><dd>@(ocr.ExtractedReferenceNumber??"Not detected")</dd></div><div><dt>Sender</dt><dd>@(ocr.ExtractedSender??"Not detected")</dd></div><div><dt>Receiver</dt><dd>@(ocr.ExtractedReceiver??"Not detected")</dd></div><div><dt>Transaction Date</dt><dd>@(ocr.ExtractedDate?.ToString("MMM dd, yyyy")??"Not detected")</dd></div><div><dt>Transaction Time</dt><dd>@(ocr.ExtractedTime?.ToString()??"Not detected")</dd></div><div><dt>Status</dt><dd>@(ocr.ExtractedStatus??"Not detected")</dd></div><div><dt>OCR Text Confidence</dt><dd>@(ocr.OcrConfidence.HasValue ? ocr.OcrConfidence.Value.ToString("0.0") + "%" : "Not available")</dd></div></dl><details class="owner-raw-details"><summary>View raw OCR text</summary><pre>@ocr.RawText</pre></details>}
            </section>

            <section class="owner-review-card"><div class="owner-section-heading"><div><h2>Expected vs Detected</h2></div></div><div class="table-responsive" role="region" aria-label="Payment comparison" tabindex="0"><table class="table owner-compare-table owner-payment-compare"><thead><tr><th scope="col">Field</th><th scope="col">Expected</th><th scope="col">Detected</th><th scope="col">Result</th></tr></thead><tbody><tr><td>Amount</td><td>₱@expectedAtUpload.ToString("N2")</td><td>@(ocr?.ExtractedAmount.HasValue==true?$"₱{ocr.ExtractedAmount.Value:N2}":"Not detected")</td><td><span class="owner-compare-result @CompareClass(amountResult)">@amountResult</span>@if (amountResult is "Possible overpayment" or "Possible underpayment") {<span class="d-block small">₱@Math.Abs(amountDifference!.Value).ToString("N2") @(amountDifference > 0 ? "above" : "below") the submitted amount. OCR is advisory.</span>}</td></tr><tr><td>Receiver</td><td>@expectedReceiver</td><td>@(ocr?.ExtractedReceiver??"Not detected")</td><td><span class="owner-compare-result @CompareClass(receiverResult)">@receiverResult</span></td></tr><tr><td>Status</td><td>Successful / Completed</td><td>@(ocr?.ExtractedStatus??"Not detected")</td><td><span class="owner-compare-result @CompareClass(statusResult)">@statusResult</span></td></tr></tbody></table></div>@if (ocr?.IsDuplicateImage == true || ocr?.IsDuplicateReference == true)
            {
                <div class="owner-warning-box" role="alert"><strong>Duplicate evidence detected.</strong>
                    Investigate the recorded transaction reference and original payment provider record before approval.
                </div>
            }
            @if (possibleOcrOverpayment)
            {
                <div class="owner-warning-box" role="alert"><strong>Possible overpayment.</strong>
                    OCR suggests more than the remaining balance. Resolve the discrepancy before any funds are credited.
                </div>
            }
<section class="owner-assessment-card"><div><h2>@assessmentTitle — OCR is not payment confirmation</h2><p>@(!string.IsNullOrWhiteSpace(ocr?.WarningSummary) ? ocr.WarningSummary : (ocr?.VerificationResult==OcrVerificationResults.LikelyMatch?"Important payment fields appear consistent. Final verification still requires Owner review.":"Review the highlighted fields and proof before deciding."))</p></div><i class="bi bi-shield-check" aria-hidden="true"></i></section></section>

<section class="owner-action-bar" aria-label="Payment verification actions">

        <div class="owner-action-buttons">
            @if(isOwner && pending){<button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#approvePaymentModal" disabled="@overpayment"><i class="bi bi-check2-circle" aria-hidden="true"></i> Approve</button><button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#evidencePaymentModal"><i class="bi bi-image" aria-hidden="true"></i> Request New Proof</button>}

        </div>
    </section>
        </div>
        <aside class="owner-booking-detail-timeline" aria-label="Booking activity history">
            @if (Model.Booking != null)
            {
                <partial name="_BookingTimeline" model="Model.Booking" />
            }
        </aside>
    </div>
</div>
<partial name="_FinancialProofViewer" />
@if(isOwner && pending){
<div class="modal fade owner-decision-modal" id="approvePaymentModal" tabindex="-1" aria-labelledby="approvePaymentModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form asp-action="Verify" method="post" class="js-owner-action-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><div class="modal-header"><h2 id="approvePaymentModalTitle" class="modal-title fs-5">Approve Payment</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><p>Confirm the actual funds received using a trusted payment transaction record. OCR cannot approve a payment.</p><label class="form-label" for="verifiedAmount">Owner-verified amount (₱)</label><input id="verifiedAmount" class="form-control mb-2" name="verifiedAmount" type="number" min="0.01" step="0.01" required value="@Model.Amount.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)" /><label class="form-label" for="verifiedReference">Owner-confirmed reference (optional)</label><input id="verifiedReference" class="form-control mb-2" name="correctedReference" maxlength="100" value="@Model.TransactionReference" /><label class="form-label" for="amountCorrectionReason">Correction reason (required when changing amount or reference)</label><textarea id="amountCorrectionReason" class="form-control mb-2" name="amountCorrectionReason" maxlength="1000" rows="2"></textarea><div class="form-check"><input class="form-check-input" type="checkbox" value="true" name="duplicateOverrideConfirmed" id="duplicateOverrideConfirmed"/><label class="form-check-label" for="duplicateOverrideConfirmed">I investigated any previously verified duplicate and authorize a justified exception.</label></div><label class="form-label mt-2" for="duplicateOverrideReason">Duplicate exception reason (required for verified duplicates)</label><textarea id="duplicateOverrideReason" class="form-control" name="duplicateOverrideReason" maxlength="500" rows="2"></textarea><div class="owner-confirm-impact"><span>Remaining Balance After Approval</span><strong>₱@afterRemaining.ToString("N2")</strong></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-success js-owner-submit" data-loading-text="Approving...">Approve Payment</button></div></form></div></div></div>
<div class="modal fade owner-decision-modal" id="evidencePaymentModal" tabindex="-1" aria-labelledby="evidencePaymentModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form asp-action="RequestAdditionalEvidence" method="post" class="js-owner-action-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><div class="modal-header"><h2 id="evidencePaymentModalTitle" class="modal-title fs-5">Request New Proof</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><label class="form-label" for="evidenceReason">What should the client provide?</label><textarea id="evidenceReason" name="reason" class="form-control" rows="3" placeholder="Example: Please upload a clearer screenshot showing the full reference number."></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-warning js-owner-submit" data-loading-text="Sending...">Request New Proof</button></div></form></div></div></div>}
@section Scripts { <script src="~/js/owner-financial.js" asp-append-version="true"></script> }
