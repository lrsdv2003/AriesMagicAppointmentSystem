@model AriesMagicAppointmentSystem.Models.Payment
@using AriesMagicAppointmentSystem.Models
@using AriesMagicAppointmentSystem.ViewModels
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "OCR-Assisted Payment Review";
    var ocr = Model.OcrVerifications.OrderByDescending(x => x.ProcessedAt).FirstOrDefault();
    var expectedReceiver = "Aries Magic";
    var finance = ViewBag.FinancialSummary as BookingFinancialSummaryViewModel;
    var isPendingReview = Model.Status == PaymentStatus.Pending;
    var isOwner = User.IsInRole("Owner");
    var afterTotalPaid = finance == null ? Model.Amount : isPendingReview ? finance.TotalVerifiedPayments + Model.Amount : finance.TotalVerifiedPayments;
    var afterRemaining = finance == null ? 0m : isPendingReview ? Math.Max(0m, finance.BookingTotal - afterTotalPaid) : finance.RemainingBalance;
    var hasOverpaymentRisk = isPendingReview && finance != null && (Model.Amount > finance.RemainingBalance || (ocr?.ExtractedAmount.HasValue == true && ocr.ExtractedAmount.Value > finance.RemainingBalance));
    var resultClass = ocr?.VerificationResult switch {
        OcrVerificationResults.LikelyMatch => "ocr-likely",
        OcrVerificationResults.PartialMatch => "ocr-partial",
        OcrVerificationResults.MismatchDetected => "ocr-mismatch",
        OcrVerificationResults.OcrFailed => "ocr-failed",
        _ => "ocr-manual"
    };
    string Match(bool ok) => ok ? "Match" : "Review";
    var paymentStatusClass = Model.Status switch { PaymentStatus.Verified => "status-verified", PaymentStatus.Rejected => "status-rejected", _ => "status-pending" };
    var paymentStatusLabel = Model.Status == PaymentStatus.Pending ? "AWAITING OWNER VERIFICATION" : Model.Status == PaymentStatus.AdditionalEvidenceRequired ? "ADDITIONAL EVIDENCE REQUIRED" : Model.Status.ToUpperInvariant();
}
<div class="page-header"><div><h1>OCR-Assisted Payment Review</h1><p class="page-subtitle">OCR findings support review only. The Owner is the sole role that can approve, reject, or request new payment evidence.</p></div><a asp-action="PendingVerification" class="btn btn-outline-secondary">Back to Queue</a></div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="ocr-workspace">
<section class="ocr-panel"><div class="d-flex justify-content-between align-items-center mb-3"><div><div class="text-muted small">Client submission</div><h3 class="mb-0">Payment #@Model.Id</h3></div><span class="status-badge @paymentStatusClass">@paymentStatusLabel</span></div>
<div class="ocr-proof-frame"><img src="@Url.Action("PaymentProof", "Payments", new { id = Model.Id })" alt="Protected payment proof" /></div>
<div class="ocr-summary-grid"><div class="ocr-metric"><small>Booking</small><strong>BK-@Model.BookingId</strong></div><div class="ocr-metric"><small>Expected amount</small><strong>₱@Model.Amount.ToString("N2")</strong></div><div class="ocr-metric"><small>Method</small><strong>@Model.PaymentMethod</strong></div></div>
<div class="ocr-client-note"><strong>@Model.Booking?.Client?.FullName</strong><br/><span>@Model.Booking?.Service?.Name · @(Model.Booking?.EventDate.ToString("MMM d, yyyy") ?? "N/A")</span></div></section>
<section class="ocr-panel">
@if (finance != null) {
<div class="mb-4"><div class="ocr-kicker">Financial impact before approval</div><h3>Balance Preview</h3>
<div class="ocr-summary-grid"><div class="ocr-metric"><small>Booking Total</small><strong>₱@finance.BookingTotal.ToString("N2")</strong></div><div class="ocr-metric"><small>Previously Verified</small><strong>₱@finance.TotalVerifiedPayments.ToString("N2")</strong></div><div class="ocr-metric"><small>Current Remaining</small><strong>₱@finance.RemainingBalance.ToString("N2")</strong></div><div class="ocr-metric"><small>Submitted Payment</small><strong>₱@Model.Amount.ToString("N2")</strong></div><div class="ocr-metric"><small>After Approval — Total Paid</small><strong>₱@afterTotalPaid.ToString("N2")</strong></div><div class="ocr-metric"><small>After Approval — Remaining</small><strong>₱@afterRemaining.ToString("N2")</strong></div></div>
@if (Model.Amount > finance.RemainingBalance || (ocr?.ExtractedAmount.HasValue == true && ocr.ExtractedAmount.Value > finance.RemainingBalance)) { <div class="ocr-warning mt-3"><i class="bi bi-exclamation-triangle"></i><span><strong>Payment amount exceeds the remaining balance. Manual review required.</strong> Approval is blocked until the discrepancy is resolved.</span></div> }
</div>
}
<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap"><div><div class="text-muted small">OCR verification assistant</div><h3>Comparison Result</h3></div><span class="ocr-badge @resultClass">@(ocr?.VerificationResult ?? "Manual Review Required")</span></div>@if (ocr == null) { <div class="ocr-warning"><i class="bi bi-exclamation-triangle"></i><span>No OCR result is available. Review the screenshot manually.</span></div> }
else {
<div class="ocr-summary-grid"><div class="ocr-metric"><small>OCR confidence</small><strong>@(ocr.OcrConfidence?.ToString("0.0") ?? "N/A")%</strong></div><div class="ocr-metric"><small>Reference</small><strong>@(ocr.ExtractedReferenceNumber ?? "Not detected")</strong></div><div class="ocr-metric"><small>Processed</small><strong>@ocr.ProcessedAt.ToLocalTime().ToString("MMM d, h:mm tt")</strong></div></div>
<table class="ocr-table"><thead><tr><th>Information</th><th>Expected</th><th>OCR detected</th><th>Result</th></tr></thead><tbody>
<tr><td>Amount</td><td>₱@Model.Amount.ToString("N2")</td><td>@(ocr.ExtractedAmount.HasValue ? $"₱{ocr.ExtractedAmount:N2}" : "Not detected")</td><td class="@(ocr.ExtractedAmount == Model.Amount ? "ocr-result-match" : "ocr-result-warning")">@Match(ocr.ExtractedAmount == Model.Amount)</td></tr>
<tr><td>Receiver</td><td>@expectedReceiver</td><td>@(ocr.ExtractedReceiver ?? "Not detected")</td><td class="@(ocr.ExtractedReceiver?.Contains(expectedReceiver, StringComparison.OrdinalIgnoreCase) == true ? "ocr-result-match" : "ocr-result-warning")">@Match(ocr.ExtractedReceiver?.Contains(expectedReceiver, StringComparison.OrdinalIgnoreCase) == true)</td></tr>
<tr><td>Payment method</td><td>@Model.PaymentMethod</td><td>@(ocr.ExtractedPaymentMethod ?? "Not detected")</td><td class="@(ocr.ExtractedPaymentMethod == Model.PaymentMethod ? "ocr-result-match" : "ocr-result-warning")">@Match(ocr.ExtractedPaymentMethod == Model.PaymentMethod)</td></tr>
<tr><td>Status</td><td>Successful / Completed</td><td>@(ocr.ExtractedStatus ?? "Not detected")</td><td>@(ocr.ExtractedStatus ?? "Manual review")</td></tr>
<tr><td>Transaction date</td><td>Near submission date</td><td>@(ocr.ExtractedDate?.ToString("MMM d, yyyy") ?? "Not detected")</td><td>Review</td></tr>
</tbody></table>
@if (!string.IsNullOrWhiteSpace(ocr.WarningSummary)) { <div class="ocr-warning-list">@foreach (var warning in ocr.WarningSummary.Split('\n', StringSplitOptions.RemoveEmptyEntries)) { <div class="ocr-warning"><i class="bi bi-exclamation-triangle"></i><span>@warning</span></div> }</div> }
<details class="mt-3"><summary>View raw OCR text</summary><div class="ocr-raw mt-2">@ocr.RawText</div></details>
}
<div class="ocr-actions">@if (isOwner && Model.Status == PaymentStatus.Pending) {
@if (!hasOverpaymentRisk) { <form asp-action="Verify" method="post" class="d-flex gap-2 align-items-start flex-wrap">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><input class="form-control" name="reviewerNote" style="min-width:240px" placeholder="Optional Owner review note"/><button class="btn btn-success"><i class="bi bi-check2-circle"></i> Approve Payment</button></form> } else { <button class="btn btn-success" disabled title="Resolve overpayment discrepancy first"><i class="bi bi-shield-exclamation"></i> Approval Blocked</button> }
<a asp-action="Reject" asp-route-id="@Model.Id" class="btn btn-danger"><i class="bi bi-x-circle"></i> Reject Payment</a>
<form asp-action="RequestAdditionalEvidence" method="post" class="d-flex gap-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><input class="form-control" name="reason" style="min-width:240px" placeholder="Reason / what should be clearer"/><button class="btn btn-warning">Request New Screenshot</button></form>
}
@if (!isOwner) { <form asp-controller="Communications" asp-action="RequestOwnerFinancialReview" method="post">@Html.AntiForgeryToken()<input type="hidden" name="paymentId" value="@Model.Id"/><button class="btn btn-warning"><i class="bi bi-person-check"></i> Message Owner</button></form> }
@if (Model.Booking != null) { <form asp-controller="Communications" asp-action="StartBookingConversation" method="post">@Html.AntiForgeryToken()<input type="hidden" name="bookingId" value="@Model.BookingId"/><button class="btn btn-outline-primary"><i class="bi bi-chat-dots"></i> Message Client</button></form> }
</div><p class="text-muted small mt-3 mb-0"><i class="bi bi-shield-check"></i> Final approval or rejection is always an Owner decision. OCR cannot prove that a screenshot or transaction is authentic.</p></section></div>