@model IEnumerable<AriesMagicAppointmentSystem.Models.RefundRequest>
@{
 Layout="_ClientHubLayout";ViewData["Title"]="My Refund Requests";
 var requests=Model.OrderByDescending(x=>x.RequestedAt).ToList();
 var canRequest=ViewBag.CanRequestRefund is bool allowed&&allowed;
}
<div class="cn-page client-final-refund-home pro-refund-home">

@if(TempData["Success"] is string success){<div class="cn-success" role="status">@success</div>}
@if(TempData["Error"] is string error){<div class="cn-error-summary" role="alert">@error</div>}
@if(canRequest)
{
 <section class="hub-card pro-refund-action" aria-labelledby="proRefundAvailable">
  <div class="pro-refund-action-icon"><i class="bi bi-wallet2" aria-hidden="true"></i></div>
  <div class="pro-refund-action-copy">
   <h2 id="proRefundAvailable">Eligible payment available</h2>
   <p>Review the eligible transaction, amount, and GCash destination before sending your request for Owner approval.</p>
  </div>
  <a asp-action="RequestRefund" class="cn-button cn-primary">Request refund <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
 </section>
}
else
{
 <section class="hub-card hub-empty pro-refund-empty" aria-labelledby="proRefundEmpty">
  <i class="bi bi-check-circle" aria-hidden="true"></i>
  <h2 id="proRefundEmpty">No refunds available right now</h2>
  <p>You currently have no payments eligible for a refund request.</p>
  <a asp-controller="Bookings" asp-action="MyBookings" class="cn-button cn-primary">View My Bookings <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
 </section>
}

</div>
