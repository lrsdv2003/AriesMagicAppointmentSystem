@model AriesMagicAppointmentSystem.ViewModels.RefundRequestViewModel

@{ Layout="_ClientHubLayout";
    ViewData["Title"] = "Request Refund";
}

<div class="client-portal-header">
    <div>
        <div class="section-kicker">Client Portal</div>
        <h1 class="client-portal-title">Request Refund</h1>
        <p class="client-portal-text">
            Refund review is available only for a system-recorded eligible payment scenario. The Owner reviews the original receipt and decides whether a refund is approved. Submission never triggers an automatic payment.
        </p>
    </div>
</div>

<div class="dashboard-panel">
    <form asp-action="RequestRefund" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="PaymentId" class="form-label">Eligible payment</label>
                <select asp-for="PaymentId" asp-items="Model.Bookings" class="form-select">
                    <option value="">-- Select an eligible payment --</option>
                </select>
                <span asp-validation-for="PaymentId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label" for="refundAmount">Refund Amount</label>
                <input id="refundAmount" value="Set to the original eligible payment amount" class="form-control" readonly />
            </div>

            <div class="col-md-6">
                <label asp-for="GCashNumber" class="form-label"></label>
                <input asp-for="GCashNumber" class="form-control" placeholder="Enter your GCash number" />
                <span asp-validation-for="GCashNumber" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="GCashAccountName" class="form-label"></label>
                <input asp-for="GCashAccountName" class="form-control" placeholder="Enter your GCash account name" />
                <span asp-validation-for="GCashAccountName" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <p class="form-text">The original payment receipt is already linked to this request and is available to the Owner through the protected proof route.</p>
            </div>

            <div class="col-12">
                <p class="form-text">Eligibility reason comes from the system’s booking and payment records and cannot be changed here.</p>
            </div>
        </div>

        <div class="upload-payment-actions mt-4">
            <button type="submit" class="btn btn-danger btn-lg">Submit Refund Request</button>
            <a asp-action="MyRefundRequests" class="btn btn-outline-secondary btn-lg">My Refund Requests</a>
            <a asp-action="Upload" class="btn btn-outline-secondary btn-lg">Back to Payment Upload</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/proof-preview.js" asp-append-version="true"></script>
}
