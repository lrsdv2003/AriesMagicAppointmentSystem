@model IEnumerable<AriesMagicAppointmentSystem.Models.Notification>
@{
    Layout = User.IsInRole("Client") ? "_ClientHubLayout" : "_DashboardLayout";
    ViewData["Title"] = "Notifications";
    var notifications = Model.OrderByDescending(x => x.CreatedAt).ToList();
    var unread = notifications.Count(x => !x.IsRead);
}
@if(User.IsInRole("Staff")) {
<section class="staff-final-notifications" aria-label="Staff notifications">
    <div class="staff-final-notifications-toolbar">
        <p><strong>@unread unread</strong> · @notifications.Count total updates, newest first</p>
        @if(unread > 0) {
            <form asp-controller="Notifications" asp-action="MarkAllRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">Mark all as read</button>
            </form>
        }
    </div>
    @if(notifications.Count == 0) {
        <div class="staff-final-notice-empty" role="status">No notifications to display.</div>
    } else {
        @foreach(var group in notifications.GroupBy(n=>n.CreatedAt.Date==DateTime.Today ? "Today" : "Earlier")) {
            <section class="staff-final-notice-group" aria-label="@group.Key notifications">
                <h2>@group.Key</h2>
                <div class="staff-final-notice-list">
                    @foreach(var item in group) { <partial name="_NotificationRow" model="item" /> }
                </div>
            </section>
        }
    }
</section>
} else if(User.IsInRole("Client") || User.IsInRole("Owner")){<partial name="_ClientNotifications" model="Model"/>}
else
{
<section class="notice-page" aria-labelledby="noticeTitle">
    <header class="notice-header">
        <div>@if(User.IsInRole("Client")){<h1 id="noticeTitle">Notifications</h1>}else{<span id="noticeTitle" class="visually-hidden">Notifications</span>}<p>@unread unread <span aria-hidden="true">&middot;</span> @notifications.Count total</p></div>
        @if (unread > 0) {
            <form asp-controller="Notifications" asp-action="MarkAllRead" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-secondary">Mark all as read</button></form>
        }
    </header>
    @if (notifications.Count == 0) {
        <p class="notice-empty" role="status">You're all caught up.</p>
    } else {
        <div class="notice-list">@foreach (var item in notifications) { <partial name="_NotificationRow" model="item" /> }</div>
    }
</section>

}
