@model IEnumerable<AriesMagicAppointmentSystem.Models.Notification>
@{
    Layout = User.IsInRole("Client") ? "_Layout" : "_DashboardLayout";
    ViewData["Title"] = "Notifications";
    var notifications = Model.OrderByDescending(x => x.CreatedAt).ToList();
    var unread = notifications.Count(x => !x.IsRead);
}
<section class="notice-page" aria-labelledby="noticeTitle">
    <header class="notice-header">
        <div><h1 id="noticeTitle">Notifications</h1><p>@unread unread <span aria-hidden="true">&middot;</span> @notifications.Count total</p></div>
        @if (unread > 0) {
            <form asp-controller="Notifications" asp-action="MarkAllRead" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-secondary">Mark all as read</button></form>
        }
    </header>
    @if (notifications.Count == 0) {
        <p class="notice-empty" role="status">You're all caught up.</p>
    } else {
        <div class="notice-list">@foreach (var item in notifications) { <partial name="_NotificationRow" model="item" /> }</div>
    }
</section>
