@model AriesMagicAppointmentSystem.ViewModels.ServiceManageViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Edit Package";
}
<div class="package-editor">

    <form asp-action="Edit" method="post" id="packageEditorForm">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="package-editor-grid">
            <div class="package-editor-sections">
                <section class="package-editor-section" aria-labelledby="packageBasic">
                    <h2 id="packageBasic">Basic Information</h2>
                    <label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" required /><span asp-validation-for="Name" class="text-danger"></span>
                    <label asp-for="Description" class="form-label mt-3">Description</label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span>
                </section>
                <section class="package-editor-section" aria-labelledby="packagePricing">
                    <h2 id="packagePricing">Pricing &amp; Duration</h2>
                    <div class="row g-3">
                        <div class="col-md-6"><label asp-for="Price" class="form-label">Package Price (PHP)</label><input asp-for="Price" type="number" min="0" max="999999" step="0.01" required class="form-control" /><span asp-validation-for="Price" class="text-danger"></span></div>
                        <div class="col-md-6"><label asp-for="DurationInHours" class="form-label">Performance Duration (Hours)</label><input asp-for="DurationInHours" type="number" min="1" max="24" step="1" required class="form-control" /><span asp-validation-for="DurationInHours" class="text-danger"></span></div>
                    </div>
                </section>
                <section class="package-editor-section" aria-labelledby="packageInclusions">
                    <div class="package-editor-section-heading"><h2 id="packageInclusions">Package Inclusions</h2><button type="button" class="btn btn-outline-primary" id="addInclusion">Add Inclusion</button></div>
                    <p class="form-text">Deduction applies when a client removes an eligible inclusion.</p>
                    <span asp-validation-for="Inclusions" class="text-danger" id="inclusionsError"></span>
                    <div id="inclusions-container">
                        @for (var i = 0; i < Model.Inclusions.Count; i++) {
                            @await Html.PartialAsync("_PackageInclusionRow", Model.Inclusions[i], new ViewDataDictionary(ViewData) { ["Index"] = i.ToString() })
                        }
                    </div>
                    <p id="inclusionFeedback" class="visually-hidden" role="status"></p>
                </section>
                <section class="package-editor-section" aria-labelledby="packageAvailability"><h2 id="packageAvailability">Availability</h2><strong>@(Model.IsArchived ? "Archived" : "Active")</strong><p class="form-text mb-0">Availability is managed separately using Archive or Restore.</p></section>
            </div>
            <aside class="package-editor-section package-editor-preview" aria-labelledby="packagePreviewTitle">
                <h2 id="packagePreviewTitle">Package Summary</h2>
                <h3 id="previewPackageName">@Model.Name</h3><strong id="previewPackagePrice">&#8369;@Model.Price.ToString("N2")</strong>
                <p id="previewPackageDuration">@Model.DurationInHours hour(s)</p><span class="staff-package-section-label">Main Inclusions</span><ul id="previewPackageInclusions"></ul>
            </aside>
        </div>
        <div class="package-editor-footer"><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button type="submit" class="btn btn-primary">Save Changes</button></div>
    </form>
    <template id="inclusionTemplate">@await Html.PartialAsync("_PackageInclusionRow", new AriesMagicAppointmentSystem.ViewModels.ServiceInclusionInputViewModel(), new ViewDataDictionary(ViewData) { ["Index"] = "__index__" })</template>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/package-editor.js" asp-append-version="true"></script>
}
