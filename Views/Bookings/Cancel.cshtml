@model AriesMagicAppointmentSystem.Models.Booking

@{
    ViewData["Title"] = "Cancel Booking";

    var packageName = string.IsNullOrWhiteSpace(Model.PackageName)
        ? Model.Service?.Name
        : Model.PackageName;
    var deadlineUtc = (DateTime)ViewBag.CancellationDeadline;
    var deadlineLocal = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(deadlineUtc, DateTimeKind.Utc), AriesMagicAppointmentSystem.Services.FeedbackPolicy.BusinessZone);
    var remaining = deadlineUtc - DateTime.UtcNow;
}

<div class="client-portal-header">
    <div>
        <div class="section-kicker">Client Portal</div>
        <h1 class="client-portal-title">Cancel Booking</h1>
        <p class="client-portal-text">
            Review the booking details below before confirming the cancellation. This action cannot be undone.
        </p>
    </div>
</div>

<div class="booking-details-layout">
    <div class="dashboard-panel">
        <div class="form-section-title mb-3">Booking Information</div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="package-meta-box h-100">
                    <span class="package-meta-label">Booking Code</span>
                    <span class="package-meta-value">BK-@Model.CreatedAt.Year-@Model.Id.ToString("D3")</span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="package-meta-box h-100">
                    <span class="package-meta-label">Package</span>
                    <span class="package-meta-value">@packageName</span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="package-meta-box h-100">
                    <span class="package-meta-label">Event Type</span>
                    <span class="package-meta-value">@Model.EventType</span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="package-meta-box h-100">
                    <span class="package-meta-label">Status</span>
                    <span class="package-meta-value">@Model.Status</span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="package-meta-box h-100">
                    <span class="package-meta-label">Event Date</span>
                    <span class="package-meta-value">@Model.EventDate.ToString("MMMM dd, yyyy")</span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="package-meta-box h-100">
                    <span class="package-meta-label">Start Time</span>
                    <span class="package-meta-value">@Model.StartTime.ToString("hh:mm tt")</span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="package-meta-box h-100">
                    <span class="package-meta-label">End Time</span>
                    <span class="package-meta-value">@Model.EndTime.ToString("hh:mm tt")</span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="package-meta-box h-100">
                    <span class="package-meta-label">Venue</span>
                    <span class="package-meta-value">@Model.PartyVenue</span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="package-meta-box h-100">
                    <span class="package-meta-label">Contact Person</span>
                    <span class="package-meta-value">@Model.ContactPerson</span>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-panel">
        <div class="form-section-title mb-3">Cancellation</div>

        <div class="booking-price-row">
            <span>Final Price</span>
            <strong>₱@Model.FinalPrice.ToString("N2")</strong>
        </div>

        <div class="booking-price-row">
            <span>Required Downpayment</span>
            <strong>₱@Model.RequiredDownpayment.ToString("N2")</strong>
        </div>

        <div class="booking-summary-note mt-4 mb-4">
            <p>This direct cancellation window ends <strong>@deadlineLocal.ToString("MMMM d, yyyy 'at' h:mm tt") Manila time</strong> (@Math.Max(0,(int)remaining.TotalHours) hours and @Math.Max(0,remaining.Minutes) minutes remaining).</p>
            <p>Cancelling will cancel this booking. If the payment qualifies, you may submit a refund request; every refund remains subject to Owner review and approval. Cancellation does not automatically issue a refund.</p>
        </div>

        <form asp-action="Cancel" method="post" id="confirmCancellationForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-danger" id="openCancellationConfirmation">Review cancellation</button>
                <a asp-action="MyBookings" class="btn btn-outline-secondary">Keep Booking</a>
            </div>
        </form>
        <dialog id="cancellationConfirmation" aria-labelledby="cancelConfirmTitle"><h2 id="cancelConfirmTitle">Cancel BK-@Model.CreatedAt.Year-@Model.Id.ToString("D3")?</h2><p>This booking will be cancelled. A qualifying payment may be submitted for Owner refund review; no refund is automatic.</p><div class="d-flex gap-2"><button type="button" id="closeCancellationConfirmation" class="btn btn-outline-secondary">Keep booking</button><button type="submit" form="confirmCancellationForm" class="btn btn-danger">Confirm cancellation</button></div></dialog>
    </div>
</div>
<script>document.getElementById('openCancellationConfirmation')?.addEventListener('click',()=>document.getElementById('cancellationConfirmation')?.showModal());document.getElementById('closeCancellationConfirmation')?.addEventListener('click',()=>document.getElementById('cancellationConfirmation')?.close());</script>
