@model AriesMagicAppointmentSystem.Models.Booking
@using AriesMagicAppointmentSystem.Models
@using AriesMagicAppointmentSystem.ViewModels
@using AriesMagicAppointmentSystem.Services
@{
    Layout = "_ClientHubLayout";
    ViewData["Title"] = "Booking details";
    var finance = ViewBag.FinancialSummary as BookingFinancialSummaryViewModel;
    var canCancel = new[] { BookingStatus.Pending, BookingStatus.AwaitingDownpayment, BookingStatus.AwaitingVerification, BookingStatus.Confirmed }.Contains(Model.Status);
    var canDirectCancel = ViewBag.CanDirectCancel is bool direct && direct;
    var directCancelDeadline = ViewBag.CancellationDeadline as DateTime?;
    var canReschedule = new[] { BookingStatus.Confirmed, BookingStatus.AwaitingDownpayment, BookingStatus.AwaitingVerification }.Contains(Model.Status);
    var pendingReschedule = Model.RescheduleRequests.Any(r => r.Status == RescheduleRequestStatus.Pending);
    var scheduleUnavailable = ViewBag.IsScheduleUnavailable is bool unavailable && unavailable;
    var travelPending = Model.TravelFeeStatus is VenueLocationPolicy.PendingReview or VenueLocationPolicy.AwaitingCustomerAcceptance;
    var canPay = VenueLocationPolicy.CanOpenPayment(Model.TravelFeeStatus) && !scheduleUnavailable && finance != null && finance.RemainingBalance > 0 && !finance.HasPendingVerification && !finance.HasAdditionalEvidenceRequired && new[] { BookingStatus.AwaitingDownpayment, BookingStatus.Confirmed, BookingStatus.Completed }.Contains(Model.Status);
}
<div class="cn-page">
<header class="cn-page-heading"><div><p class="cn-kicker">BK-@Model.CreatedAt.Year-@Model.Id.ToString("D3")</p><h1>@(Model.Status == BookingStatus.Confirmed ? "Your event is confirmed." : "Your booking.")</h1></div><a asp-action="MyBookings" class="cn-text-link">All bookings</a></header>
<div class="cn-next-step" role="status">@(scheduleUnavailable ? "This time is no longer available. Request another schedule or message Staff before making a payment." : ClientBookingPresentation.NextAction(Model,finance))</div>
<partial name="_FeedbackEntry" model="Model"/>
<div class="cn-detail-layout">
<section class="cn-event"><div class="cn-event-head"><div><span class="cn-reference">Your experience</span><h2>@Model.PackageName</h2></div><partial name="_StatusBadge" model="@(scheduleUnavailable ? "Schedule unavailable" : ClientBookingPresentation.Status(Model.Status))"/></div>
<dl class="cn-facts"><div><dt>Event date</dt><dd>@Model.EventDate.ToString("dddd, MMMM d, yyyy")</dd></div><div><dt>Time</dt><dd>@Model.StartTime.ToString("h:mm tt")–@Model.EndTime.ToString("h:mm tt") @if(Model.EndTime.Date!=Model.StartTime.Date){<span>(@Model.EndTime.ToString("MMM d"))</span>}</dd></div><div><dt>Venue</dt><dd>@Model.PartyVenue</dd></div></dl>
@if(travelPending){
<section class="cn-notice" role="status">
    <strong>@(Model.TravelFeeStatus == VenueLocationPolicy.PendingReview ? "Location needs Staff review" : "Revised travel quote awaiting your acceptance")</strong>
    <p>Venue: @Model.PartyVenue</p>
    <p>Selection: @(Model.VenueSelectionMethod ?? "Not recorded"). @(Model.VenueLatitude.HasValue && Model.VenueLongitude.HasValue ? "Customer pin provided." : "Staff will clarify the exact pin.")</p>
    @if(!string.IsNullOrWhiteSpace(Model.VenueDirections)){<p>Directions: @Model.VenueDirections</p>}
    @if(Model.TravelFeeStatus == VenueLocationPolicy.PendingReview){
        <p>Service area and travel charge are not yet confirmed. You cannot pay until Staff reviews the location and you accept any revised quote.</p>
    }else{
        <p>Staff quoted <strong>₱@Model.TravelFee.ToString("N2") travel</strong> and <strong>₱@Model.FinalPrice.ToString("N2") total</strong>. Review these details carefully before accepting.</p>
        <form asp-action="AcceptVenueQuote" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="quotedTotal" value="@Model.FinalPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"/>
            <label class="cn-check"><input type="checkbox" name="acceptTravelQuote" value="true" required/>
                <span>I accept the reviewed venue and updated travel charge for this booking.</span></label>
            <button type="submit" class="cn-button cn-primary">Accept reviewed location quote</button>
        </form>
    }
</section>}
<details class="cn-disclosure"><summary>Event & contact details</summary><dl class="cn-facts"><div><dt>Event type</dt><dd>@Model.EventType</dd></div><div><dt>Motif</dt><dd>@Model.Motif</dd></div>@if(!string.IsNullOrWhiteSpace(Model.PartyTheme)){<div><dt>Party theme</dt><dd>@Model.PartyTheme</dd></div>}@if(!string.IsNullOrWhiteSpace(Model.CelebrantName)){<div><dt>Celebrant</dt><dd>@Model.CelebrantName @if(Model.Age.HasValue){<span>· Age @Model.Age</span>}</dd></div>}<div><dt>Guests</dt><dd>@Model.PaxCount</dd></div><div><dt>Contact</dt><dd>@Model.ContactPerson · @Model.ContactNumber</dd></div></dl></details>
<details class="cn-disclosure"><summary>Manage this booking</summary>
@if(pendingReschedule){<p>A reschedule request is awaiting Staff review.</p><a asp-controller="RescheduleRequests" asp-action="MyRequests" class="cn-text-link">View request status</a>}
else if(canReschedule){<p>A schedule change needs availability and Staff approval.</p><a asp-controller="RescheduleRequests" asp-action="Create" asp-route-bookingId="@Model.Id" class="cn-text-link">Request reschedule</a>}
@if(canDirectCancel&&directCancelDeadline.HasValue){var deadline=TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(directCancelDeadline.Value,DateTimeKind.Utc),AriesMagicAppointmentSystem.Services.FeedbackPolicy.BusinessZone);<p>Direct cancellation is available until @deadline.ToString("MMM d, h:mm tt") Manila time. Refund eligibility is reviewed separately by the Owner.</p><a asp-action="Cancel" asp-route-id="@Model.Id" class="cn-text-link">Review cancellation</a>}
else if(canCancel && ViewBag.CanRequestCancellationReview is bool canRequest && canRequest){
    if(ViewBag.CancellationConversationId is int conversationId){<p>Your cancellation request has been sent. Continue the private conversation with Staff.</p><a asp-controller="Communications" asp-action="Index" asp-route-id="@conversationId" class="cn-text-link">Open cancellation conversation</a>}
    else{<p>Your 24-hour window has ended. Tell Staff why you need to cancel. This sends a private cancellation request through the existing booking conversation; it does not approve a refund.</p><form asp-controller="Communications" asp-action="RequestBookingCancellation" method="post" class="cn-support">@Html.AntiForgeryToken()<input type="hidden" name="bookingId" value="@Model.Id"/><label class="form-label" for="cancellationReviewReason">Why do you need to cancel?</label><textarea id="cancellationReviewReason" name="reason" class="form-control" minlength="8" maxlength="1000" required></textarea><button class="cn-edit" type="submit">Contact Staff</button></form>}
}
else if(canCancel){<p>A direct cancellation is not available now. Contact Staff through the private booking conversation for help.</p>}
@if(ViewBag.HasRefundEligibility is bool canRefund && canRefund){<p>A system-recorded payment scenario is eligible for Owner refund review. Approval is not automatic.</p><a asp-controller="Payments" asp-action="RequestRefund" asp-route-bookingId="@Model.Id" class="cn-text-link">Request a refund</a>}
@if(!canCancel&&!canReschedule){<p>Online changes are unavailable at this stage. Message Staff if you need help.</p>}
<div class="cn-links"><a asp-controller="RescheduleRequests" asp-action="MyRequests">Reschedule history</a><a asp-controller="Payments" asp-action="MyRefundRequests">Refund history</a></div>
</details>
@if(ViewBag.CancellationConversationId is not int){<form asp-controller="Communications" asp-action="StartBookingConversation" method="post" class="cn-support">@Html.AntiForgeryToken()<input type="hidden" name="bookingId" value="@Model.Id"/><button class="cn-edit" type="submit">Message Staff about this event</button></form>}
</section>
<aside class="cn-balance"><h2>Payment summary</h2><dl><div><dt>Required downpayment</dt><dd>₱@((finance?.RequiredDownpayment ?? Model.RequiredDownpayment).ToString("N2"))</dd></div><div><dt>Booking total</dt><dd>@(Model.TravelFeeStatus == VenueLocationPolicy.PendingReview ? "Base estimate + travel pending" : $"₱{(finance?.BookingTotal ?? Model.FinalPrice):N2}")</dd></div><div><dt>Verified payments</dt><dd>₱@((finance?.TotalVerifiedPayments ?? 0).ToString("N2"))</dd></div><div class="cn-total"><dt>Remaining balance</dt><dd>₱@((finance?.RemainingBalance ?? Model.FinalPrice).ToString("N2"))</dd></div></dl><p class="cn-help">@(finance?.PaymentStatus ?? "Unpaid"). Only verified payments reduce your balance.</p>
@if(finance?.TotalVerifiedPayments>0&&finance.RemainingBalance>0){<p class="cn-help">Your initial payment is verified. The remaining balance of ₱@finance.RemainingBalance.ToString("N2") is due on the day of your event.</p>}else if(finance?.IsFullyPaid==true){<p class="cn-help">Your booking has been fully paid. No remaining balance is due.</p>}
@if(canPay){<a asp-controller="Payments" asp-action="Upload" asp-route-bookingId="@Model.Id" class="cn-button cn-primary cn-balance-action">Upload payment proof</a>}
@if(finance?.HasAdditionalEvidenceRequired == true){<a asp-controller="Payments" asp-action="MyUploads" class="cn-button cn-primary cn-balance-action">Replace payment proof</a>}
<a asp-controller="Payments" asp-action="MyUploads" class="cn-text-link">View payment activity</a>
</aside>
</div>
</div>
