@model AriesMagicAppointmentSystem.Models.Booking
@using AriesMagicAppointmentSystem.Models
@using AriesMagicAppointmentSystem.Services
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = $"BK-{Model.CreatedAt.Year}-{Model.Id:D3}";
    var isPending = User.IsInRole("Staff") && Model.Status == BookingStatus.Pending;
    var changeProposal = ViewBag.PendingConfirmedChange as ConfirmedBookingChangeProposal;
    var canProposeChange = User.IsInRole("Staff")
        && ConfirmedBookingChangePolicy.MayStart(Model,
            TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, FeedbackPolicy.BusinessZone));
    var verifiedInitial = Model.Payments.Where(p => p.Status == PaymentStatus.Verified && p.InitialVerificationAtUtc.HasValue)
        .OrderBy(p => p.InitialVerificationAtUtc).FirstOrDefault();
    var hasClientCancelRequest = User.IsInRole("Staff")
        && ViewBag.CancellationRequestLinked is bool linked && linked
        && Model.CancellationRequestAtUtc.HasValue;
    var canStaffCancel = hasClientCancelRequest
        && verifiedInitial?.InitialVerificationAtUtc is DateTime verifiedUtc
        && DateTime.UtcNow >= verifiedUtc.AddHours(24)
        && Model.Status is BookingStatus.Confirmed or BookingStatus.AwaitingDownpayment or BookingStatus.AwaitingVerification
        && !Model.RefundEligible
        && !Model.Payments.Any(p => p.Status is PaymentStatus.Pending or PaymentStatus.AdditionalEvidenceRequired);

}
<div class="staff-booking-page staff-booking-details-page staff-unified-booking-details">
    <header class="staff-final-booking-hero staff-unified-booking-header">
        <h1>BK-@Model.CreatedAt.Year-@Model.Id.ToString("D3")</h1>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Requests</a>
    </header>
    @if (TempData["Error"] is string bookingError) { <div class="alert alert-danger" role="alert">@bookingError</div> }
    @if (TempData["Success"] is string bookingSuccess) { <div class="alert alert-success" role="status">@bookingSuccess</div> }
    <div class="staff-final-booking-shell">
        <div class="staff-final-booking-primary" aria-label="Booking information and actions">
            <partial name="_StaffBookingDetailsSections" model="Model" />
    @if (isPending || Model.Status is BookingStatus.AwaitingDownpayment or BookingStatus.AwaitingVerification ||
         (Model.Status == BookingStatus.Confirmed && User.IsInRole("Staff") && (changeProposal != null || canProposeChange)) ||
         canStaffCancel || !string.IsNullOrWhiteSpace(Model.InternalNotes))
    {
    <section class="dashboard-panel staff-decision-panel staff-unified-actions" aria-label="Booking actions and staff review">
        @if (isPending)
        {
            <div class="staff-decision-actions">
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#declineBookingModal">
                    <i class="bi bi-x-lg" aria-hidden="true"></i> Decline Booking
                </button>
                <button type="button" class="btn btn-success staff-unified-approve" data-bs-toggle="modal" data-bs-target="#approveBookingModal"
                    disabled="@(Model.TravelFeeStatus != null && !VenueLocationPolicy.CanOpenPayment(Model.TravelFeeStatus))">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Approve Booking
                </button>
            </div>
        }
        else if (Model.Status is BookingStatus.AwaitingDownpayment or BookingStatus.AwaitingVerification)
        {
            <p class="staff-unified-status-message" role="status">@(Model.Status == BookingStatus.AwaitingDownpayment ? "Awaiting Client payment." : "Awaiting Owner payment verification.")</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.InternalNotes))
        {
            <section class="staff-unified-private-notes" aria-labelledby="internalNotesTitle">
                <h2 id="internalNotesTitle"><i class="bi bi-journal-text" aria-hidden="true"></i> Staff Review Notes</h2>
                <div class="staff-note-block"><pre>@Model.InternalNotes</pre></div>
            </section>
        }
    @if(Model.Status == BookingStatus.Confirmed && User.IsInRole("Staff")){
      @if(changeProposal != null){
        <section class="booking-change-pending" aria-labelledby="staffChangePending">
          <h2 id="staffChangePending">Awaiting Client approval</h2>
          <p>Proposal sent @changeProposal.ProposedAtUtc.ToString("MMM d, yyyy") (UTC). The confirmed details and all verified payments remain unchanged until Client acceptance.</p>
          <dl>
            <div><dt>Proposed package</dt><dd>@changeProposal.NewPackageName</dd></div>
            <div><dt>Proposed venue</dt><dd>@changeProposal.NewVenue</dd></div>
            <div><dt>Revised total</dt><dd>&#8369;@changeProposal.NewFinalPrice.ToString("N2")</dd></div>
            <div><dt>Verified payments</dt><dd>&#8369;@changeProposal.VerifiedPaymentsAtProposal.ToString("N2")</dd></div>
            <div><dt>New balance</dt><dd>&#8369;@changeProposal.NewRemainingBalance.ToString("N2")</dd></div>
            @if(!string.IsNullOrWhiteSpace(changeProposal.Reason)){<div><dt>Reason</dt><dd>@changeProposal.Reason</dd></div>}
          </dl>
          <form asp-controller="BookingChanges" asp-action="Withdraw" method="post" class="booking-change-actions">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id"/>
            <input type="hidden" name="token" value="@changeProposal.Token"/>
            <button type="submit" class="btn btn-outline-secondary">Withdraw proposal</button>
          </form>
        </section>
      }else if(canProposeChange){
        <div class="booking-change-pending">
          <a class="btn btn-primary" asp-controller="BookingChanges" asp-action="Edit" asp-route-id="@Model.Id">
             <i class="bi bi-pencil-square" aria-hidden="true"></i> Edit Booking Venue / Package
          </a>
        </div>
      }
    }
    @if(canStaffCancel){
      <div class="staff-round2-cancel-review">
        <h3>Client cancellation review</h3>
        <p>Client request received @Model.CancellationRequestAtUtc!.Value.ToString("u"). Reason: @Model.CancellationRequestReason</p>
        <p>Record why this Client request is valid. Cancellation creates eligibility for Owner refund review, but does not approve or issue a refund.</p>
        <form asp-action="CancelAfterReview" method="post" id="staffCancellationForm">
          @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/>
          <label class="form-label" for="staffCancelReason">Required Staff decision reason</label>
          <textarea class="form-control" id="staffCancelReason" name="reason" minlength="8" maxlength="1000" required></textarea>
          <button class="btn btn-danger mt-2" type="button" id="reviewStaffCancellation">Cancel Booking</button>
        </form>
        <dialog id="staffCancellationConfirmation" aria-labelledby="staffCancellationConfirmTitle">
          <h3 id="staffCancellationConfirmTitle">Cancel BK-@Model.CreatedAt.Year-@Model.Id.ToString("D3")?</h3>
          <p>Owner refund review remains separate. This action cannot approve or issue a refund.</p>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" id="keepStaffBooking">Keep booking</button>
            <button class="btn btn-danger" type="submit" form="staffCancellationForm">Confirm cancellation review</button>
          </div>
        </dialog>
      </div>
    }
    </section>
    }
        </div>
        <aside class="staff-final-booking-timeline" aria-label="Booking activity history">
            <partial name="_BookingTimeline" model="Model" />
        </aside>
    </div>
</div>
@if (User.IsInRole("Owner")) { <partial name="_OwnerBookingFinancialDetails" model="Model" /> }
@if (isPending)
{
    <div class="modal fade staff-booking-modal" id="approveBookingModal" tabindex="-1" aria-labelledby="approveBookingModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="Approve" method="post" class="js-booking-decision-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="modal-header"><h2 class="modal-title fs-5" id="approveBookingModalLabel">Approve Booking</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                    <div class="modal-body">
                        <p>Are you sure you want to approve this booking?</p>
                        <label for="approveInternalNote" class="form-label">Internal Note <span class="text-muted">— Optional</span></label>
                        <textarea id="approveInternalNote" name="internalNote" class="form-control" rows="4" maxlength="1000" placeholder="Add an internal operational note if needed."></textarea>
                        <div class="form-text">Internal notes are not shown to the client.</div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-success js-decision-submit" data-loading-text="Approving...">Approve Booking</button></div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade staff-booking-modal" id="declineBookingModal" tabindex="-1" aria-labelledby="declineBookingModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="Decline" method="post" class="js-booking-decision-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="modal-header"><h2 class="modal-title fs-5" id="declineBookingModalLabel">Decline Booking</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                    <div class="modal-body">
                        <p>Are you sure you want to decline this booking?</p>
                        <label for="declineInternalNote" class="form-label">Reason / Internal Note <span class="text-muted">— Optional</span></label>
                        <textarea id="declineInternalNote" name="internalNote" class="form-control" rows="4" maxlength="1000" placeholder="Add an internal reason or operational note if needed."></textarea>
                        <div class="form-text">This note remains internal and is not automatically shown to the client.</div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger js-decision-submit" data-loading-text="Declining...">Decline Booking</button></div>
                </form>
            </div>
        </div>
    </div>
}



@section Scripts {
<script>
    document.getElementById('reviewStaffCancellation')?.addEventListener('click', () => {
        const form = document.getElementById('staffCancellationForm');
        const reason = document.getElementById('staffCancelReason');
        if (!reason.checkValidity()) { reason.reportValidity(); return; }
        document.getElementById('staffCancellationConfirmation')?.showModal();
    });
    document.getElementById('keepStaffBooking')?.addEventListener('click', () => document.getElementById('staffCancellationConfirmation')?.close());
    document.querySelectorAll('.js-booking-decision-form').forEach(form => form.addEventListener('submit', () => {
        const submit = form.querySelector('.js-decision-submit');
        if (!submit || submit.disabled) return;
        submit.disabled = true;
        submit.setAttribute('aria-disabled', 'true');
        submit.textContent = submit.dataset.loadingText || 'Processing...';
    }));
</script>
}
