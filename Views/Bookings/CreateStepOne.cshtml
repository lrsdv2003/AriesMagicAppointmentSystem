@model AriesMagicAppointmentSystem.ViewModels.BookingStepOneViewModel

@{

    ViewData["Title"] = "Create Booking - Step 1";

    var eventTypes = ViewBag.EventTypes as List<string> ?? new List<string>();

    var unavailableDates = ViewBag.UnavailableDates as List<string> ?? new List<string>();

    var unavailableDatesJson = System.Text.Json.JsonSerializer.Serialize(unavailableDates);

    ViewData["WizardPhysicalStep"] = 1;

    ViewData["WizardSubStep"] = 1;

}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

<partial name="_BookingWizardTracker" />

<div class="page-header">

    <div>

        <h1>Create Booking</h1>

        <p class="page-subtitle">

            Tell us about your event, then choose a schedule and package.

        </p>

    </div>

</div>

<div class="dashboard-panel">

    <form asp-action="CreateStepOne" method="post" id="stepOneForm">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- PANEL A: EVENT DETAILS -->

        <div class="am-panel" id="panelEventDetails" data-panel-index="1">

            <div class="form-section-title mb-3">

                Event Details

            </div>

            <div class="row g-3">

                <div class="col-md-6">

                    <label asp-for="EventType" class="form-label"></label>

                    <select asp-for="EventType"

                            class="form-select"

                            id="EventType"

                            required>

                        <option value="">-- Select Event Type --</option>

                        @foreach (var eventType in eventTypes)

                        {

                            <option value="@eventType">@eventType</option>

                        }

                    </select>

                    <span asp-validation-for="EventType"

                          class="text-danger"></span>

                </div>

                <div class="col-md-6">

                    <label asp-for="Motif" class="form-label"></label>

                    <input asp-for="Motif"

                           class="form-control"

                           placeholder="Enter event motif"

                           required />

                    <span asp-validation-for="Motif"

                          class="text-danger"></span>

                </div>

                <div class="col-md-6" id="partyThemeField">

                    <label asp-for="PartyTheme" class="form-label"></label>

                    <input asp-for="PartyTheme"

                           class="form-control"

                           placeholder="Enter party theme" />

                    <span asp-validation-for="PartyTheme"

                          class="text-danger"></span>

                </div>

                <!-- VENUE -->

                <div class="col-md-6">

                    <label asp-for="PartyVenue" class="form-label"></label>

                    <div class="input-group">

                        <input asp-for="PartyVenue"

                               class="form-control"

                               id="PartyVenue"

                               placeholder="Search venue or full address"

                               required />

                        <button type="button"

                                class="btn btn-outline-primary"

                                id="searchVenueBtn">

                            Search

                        </button>

                    </div>

                    <small class="text-muted">

                        Search and select the exact venue so the system can

                        calculate the service distance.

                    </small>

                    <div id="venueSearchResults"

                         class="list-group mt-2">

                    </div>

                    <span asp-validation-for="PartyVenue"

                          class="text-danger"></span>

                    <!-- Hidden coordinates -->

                    <input asp-for="VenueLatitude"

                           type="hidden"

                           id="VenueLatitude" />

                    <input asp-for="VenueLongitude"

                           type="hidden"

                           id="VenueLongitude" />

                    <div id="venueLocationStatus" class="mt-2"></div>

                    <div id="venueDistancePreview" class="mt-3"></div>

                </div>

                <div class="col-md-6"

                     id="celebrantNameField">

                    <label asp-for="CelebrantName"

                           class="form-label"></label>

                    <input asp-for="CelebrantName"

                           class="form-control"

                           placeholder="Enter celebrant name" />

                    <span asp-validation-for="CelebrantName"

                          class="text-danger"></span>

                </div>

                <div class="col-md-3"

                     id="ageField">

                    <label asp-for="Age"

                           class="form-label"></label>

                    <input asp-for="Age"

                           class="form-control"

                           placeholder="Age" />

                    <span asp-validation-for="Age"

                          class="text-danger"></span>

                </div>

                <div class="col-md-3">

                    <label asp-for="PaxCount"

                           class="form-label"></label>

                    <input asp-for="PaxCount"

                           class="form-control"

                           placeholder="Number of guests"

                           required />

                    <span asp-validation-for="PaxCount"

                          class="text-danger"></span>

                </div>

            </div>

            <div class="am-panel-nav">

                <span></span>

                <button type="button"

                        class="btn btn-primary"

                        id="goToScheduleBtn"

                        disabled

                        aria-disabled="true">

                    Continue to Schedule

                </button>

            </div>

        </div>

        <!-- PANEL B: SCHEDULE & CONTACT -->

        <div class="am-panel"

             id="panelSchedule"

             data-panel-index="2"

             hidden>

            <div class="form-section-title mb-2">

                Availability Guide

            </div>

            <p class="availability-help mb-3">

                Some dates may be unavailable because they are already full

                or blocked by the admin.

                All packages last

                <strong>3 hours</strong>

                and include a required

                <strong>1-hour buffer</strong>

                after the event.

            </p>

            <div class="availability-legend mb-4">

                <div class="availability-legend-item">

                    <span class="availability-dot available"></span>

                    <span>Available date</span>

                </div>

                <div class="availability-legend-item">

                    <span class="availability-dot unavailable"></span>

                    <span>Unavailable date</span>

                </div>

            </div>

            <div id="dateAvailabilityAlert"

                 class="alert alert-warning d-none mb-3">

                This selected date is unavailable for booking because it is

                either blocked or already at full capacity.

            </div>

            <div id="dateSlotsInfo"

                 class="alert alert-info d-none mb-3">

            </div>

            <div id="timeConflictAlert"

                 class="alert alert-danger d-none mb-3">

                The selected start time conflicts with an existing booking

                schedule.

            </div>

            <div id="unavailableTimeRangesBox"

                 class="dashboard-panel mt-3 d-none">

                <div class="time-range-box-title">

                    Unavailable Time Ranges

                </div>

                <p class="availability-help mb-2">

                    These time ranges are unavailable because of confirmed

                    bookings and the required 1-hour buffer.

                </p>

                <div id="unavailableTimeRangesList"

                     class="time-range-chip-list">

                </div>

            </div>

            <div class="row g-3 mt-1">

                <div class="col-md-6">

                    <label asp-for="EventDate"

                           class="form-label"></label>

                    <input asp-for="EventDate"

                           type="text"

                           class="form-control"

                           id="eventDateInput"

                           autocomplete="off"

                           required />

                    <span asp-validation-for="EventDate"

                          class="text-danger"></span>

                </div>

                <div class="col-md-6">

                    <label asp-for="StartTime"

                           class="form-label"></label>

                    <input asp-for="StartTime"

                           type="time"

                           class="form-control"

                           id="startTimeInput"

                           required />

                    <span asp-validation-for="StartTime"

                          class="text-danger"></span>

                </div>

                <div class="col-md-6">

                    <label asp-for="ContactPerson"

                           class="form-label"></label>

                    <input asp-for="ContactPerson"

                           class="form-control"

                           placeholder="Enter contact person"

                           required />

                    <span asp-validation-for="ContactPerson"

                          class="text-danger"></span>

                </div>

                <div class="col-md-6">

                    <label asp-for="ContactNumber"

                           class="form-label"></label>

                    <input asp-for="ContactNumber"

                           class="form-control"

                           placeholder="Enter contact number"

                           required />

                    <span asp-validation-for="ContactNumber"

                          class="text-danger"></span>

                </div>

            </div>

            <div class="am-panel-nav">

                <button type="button"

                        class="btn btn-outline-secondary"

                        id="backToEventDetailsBtn">

                    Back

                </button>

                <button type="submit"

                        class="btn btn-primary"

                        id="nextStepBtn">

                    Next Step

                </button>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    <!-- VENUE SEARCH + SERVICEABILITY -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const venueInput = document.getElementById("PartyVenue");

            const searchBtn = document.getElementById("searchVenueBtn");

            const results = document.getElementById("venueSearchResults");

            const latInput = document.getElementById("VenueLatitude");

            const lonInput = document.getElementById("VenueLongitude");

            const status = document.getElementById("venueLocationStatus");

            const distancePreview = document.getElementById("venueDistancePreview");

            if (!searchBtn || !venueInput)

                return;

            let venueServiceabilityState = "NO_LOCATION";
            window.venueServiceabilityState = venueServiceabilityState;
            let venueCheckSequence = 0;

            const goToScheduleBtn = document.getElementById("goToScheduleBtn");
            const serviceabilityUrl = '@Url.Action("CheckVenueServiceability", "Bookings")';
            const eventDateInput = document.getElementById("eventDateInput");
            const startTimeInput = document.getElementById("startTimeInput");

            function escapeHtml(value) {
                return String(value ?? "").replace(/[&<>"]/g, character => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[character]);
            }

            function formatTravelTime(minutes) {
                const totalMinutes = Math.max(0, Math.round(Number(minutes) || 0));
                const hours = Math.floor(totalMinutes / 60);
                const remainingMinutes = totalMinutes % 60;
                if (!hours) return `${totalMinutes} minutes`;
                return remainingMinutes ? `${hours} hr ${remainingMinutes} min` : `${hours} hr`;
            }

            function setVenueGateState(state) {
                venueServiceabilityState = state;
                window.venueServiceabilityState = state;

                if (!goToScheduleBtn) return;

                const canProceed =
                    state === "SERVICEABLE" ||
                    state === "FOR_STAFF_REVIEW";

                goToScheduleBtn.disabled = !canProceed;
                goToScheduleBtn.setAttribute("aria-disabled", canProceed ? "false" : "true");
            }

            function clearVenueSelection(message) {
                latInput.value = "";
                lonInput.value = "";
                venueServiceabilityState = "NO_LOCATION";
                setVenueGateState("NO_LOCATION");
                distancePreview.innerHTML = "";
                status.innerHTML = "";
                if (message) {
                    status.innerHTML = `<div class="alert alert-warning py-2 mb-0">${message}</div>`;
                }
            }

            function showCheckingState() {
                setVenueGateState("CHECKING");
                status.innerHTML = `
                    <div class="venue-checking-state" role="status">
                        <span class="venue-checking-spinner" aria-hidden="true"></span>
                        <div><strong>Checking venue...</strong><span>Calculating distance and travel availability</span></div>
                    </div>`;
                distancePreview.innerHTML = '';
            }

            function showServerServiceability(result) {
                const distance = Number(result.distanceKm);
                const fee = Number(result.travelFee || 0);
                const formattedDistance = distance.toLocaleString("en-PH", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                const formattedFee = fee.toLocaleString("en-PH", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                const estimatedTravelTime = Number(result.estimatedTravelTimeMinutes || 0);
                const availableTravelTime = result.availableTravelTimeMinutes;
                const state = result.status;
                const statusLabel = state === "FOR_STAFF_REVIEW" ? "FOR STAFF REVIEW" : state === "SERVICEABLE" ? "SERVICEABLE" : "NOT SERVICEABLE";
                const statusClass = state === "FOR_STAFF_REVIEW" ? "venue-status-review" : state === "SERVICEABLE" ? "venue-status-serviceable" : "venue-status-unavailable";
                const feeDisplay = fee > 0 ? `₱${formattedFee}` : "No Additional Travel Fee";
                const startingPoint = escapeHtml(result.startingPointName || "Aries Magic Base");
                const destination = escapeHtml(result.displayName || venueInput.value);
                const reason = escapeHtml(result.serviceabilityReason || "This venue cannot currently be serviced.");
                const hasAvailableTravelTime = result.usesPreviousEventLocation && Number.isFinite(Number(availableTravelTime));
                const travelBuffer = hasAvailableTravelTime ? Number(availableTravelTime) - estimatedTravelTime : null;
                const statusIcon = state === "FOR_STAFF_REVIEW" ? "bi-exclamation-triangle-fill" : state === "SERVICEABLE" ? "bi-check-circle-fill" : "bi-x-circle-fill";
                const statusSummary = state === "FOR_STAFF_REVIEW"
                    ? "This venue requires staff review before approval."
                    : state === "SERVICEABLE"
                        ? "The selected venue is within the current serviceable conditions."
                        : reason;
                if (state === "SERVICEABLE") {
                    setVenueGateState("SERVICEABLE");
                    status.innerHTML = '<div class="venue-verified-state"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Venue verified</div>';
                } else if (state === "FOR_STAFF_REVIEW") {
                    setVenueGateState("FOR_STAFF_REVIEW");
                    status.innerHTML = '<div class="venue-verified-state venue-verified-state-review"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Venue verified — staff review required</div>';
                } else {
                    setVenueGateState("NOT_SERVICEABLE");
                    status.innerHTML = '<div class="venue-verified-state venue-verified-state-unavailable"><i class="bi bi-x-circle-fill" aria-hidden="true"></i> Venue cannot be used for this booking</div>';
                }

                distancePreview.innerHTML = `
                    <section class="venue-travel-overview" aria-label="Venue travel overview">
                        <div class="venue-overview-heading"><i class="bi bi-signpost-split-fill" aria-hidden="true"></i><div><span>Venue travel overview</span><strong>Travel details for your selected venue</strong></div></div>
                        <div class="venue-serviceability ${statusClass}">
                            <i class="bi ${statusIcon}" aria-hidden="true"></i>
                            <div><span>Venue serviceability</span><strong>${statusLabel}</strong><p>${statusSummary}</p></div>
                        </div>
                        <div class="venue-journey">
                            <div class="venue-journey-stop"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i><div><span>${result.usesPreviousEventLocation ? "Previous event" : "Starting point"}</span><strong title="${startingPoint}">${startingPoint}</strong></div></div>
                            <div class="venue-journey-line" aria-hidden="true"><i class="bi bi-arrow-down"></i></div>
                            <div class="venue-journey-stop venue-journey-destination"><i class="bi bi-flag-fill" aria-hidden="true"></i><div><span>${result.usesPreviousEventLocation ? "New client venue" : "Destination"}</span><strong title="${destination}">${destination}</strong></div></div>
                        </div>
                        <div class="venue-metric-grid">
                            <div class="venue-metric"><span>Distance</span><strong>${formattedDistance} <small>km</small></strong></div>
                            <div class="venue-metric"><span>Estimated travel time</span><strong>${formatTravelTime(estimatedTravelTime)}</strong></div>
                            ${hasAvailableTravelTime ? `<div class="venue-metric"><span>Available travel time</span><strong>${formatTravelTime(availableTravelTime)}</strong></div>` : ""}
                            ${travelBuffer !== null && travelBuffer >= 0 ? `<div class="venue-metric venue-metric-buffer"><span>Travel buffer</span><strong>${formatTravelTime(travelBuffer)}</strong></div>` : ""}
                        </div>
                        <div class="venue-service-details">
                            <div><span>Service zone</span><strong>${escapeHtml(result.serviceZone || "Not available")}</strong></div>
                            <div><span>Travel fee</span><strong>${feeDisplay}</strong></div>
                        </div>
                        <p class="venue-travel-context"><i class="bi bi-info-circle-fill" aria-hidden="true"></i>${result.usesPreviousEventLocation ? (state === "NOT_SERVICEABLE" && hasAvailableTravelTime && travelBuffer < 0 ? "There is not enough available travel time between the previous event and this appointment." : `${formatTravelTime(availableTravelTime)} are available between the previous event and this appointment.`) : `Travel will begin from ${startingPoint}.`}</p>
                        ${state === "NOT_SERVICEABLE" ? `<div class="venue-service-reason"><i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i><div><strong>Reason</strong><span>${reason}</span></div></div>` : ""}
                    </section>`;
            }

            async function verifySelectedVenue(displayName) {
                const sequence = ++venueCheckSequence;
                showCheckingState();

                try {
                    const token = document.querySelector('#stepOneForm input[name="__RequestVerificationToken"]')?.value;
                    const body = new URLSearchParams();
                    body.append("partyVenue", displayName);
                    if (eventDateInput?.value) body.append("eventDate", eventDateInput.value);
                    if (startTimeInput?.value) body.append("startTime", startTimeInput.value);

                    const response = await fetch(serviceabilityUrl, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
                            "RequestVerificationToken": token || ""
                        },
                        body
                    });

                    const result = await response.json();
                    if (sequence !== venueCheckSequence) return;

                    if (!response.ok || !result.success) {
                        setVenueGateState("NOT_VERIFIED");
                        status.innerHTML = '<div class="venue-verification-error"><i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i><div><strong>Unable to verify venue</strong><span>Please select the venue again or verify the address.</span></div></div>';
                        distancePreview.innerHTML = "";
                        latInput.value = "";
                        lonInput.value = "";
                        return;
                    }

                    // Replace client values with the server-resolved coordinates/result.
                    venueInput.value = result.displayName;
                    latInput.value = result.latitude;
                    lonInput.value = result.longitude;
                    showServerServiceability(result);
                } catch (error) {
                    if (sequence !== venueCheckSequence) return;
                    console.error(error);
                    setVenueGateState("NOT_VERIFIED");
                    status.innerHTML = '<div class="venue-verification-error"><i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i><div><strong>Unable to verify venue</strong><span>Please select the venue again or verify the address.</span></div></div>';
                    distancePreview.innerHTML = "";
                }
            }

            setVenueGateState("NO_LOCATION");
            status.innerHTML = '<div class="alert alert-warning py-2 mb-0">Please select an event venue to continue.</div>';

            // Any manual edit invalidates the previous venue validation immediately.
            venueInput.addEventListener("input", function () {
                venueCheckSequence++;
                clearVenueSelection();
                results.innerHTML = "";
            });

            function refreshVenueServiceabilityForSchedule() {
                if (venueInput.value && latInput.value && lonInput.value) {
                    verifySelectedVenue(venueInput.value);
                }
            }

            eventDateInput?.addEventListener("change", refreshVenueServiceabilityForSchedule);
            startTimeInput?.addEventListener("change", refreshVenueServiceabilityForSchedule);

            /*

             * VENUE SEARCH

             */

            searchBtn.addEventListener(

                "click",

                async function () {

                    const query =

                        venueInput.value.trim();

                    if (!query)

                        return;

                    searchBtn.disabled = true;

                    searchBtn.textContent =

                        "Searching...";

                    results.innerHTML = "";

                    clearVenueSelection();
                    status.innerHTML = "";
                    distancePreview.innerHTML = "";

                    try {

                        const response =

                            await fetch(

                                `@Url.Action("SearchVenue", "Bookings")?query=${encodeURIComponent(query)}`

                            );

                        if (!response.ok)

                            throw new Error(

                                "Search failed"

                            );

                        const items =

                            await response.json();

                        if (!items.length) {

                            results.innerHTML = `

                                <div class="alert alert-warning mb-0">

                                    No matching venue was found.

                                    Try a more complete address.

                                </div>

                            `;

                            return;

                        }

                        /*

                         * DISPLAY SEARCH RESULTS

                         */

                        items.forEach(

                            item => {

                                const button =

                                    document.createElement(

                                        "button"

                                    );

                                button.type =

                                    "button";

                                button.className =

                                    "list-group-item list-group-item-action";

                                button.textContent =

                                    item.displayName;
                                button.addEventListener("click", function () {

                                    venueInput.value = item.displayName;

                                    latInput.value = item.latitude;

                                    lonInput.value = item.longitude;

                                    results.innerHTML = "";

                                    status.innerHTML =

                                        '<div class="alert alert-success py-2 mb-0">' +

                                        '✓ Venue location selected and coordinates captured.' +

                                        '</div>';

                                    verifySelectedVenue(item.displayName);

                                });

                                results.appendChild(button);

                            }

                        );

                    }

                    catch (error) {

                        console.error(error);

                        results.innerHTML = `

                            <div class="alert alert-danger mb-0">

                                Venue search is temporarily unavailable.

                                You can try again.

                            </div>

                        `;

                    }

                    finally {

                        searchBtn.disabled =

                            false;

                        searchBtn.textContent =

                            "Search";

                    }

                }

            );

        });

    </script>

    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>

    <!-- EXISTING DATE / AVAILABILITY / WIZARD LOGIC -->

    <script>

        document.addEventListener(

            "DOMContentLoaded",

            function () {

                const unavailableDates =

                    @Html.Raw(unavailableDatesJson);

                const alertBox =

                    document.getElementById(

                        "dateAvailabilityAlert"

                    );

                const slotsInfo =

                    document.getElementById(

                        "dateSlotsInfo"

                    );

                const timeConflictAlert =

                    document.getElementById(

                        "timeConflictAlert"

                    );

                const nextBtn =

                    document.getElementById(

                        "nextStepBtn"

                    );

                const dateInput =

                    document.getElementById(

                        "eventDateInput"

                    );

                const startTimeInput =

                    document.getElementById(

                        "startTimeInput"

                    );

                const timeRangesBox =

                    document.getElementById(

                        "unavailableTimeRangesBox"

                    );

                const timeRangesList =

                    document.getElementById(

                        "unavailableTimeRangesList"

                    );

                const eventTypeInput =

                    document.getElementById(

                        "EventType"

                    );

                const partyThemeField =

                    document.getElementById(

                        "partyThemeField"

                    );

                const celebrantNameField =

                    document.getElementById(

                        "celebrantNameField"

                    );

                const ageField =

                    document.getElementById(

                        "ageField"

                    );

                let currentUnavailableRanges =

                    [];

                /*

                 * SHOW FIELD

                 */

                function showField(field) {

                    field.classList.remove(

                        "d-none"

                    );

                    const input =

                        field.querySelector(

                            "input, select, textarea"

                        );

                    if (input) {

                        input.disabled =

                            false;

                    }

                }

                /*

                 * HIDE FIELD

                 */

                function hideField(field) {

                    field.classList.add(

                        "d-none"

                    );

                    const input =

                        field.querySelector(

                            "input, select, textarea"

                        );

                    if (input) {

                        input.disabled =

                            true;

                        input.value =

                            "";

                    }

                }

                /*

                 * EVENT-SPECIFIC FIELDS

                 */

                function updateEventSpecificFields() {

                    const selectedEvent =

                        eventTypeInput.value;

                    showField(

                        partyThemeField

                    );

                    showField(

                        celebrantNameField

                    );

                    showField(

                        ageField

                    );

                    if (

                        selectedEvent ===

                        "Birthday"

                    ) {

                        showField(

                            partyThemeField

                        );

                        showField(

                            celebrantNameField

                        );

                        showField(

                            ageField

                        );

                    }

                    else if (

                        selectedEvent ===

                        "Bridal Shower"

                    ) {

                        showField(

                            partyThemeField

                        );

                        showField(

                            celebrantNameField

                        );

                        hideField(

                            ageField

                        );

                    }

                    else if (

                        selectedEvent ===

                        "Company Events"

                        ||

                        selectedEvent ===

                        "School Events"

                    ) {

                        hideField(

                            partyThemeField

                        );

                        hideField(

                            celebrantNameField

                        );

                        hideField(

                            ageField

                        );

                    }

                    else if (

                        selectedEvent ===

                        "Gender Reveal"

                        ||

                        selectedEvent ===

                        "Halloween"

                        ||

                        selectedEvent ===

                        "Christmas Parties"

                        ||

                        selectedEvent ===

                        "Easter Events"

                    ) {

                        showField(

                            partyThemeField

                        );

                        hideField(

                            celebrantNameField

                        );

                        hideField(

                            ageField

                        );

                    }

                }

                /*

                 * TIME TO MINUTES

                 */

                function timeToMinutes(timeStr) {

                    if (!timeStr)

                        return -1;

                    const [

                        hours,

                        minutes

                    ] =

                        timeStr

                            .split(":")

                            .map(Number);

                    return (

                        hours * 60

                    ) + minutes;

                }

                /*

                 * TIME CONFLICT

                 */

                function checkTimeConflict() {

                    const selectedTime =

                        startTimeInput.value;

                    if (

                        !selectedTime

                        ||

                        currentUnavailableRanges.length === 0

                    ) {

                        timeConflictAlert.classList.add(

                            "d-none"

                        );

                        nextBtn.disabled =

                            false;

                        return;

                    }

                    const selectedMinutes =

                        timeToMinutes(

                            selectedTime

                        );

                    const hasConflict =

                        currentUnavailableRanges.some(

                            range => {

                                const start =

                                    timeToMinutes(

                                        range.start

                                    );

                                const end =

                                    timeToMinutes(

                                        range.end

                                    );

                                return (

                                    selectedMinutes >= start

                                    &&

                                    selectedMinutes < end

                                );

                            }

                        );

                    if (hasConflict) {

                        timeConflictAlert.classList.remove(

                            "d-none"

                        );

                        nextBtn.disabled =

                            true;

                    }

                    else {

                        timeConflictAlert.classList.add(

                            "d-none"

                        );

                        nextBtn.disabled =

                            false;

                    }

                }

                /*

                 * LOAD UNAVAILABLE TIME RANGES

                 */

                async function loadUnavailableTimeRanges(

                    selectedDate

                ) {

                    timeRangesList.innerHTML =

                        "";

                    currentUnavailableRanges =

                        [];

                    timeRangesBox.classList.add(

                        "d-none"

                    );

                    timeConflictAlert.classList.add(

                        "d-none"

                    );

                    if (!selectedDate)

                        return;

                    try {

                        const response =

                            await fetch(

                                `/Bookings/GetUnavailableTimeRanges?date=${selectedDate}`

                            );

                        const data =

                            await response.json();

                        currentUnavailableRanges =

                            data || [];

                        if (

                            currentUnavailableRanges.length > 0

                        ) {

                            currentUnavailableRanges.forEach(

                                range => {

                                    const chip =

                                        document.createElement(

                                            "div"

                                        );

                                    chip.className =

                                        "time-range-chip";

                                    chip.textContent =

                                        range.display;

                                    timeRangesList.appendChild(

                                        chip

                                    );

                                }

                            );

                            timeRangesBox.classList.remove(

                                "d-none"

                            );

                        }

                        checkTimeConflict();

                    }

                    catch (error) {

                        timeRangesBox.classList.add(

                            "d-none"

                        );

                    }

                }

                /*

                 * LOAD DATE AVAILABILITY

                 */

                async function loadDateAvailability(

                    selectedDate

                ) {

                    if (!selectedDate) {

                        alertBox.classList.add(

                            "d-none"

                        );

                        slotsInfo.classList.add(

                            "d-none"

                        );

                        timeRangesBox.classList.add(

                            "d-none"

                        );

                        timeConflictAlert.classList.add(

                            "d-none"

                        );

                        nextBtn.disabled =

                            false;

                        return;

                    }

                    try {

                        const response =

                            await fetch(

                                `/Bookings/CheckDateAvailability?date=${selectedDate}`

                            );

                        const data =

                            await response.json();

                        if (data.isBlocked) {

                            const reasonText =

                                data.blockReason

                                    ? ` Reason: ${data.blockReason}`

                                    : "";

                            alertBox.textContent =

                                `This selected date is blocked by the admin.${reasonText}`;

                            alertBox.classList.remove(

                                "d-none"

                            );

                            slotsInfo.classList.add(

                                "d-none"

                            );

                            timeRangesBox.classList.add(

                                "d-none"

                            );

                            timeConflictAlert.classList.add(

                                "d-none"

                            );

                            nextBtn.disabled =

                                true;

                            return;

                        }

                        if (data.isFull) {

                            alertBox.textContent =

                                "This selected date is fully booked.";

                            alertBox.classList.remove(

                                "d-none"

                            );

                            slotsInfo.classList.add(

                                "d-none"

                            );

                            timeRangesBox.classList.add(

                                "d-none"

                            );

                            timeConflictAlert.classList.add(

                                "d-none"

                            );

                            nextBtn.disabled =

                                true;

                            return;

                        }

                        alertBox.classList.add(

                            "d-none"

                        );

                        slotsInfo.classList.remove(

                            "slots-alert-good",

                            "slots-alert-warning",

                            "slots-alert-danger"

                        );

                        if (

                            data.remainingSlots <= 0

                        ) {

                            slotsInfo.textContent =

                                "No slots left for this date.";

                            slotsInfo.classList.add(

                                "slots-alert-danger"

                            );

                        }

                        else if (

                            data.remainingSlots === 1

                        ) {

                            slotsInfo.textContent =

                                "Only 1 slot remains for this date.";

                            slotsInfo.classList.add(

                                "slots-alert-warning"

                            );

                        }

                        else {

                            slotsInfo.textContent =

                                `${data.remainingSlots} slots are still available out of ${data.maxPerDay}.`;

                            slotsInfo.classList.add(

                                "slots-alert-good"

                            );

                        }

                        slotsInfo.classList.remove(

                            "d-none"

                        );

                        await loadUnavailableTimeRanges(

                            selectedDate

                        );

                    }

                    catch (error) {

                        slotsInfo.classList.add(

                            "d-none"

                        );

                        timeRangesBox.classList.add(

                            "d-none"

                        );

                    }

                }

                /*

                 * FLATPICKR

                 */

                flatpickr(

                    "#eventDateInput",

                    {

                        dateFormat: "Y-m-d",

                        minDate:

                            new Date().fp_incr(3),

                        disable:

                            unavailableDates,

                        defaultDate:

                            dateInput.value || null,

                        onChange:

                            async function (

                                selectedDates,

                                dateStr

                            ) {

                                await loadDateAvailability(

                                    dateStr

                                );

                            },

                        onReady:

                            async function (

                                selectedDates,

                                dateStr

                            ) {

                                await loadDateAvailability(

                                    dateStr

                                );

                            }

                    }

                );

                /*

                 * EVENT TYPE

                 */

                eventTypeInput.addEventListener(

                    "change",

                    updateEventSpecificFields

                );

                /*

                 * START TIME

                 */

                startTimeInput.addEventListener(

                    "change",

                    checkTimeConflict

                );

                updateEventSpecificFields();

                /*

                 * INTERNAL 2-PANEL MINI-WIZARD

                 */

                const panelEventDetails =

                    document.getElementById(

                        "panelEventDetails"

                    );

                const panelSchedule =

                    document.getElementById(

                        "panelSchedule"

                    );

                const goToScheduleBtn =

                    document.getElementById(

                        "goToScheduleBtn"

                    );

                const backToEventDetailsBtn =

                    document.getElementById(

                        "backToEventDetailsBtn"

                    );

                const tracker =

                    document.getElementById(

                        "ariesWizardTracker"

                    );

                /*

                 * SET TRACKER

                 */

                function setTrackerActive(

                    nodeIndex

                ) {

                    if (!tracker)

                        return;

                    tracker

                         .querySelectorAll(

                            ".am-wizard-node"

                        )

                        .forEach(

                            function (node) {

                                const idx =

                                    parseInt(

                                        node.getAttribute(

                                            "data-node"

                                        ),

                                        10

                                    );

                                node.classList.remove(

                                    "is-active",

                                    "is-done",

                                    "is-upcoming"

                                );

                                if (

                                    idx <

                                    nodeIndex

                                ) {

                                    node.classList.add(

                                        "is-done"

                                    );

                                }

                                else if (

                                    idx ===

                                    nodeIndex

                                ) {

                                    node.classList.add(

                                        "is-active"

                                    );

                                }

                                else {

                                    node.classList.add(

                                        "is-upcoming"

                                    );

                                }

                                const dot =

                                    node.querySelector(

                                        ".am-wizard-node-dot"

                                    );

                                if (dot) {

                                    dot.innerHTML =

                                        idx < nodeIndex

                                            ? '<i class="bi bi-check-lg"></i>'

                                            : idx;

                                }

                            }

                        );

                }

                /*

                 * PANEL VALIDATION

                 */

                function panelFieldsValid(

                    panel

                ) {

                    const fields =

                        panel.querySelectorAll(

                            "input:not([disabled]), select:not([disabled]), textarea:not([disabled])"

                        );

                    for (

                        const field

                        of fields

                    ) {

                        if (

                            !field.checkValidity()

                        ) {

                            field.reportValidity();

                            return false;

                        }

                    }

                    return true;

                }

                /*

                 * CONTINUE TO SCHEDULE

                 */

                if (goToScheduleBtn) {

                    goToScheduleBtn.addEventListener(

                        "click",

                        function () {

                            if (

                                !panelFieldsValid(

                                    panelEventDetails

                                )

                            )

                                return;

                            const currentVenueState = window.venueServiceabilityState;
                            if (currentVenueState !== "SERVICEABLE" && currentVenueState !== "FOR_STAFF_REVIEW") {
                                const gateMessage = currentVenueState === "CHECKING"
                                    ? "Please wait while the venue location is being verified."
                                    : currentVenueState === "NOT_SERVICEABLE"
                                        ? "This venue is outside the serviceable area. Please select another venue."
                                        : "Please select a venue and wait for its serviceability check to finish before continuing.";
                                const gateStatus = document.getElementById("venueLocationStatus");
                                if (gateStatus) {
                                    gateStatus.innerHTML = `<div class="alert alert-danger py-2 mb-0">${gateMessage}</div>`;
                                }
                                return;
                            }

                            panelEventDetails.hidden =

                                true;

                            panelSchedule.hidden =

                                false;

                            setTrackerActive(

                                2

                            );

                            panelSchedule.scrollIntoView(

                                {

                                    behavior:

                                        "smooth",

                                    block:

                                        "start"

                                }

                            );

                        }

                    );

                }

                /*

                 * BACK TO EVENT DETAILS

                 */

                if (backToEventDetailsBtn) {

                    backToEventDetailsBtn.addEventListener(

                        "click",

                        function () {

                            panelSchedule.hidden =

                                true;

                            panelEventDetails.hidden =

                                false;

                            setTrackerActive(

                                1

                            );

                            panelEventDetails.scrollIntoView(

                                {

                                    behavior:

                                        "smooth",

                                    block:

                                        "start"

                                }

                            );

                        }

                    );

                }

            }

        );

    </script>

}
