@model IEnumerable<AriesMagicAppointmentSystem.Models.Booking>
@using AriesMagicAppointmentSystem.Models
@using AriesMagicAppointmentSystem.ViewModels
@{
    ViewData["Title"] = "My dashboard";
    var bookings = Model.ToList();
    var finances = ViewBag.FinancialSummaries as Dictionary<int, BookingFinancialSummaryViewModel> ?? new();
    var unavailable = ViewBag.UnavailableBookingIds as List<int> ?? new();
    var active = bookings.Where(b => b.EventDate.Date >= DateTime.Today && !unavailable.Contains(b.Id) && new[] { BookingStatus.Pending, BookingStatus.AwaitingDownpayment, BookingStatus.AwaitingVerification, BookingStatus.Confirmed }.Contains(b.Status)).OrderBy(b => b.EventDate).ThenBy(b => b.StartTime).ToList();
    var next = active.FirstOrDefault();
}
<header class="cr-page-heading"><div><span class="cr-eyebrow">Your own little wonder studio</span><h1>Your celebrations,<br />all in one place.</h1><p>The next date to look forward to. The details that make it yours.</p></div><a asp-action="CreateStepOne" class="btn btn-primary">Plan another event ↗</a></header>
@if (next != null)
{
    var finance = finances.GetValueOrDefault(next.Id);
    <article class="cr-event-spotlight"><div><span class="cr-eyebrow">Upcoming event · BK-@next.CreatedAt.Year-@next.Id.ToString("D3")</span><h2>@(next.PackageName ?? next.Service?.Name)</h2><p class="cr-event-date">@next.EventDate.ToString("dddd, MMMM d, yyyy") · @next.StartTime.ToString("h:mm tt")</p><p>@next.PartyVenue</p><partial name="_StatusBadge" model="@ClientBookingPresentation.Status(next.Status)" /><p class="cr-next-action">@ClientBookingPresentation.NextAction(next, finance)</p><a asp-action="Details" asp-route-id="@next.Id" class="btn btn-primary">View booking & next steps</a></div><div class="cr-event-date-tile" aria-hidden="true"><span>@next.EventDate.ToString("MMM")</span><strong>@next.EventDate.Day</strong><span>@next.EventDate.ToString("dddd")</span></div></article>
    @if(active.Count > 1) { <p class="mt-3">You have @(active.Count - 1) other upcoming request(s). <a asp-action="MyBookings">View all bookings</a></p> }
}
else
{
    <section class="cr-card cr-empty"><h2>A new celebration awaits</h2><p>You have no upcoming active event. Explore the packages or check a venue and date to get started.</p><a asp-controller="Home" asp-action="Packages" class="btn btn-primary">Explore packages</a><a asp-action="CreateStepOne" class="btn btn-outline-secondary">Check availability</a></section>
}
<div class="cr-dashboard-links"><a asp-action="MyBookings"><i class="bi bi-calendar-heart" aria-hidden="true"></i><strong>My bookings</strong><span>Your dates, requests, and event details</span></a><a asp-controller="Communications" asp-action="Index" asp-route-view="inbox"><i class="bi bi-chat-heart" aria-hidden="true"></i><strong>Messages</strong><span>A question? Keep the conversation going</span></a><a asp-controller="Payments" asp-action="MyUploads"><i class="bi bi-receipt" aria-hidden="true"></i><strong>My payments</strong><span>Proofs, verification, and payment history</span></a><a asp-controller="Feedback" asp-action="Index"><i class="bi bi-stars" aria-hidden="true"></i><strong>My feedback</strong><span>Your experience, in your own words</span></a><a asp-controller="Profile" asp-action="Index"><i class="bi bi-person" aria-hidden="true"></i><strong>My profile</strong><span>The details that keep us in touch</span></a></div>
