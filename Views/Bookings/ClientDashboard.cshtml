@model IEnumerable<AriesMagicAppointmentSystem.Models.Booking>
@using AriesMagicAppointmentSystem.Models
@using AriesMagicAppointmentSystem.ViewModels
@using AriesMagicAppointmentSystem.Services
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "_ClientHubLayout";
    ViewData["Title"] = "Client Dashboard";
    var today = FeedbackPolicy.BusinessNow.Date;
    var packages = ViewBag.DashboardPackages as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var finances = ViewBag.FinancialSummaries as Dictionary<int, BookingFinancialSummaryViewModel> ?? new();
    var unavailable = ViewBag.UnavailableBookingIds as List<int> ?? new();
    // Client actions take priority. Within each priority, use event start and then booking ID.
    var next = Model.OrderBy(b => b.TravelFeeStatus == VenueLocationPolicy.AwaitingCustomerAcceptance
            || unavailable.Contains(b.Id) || finances.GetValueOrDefault(b.Id)?.HasAdditionalEvidenceRequired == true
            || (b.Status == BookingStatus.AwaitingDownpayment && ClientHubAction.CanPay(b, finances.GetValueOrDefault(b.Id), false)) ? 0 : 1)
        .ThenBy(b => b.StartTime).ThenBy(b => b.Id).FirstOrDefault();
}
<div class="event-dashboard" id="eventDashboard">
    <section class="event-dashboard-hero hub-card">
        <i class="bi bi-stars event-dashboard-icon" aria-hidden="true"></i>
        <div>
            <h1>Let’s make your event <span class="event-dashboard-accent">magical!</span></h1>
            <p>Plan your event with ease — check availability, verify your venue, and manage your booking all in one place.</p>
        </div>
        <a asp-action="CreateStepOne" id="dashboardPlan" class="cn-button cn-primary"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Plan an Event</a>
    </section>

    <div class="event-dashboard-checkers">
        <section class="hub-card event-dashboard-card" aria-labelledby="dashboardScheduleTitle">
            <header class="event-dashboard-heading">
                <i class="bi bi-calendar-event event-dashboard-icon" aria-hidden="true"></i>
                <div><h2 id="dashboardScheduleTitle">Date &amp; Time Availability Checker</h2><p>Check if your preferred date and time are available for your event.</p></div>
            </header>
            <form asp-action="CheckScheduleAvailability" method="get" id="dashboardSchedule">
                <input type="hidden" name="suggest" value="true" />
                <div class="event-dashboard-schedule-fields">
                    <div class="cn-field">
                        <label for="dashboardDate">Event Date</label>
                        <input id="dashboardDate" name="date" class="cn-input" type="date" required
                               min="@today.AddDays(BookingRules.MinimumAdvanceDays).ToString("yyyy-MM-dd")"
                               max="@today.AddYears(BookingRules.MaximumAdvanceYears).ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="cn-field">
                        <label for="dashboardTime">Start Time</label>
                        <input id="dashboardTime" name="startTime" class="cn-input" type="time" required />
                    </div>
                    <div class="cn-field event-dashboard-package">
                        <label for="dashboardPackage">Package</label>
                        <select id="dashboardPackage" name="serviceId" class="cn-input" asp-items="packages"><option value="">Any available package</option></select>
                    </div>
                    <button class="cn-button cn-primary" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Check Availability</button>
                </div>
            </form>
            <div id="dashboardScheduleResult" class="event-dashboard-result" role="status" hidden></div>
            <div id="dashboardAlternatives" class="event-dashboard-alternatives" hidden>
                <h3>Suggested available schedules</h3>
                <div id="dashboardAlternativeChoices"></div>
            </div>
            <p class="event-dashboard-note"><i class="bi bi-info-circle" aria-hidden="true"></i> Times are in the Philippines. Checking availability does not reserve a slot.</p>
        </section>

        <section class="hub-card event-dashboard-card" aria-labelledby="dashboardVenueTitle">
            <header class="event-dashboard-heading">
                <i class="bi bi-geo-alt event-dashboard-icon" aria-hidden="true"></i>
                <div><h2 id="dashboardVenueTitle">Venue &amp; Travel Checker</h2><p>Verify if your venue is serviceable and see the estimated travel details.</p></div>
            </header>
            <form asp-action="CheckVenueServiceability" method="post" id="dashboardVenue" data-search-url="@Url.Action("SearchVenue")">
                <div class="cn-field">
                    <label for="dashboardAddress">Venue / Address</label>
                    <div class="event-dashboard-venue-fields">
                        <input id="dashboardAddress" class="cn-input" type="search" placeholder="Venue, street, city or province" minlength="3" maxlength="180" autocomplete="off" required />
                        <button class="cn-button cn-primary" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Check Venue</button>
                    </div>
                </div>
                <div class="event-dashboard-matches" id="dashboardVenueMatches"></div>
            </form>
            <div id="dashboardVenueResult" class="event-dashboard-result" role="status" hidden></div>
            <dl id="dashboardTravel" class="event-dashboard-travel" hidden>
                <div><dt>Estimated Distance</dt><dd id="dashboardDistance"></dd></div>
                <div><dt>Estimated Travel Fee</dt><dd id="dashboardFee"></dd></div>
            </dl>
            <p class="event-dashboard-note"><i class="bi bi-info-circle" aria-hidden="true"></i> Travel estimates use your selected date and time. Staff may confirm the fee during booking review.</p>
        </section>
    </div>

    @if (next != null)
    {
        var action = ClientHubAction.For(next, finances.GetValueOrDefault(next.Id), unavailable.Contains(next.Id),
            next.RescheduleRequests.Any(r => r.Status == RescheduleRequestStatus.Pending));
        var details = Url.Action("Details", new { id = next.Id });
        <section class="hub-card event-dashboard-card" aria-labelledby="dashboardBookingTitle" data-focus-booking="@next.Id">
            <header class="event-dashboard-heading">
                <i class="bi bi-calendar-check event-dashboard-icon" aria-hidden="true"></i>
                <div><h2 id="dashboardBookingTitle">Your Active Booking</h2><p>Here’s a summary of your booking and what to do next.</p></div>
            </header>
            <div class="event-dashboard-booking">
                <dl>
                    <div><dt>Booking ID</dt><dd>BK-@next.CreatedAt.Year-@next.Id.ToString("D3")</dd></div>
                    <div><dt>Event Date &amp; Time</dt><dd>@next.EventDate.ToString("MMM d, yyyy") · @next.StartTime.ToString("h:mm tt")</dd></div>
                    <div><dt>Venue</dt><dd>@(string.IsNullOrWhiteSpace(next.PartyVenue) ? "Venue pending" : next.PartyVenue)</dd></div>
                    <div><dt>Booking Status</dt><dd><partial name="_StatusBadge" model="@ClientBookingPresentation.Status(next.Status)" /></dd></div>
                    <div><dt>Next Action</dt><dd>
                        @if (!action.Href.EndsWith($"/Details/{next.Id}") || next.TravelFeeStatus == VenueLocationPolicy.AwaitingCustomerAcceptance)
                        {
                            <a href="@(action.Href.StartsWith("/Bookings/") ? details : Url.Content("~" + action.Href))" data-hub-next>@action.Title</a>
                        }
                        else
                        {
                            <strong>@action.Title</strong>
                        }
                        <small>@action.Description</small>
                    </dd></div>
                </dl>
                <a href="@details" class="cn-button cn-primary"><i class="bi bi-eye" aria-hidden="true"></i> View Booking</a>
            </div>
        </section>
    }

    <section class="hub-card event-dashboard-support" aria-labelledby="dashboardSupportTitle">
        <i class="bi bi-headset event-dashboard-icon" aria-hidden="true"></i>
        <div><h2 id="dashboardSupportTitle">Need help planning?</h2><p>Have questions about your event, availability, venue, or booking? We’re here to help!</p></div>
        <a asp-controller="Communications" asp-action="Index" asp-route-view="inbox" class="cn-button cn-primary"><i class="bi bi-chat-dots" aria-hidden="true"></i> Message Us</a>
    </section>
</div>

@section Scripts {
    <script src="~/js/client-dashboard.js" asp-append-version="true"></script>
}
