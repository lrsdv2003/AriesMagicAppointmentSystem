@model AriesMagicAppointmentSystem.ViewModels.BookingManagementViewModel
@using AriesMagicAppointmentSystem.Models
@using AriesMagicAppointmentSystem.Services
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Booking Requests";
    var requests = Model.Bookings.ToList();
    var pendingCount = requests.Count(x => x.BookingStatus == BookingStatus.Pending);
    var waitingClientCount = requests.Count(x => x.TravelFeeStatus == VenueLocationPolicy.AwaitingCustomerAcceptance);
    var reviewCount = requests.Count(x => x.RequiresManualReview);

    string StatusClass(string status) => status switch {
        BookingStatus.Pending => "status-pending",
        BookingStatus.AwaitingDownpayment => "status-pending",
        BookingStatus.AwaitingVerification => "status-pending",
        BookingStatus.Declined => "status-declined",
        BookingStatus.Cancelled => "status-declined",
        BookingStatus.Completed => "status-completed",
        BookingStatus.Confirmed => "status-confirmed",
        _ => "status-read"
    };
}
<div class="staff-booking-page">
    <p class="staff-round2-intro">Staff action queue · Pending approvals and venue reviews only. Owner payment verification is managed separately.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <div class="staff-booking-stats" aria-label="Booking request summary">
        <div class="staff-booking-stat"><span class="staff-stat-label"><i class="bi bi-card-checklist" aria-hidden="true"></i> Staff Queue Total</span><strong>@Model.TotalCount</strong></div>
        <div class="staff-booking-stat"><span class="staff-stat-label"><i class="bi bi-hourglass-split" aria-hidden="true"></i> Requests on Page</span><strong>@requests.Count</strong></div>
        <div class="staff-booking-stat"><span class="staff-stat-label"><i class="bi bi-hourglass" aria-hidden="true"></i> Awaiting Client Venue Confirmation (page)</span><strong>@waitingClientCount</strong></div>
        <div class="staff-booking-stat"><span class="staff-stat-label"><i class="bi bi-geo-alt" aria-hidden="true"></i> Manual Venue Review (page)</span><strong>@reviewCount</strong></div>
    </div>
    <div class="am-filter-container">
        <form method="get" asp-action="Index" class="am-filter-bar am-filter-row staff-final-filter-toolbar aries-round3-toolbar" data-staff-autosearch="bookings" role="search">
            <div class="am-filter-search">
                <label class="visually-hidden" for="staffBookingSearch">Search bookings</label>
                <i class="bi bi-search" aria-hidden="true"></i><input id="staffBookingSearch" type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search booking ID, client, package, or venue" autocomplete="off" />
            </div>
<div class="dropdown"><button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"><i class="bi bi-funnel" aria-hidden="true"></i> Filters</button><div class="dropdown-menu dropdown-menu-end"><h6>Filter requests</h6>
            <div>
                <label class="form-label" for="staffBookingStatus">Booking status</label>
                <select id="staffBookingStatus" name="bookingStatus" class="form-select">
                    <option value="AllRequests" selected="@(Model.BookingStatus == "AllRequests")">All Staff Actions</option>
                    <option value="Pending" selected="@(Model.BookingStatus == "Pending")">Pending</option>
                    <option value="RequiresReview" selected="@(Model.BookingStatus == "RequiresReview")">Venue / Client Confirmation Review</option>
                </select>
            </div>

            <div>
                <label class="form-label" for="staffBookingSort">Sort requests by submission</label>
                <select id="staffBookingSort" name="sortBy" class="form-select">
                    <option value="newest" selected="@((string?)ViewBag.StaffSort != "oldest")">Newest to Oldest</option>
                    <option value="oldest" selected="@((string?)ViewBag.StaffSort == "oldest")">Oldest to Newest</option>
                </select>
            </div>
</div></div><button type="button" class="btn btn-outline-secondary aries-refresh-now" aria-label="Refresh booking requests"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button><button type="submit" class="visually-hidden">Search bookings</button></form>
    </div>
    <div class="dashboard-panel staff-booking-table-panel">
        <div class="staff-booking-panel-heading">
            <div>
                <h2>Requests Requiring Attention</h2>
                <p>Operational booking review only. Payment verification is handled by the Owner.</p>
            </div>
        </div>

        @if (!requests.Any())
        {
            <div class="empty-state staff-booking-empty">
                <i class="bi bi-check2-circle" aria-hidden="true"></i>
                <h3>No booking requests currently require your attention.</h3>
                <p>Confirmed events can be managed from the Calendar.</p>
            </div>
        }
        else
        {
            <div class="table-responsive staff-booking-table-wrap">
                <table class="table align-middle staff-booking-table">
                    <thead>
                        <tr>
                            <th scope="col">Booking</th>
                            <th scope="col">Client</th>
                            <th scope="col">Event Date &amp; Time</th>
                            <th scope="col">Venue</th>
                            <th scope="col">Booking Status</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in requests)
                    {
                        var venueText = string.IsNullOrWhiteSpace(item.VenueAddress) ? "Venue not provided" : item.VenueAddress;
                        <tr>
                            <td>
                                <strong class="staff-booking-code">@item.BookingCode</strong>

                            </td>
                            <td><strong>@item.ClientName</strong></td>
                            <td>
                                <div class="staff-date-stack">
                                    <strong>@item.EventDate.ToString("MMM dd, yyyy")</strong>
                                    <span>@item.StartTime.ToString("hh:mm tt") – @item.EndTime.ToString("hh:mm tt")</span>
                                </div>
                            </td>
                            <td>
                                <div class="staff-venue-cell" title="@venueText"><strong>@venueText</strong></div>
                            </td>
                            <td>
                                @if(item.TravelFeeStatus == VenueLocationPolicy.AwaitingCustomerAcceptance){<span class="status-badge status-pending">Awaiting Client Venue Confirmation</span>}
                                else if(item.TravelFeeStatus == VenueLocationPolicy.PendingReview || item.RequiresManualReview){<span class="status-badge status-pending">Venue Review Needed</span>}
                                else{<span class="status-badge staff-status-badge @StatusClass(item.BookingStatus)">Pending Staff Approval</span>}
                            </td>
                            <td class="text-end">
                                <div class="staff-booking-actions">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary staff-final-details-action">
                                        <i class="bi bi-eye" aria-hidden="true"></i> View Details
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
@{
    var staffPager = new AriesMagicAppointmentSystem.ViewModels.QueuePaginationViewModel(
        Model.TotalCount, Model.Page, 5, "Index", new Dictionary<string,string> {
            ["search"] = Model.Search ?? "",
            ["bookingStatus"] = Model.BookingStatus ?? "AllRequests",
            ["sortBy"] = (string?)ViewBag.StaffSort ?? "newest"
        });
}
<partial name="_QueuePagination" model="staffPager" />
