@model AriesMagicAppointmentSystem.ViewModels.BookingManagementViewModel
@using AriesMagicAppointmentSystem.Models
@using AriesMagicAppointmentSystem.Services
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Booking Requests";
    var requests = Model.Bookings.ToList();
    var pendingCount = requests.Count(x => x.BookingStatus == BookingStatus.Pending);
    var waitingClientCount = requests.Count(x => x.TravelFeeStatus == VenueLocationPolicy.AwaitingCustomerAcceptance);
    var reviewCount = requests.Count(x => x.RequiresManualReview);

    string StatusClass(string status) => status switch {
        BookingStatus.Pending => "status-pending",
        BookingStatus.AwaitingDownpayment => "status-pending",
        BookingStatus.AwaitingVerification => "status-pending",
        BookingStatus.Declined => "status-declined",
        BookingStatus.Cancelled => "status-declined",
        BookingStatus.Completed => "status-completed",
        BookingStatus.Confirmed => "status-confirmed",
        _ => "status-read"
    };
}
<div class="staff-booking-page staff-final-round-list">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }
    <div class="am-filter-container">
        <form method="get" asp-action="Index" class="am-filter-bar am-filter-row staff-final-filter-toolbar aries-round3-toolbar" data-staff-autosearch="bookings" role="search">
            <div class="am-filter-search">
                <label class="visually-hidden" for="staffBookingSearch">Search bookings</label>
                <i class="bi bi-search" aria-hidden="true"></i><input id="staffBookingSearch" type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search booking ID, client, package, or venue" autocomplete="off" />
            </div>
<div class="staff-part3-sort-control staff-data-sort">
                <label for="staffBookingSort">Sort by</label>
                <select id="staffBookingSort" name="sortBy" class="form-select" aria-label="Sort booking requests">
                    <option value="newest" selected="@((string?)ViewBag.StaffSort != "oldest")">Newest first</option>
                    <option value="oldest" selected="@((string?)ViewBag.StaffSort == "oldest")">Oldest first</option>
                </select>
            </div><button type="button" class="btn btn-outline-secondary aries-refresh-now" aria-label="Refresh booking requests"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button><button type="submit" class="visually-hidden">Search bookings</button></form>
    </div>
    <div class="staff-data-table-frame" data-staff-table-capacity="5">
        <div class="dashboard-panel staff-booking-table-panel staff-data-table-panel">
            <div class="table-responsive staff-booking-table-wrap staff-data-table-scroll">
                <table class="table align-middle staff-booking-table staff-data-table">
                    <colgroup>
                        <col class="staff-col-booking" />
                        <col class="staff-col-client" />
                        <col class="staff-col-event" />
                        <col class="staff-col-venue" />
                        <col class="staff-col-status" />
                        <col class="staff-col-actions" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col">Booking</th>
                            <th scope="col">Client</th>
                            <th scope="col">Event Date &amp; Time</th>
                            <th scope="col">Venue</th>
                            <th scope="col">Booking Status</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!requests.Any())
                    {
                        <tr class="staff-data-table-empty-row">
                            <td colspan="6">
                                <div class="staff-data-table-empty" role="status">
                                    <i class="bi bi-inbox" aria-hidden="true"></i>
                                    @if (!string.IsNullOrWhiteSpace(Model.Search) && Model.StaffHasAnyRequests)
                                    {
                                        <strong>No matching bookings</strong>
                                        <p>Try adjusting your search.</p>
                                        <a asp-controller="Bookings" asp-action="Index" class="staff-data-table-reset">Clear search</a>
                                    }
                                    else
                                    {
                                        <strong>No bookings found</strong>
                                        <p>No booking records are available.</p>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                    @foreach (var item in requests)
                    {
                        var venueText = string.IsNullOrWhiteSpace(item.VenueAddress) ? "Venue not provided" : item.VenueAddress;
                        <tr>
                            <td>
                                <strong class="staff-booking-code">@item.BookingCode</strong>

                            </td>
                            <td><strong>@item.ClientName</strong></td>
                            <td>
                                <div class="staff-date-stack">
                                    <strong>@item.EventDate.ToString("MMM dd, yyyy")</strong>
                                    <span>@item.StartTime.ToString("hh:mm tt") – @item.EndTime.ToString("hh:mm tt")</span>
                                </div>
                            </td>
                            <td>
                                <div class="staff-venue-cell" title="@venueText"><strong>@venueText</strong></div>
                            </td>
                            <td>
                                @if(item.TravelFeeStatus == VenueLocationPolicy.AwaitingCustomerAcceptance){<span class="status-badge status-pending">Awaiting Client Venue Confirmation</span>}
                                else if(item.TravelFeeStatus == VenueLocationPolicy.PendingReview || item.RequiresManualReview){<span class="status-badge status-pending">Venue Review Needed</span>}
                                else{<span class="status-badge staff-status-badge @StatusClass(item.BookingStatus)">Pending Staff Approval</span>}
                            </td>
                            <td class="text-end">
                                <div class="staff-booking-actions">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary staff-final-details-action">
                                        <i class="bi bi-eye" aria-hidden="true"></i> View Details
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    }
                    </tbody>
                </table>
            </div>
        </div>
        @{
            var staffPager = new AriesMagicAppointmentSystem.ViewModels.QueuePaginationViewModel(
                Model.TotalCount, Model.Page, 5, "Index", new Dictionary<string,string> {
                    ["search"] = Model.Search ?? "",
                    ["sortBy"] = (string?)ViewBag.StaffSort ?? "newest"
                }) { ShowTotalForStaff = true, HideSinglePageControls = true };
        }
        <partial name="_QueuePagination" model="staffPager" />
    </div>
</div>
