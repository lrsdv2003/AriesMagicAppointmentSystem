@model IEnumerable<AriesMagicAppointmentSystem.Models.Booking>
@using AriesMagicAppointmentSystem.Models
@using AriesMagicAppointmentSystem.ViewModels
@{
    ViewData["Title"] = "My bookings";
    var bookings = Model.OrderByDescending(b => b.CreatedAt).ToList();
    var finances = ViewBag.FinancialSummaries as Dictionary<int, BookingFinancialSummaryViewModel> ?? new();
    var unavailable = ViewBag.UnavailableBookingIds as List<int> ?? new();
}
<header class="cr-page-heading"><div><span class="cr-eyebrow">Your events</span><h1>My bookings</h1><p>Review active requests and revisit past celebrations.</p></div><a asp-action="CreateStepOne" class="btn btn-primary">New booking</a></header>
@if(TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@if(TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<div class="cr-list-tools"><label for="bookingSearch">Find a booking<input id="bookingSearch" type="search" class="form-control" placeholder="Package, venue, or booking number" /></label><label for="bookingGroup">Show<select id="bookingGroup" class="form-select"><option value="all">All bookings</option><option value="active">Active requests & upcoming</option><option value="past">Past & closed</option></select></label></div>
<div class="cr-booking-grid" id="clientBookingList">
@foreach(var booking in bookings)
{
    var finance = finances.GetValueOrDefault(booking.Id);
    var isActive = new[] { BookingStatus.Pending, BookingStatus.AwaitingDownpayment, BookingStatus.AwaitingVerification, BookingStatus.Confirmed }.Contains(booking.Status) && booking.EventDate.Date >= DateTime.Today;
    <article class="cr-card cr-booking-item" data-group="@(isActive ? "active" : "past")"><div class="cr-card-top"><span class="cr-eyebrow">BK-@booking.CreatedAt.Year-@booking.Id.ToString("D3")</span><span class="cr-status">@(unavailable.Contains(booking.Id) ? "Schedule unavailable" : ClientBookingPresentation.Status(booking.Status))</span></div><h2>@booking.PackageName</h2><p>@booking.EventDate.ToString("MMM d, yyyy") · @booking.StartTime.ToString("h:mm tt")</p><p class="cr-venue">@booking.PartyVenue</p><p class="cr-next-action">@(unavailable.Contains(booking.Id) ? "This time is no longer available. Open your booking to discuss another schedule." : ClientBookingPresentation.NextAction(booking,finance))</p><a asp-action="Details" asp-route-id="@booking.Id" class="btn btn-outline-primary">View booking</a></article>
}
</div>
<div class="cr-card cr-empty" id="bookingListEmpty" hidden="@(bookings.Count > 0)"><h2>No bookings to show</h2><p>Try another search or start a new booking.</p></div>
@section Scripts {
<script>
(() => { const search=document.getElementById('bookingSearch'), group=document.getElementById('bookingGroup'), cards=[...document.querySelectorAll('.cr-booking-item')]; function filter(){let count=0; for(const card of cards){const show=(group.value==='all'||card.dataset.group===group.value)&&card.textContent.toLowerCase().includes(search.value.trim().toLowerCase());card.hidden=!show;if(show)count++;}document.getElementById('bookingListEmpty').hidden=count>0;} search.addEventListener('input',filter);group.addEventListener('change',filter);})();
</script>
}
