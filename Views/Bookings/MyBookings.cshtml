@model IEnumerable<AriesMagicAppointmentSystem.Models.Booking>
@using AriesMagicAppointmentSystem.Models
@using AriesMagicAppointmentSystem.ViewModels
@{
 Layout="_ClientHubLayout";ViewData["Title"]="My bookings";
 var bookings=Model.OrderByDescending(b=>b.CreatedAt).ToList();var finances=ViewBag.FinancialSummaries as Dictionary<int,BookingFinancialSummaryViewModel>??new();var unavailable=ViewBag.UnavailableBookingIds as List<int>??new();
}
<header class="hub-heading"><div><span class="hub-kicker">Dates, details & next steps</span><h1>My bookings.</h1><p>Every request and celebration, with its current status.</p></div><a asp-action="CreateStepOne" class="cn-button cn-primary">Plan an event <span aria-hidden="true">→</span></a></header>
@if(TempData["Success"] is string success){<div class="cn-success" role="status"><strong>Booking update</strong>@success</div>}
@if(TempData["Error"] is string error){<div class="cn-error-summary" role="alert">@error</div>}
<div class="cn-list-tools"><div class="cn-field"><label for="bookingSearch">Find a booking</label><input id="bookingSearch" type="search" class="cn-input" placeholder="Package, venue, or reference"/></div><div class="cn-field"><label for="bookingGroup">Show</label><select id="bookingGroup" class="cn-input"><option value="all">All bookings</option><option value="active">Active & upcoming</option><option value="past">Past & closed</option></select></div></div>
<div class="cn-records" id="clientBookingList">
@foreach(var booking in bookings){var finance=finances.GetValueOrDefault(booking.Id);var blocked=unavailable.Contains(booking.Id);var nextAction=ClientHubAction.For(booking,finance,blocked);var isActive=new[]{BookingStatus.Pending,BookingStatus.AwaitingDownpayment,BookingStatus.AwaitingVerification,BookingStatus.Confirmed}.Contains(booking.Status)&&booking.EventDate.Date>=DateTime.Today;
<article class="cn-record cr-booking-item hub-booking-record" data-group="@(isActive?"active":"past")" data-status="@booking.Status"><div class="hub-booking-main"><span class="hub-reference">BK-@booking.CreatedAt.Year-@booking.Id.ToString("D3")</span><h2>@booking.PackageName</h2><p><strong>@booking.EventDate.ToString("ddd, MMM d, yyyy")</strong> · @booking.StartTime.ToString("h:mm tt")</p><p>@booking.PartyVenue</p><partial name="_StatusBadge" model="@(blocked?"Schedule unavailable":ClientBookingPresentation.Status(booking.Status))"/></div><div class="hub-booking-finance">@if(finance!=null){<dl><dt>Remaining balance</dt><dd>₱@finance.RemainingBalance.ToString("N2")</dd></dl><progress class="hub-progress" value="@Math.Clamp(finance.TotalVerifiedPayments,0,Math.Max(1,finance.BookingTotal))" max="@Math.Max(1,finance.BookingTotal)" aria-label="Verified payments toward booking total"></progress><small>₱@finance.TotalVerifiedPayments.ToString("N2") verified of ₱@finance.BookingTotal.ToString("N2")</small><small>@finance.PaymentStatus</small>}else{<p>Financial details are available in your booking.</p>}</div><div class="cn-record-actions"><p>@(blocked?"Review this schedule before making a payment.":ClientBookingPresentation.NextAction(booking,finance))</p><div class="hub-row-links">@if(!nextAction.Href.EndsWith($"/Details/{booking.Id}")){<a href="@nextAction.Href">@nextAction.Label</a>}<a asp-action="Details" asp-route-id="@booking.Id">View booking <span aria-hidden="true">→</span></a></div></div></article>}
</div>
<section class="hub-card hub-empty" id="bookingListEmpty" hidden="@(bookings.Count>0)"><h2>No bookings to show.</h2><p>@(bookings.Any()?"Try another search or change the Show filter.":"Your first booking will appear here with its schedule, balance and next steps.")</p><a asp-action="CreateStepOne" class="cn-text-link">Plan an event</a></section><p id="bookingListCount" class="cn-help" role="status"></p>
@section Scripts {
<script>(()=>{const search=document.getElementById('bookingSearch'),group=document.getElementById('bookingGroup'),cards=[...document.querySelectorAll('.cr-booking-item')],initial=new URLSearchParams(location.search).get('group');if(['all','active','past'].includes(initial))group.value=initial;function filter(){let count=0;for(const card of cards){const show=(group.value==='all'||card.dataset.group===group.value)&&card.textContent.toLowerCase().includes(search.value.trim().toLowerCase());card.hidden=!show;if(show)count++;}document.getElementById('bookingListEmpty').hidden=count>0;document.getElementById('bookingListCount').textContent=`${count} booking${count===1?'':'s'} shown`;}search.addEventListener('input',filter);group.addEventListener('change',filter);window.addEventListener('pageshow',filter);filter();})();</script>
}
