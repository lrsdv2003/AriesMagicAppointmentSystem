@model IEnumerable<AriesMagicAppointmentSystem.Models.Booking>
@using AriesMagicAppointmentSystem.Models
@using AriesMagicAppointmentSystem.ViewModels
@using AriesMagicAppointmentSystem.Services
@{
 Layout="_ClientHubLayout"; ViewData["Title"]="My bookings";
 var bookings=Model.OrderByDescending(b=>b.CreatedAt).ToList();
 var finances=ViewBag.FinancialSummaries as Dictionary<int,BookingFinancialSummaryViewModel>??new();
 var unavailable=ViewBag.UnavailableBookingIds as List<int>??new();
 var paymentDeadlines=ViewBag.PaymentDeadlines as Dictionary<int,DateTime>??new();
}
<header class="hub-heading">
 <div><span class="hub-kicker">All your events in one place</span><h1>My bookings</h1><p>Manage event schedules, track verified payments, review requests, and see the next action for each booking.</p></div>
 <a asp-action="CreateStepOne" class="cn-button cn-primary"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Plan an event</a>
</header>
@if(TempData["Success"] is string success){<div class="cn-success" role="status"><strong>Booking update:</strong> @success</div>}
@if(TempData["Error"] is string error){<div class="cn-error-summary" role="alert">@error</div>}
<div class="cn-list-tools hub-search-row r2-bookings-tools aries-client-round3-toolbar" role="search" aria-label="Search and filter my bookings">
 <div class="am-filter-search"><i class="bi bi-search" aria-hidden="true"></i><label for="bookingSearch" class="visually-hidden">Search bookings</label><input id="bookingSearch" type="search" class="cn-input" placeholder="Search booking ID, package, venue, or contact" autocomplete="off" /></div>
 <div class="dropdown"><button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"><i class="bi bi-funnel" aria-hidden="true"></i> Filters</button>
 <div class="dropdown-menu dropdown-menu-end p-3"><label for="bookingStatusFilter">Booking status</label><select id="bookingStatusFilter" class="cn-input"><option value="all">Any status</option><option value="staff-review">Pending Staff review</option><option value="awaiting-payment">Awaiting payment</option><option value="payment-review">Payment under review</option><option value="confirmed">Confirmed</option><option value="reschedule">Reschedule requested</option><option value="rejected">Payment proof rejected</option><option value="completed">Completed</option><option value="cancelled">Cancelled</option><option value="declined">Declined</option><option value="expired">Expired</option></select><button class="btn btn-outline-secondary btn-sm mt-2" type="button" id="clientClearFilters">Reset filters</button></div></div>
 <button class="btn btn-outline-secondary" type="button" id="clientBookingRefresh" aria-label="Refresh my bookings"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i><span>Refresh</span></button>
</div>
<div class="r2-booking-grid" id="clientBookingList">
@foreach(var booking in bookings){
 var finance=finances.GetValueOrDefault(booking.Id);
 var blocked=unavailable.Contains(booking.Id);
 var nextAction=ClientHubAction.For(booking,finance,blocked);
 var isActive=new[]{BookingStatus.Pending,BookingStatus.AwaitingDownpayment,BookingStatus.AwaitingVerification,BookingStatus.Confirmed,BookingStatus.PaymentSubmitted}.Contains(booking.Status)&&booking.EventDate.Date>=DateTime.Today;
 var pendingChange=booking.RescheduleRequests.OrderByDescending(r=>r.CreatedAt).FirstOrDefault(r=>r.Status==RescheduleRequestStatus.Pending);
 var lastPayment=booking.Payments.OrderByDescending(p=>p.UploadedAt).ThenByDescending(p=>p.Id).FirstOrDefault();
 var rejected=lastPayment?.Status==PaymentStatus.Rejected && booking.Status!=BookingStatus.Cancelled && booking.Status!=BookingStatus.Declined;
 var filterStates = new List<string>();
 var isConfirmed=booking.Status==BookingStatus.Confirmed;
 var isVerifiedConfirmed=isConfirmed && finance?.TotalVerifiedPayments>0;
 var isAwaitingStaff=booking.Status==BookingStatus.Pending;
 if(isAwaitingStaff) filterStates.Add("staff-review");
 if(booking.Status==BookingStatus.AwaitingDownpayment) filterStates.Add("awaiting-payment");
 if(booking.Status==BookingStatus.AwaitingVerification || booking.Status==BookingStatus.PaymentSubmitted || finance?.HasPendingVerification==true) filterStates.Add("payment-review");
 if(isConfirmed) filterStates.Add("confirmed");
 if(pendingChange!=null) filterStates.Add("reschedule");
 if(rejected) filterStates.Add("rejected");
 if(booking.Status==BookingStatus.Completed) filterStates.Add("completed");
 if(booking.Status==BookingStatus.Cancelled) filterStates.Add("cancelled");
 if(booking.Status==BookingStatus.Declined) filterStates.Add("declined");
 if(booking.Status==BookingStatus.Expired) filterStates.Add("expired");
 var deadline=paymentDeadlines.TryGetValue(booking.Id,out var currentDeadline)?currentDeadline:(DateTime?)null;
 var statusText=booking.Status==BookingStatus.Expired?"Expired":blocked?"Schedule unavailable":pendingChange!=null?"Reschedule requested":rejected?"Payment proof rejected":isConfirmed?"Booking confirmed":ClientBookingPresentation.Status(booking.Status);
 var statusTone=booking.Status==BookingStatus.Expired?"danger":blocked||rejected||booking.Status==BookingStatus.Cancelled||booking.Status==BookingStatus.Declined?"danger":pendingChange!=null||isAwaitingStaff||booking.Status==BookingStatus.AwaitingVerification?"warning":isConfirmed?"success":"neutral";
 var helper=booking.Status==BookingStatus.Expired?"This booking expired because no qualifying payment proof was submitted within 24 hours of Staff approval. Message Staff for assistance.":blocked?"This event schedule is no longer available. Review the booking before proceeding.":pendingChange!=null?"Staff will review your reschedule request. Your current booking schedule stays in place until approval.":rejected?"Your proof was not accepted. Check the review reason and upload a new eligible proof if permitted.":isVerifiedConfirmed?"Your verified payment has secured this event. Any remaining balance follows your booking payment policy.":isConfirmed?"This booking is marked confirmed, but no verified payment was recorded. Contact Staff if this is unexpected.":ClientBookingPresentation.NextAction(booking,finance);
 var canAction=!string.IsNullOrWhiteSpace(nextAction.Href)&&!nextAction.Href.EndsWith($"/Details/{booking.Id}",StringComparison.OrdinalIgnoreCase);
 <article class="r2-booking-card cr-booking-item" data-group="@(isActive?"active":"past")" data-status="@string.Join(" ",filterStates)">
  <div class="r2-booking-header">
   <div><span class="r2-overline">Booking ID</span><h2>BK-@booking.CreatedAt.Year-@booking.Id.ToString("D3")</h2></div>
   <span class="r2-status-pill r2-status-@statusTone">@statusText</span>
  </div>
  <div class="r2-booking-body">
   <div class="r2-booking-essentials">
    <div class="r2-event-facts"><p><i class="bi bi-calendar-event" aria-hidden="true"></i><strong>@booking.EventDate.ToString("ddd, MMM d, yyyy") · @booking.StartTime.ToString("h:mm tt")</strong></p>
    <p><i class="bi bi-geo-alt" aria-hidden="true"></i>@booking.PartyVenue</p>
    <p><i class="bi bi-stars" aria-hidden="true"></i>@booking.PackageName</p></div>
    <div class="r2-contact-facts"><div><i class="bi bi-person" aria-hidden="true"></i><span><small>Contact person</small>@booking.ContactPerson</span></div>
    <div><i class="bi bi-telephone" aria-hidden="true"></i><span><small>Contact number</small>@booking.ContactNumber</span></div></div>
    @if(booking.TravelFeeStatus is VenueLocationPolicy.PendingReview or VenueLocationPolicy.AwaitingCustomerAcceptance){<p class="r2-event-warning"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> @(booking.TravelFeeStatus==VenueLocationPolicy.PendingReview?"Venue/travel quote awaiting Staff review":"Your revised travel quote requires acceptance")</p>}
   </div>
   <aside class="r2-booking-context">
    @if(booking.Status==BookingStatus.AwaitingDownpayment && deadline.HasValue){
     <div class="ultra-payment-deadline"><strong>Payment proof deadline</strong><p>@AriesMagicAppointmentSystem.Services.InitialPaymentWindowPolicy.FormatManila(deadline.Value)</p><small>Submit a valid receipt before this deadline to keep your request active.</small></div>
    }
    @if(pendingChange!=null){
     <h3><i class="bi bi-calendar2-week" aria-hidden="true"></i> Reschedule details</h3>
     <dl><div><dt>Current schedule</dt><dd>@booking.EventDate.ToString("MMM d, yyyy") · @booking.StartTime.ToString("h:mm tt")</dd></div>
     <div><dt>Requested schedule</dt><dd>@pendingChange.RequestedDate.ToString("MMM d, yyyy") · @pendingChange.RequestedStartTime.ToString("h:mm tt")</dd></div>
     <div><dt>Review status</dt><dd><span class="r2-mini-status r2-mini-warning">Pending Staff review</span></dd></div></dl>
    }else if(rejected && lastPayment!=null){
     <h3><i class="bi bi-receipt" aria-hidden="true"></i> Payment review</h3>
     <dl><div><dt>Submitted amount</dt><dd>₱@lastPayment.Amount.ToString("N2")</dd></div>
      <div><dt>Review result</dt><dd><span class="r2-mini-status r2-mini-danger">Rejected</span></dd></div>
      @if(!string.IsNullOrWhiteSpace(lastPayment.RejectionReason??lastPayment.ReviewerNote)){<div><dt>Reason</dt><dd class="r2-reason">@(lastPayment.RejectionReason??lastPayment.ReviewerNote)</dd></div>}
      <div><dt>Action</dt><dd>Review proof or upload a replacement, when eligible</dd></div></dl>
    }else if(isVerifiedConfirmed && finance!=null){
     <h3><i class="bi bi-calendar-check" aria-hidden="true"></i> Confirmation & payment</h3>
     <dl><div><dt>Verified payment</dt><dd><span class="r2-mini-status r2-mini-success">₱@finance.TotalVerifiedPayments.ToString("N2")</span></dd></div>
      <div><dt>Additional balance</dt><dd>₱@finance.RemainingBalance.ToString("N2")</dd></div>
      <div><dt>Payment status</dt><dd>@finance.PaymentStatus</dd></div>
      <div><dt>Booking status</dt><dd><span class="r2-mini-status r2-mini-success">Confirmed</span></dd></div></dl>
    }else if(finance!=null){
     <h3><i class="bi bi-wallet2" aria-hidden="true"></i> @(isAwaitingStaff?"Booking review":"Payment progress")</h3>
     <dl><div><dt>Booking total</dt><dd>₱@finance.BookingTotal.ToString("N2")</dd></div>
      <div><dt>Verified payments</dt><dd>₱@finance.TotalVerifiedPayments.ToString("N2")</dd></div>
      <div><dt>Remaining balance</dt><dd>@(booking.TravelFeeStatus==VenueLocationPolicy.PendingReview?"Travel quote pending":$"₱{finance.RemainingBalance:N2}")</dd></div>
      <div><dt>Review status</dt><dd>@(isAwaitingStaff?"Awaiting Staff review":finance.PaymentStatus)</dd></div></dl>
    }else{
      <h3><i class="bi bi-info-circle" aria-hidden="true"></i> Booking overview</h3>
      <dl><div><dt>Booking status</dt><dd>@statusText</dd></div><div><dt>Event package</dt><dd>@booking.PackageName</dd></div></dl>
    }
   </aside>
  </div>
  @if(finance!=null && !isAwaitingStaff && pendingChange==null && booking.TravelFeeStatus!=VenueLocationPolicy.PendingReview){
   <div class="r2-booking-payment-strip"><span>Verified payment progress</span><progress value="@Math.Clamp(finance.TotalVerifiedPayments,0,Math.Max(1,finance.BookingTotal))" max="@Math.Max(1,finance.BookingTotal)" aria-label="Verified amount out of booking total"></progress><strong>₱@finance.TotalVerifiedPayments.ToString("N2") / ₱@finance.BookingTotal.ToString("N2")</strong></div>
  }
  <footer class="r2-booking-footer"><p><i class="bi bi-info-circle" aria-hidden="true"></i>@(helper)</p><div class="r2-booking-buttons">
   @if(canAction){<a href="@nextAction.Href" class="r2-secondary-action">@nextAction.Label</a>}
   <a asp-action="Details" asp-route-id="@booking.Id" class="r2-view-booking">View booking <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
  </footer>
 </article>
}
</div>
<section class="hub-card hub-empty" id="bookingListEmpty" hidden="@(bookings.Count>0)"><h2>No bookings to show.</h2><p>@(bookings.Any()?"Try another search or change the booking filter.":"When you book your first event, it will appear here with schedules, payments and next actions.")</p><a asp-action="CreateStepOne" class="cn-button cn-primary">Plan an event</a></section>
<nav class="aries-five-pager aries-client-five-pager" aria-label="My booking pages">
 <span id="bookingListCount" class="aries-five-total" role="status"></span>
 <div class="aries-five-actions">
  <button type="button" class="btn btn-outline-secondary" id="clientBookingPrev" aria-label="Previous page" disabled><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
  <span class="aries-five-page" id="clientBookingPage" aria-live="polite">Page 1 of 1</span>
  <button type="button" class="btn btn-primary" id="clientBookingNext" aria-label="Next page" disabled><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
 </div>
</nav>
@section Scripts {
<script src="~/js/aries-round3-client-bookings.js" asp-append-version="true"></script>
}
