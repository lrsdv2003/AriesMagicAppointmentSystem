@model AriesMagicAppointmentSystem.ViewModels.InternalProfileViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Change Password";
    ViewData["HideWorkspaceHeading"] = true;
}
<div class="unified-profile owner-password-workspace" data-role="Owner">
    <header class="up-header">
        <div>
            <h1>Change Password</h1>
            <p>Update your password using your current credentials.</p>
        </div>
        <a asp-controller="InternalProfile" asp-action="Index" class="up-btn up-btn-outline">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Profile
        </a>
    </header>
    @if (TempData["ProfileSuccess"] is string success)
    {
        <p class="up-feedback up-success" role="status">@success</p>
    }
    @if (TempData["ProfileWarning"] is string warning)
    {
        <p class="up-feedback up-warning" role="status">@warning</p>
    }
    @if (TempData["Error"] is string error)
    {
        <p class="up-feedback up-error" role="alert">@error</p>
    }
    <div asp-validation-summary="ModelOnly" class="up-feedback up-error" role="alert"></div>
    <section class="up-card owner-password-card" aria-labelledby="ownerChangePasswordHeading">
        <div class="up-card-heading">
            <h2 id="ownerChangePasswordHeading">Change Password</h2>
            <p>Your password will only change after your current password is verified.</p>
        </div>
        <partial name="_UnifiedPasswordForm" model="Model" />
    </section>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/internal-profile.js" asp-append-version="true"></script>
}
