@model AriesMagicAppointmentSystem.ViewModels.FeedbackListPage
@{Layout="_DashboardLayout";ViewData["Title"]="Testimonials & Feedback";}
<section class="ui-panel"><header class="ui-toolbar"><div><h2>Feedback review</h2><p>Review completed-event experiences. Consent always comes first.</p></div></header>
@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}
<form method="get" class="feedback-filters"><label for="testimonialFilter">Status<select id="testimonialFilter" name="filter" class="form-select">@foreach(var filter in new[]{"Pending","Approved","Featured","NotFeatured","Withdrawn","All"}){<option selected="@(Model.Filter==filter)" value="@filter">@filter</option>}</select></label><label for="testimonialSearch">Search package or display name<input type="search" id="testimonialSearch" name="q" value="@Model.Search" maxlength="100" class="form-control" /></label><button class="btn btn-primary">Apply</button><a asp-action="Index" class="btn btn-light">Reset</a></form>
<div class="table-responsive feedback-table-wrap"><table class="table"><caption>@Model.Total feedback submissions match this view</caption><thead><tr><th>Booking / client display name</th><th>Event date</th><th>Overall</th><th>Submitted</th><th>Status</th><th>Consent</th><th>Photos</th><th>Review</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>BK-@item.BookingId · @(string.IsNullOrEmpty(item.PublicDisplayName)?"Name not shared":item.PublicDisplayName)<br/>@item.Booking.PackageName</td><td>@item.Booking.EventDate.ToString("MMM d, yyyy")</td><td>@item.OverallRating / 5</td><td>@item.SubmittedAtUtc.ToString("MMM d, yyyy") UTC</td><td>@item.ModerationStatus @(item.Featured?"· Featured":"· Not featured")</td><td>@(item.TextConsent&&item.WithdrawnAtUtc==null?"Active":"Private / withdrawn")</td><td>@item.Media.Count</td><td><a asp-action="Review" asp-route-id="@item.Id" class="btn btn-outline-secondary">Review <span class="visually-hidden">feedback @item.Id</span></a></td></tr>}</tbody></table></div>
@if(Model.Items.Count==0){<p>No feedback matches this view.</p>}
<nav class="feedback-pagination" aria-label="Testimonial pages">@if(Model.Page>1){<a asp-action="Index" asp-route-filter="@Model.Filter" asp-route-q="@Model.Search" asp-route-page="@(Model.Page-1)" class="btn btn-outline-secondary">Previous</a>}<span>Page @Model.Page of @Model.Pages</span>@if(Model.Page<Model.Pages){<a asp-action="Index" asp-route-filter="@Model.Filter" asp-route-q="@Model.Search" asp-route-page="@(Model.Page+1)" class="btn btn-outline-secondary">Next</a>}</nav></section>
