@model AriesMagicAppointmentSystem.Models.EventFeedback
@{Layout="_DashboardLayout";ViewData["Title"]="Review feedback";var canApprove=Model.TextConsent&&Model.WithdrawnAtUtc==null&&AriesMagicAppointmentSystem.Services.FeedbackPolicy.Eligible(Model.Booking)&&!string.IsNullOrWhiteSpace(Model.Experience)&&AriesMagicAppointmentSystem.Services.FeedbackPolicy.SafePublicText(Model.Experience)&&(!Model.NameConsent||AriesMagicAppointmentSystem.Services.FeedbackPolicy.SafePublicText(Model.PublicDisplayName));}
<section class="ui-panel"><header class="ui-toolbar"><div><h2>Completed-event feedback</h2><p>BK-@Model.BookingId · @Model.Booking.PackageName · @Model.Booking.EventDate.ToString("MMM d, yyyy")</p></div><a asp-action="Index" class="btn btn-outline-secondary">All feedback</a></header>
@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}
<dl class="cr-facts"><div><dt>Overall / performance / booking</dt><dd>@Model.OverallRating / @Model.PerformanceRating / @Model.BookingRating (out of 5)</dd></div><div><dt>Moderation</dt><dd>@Model.ModerationStatus @(Model.Featured?"· Featured":"· Not featured")</dd></div><div><dt>Public text consent</dt><dd>@(Model.TextConsent&&Model.WithdrawnAtUtc==null?"Active":"Absent or withdrawn")</dd></div><div><dt>Name permission</dt><dd>@(Model.NameConsent?Model.PublicDisplayName:"Use Verified client")</dd></div><div><dt>Photo permission</dt><dd>@(Model.MediaConsent?"Active":"Absent")</dd></div></dl>
<h2>Public experience answer</h2><p class="feedback-answer">@(Model.Experience==""?"No written answer supplied.":Model.Experience)</p><h2>Private suggestions — never published</h2><p class="feedback-answer">@Model.Suggestions</p><h2>Submitted photos</h2><partial name="_FeedbackMedia" model="Model.Media" />
<form asp-action="Review" method="post" class="feedback-review-form">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.Id" /><input type="hidden" name="Version" value="@Convert.ToBase64String(Model.Version)" />
@if(!canApprove){<p class="alert alert-warning">This submission lacks active public consent, completed-event eligibility, or publishable text. It cannot be approved or featured. Staff cannot edit client answers.</p>}
<fieldset><legend>Photos eligible for public display</legend>@foreach(var media in Model.Media){<label class="form-check"><input type="checkbox" name="PublicMediaIds" value="@media.Id" checked="@media.PublicApproved" disabled="@(!Model.MediaConsent||media.ProcessingStatus!="Ready"||media.ScannedAtUtc==null)" /> @media.DisplayFilename · @media.ProcessingStatus</label>}</fieldset>
<label for="moderationReason" class="form-label">Moderation reason (optional, private)</label><textarea id="moderationReason" name="Reason" class="form-control" maxlength="500" rows="2"></textarea>
<label class="form-check my-3"><input type="checkbox" name="ConfirmPublication" value="true" required /> I reviewed the client's consent choices, contact details, content suitability, and permissions for selected photos. I confirm this moderation change.</label>
<div class="feedback-review-actions"><button name="Decision" value="Approve" class="btn btn-primary" disabled="@(!canApprove)">Approve, keep unfeatured</button><button name="Decision" value="Feature" class="btn btn-success" disabled="@(!canApprove||Model.ModerationStatus!="Approved")">Feature approved testimonial</button><button name="Decision" value="Unfeature" class="btn btn-outline-secondary">Unfeature</button><button name="Decision" value="Private" class="btn btn-outline-danger">Keep private / decline</button></div>
</form><h2 class="mt-4">Publication history</h2><ol>@foreach(var entry in Model.PublicationEvents.OrderByDescending(e=>e.AtUtc)){<li>@entry.AtUtc.ToString("yyyy-MM-dd HH:mm") UTC · @entry.Action · Actor @entry.ActorId <p>@entry.Reason</p></li>}</ol></section>
