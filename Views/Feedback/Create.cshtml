@model AriesMagicAppointmentSystem.ViewModels.FeedbackInput
@inject Microsoft.Extensions.Options.IOptions<AriesMagicAppointmentSystem.Services.FeedbackMediaOptions> MediaOptions
@{ Layout="_ClientHubLayout";  ViewData["Title"]="Share your experience"; var limits=MediaOptions.Value; }
<header class="cr-page-heading"><div><span class="cr-eyebrow">After the applause / @Model.EventLabel</span><h1>How was your celebration?</h1><p>Three ratings. Your words, if you wish. Public sharing is always optional.</p></div><a asp-action="Index" class="btn btn-outline-secondary">My feedback</a></header>
<form asp-action="Create" method="post" enctype="multipart/form-data" id="clientFeedbackForm" class="feedback-form" data-max-files="@limits.MaxImages" data-max-bytes="@limits.MaxImageBytes" data-max-video-bytes="@limits.MaxVideoBytes">
@Html.AntiForgeryToken()
<input asp-for="BookingId" type="hidden" />
<div asp-validation-summary="All" id="feedbackFormErrors" class="alert alert-danger" role="alert" tabindex="-1"></div>
<section class="cr-card"><h2>The experience</h2><p>All three ratings are required. Choose one answer per question.</p>
@foreach(var question in new[]{("OverallRating","How would you rate your overall experience?"),("PerformanceRating","How satisfied were you with the entertainment or performance?"),("BookingRating","How easy was the booking process?")})
{
 var value=question.Item1=="OverallRating"?Model.OverallRating:question.Item1=="PerformanceRating"?Model.PerformanceRating:Model.BookingRating;
 <fieldset class="feedback-rating"><legend>@question.Item2</legend><div class="feedback-rating-options">
 @for(var rating=1;rating<=5;rating++){<label><input type="radio" name="@question.Item1" value="@rating" checked="@(value==rating)" required /><span>@rating</span><small>@(rating==1?"Very poor":rating==2?"Poor":rating==3?"Fair":rating==4?"Good":"Excellent")</small></label>}
 </div></fieldset>
}
</section>
<section class="cr-card"><h2>In your own words</h2><label asp-for="Experience" class="form-label">What did you enjoy most? <span class="text-muted">(optional, up to 1,500 characters)</span></label><textarea asp-for="Experience" class="form-control" rows="4" maxlength="1500" aria-describedby="experienceHelp"></textarea><p id="experienceHelp" class="form-text">This is the only written answer that may become a public testimonial, if you opt in below.</p>
<label asp-for="Suggestions" class="form-label mt-4">Is there anything we could improve? <span class="text-muted">(optional)</span></label><textarea asp-for="Suggestions" class="form-control" rows="3" maxlength="1500" aria-describedby="suggestionsHelp"></textarea><p id="suggestionsHelp" class="form-text">Private operational feedback. Suggestions are never included in public testimonials.</p></section>
@if(limits.CanUpload)
{
<details class="hub-feedback-extra cr-card"><summary>Add event photos or a video <span>Optional</span></summary><div class="hub-disclosure-body"><h2>A memory from your event</h2><label asp-for="Files" class="form-label">Optional event photos and one MP4 video</label><input asp-for="Files" type="file" multiple class="form-control" accept=".jpg,.jpeg,.png,.webp,.mp4,image/jpeg,image/png,image/webp,video/mp4" aria-describedby="mediaHelp" /><p id="mediaHelp" class="form-text">Up to @limits.MaxImages JPEG, PNG, or WebP photos, @(@limits.MaxImageBytes/1024/1024) MB each, and one MP4 video up to @(@limits.MaxVideoBytes/1024/1024) MB. Media is privately stored and must pass signature validation and malware scanning before preview. Public photo selection requires your separate permission and Staff approval; video remains private.</p><div id="feedbackPreviews" class="feedback-previews" role="region" aria-label="Selected media previews"></div></div></details>
}
else
{
<section class="cr-card"><h2>Event photos and video</h2><p>@AriesMagicAppointmentSystem.Services.FeedbackMediaOptions.UploadsUnavailableMessage</p></section>
}
<details class="hub-feedback-extra cr-card"><summary>Public sharing permissions <span>Optional</span></summary><div class="hub-disclosure-body"><h2>Your words. Your choice.</h2><p>Your required public/private decision is collected when you submit. Nothing is published without Staff approval.</p>
<label class="cr-check"><input asp-for="NameConsent" /><span>I permit the display name below to appear with my testimonial. Otherwise, use “Verified client”.</span></label>
<label asp-for="PublicDisplayName" class="form-label">Public display name <span class="text-muted">(optional unless name sharing is selected)</span></label><input asp-for="PublicDisplayName" class="form-control" maxlength="60" autocomplete="off" placeholder="For example, a first name or initials" />
@if(limits.CanUpload)
{
<label class="cr-check"><input asp-for="MediaConsent" /><span>I permit Staff to select processed event photos for public display with my testimonial, and confirm I have permission to share them.</span></label>
}
<p class="form-text">You can withdraw all public-sharing consent from your feedback details at any time. Withdrawal promptly hides the testimonial and its public media.</p></div></details>
<div class="feedback-submit"><div id="feedbackUploadStatus" role="status" aria-live="polite"></div><progress id="feedbackUploadProgress" max="100" value="0" aria-label="Feedback upload progress" hidden></progress><button type="button" class="btn btn-primary" id="openFeedbackConsent">Review sharing choice &amp; submit</button></div>
<dialog id="feedbackConsentDialog" class="cn-terms-dialog" aria-labelledby="feedbackConsentTitle"><header><h2 id="feedbackConsentTitle">Choose how your feedback may be shared</h2><button type="button" data-close-feedback-consent aria-label="Close sharing choice">×</button></header><p>Choose one. Your feedback stays available to authorized Staff for moderation. Public sharing does not bypass Staff approval.</p><fieldset><legend>Required sharing preference</legend><label class="cr-check"><input type="radio" name="SharingPreference" value="Public" required/><span><strong>Share My Feedback Publicly</strong><br/>Your written feedback and any separately approved media may appear on the public Aries d’ Magic Artist website after Staff moderation.</span></label><label class="cr-check"><input type="radio" name="SharingPreference" value="Private" required/><span><strong>Keep My Feedback Private</strong><br/>Your feedback remains available only to authorized internal Staff for review and service improvement.</span></label></fieldset><p id="sharingChoiceError" class="text-danger" role="alert" hidden>Choose one sharing option to continue.</p><footer><button type="button" class="btn btn-outline-secondary" data-close-feedback-consent>Review feedback</button><button type="button" class="btn btn-primary" id="confirmFeedbackConsent">Submit feedback</button></footer></dialog>
</form>
@section Scripts {<script src="~/js/feedback.js" asp-append-version="true"></script>}
