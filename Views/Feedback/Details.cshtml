@model AriesMagicAppointmentSystem.Models.EventFeedback
@using AriesMagicAppointmentSystem.Services
@{ViewData["Title"]="Your feedback";}
<header class="cr-page-heading"><div><span class="cr-eyebrow">Your feedback / @Model.Booking.EventDate.ToString("MMMM d, yyyy")</span><h1>Thank you for sharing.</h1><p>@Model.Booking.PackageName</p></div><a asp-action="Index" class="btn btn-outline-secondary">My feedback</a></header>
@if(TempData["Success"] is string message){<div class="alert alert-success" role="status">@message</div>}
<div class="cr-detail-grid"><div><section class="cr-card"><h2>Your experience</h2><dl class="cr-facts"><div><dt>Overall experience</dt><dd>@Model.OverallRating / 5</dd></div><div><dt>Performance</dt><dd>@Model.PerformanceRating / 5</dd></div><div><dt>Booking experience</dt><dd>@Model.BookingRating / 5</dd></div><div><dt>Submitted</dt><dd>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(Model.SubmittedAtUtc,DateTimeKind.Utc),FeedbackPolicy.BusinessZone).ToString("MMM d, yyyy · h:mm tt") Manila time</dd></div></dl><h3>What you enjoyed</h3><p class="feedback-answer">@(string.IsNullOrWhiteSpace(Model.Experience)?"No written answer supplied.":Model.Experience)</p><h3>Private suggestions</h3><p class="feedback-answer">@(string.IsNullOrWhiteSpace(Model.Suggestions)?"No suggestions supplied.":Model.Suggestions)</p></section><section class="cr-card mt-4"><h2>Your event photos</h2><partial name="_FeedbackMedia" model="Model.Media" /></section></div><aside class="cr-card cr-price-summary"><h2>Public sharing</h2><p>@(Model.Featured?"Featured on the website":Model.ModerationStatus)</p><dl class="cr-facts"><div><dt>Experience and rating</dt><dd>@(Model.TextConsent?"Permitted":"Private")</dd></div><div><dt>Display name</dt><dd>@(Model.NameConsent?Model.PublicDisplayName:"Not shared")</dd></div><div><dt>Selected photos</dt><dd>@(Model.MediaConsent?"Permitted after security checks":"Private")</dd></div></dl><p>Your suggestions are always private. Staff cannot change your ratings or written answers.</p>@if(Model.WithdrawnAtUtc==null&&(Model.TextConsent||Model.MediaConsent||Model.NameConsent)){<form asp-action="Withdraw" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><p>Withdrawing promptly removes your public testimonial and media.</p><button class="btn btn-outline-danger" type="submit">Withdraw public consent</button></form>}else if(Model.WithdrawnAtUtc!=null){<p class="cr-notice">Public consent has been withdrawn.</p>}</aside></div>
