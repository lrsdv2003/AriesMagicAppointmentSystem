@model AriesMagicAppointmentSystem.ViewModels.ClientFeedbackPage
@{ ViewData["Title"]="My feedback"; }
<header class="cr-page-heading"><div><span class="cr-eyebrow">Your celebrations / Feedback</span><h1>The view from your table.</h1><p>Share a completed-event experience and review the feedback you’ve sent.</p></div><a asp-controller="Bookings" asp-action="MyBookings" class="btn btn-outline-secondary">My bookings</a></header>
@if(Model.Eligible.Count>0){<section class="cr-card mb-4"><h2>A moment to look back</h2>@foreach(var booking in Model.Eligible){<div class="feedback-event-row"><div><strong>@booking.PackageName</strong><p>@booking.EventDate.ToString("MMM d, yyyy")</p></div><a asp-action="Create" asp-route-bookingId="@booking.Id" class="btn btn-primary">Share your experience</a></div>}</section>}
<div class="feedback-history">
@foreach(var item in Model.Items){<article class="cr-card"><span class="cr-eyebrow">@item.Booking.EventDate.ToString("MMMM d, yyyy")</span><h2>@item.Booking.PackageName</h2><p>@item.OverallRating / 5 · Overall experience</p><p>@(item.Featured?"Featured publicly":item.WithdrawnAtUtc!=null?"Public consent withdrawn":item.ModerationStatus=="Approved"?"Approved, not featured":item.ModerationStatus=="Pending"?"Awaiting Staff review":"Kept private")</p><p>Submitted @TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(item.SubmittedAtUtc,DateTimeKind.Utc),AriesMagicAppointmentSystem.Services.FeedbackPolicy.BusinessZone).ToString("MMM d, yyyy") Manila time</p><a asp-action="Details" asp-route-id="@item.Id" class="cx-text-link">View your feedback →</a></article>}
</div>
@if(Model.Items.Count==0){<section class="cr-card cr-empty"><h2>Your story is still to come.</h2><p>You haven’t submitted feedback yet. Eligible completed events appear above.</p></section>}
@if(Model.Pages>1){<nav class="feedback-pagination" aria-label="Feedback pages">@if(Model.Page>1){<a asp-action="Index" asp-route-page="@(Model.Page-1)" class="btn btn-outline-secondary">Previous</a>}<span>Page @Model.Page of @Model.Pages</span>@if(Model.Page<Model.Pages){<a asp-action="Index" asp-route-page="@(Model.Page+1)" class="btn btn-outline-secondary">Next</a>}</nav>}
