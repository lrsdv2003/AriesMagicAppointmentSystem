@model AriesMagicAppointmentSystem.ViewModels.ClientFeedbackPage
@{Layout="_ClientHubLayout";ViewData["Title"]="My feedback";}
<header class="hub-heading"><div><span class="hub-kicker">After the applause</span><h1>Your experience matters.</h1><p>Share a completed-event experience. Your private feedback and public-sharing choices stay separate.</p></div><a asp-controller="Bookings" asp-action="MyBookings" class="cn-text-link">My bookings</a></header>
@if(Model.Eligible.Count>0){<section class="hub-card hub-feedback-eligible"><div class="hub-section-heading"><h2>Ready to look back?</h2><span class="hub-help">Completed events only</span></div>@foreach(var booking in Model.Eligible){<div class="feedback-event-row"><div><strong>@booking.PackageName</strong><p>@booking.EventDate.ToString("MMM d, yyyy")</p></div><a asp-action="Create" asp-route-bookingId="@booking.Id" class="cn-button cn-primary">Share your experience</a></div>}</section>}
else if(Model.Items.Count==0){<section class="hub-card hub-empty"><h2>No event is ready for feedback yet.</h2><p>Eligible completed events will appear here. Until then, your booking details have the latest status and next steps.</p><a asp-controller="Bookings" asp-action="MyBookings" class="cn-text-link">View my bookings</a></section>}
@if(Model.Items.Count>0){<section class="hub-feedback-history"><div class="hub-section-heading"><h2>Feedback you’ve shared</h2></div><div class="cn-records">@foreach(var item in Model.Items){<article class="cn-record"><div class="hub-section-heading"><div><span class="hub-reference">@item.Booking.EventDate.ToString("MMMM d, yyyy")</span><h3>@item.Booking.PackageName</h3></div><strong>@item.OverallRating / 5 <span class="visually-hidden">Overall experience</span></strong></div><p class="hub-help">@(item.Featured?"Featured publicly":item.WithdrawnAtUtc!=null?"Public consent withdrawn":item.ModerationStatus=="Approved"?"Approved, not featured":item.ModerationStatus=="Pending"?"Awaiting Staff review":"Kept private")</p><a asp-action="Details" asp-route-id="@item.Id" class="cn-text-link">View feedback & sharing preferences <span aria-hidden="true">→</span></a></article>}</div></section>}
@if(Model.Pages>1){<nav class="feedback-pagination" aria-label="Feedback pages">@if(Model.Page>1){<a asp-action="Index" asp-route-page="@(Model.Page-1)" class="cn-button cn-secondary">Previous</a>}<span>Page @Model.Page of @Model.Pages</span>@if(Model.Page<Model.Pages){<a asp-action="Index" asp-route-page="@(Model.Page+1)" class="cn-button cn-secondary">Next</a>}</nav>}
