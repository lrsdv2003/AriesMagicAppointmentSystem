@model AriesMagicAppointmentSystem.ViewModels.HistoryIndexViewModel
@using AriesMagicAppointmentSystem.ViewModels
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "History";
    var financial = User.IsInRole("Owner");
}
<div class="ui-page history-page">
<partial name="_HistoryFilters" model="Model" />
<div class="ui-toolbar">
<p class="ui-result-count">@Model.TotalCount record@(Model.TotalCount==1?"":"s")</p>
@if(financial) {
<div class="dropdown">
<button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" id="historyExport">Export</button>
<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="historyExport">
<li><a class="dropdown-item" asp-action="Print" asp-all-route-data="@HistoryPresentation.Routes(Model.Filters)" target="_blank">Print</a></li>
<li><a class="dropdown-item" asp-action="ExportCsv" asp-all-route-data="@HistoryPresentation.Routes(Model.Filters)">CSV</a></li>
<li><a class="dropdown-item" asp-action="ExportPdf" asp-all-route-data="@HistoryPresentation.Routes(Model.Filters)">PDF</a></li>
</ul></div>
}
</div>
@if(!Model.Bookings.Any()) {
<div class="ui-empty" role="status"><p>@(HistoryPresentation.Filtered(Model.Filters) ? "No records match the selected filters." : "No history records found.")</p>
@if(HistoryPresentation.Filtered(Model.Filters)) { <a asp-action="Index" class="btn btn-outline-secondary">Clear Filters</a> }</div>
} else {
<div class="ui-table-wrap">
<table class="ui-table ui-table-responsive"><caption class="visually-hidden">Historical booking records</caption>
<thead><tr><th scope="col">Booking / Client</th><th scope="col">Event date &amp; time</th><th scope="col">Package</th><th scope="col">@(financial ? "Payment review" : "Venue")</th><th scope="col">Final status</th><th scope="col">Details</th></tr></thead>
<tbody>@foreach(var row in Model.Bookings) {
<tr><td data-label="Booking / Client"><strong>@row.BookingCode</strong><span class="ui-cell-secondary">@row.ClientName</span></td>
<td data-label="Event"><span>@row.EventDate.ToString("MMM d, yyyy")</span><span class="ui-cell-secondary">@row.StartTime.ToString("h:mm tt") &ndash; @row.EndTime.ToString("h:mm tt")</span></td>
<td data-label="Package">@row.PackageName</td>
<td data-label="@(financial?"Payment review":"Venue")">@if(financial){<partial name="_StatusBadge" model="row.PaymentStatus" />}else{@row.Venue}</td>
<td data-label="Final status"><partial name="_StatusBadge" model="row.BookingStatus" /></td>
<td data-label="Details"><a asp-action="Details" asp-route-id="@row.Id" class="btn btn-outline-secondary" aria-label="View @row.BookingCode details">Details</a></td></tr>
}</tbody></table></div>
}
@if(Model.TotalPages>1) {
<nav class="ui-pagination" aria-label="History pages">
@if(Model.Filters.Page>1) { <a class="btn btn-outline-secondary" asp-action="Index" asp-all-route-data="@HistoryPresentation.Routes(Model.Filters,Model.Filters.Page-1)">Previous</a> }
<span aria-live="polite">Page @Model.Filters.Page of @Model.TotalPages</span>
@if(Model.Filters.Page<Model.TotalPages) { <a class="btn btn-outline-secondary" asp-action="Index" asp-all-route-data="@HistoryPresentation.Routes(Model.Filters,Model.Filters.Page+1)">Next</a> }
</nav>
}
</div>
