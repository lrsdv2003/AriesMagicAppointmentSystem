@model AriesMagicAppointmentSystem.ViewModels.HistoryIndexViewModel
@using AriesMagicAppointmentSystem.ViewModels
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "History";
    var financial = User.IsInRole("Owner");
    if (financial) ViewData["HideWorkspaceHeading"] = true;
    var historyPager = new QueuePaginationViewModel(
        Model.TotalCount, Model.Filters.Page, 5, "Index", HistoryPresentation.Routes(Model.Filters))
    {
        ShowTotalForStaff = !financial,
        HideSinglePageControls = !financial
    };
    var filteredEmpty = financial ? HistoryPresentation.Filtered(Model.Filters) || Model.Summary.HistoryCount > 0 : Model.Summary.HistoryCount > 0;
}
<div class="ui-page history-page staff-final-round-history @(financial ? "owner-history-workspace owner-financial-page owner-payment-verification" : "")">
@if (financial)
{
    <div class="owner-history-toolbar">
        <partial name="_HistoryFilters" model="Model" />
    </div>
    <p id="ownerHistoryRefreshStatus" class="owner-history-refresh-feedback" role="alert" aria-live="assertive" hidden></p>
}
else
{
    <partial name="_HistoryFilters" model="Model" />
}
<div data-staff-search-results="history" id="historyResults">
    <div class="staff-data-table-frame @(financial ? "owner-history-table-frame owner-verification-table-frame" : "staff-history-table-frame")"
         data-staff-table-capacity="5">
        @if (financial) { @:<div class="dashboard-panel owner-table-panel staff-data-table-panel"> }
        <div class="ui-table-wrap staff-data-table-scroll" tabindex="0" role="region"
             aria-label="Historical booking records; scroll horizontally to view all columns">
            <table class="ui-table staff-data-table @(financial ? "owner-history-table table owner-audit-table align-middle" : "staff-history-table")">
                <caption class="visually-hidden">Historical booking records</caption>
                @if (financial)
                {
                    <colgroup>
                        <col class="owner-history-col-booking" />
                        <col class="owner-history-col-event" />
                        <col class="owner-history-col-package" />
                        <col class="owner-history-col-payment" />
                        <col class="owner-history-col-status" />
                        <col class="owner-history-col-actions" />
                    </colgroup>
                }
                else
                {
                    <colgroup>
                        <col class="staff-col-booking" />
                        <col class="staff-col-event" />
                        <col class="staff-col-package" />
                        <col class="staff-col-client" />
                        <col class="staff-col-status" />
                        <col class="staff-col-actions" />
                    </colgroup>
                }
                <thead>
                    <tr>
                        <th scope="col">@(financial ? "Booking / Client" : "Booking ID")</th>
                        <th scope="col">Event date &amp; time</th>
                        <th scope="col">Package</th>
                        <th scope="col">@(financial ? "Payment status" : "Client Name")</th>
                        <th scope="col">Final status</th>
                        <th scope="col">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Bookings.Any())
                    {
                        <tr class="staff-data-table-empty-row">
                            <td colspan="6">
                                <div class="staff-data-table-empty" role="status">
                                    <i class="bi bi-inbox" aria-hidden="true"></i>
                                    @if (filteredEmpty)
                                    {
                                        <strong>No matching records</strong>
                                        <p>Try adjusting your search or filters.</p>
                                        <a asp-controller="History" asp-action="Index" class="staff-data-table-reset">Clear filters</a>
                                    }
                                    else
                                    {
                                        <strong>No booking history</strong>
                                        <p>No historical booking records are available.</p>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in Model.Bookings)
                        {
                            <tr>
                                <td data-label="@(financial ? "Booking / Client" : "Booking ID")">
                                    <strong class="@(financial ? "owner-booking-code" : "")">@row.BookingCode</strong>
                                    @if (financial)
                                    {
                                        <span class="ui-cell-secondary @(financial ? "owner-cell-subtext" : "")">@row.ClientName</span>
                                    }
                                </td>
                                <td data-label="Event">
                                    <span>@row.EventDate.ToString("MMM d, yyyy")</span>
                                    <span class="ui-cell-secondary">@row.StartTime.ToString("h:mm tt") &ndash; @row.EndTime.ToString("h:mm tt")</span>
                                </td>
                                <td data-label="Package">@row.PackageName</td>
                                @if (financial)
                                {
                                    <td data-label="Payment status"><partial name="_StatusBadge" model="row.PaymentStatus" /></td>
                                }
                                else
                                {
                                    <td data-label="Client Name">@row.ClientName</td>
                                }
                                <td data-label="Final status"><partial name="_StatusBadge" model="row.BookingStatus" /></td>
                                <td data-label="Details">
                                    <a asp-action="Details" asp-route-id="@row.Id" class="btn @(financial ? "btn-sm btn-primary" : "btn-outline-primary")"
                                       aria-label="View Details for @row.BookingCode">View Details</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (financial) { @:</div> }
        <partial name="_QueuePagination" model="historyPager" />
    </div>
</div>
</div>
@section Scripts {
    @if (financial)
    {
        <script src="~/js/owner-history.js" asp-append-version="true"></script>
    }
}
