@model AriesMagicAppointmentSystem.ViewModels.HistoryDetailsViewModel
@using AriesMagicAppointmentSystem.ViewModels
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = Model.BookingCode;
    var booking = Model.Booking;
    var financial = User.IsInRole("Owner");
    var events = Model.Timeline.Where(t=>HistoryPresentation.ShowEvent(t.EventType,financial)).OrderBy(t=>t.CreatedAt).ToList();
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
}
<div class="ui-page">
<div class="ui-toolbar"><div class="ui-inline"><partial name="_StatusBadge" model="booking.Status" /><span class="ui-muted">Read-only record</span></div><a asp-action="Index" class="btn btn-outline-secondary">Back to History</a></div>
<div class="ui-detail-grid">
<div class="ui-section-stack">
<section class="ui-panel" aria-labelledby="historyEventHeading"><h2 id="historyEventHeading">Booking &amp; Event</h2>
<dl class="ui-facts">
<div><dt>Client</dt><dd>@(booking.Client?.FullName??"Not recorded")</dd></div>
<div><dt>Contact number</dt><dd>@(string.IsNullOrWhiteSpace(booking.ContactNumber)?"Not provided":booking.ContactNumber)</dd></div>
<div><dt>Event</dt><dd>@Text(booking.EventType)</dd></div>
<div><dt>Package</dt><dd>@Text(booking.PackageName)</dd></div>
<div><dt>Event date</dt><dd>@booking.EventDate.ToString("MMM d, yyyy")</dd></div>
<div><dt>Schedule</dt><dd>@booking.StartTime.ToString("h:mm tt") &ndash; @booking.EndTime.ToString("h:mm tt")</dd></div>
<div class="ui-wide"><dt>Venue</dt><dd>@Text(booking.PartyVenue)</dd></div>
<div><dt>Guests</dt><dd>@booking.PaxCount</dd></div>
@if(booking.Status=="Completed") { <div><dt>Completed</dt><dd>@(Model.CompletedAt?.ToString("MMM d, yyyy h:mm tt")??"Not recorded")</dd></div> }
</dl></section>
@if(financial) {
<section class="ui-panel" aria-labelledby="historyFinanceHeading"><h2 id="historyFinanceHeading">Payment Summary</h2>
<dl class="ui-facts">
<div><dt>Booking total</dt><dd>PHP @((Model.FinancialSummary?.BookingTotal??booking.FinalPrice).ToString("N2"))</dd></div>
<div><dt>Verified payments</dt><dd>PHP @Model.AmountPaid.ToString("N2")</dd></div>
<div><dt>Remaining booking balance</dt><dd>PHP @Model.RemainingBalance.ToString("N2")</dd></div>
<div><dt>Payment state</dt><dd><partial name="_StatusBadge" model="@(Model.FinancialSummary?.PaymentStatus??Model.PaymentStatus)" /></dd></div>
@if(Model.Refund!=null) {
<div><dt>Latest refund</dt><dd><partial name="_StatusBadge" model="Model.RefundStatus" /></dd></div>
<div><dt>Requested refund</dt><dd>PHP @Model.Refund.Amount.ToString("N2")</dd></div>
<div><dt>Completed refunds</dt><dd>PHP @((Model.FinancialSummary?.CompletedRefunds??0).ToString("N2"))</dd></div>
<div><dt>Net collected</dt><dd>PHP @((Model.FinancialSummary?.NetCollected??Model.AmountPaid).ToString("N2"))</dd></div>
}
</dl></section>
}
</div>
<section class="ui-panel" aria-labelledby="historyTimelineHeading"><h2 id="historyTimelineHeading">Activity Timeline</h2>
@if(events.Count==0){<p class="ui-muted">No timeline events recorded.</p>}else{
<ol class="ui-timeline">@foreach(var item in events) {
<li><span>@AdminActivityPresentation.Label(item.EventType)</span><time datetime="@item.CreatedAt.ToString("O")">@item.CreatedAt.ToString("MMM d, yyyy h:mm tt")</time></li>
}</ol>
}
</section>
</div>
</div>
