@model AriesMagicAppointmentSystem.ViewModels.SystemActivityIndexViewModel
@using AriesMagicAppointmentSystem.Models
@using AriesMagicAppointmentSystem.ViewModels
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "System Activity"; }
<div class="admin-console">
<header class="admin-heading"><div><p>Dates and times are UTC.</p></div></header>
<div class="am-filter-container">
    <form method="get" asp-action="Index" class="am-filter-bar">
        <div class="am-filter-row">

            <!-- Direct Search Input -->
            <div class="am-filter-search">
                <div class="input-group w-100">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input aria-label="Search records" type="text" name="search" value="@Model?.SearchFilter" class="form-control border-start-0"
                           placeholder="Search action, user, record..." />
                </div>
            </div>

            <!-- Floating Filter Popover Dropdown -->
            <div class="dropdown filter-dropdown-wrapper">
                <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2"
                        type="button"
                        id="filterDropdown"
                        data-bs-toggle="dropdown"
                        data-bs-auto-close="outside"
                        aria-expanded="false">
                    <i class="bi bi-funnel"></i>
                    <span>Filters</span>
                    @if (Model != null && (Model.TypeFilter.HasValue || Model.FromDateFilter.HasValue || Model.ToDateFilter.HasValue))
                    {
                        <span class="filter-active-dot"></span>
                    }
                </button>

                <!-- Floating Card Content -->
                <div class="dropdown-menu dropdown-menu-end filter-popover-menu" aria-labelledby="filterDropdown">
                    <h6 class="fw-bold mb-3">Filter Activities</h6>

                    <div class="mb-3">
                        <label class="form-label" for="SystemActivityIndextype">Activity Type</label>
<select id="SystemActivityIndextype" name="type" class="form-select form-select-sm">
                            <option value="">All Types</option>
                            @if (Model?.ActivityTypes != null)
                            {
                                foreach (var t in Model.ActivityTypes)
                                {
                                    <option value="@((int)t)" selected="@(Model.TypeFilter == t)">@AdminActivityPresentation.Label(t)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="SystemActivityIndexfromDate">From Date</label>
<input id="SystemActivityIndexfromDate" type="date" name="fromDate" value="@(Model?.FromDateFilter?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="SystemActivityIndextoDate">To Date</label>
<input id="SystemActivityIndextoDate" type="date" name="toDate" value="@(Model?.ToDateFilter?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                    </div>

                    <hr class="my-3" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light btn-sm">Clear Filters</a>
                        <button type="submit" class="btn btn-primary btn-sm">Apply Filters</button>
                    </div>
                </div>
            </div>

            <!-- Quick Submit & Clear -->
            <button type="submit" class="btn btn-primary">Search</button>

            @if (Model != null && (!string.IsNullOrEmpty(Model.SearchFilter) || Model.TypeFilter.HasValue || Model.FromDateFilter.HasValue || Model.ToDateFilter.HasValue))
            {
                <a asp-action="Index" class="btn btn-link text-decoration-none text-muted">Clear Filters</a>
            }
        </div>
    </form>
</div>


<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th scope="col">User</th><th scope="col">Role at time</th><th scope="col">Activity</th><th scope="col">Module</th><th scope="col">Target</th><th scope="col">Date &amp; time</th><th scope="col">Result</th></tr></thead><tbody>
@foreach(var activity in Model.Activities) {
<tr>
<td data-label="User">@(activity.PerformedByUserName ?? "Not recorded")</td>
<td data-label="Role at time"><span class="admin-badge">@AdminActivityPresentation.ActorRole(activity)</span></td>
<td data-label="Activity"><div><strong>@AdminActivityPresentation.Label(activity.Type)</strong><details><summary>View Details</summary><p>@activity.Description</p></details></div></td>
<td data-label="Module"><span class="admin-badge">@AdminActivityPresentation.Category(activity.Type)</span></td>
<td data-label="Target">@(activity.AffectedRecordType == null ? "Not recorded" : AdminActivityPresentation.Label(activity.AffectedRecordType) + " #" + activity.AffectedRecordId)</td>
<td data-label="Date & time"><time datetime="@activity.CreatedAt.ToString("O")">@activity.CreatedAt.ToString("MMM d, yyyy h:mm tt")</time></td>
<td data-label="Result"><span class="admin-badge">@AdminActivityPresentation.Result(activity.Type)</span></td>
</tr>
}
</tbody></table>@if(!Model.Activities.Any()) { <p class="admin-empty">No system activity found for the selected filters.</p> }</div>
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    @for (var p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p"
                               asp-route-type="@(Model.TypeFilter?.ToString("d"))"
                               asp-route-fromDate="@(Model.FromDateFilter?.ToString("yyyy-MM-dd"))"
                               asp-route-toDate="@(Model.ToDateFilter?.ToString("yyyy-MM-dd"))"
                               asp-route-search="@Model.SearchFilter">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        }

<p class="admin-note">@Model.TotalCount recorded activities. Historical roles are shown only when recorded.</p>
</div>
