@model AriesMagicAppointmentSystem.ViewModels.SystemActivityIndexViewModel
@using AriesMagicAppointmentSystem.Models
@using AriesMagicAppointmentSystem.ViewModels
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Business Activity"; }
<div class="admin-console">
<header class="admin-heading"><div><p>Dates and times are UTC.</p></div></header>
<div class="am-filter-container">
    <form method="get" asp-action="Index" class="am-filter-bar aries-round3-toolbar" data-aries-round3-filter="true">
        <div class="am-filter-row">

            <!-- Direct Search Input -->
            <div class="am-filter-search">
                <div class="input-group w-100">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input aria-label="Search records" type="text" name="search" value="@Model?.SearchFilter" class="form-control border-start-0"
                           placeholder="Search action, user, record..." />
                </div>
            </div>

            <!-- Floating Filter Popover Dropdown -->
            <div class="dropdown filter-dropdown-wrapper">
                <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2"
                        type="button"
                        id="filterDropdown"
                        data-bs-toggle="dropdown"
                        data-bs-auto-close="outside"
                        aria-expanded="false">
                    <i class="bi bi-funnel" aria-hidden="true"></i>
                    <span>Filters</span>
                    @if (Model != null && (Model.TypeFilter.HasValue || Model.FromDateFilter.HasValue || Model.ToDateFilter.HasValue))
                    {
                        <span class="filter-active-dot"></span>
                    }
                </button>

                <!-- Floating Card Content -->
                <div class="dropdown-menu dropdown-menu-end filter-popover-menu" aria-labelledby="filterDropdown">
                    <h6 class="fw-bold mb-3">Filter Activities</h6>

                    <div class="mb-3">
                        <label class="form-label" for="SystemActivityIndextype">Activity Type</label>
<select id="SystemActivityIndextype" name="type" class="form-select form-select-sm">
                            <option value="">All Types</option>
                            @if (Model?.ActivityTypes != null)
                            {
                                foreach (var t in Model.ActivityTypes)
                                {
                                    <option value="@((int)t)" selected="@(Model.TypeFilter == t)">@BusinessActivityPresentation.Label(t)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="SystemActivityIndexfromDate">From Date</label>
<input id="SystemActivityIndexfromDate" type="date" name="fromDate" value="@(Model?.FromDateFilter?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="SystemActivityIndextoDate">To Date</label>
<input id="SystemActivityIndextoDate" type="date" name="toDate" value="@(Model?.ToDateFilter?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                    </div>

                    <hr class="my-3" />

                    <label for="systemActivitySort" class="form-label">Sort by</label>
                    <select id="systemActivitySort" name="sortBy" class="form-select mb-3">
                      <option value="newest" selected="@((string?)ViewBag.ActivitySort != "oldest")">Newest to Oldest</option>
                      <option value="oldest" selected="@((string?)ViewBag.ActivitySort == "oldest")">Oldest to Newest</option>
                    </select>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset filters</a>
                </div>
            </div>

            <!-- Quick Submit & Clear -->
            <button type="submit" class="visually-hidden">Search</button>

            <a asp-action="Index" class="btn btn-outline-secondary aries-round3-refresh"
               asp-route-page="@Model?.Page" asp-route-search="@Model?.SearchFilter"
               asp-route-type="@(Model?.TypeFilter?.ToString("d"))"
               asp-route-fromDate="@(Model?.FromDateFilter?.ToString("yyyy-MM-dd"))"
               asp-route-toDate="@(Model?.ToDateFilter?.ToString("yyyy-MM-dd"))"
               asp-route-sortBy="@ViewBag.ActivitySort" aria-label="Refresh business activity"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i><span>Refresh</span></a>
        </div>
    </form>
</div>


<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th scope="col">User</th><th scope="col">Role at time</th><th scope="col">Activity</th><th scope="col">Module</th><th scope="col">Target</th><th scope="col">Date &amp; time</th><th scope="col">Result</th></tr></thead><tbody>
@foreach(var activity in Model.Activities) {
<tr>
<td data-label="User">@(activity.PerformedByUserName ?? "Not recorded")</td>
<td data-label="Role at time"><span class="admin-badge">@BusinessActivityPresentation.ActorRole(activity)</span></td>
<td data-label="Activity"><div><strong>@BusinessActivityPresentation.Label(activity.Type)</strong><details><summary>View Details</summary><p>@activity.Description</p></details></div></td>
<td data-label="Module"><span class="admin-badge">@BusinessActivityPresentation.Category(activity.Type)</span></td>
<td data-label="Target">@(activity.AffectedRecordType == null ? "Not recorded" : BusinessActivityPresentation.Label(activity.AffectedRecordType) + " #" + activity.AffectedRecordId)</td>
<td data-label="Date & time"><time datetime="@activity.CreatedAt.ToString("O")">@activity.CreatedAt.ToString("MMM d, yyyy h:mm tt")</time></td>
<td data-label="Result"><span class="admin-badge @(BusinessActivityPresentation.Result(activity.Type) == "Success" ? "admin-state-success" : "admin-state-neutral")">@BusinessActivityPresentation.Result(activity.Type)</span></td>
</tr>
}
</tbody></table>@if(!Model.Activities.Any()) { <p class="admin-empty">No business activity found for the selected filters.</p> }</div>
        @{
            var activityPager = new AriesMagicAppointmentSystem.ViewModels.QueuePaginationViewModel(
                Model.TotalCount, Model.Page, 5, "Index", new Dictionary<string,string> {
                    ["type"] = Model.TypeFilter?.ToString("d") ?? "",
                    ["fromDate"] = Model.FromDateFilter?.ToString("yyyy-MM-dd") ?? "",
                    ["toDate"] = Model.ToDateFilter?.ToString("yyyy-MM-dd") ?? "",
                    ["search"] = Model.SearchFilter ?? "",
                    ["sortBy"] = (string?)ViewBag.ActivitySort ?? "newest"
                });
        }
        <partial name="_QueuePagination" model="activityPager" />

<p class="admin-note">@Model.TotalCount recorded activities. Historical roles are shown only when recorded.</p>
</div>
